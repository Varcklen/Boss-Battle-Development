  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope SpawnBoss initializer init\r\n\t\r\n\tfunction Trig_SpawnBoss_Conditions takes nothing returns boolean\r\n\t    return IsUnitType(GetEnteringUnit(), UNIT_TYPE_ANCIENT) and GetUnitAbilityLevel( GetEnteringUnit(), 'A1ID' ) == 0 \r\n\tendfunction\r\n\t\r\n\t/*\r\n\tIgnore List:\r\n\tCamouflage\r\n\tSuperbot\r\n\tPortal (Seiber)\r\n\tSmall Portal (Seiber)\r\n\tPortal (Vendigo)\r\n\tSiege Engine (Engi Master)\r\n\tDummy (Ogre)\r\n\t*/\r\n\t\r\n\tfunction StartFightCall takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local integer n = LoadInteger( udg_hash, id, StringHash( \"bcalln\" ) )\r\n\t    local integer s = LoadInteger( udg_hash, id, StringHash( \"bcalls\" ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bcall\" ) )\r\n\t    \r\n\t    if IsUnitAlive( boss) and IsUnitHiddenBJ(boss) == false then\r\n\t        call TransmissionFromUnitWithNameBJ( bj_FORCE_ALL_PLAYERS, boss, null, Boss_Talk[n][s], null, bj_TIMETYPE_SET, 1, false )\r\n\t    endif\r\n\t    \r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function BossCall takes unit u returns nothing\r\n\t\tlocal integer id\r\n\t\tlocal integer bossLevel = BossSpawn_GetBossKeyLevel(u)\r\n\t\tlocal integer bossIndex = BossSpawn_GetBossKeyIndex(u)\r\n\t\t\r\n\t\tif Boss_Talk[bossLevel][bossIndex] == null then\r\n\t        return\r\n\t    endif\r\n\t    \r\n\t    set id = GetHandleId( u )\r\n        if LoadTimerHandle( udg_hash, id, StringHash( \"bcall\" ) ) == null  then\r\n            call SaveTimerHandle( udg_hash, id, StringHash( \"bcall\" ), CreateTimer() )\r\n        endif\r\n        set id = GetHandleId( LoadTimerHandle( udg_hash, id, StringHash( \"bcall\" ) ) ) \r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bcall\" ), u )\r\n        call SaveInteger( udg_hash, id, StringHash( \"bcalln\" ), bossLevel )\r\n        call SaveInteger( udg_hash, id, StringHash( \"bcalls\" ), bossIndex )\r\n        call TimerStart( LoadTimerHandle( udg_hash, GetHandleId( u ), StringHash( \"bcall\" ) ), 5, false, function StartFightCall )\r\n\tendfunction\r\n\t\r\n\tprivate function EnableBossTriggers takes unit boss returns nothing\r\n\t\tlocal integer bossLevel = BossSpawn_GetBossKeyLevel(boss)\r\n\t\tlocal integer bossIndex = BossSpawn_GetBossKeyIndex(boss)\r\n\t\tlocal integer bossTriggerIndex\r\n\t\tlocal integer bossTriggerIndexInit\r\n\t\tlocal integer i\r\n\t\tlocal trigger triggerCheck\r\n\t\t\r\n\t\t//call BJDebugMsg(\"bossLevel: \" + I2S(bossLevel))\r\n\t\t\r\n\t\tif bossLevel == 0 then\r\n\t\t\treturn\r\n\t\tendif\r\n\t\t\r\n\t\tset bossTriggerIndexInit = ( bossIndex - 1 ) * 10\r\n\t\tset i = 1\r\n\t\t\r\n\t\t/*call BJDebugMsg(\"bossIndex: \" + I2S(bossIndex))\r\n\t\tcall BJDebugMsg(\"bossTriggerIndexInit: \" + I2S(bossTriggerIndexInit))\r\n\t\tcall BJDebugMsg(\"==========================\")*/\r\n\t\tloop\r\n            set bossTriggerIndex = bossTriggerIndexInit + i\r\n            //call BJDebugMsg(\"bossTriggerIndex: \" + I2S(bossTriggerIndex))\r\n            set triggerCheck = DB_Trigger_Boss[bossLevel][bossTriggerIndex]\r\n            if triggerCheck == null then\r\n            \t//call BJDebugMsg(\"null\")\r\n            \texitwhen true\r\n            endif\r\n            //call BJDebugMsg(\"Enabled!\")\r\n            call EnableTrigger( triggerCheck )\r\n            set i = i + 1\r\n        endloop\r\n\tendfunction\r\n\t\r\n\tfunction Trig_SpawnBoss_Actions takes nothing returns nothing\r\n\t    local unit u = GetEnteringUnit()\r\n\t    \r\n\t    /*Set Base Armor*/\r\n\t    call BlzSetUnitArmor( u, BASE_BOSS_ARMOR )\r\n\t    call BlzSetUnitRealFieldBJ( u, UNIT_RF_ACQUISITION_RANGE, 9999 )\r\n\t\r\n\t\tif udg_Endgame > 1 then\r\n\t        call BlzSetUnitBaseDamage( u, R2I(GetUnitDamage(u) * udg_Endgame - GetUnitAvgDiceDamage(u)), 0 )\r\n\t        call BlzSetUnitMaxHP( u, R2I(BlzGetUnitMaxHP(u) * udg_Endgame) )\r\n\t\tendif\r\n\t\r\n\t    if not( RectContainsUnit( udg_Boss_Rect, u) ) then\r\n\t        call SetUnitPositionLoc( u, GetRectCenter( udg_Boss_Rect ) )\r\n\t    endif\r\n\t\r\n\t\tif GetUnitAbilityLevel( u, 'A1HW') == 0 then\r\n\t\t\tcall SetUnitLifeBJ( u, GetUnitStateSwap(UNIT_STATE_MAX_LIFE, u) )\r\n\t\tendif\r\n\t\r\n\t    call RemoveGuardPosition(u)\r\n\t    if ( GetUnitTypeId(u) == 'n00F' and CountLivingPlayerUnitsOfTypeId('o006', GetOwningPlayer(u)) == 0 ) or GetUnitTypeId(u) != 'n00F' then\r\n\t    \tcall EnableBossTriggers(u)\r\n\t    else\r\n\t        call GroupAddUnit( udg_Bosses, u )\r\n\t        return\r\n\t    endif\r\n\t    \r\n\t    if udg_fightmod[4] and GetUnitTypeId(u) != 'e000' then\r\n\t        call dummyspawn( u, 1, 0, 0, 0 ) \r\n\t        call UnitDamageTarget( bj_lastCreatedUnit, u, 1, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)\r\n\t    endif\r\n\t    \r\n\t    call BossCall(u)\r\n\t    \r\n\t    if GetUnitTypeId(u) == 'n00A' then \r\n\t        call ShowUnitHide( udg_UNIT_CUTE_BOB )\r\n\t    endif\r\n\t\r\n\t    if GetOwningPlayer(u) == Player(10) then\r\n\t        call GroupAddUnit( udg_Bosses, u )\r\n\t    endif\r\n\t    set u = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_SpawnBoss = CreateTrigger(  )\r\n\t    call TriggerRegisterEnterRectSimple( gg_trg_SpawnBoss, GetWorldBounds() )\r\n\t    call TriggerAddCondition( gg_trg_SpawnBoss, Condition( function Trig_SpawnBoss_Conditions ) )\r\n\t    call TriggerAddAction( gg_trg_SpawnBoss, function Trig_SpawnBoss_Actions )\r\n\tendfunction\r\nendscope\r\n",
  "Events": [],
