  "Script": "scope StartFightWork\r\n\tglobals\r\n\t\tunit MainBoss = null\r\n\t\tunit SecondBoss = null\r\n\t\t\r\n\t\tprivate location array HeroSpawn\r\n\t\t\r\n\t\tprivate integer FirstBossType\r\n\t\tprivate integer SecondBossType\r\n\t\t\r\n\t\tprivate real BossSpawnX\r\n\t\tprivate real BossSpawnY\r\n\tendglobals\r\n\t\r\n\tprivate function IsSmallArena takes nothing returns boolean\r\n\t\tlocal integer firstBossChoise = BossArenaChoise[udg_Boss_LvL][udg_Boss_Random]\r\n\t\tlocal integer secondBossChoise = 0\r\n\t\t\r\n\t\tif DoubleTrouble_IsEnabled() then\r\n\t\t\tset secondBossChoise = BossArenaChoise[udg_Boss_LvL][udg_Boss_Random]\r\n\t\tendif\r\n\t\t\r\n\t\tif firstBossChoise == ARENA_TYPE_SMALL and secondBossChoise == firstBossChoise then\r\n\t\t\treturn true\r\n\t\telseif firstBossChoise == ARENA_TYPE_SMALL and secondBossChoise == 0 then\r\n\t\t\treturn true\r\n\t\tendif\r\n\t\t\r\n\t\treturn false\r\n\tendfunction\r\n\t\r\n\tprivate function SetArenaType takes nothing returns nothing\r\n\t\tif IsSmallArena() then\r\n\t        set udg_Boss_Rect = gg_rct_ArenaBossSmall\r\n\t        set udg_Boss_BigRect = gg_rct_Vision4\r\n\t\t\tset HeroSpawn[1] = udg_point[30]\r\n\t\t\tset HeroSpawn[2] = udg_point[31]\r\n\t\t\tset HeroSpawn[3] = udg_point[32]\r\n\t\t\tset HeroSpawn[4] = udg_point[33]\r\n\t\t\tset BossSpawnX = GetRectCenterX(gg_rct_BossSpawnSmall)\r\n\t\t\tset BossSpawnY = GetRectCenterY(gg_rct_BossSpawnSmall)\r\n\t\telse\r\n\t        set udg_Boss_Rect = gg_rct_ArenaBoss\r\n\t        set udg_Boss_BigRect = gg_rct_Vision2\r\n\t\t\tset HeroSpawn[1] = udg_point[5]\r\n\t\t\tset HeroSpawn[2] = udg_point[6]\r\n\t\t\tset HeroSpawn[3] = udg_point[7]\r\n\t\t\tset HeroSpawn[4] = udg_point[8]\r\n\t\t\tset BossSpawnX = GetRectCenterX(gg_rct_BossSpawn)\r\n\t\t\tset BossSpawnY = GetRectCenterY(gg_rct_BossSpawn)\r\n\t\tendif\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnHeroes takes nothing returns nothing\r\n\t\tlocal integer i = 1\r\n\t\tlocal integer k = 1\r\n\t\tlocal unit hero \r\n\t\tloop\r\n\t        exitwhen i > 4\r\n\t        if GetPlayerSlotState( Player( i - 1 ) ) == PLAYER_SLOT_STATE_PLAYING then\r\n\t        \tset hero = udg_hero[i]\r\n\t            call SetUnitPositionLoc( hero, HeroSpawn[i] )\r\n\t            call SetUnitFacing( hero, 90 )\r\n\t            call PanCameraToTimedLocForPlayer( Player( i - 1 ), HeroSpawn[i], 0 )\r\n\t            call DestroyEffect( AddSpecialEffect( \"Void Teleport Caster.mdx\", GetUnitX( hero ), GetUnitY( hero ) ) )\r\n\t            \r\n\t            set k = 1\r\n\t            loop\r\n\t                exitwhen k > 6\r\n\t                if k != udg_Boss_Random then\r\n\t                    call UnitRemoveAbility( udg_unit[i + 17], Boss_Info[udg_Boss_LvL][k] )\r\n\t                endif\r\n\t                set k = k + 1\r\n\t            endloop\r\n\t        endif\r\n\t        set i = i + 1\r\n\t    endloop\r\n\t    \r\n\t    set hero = null\r\n\tendfunction\r\n\t\r\n\tprivate function SetBossType takes nothing returns nothing\r\n\t\tset FirstBossType = DB_Boss_id[udg_Boss_LvL][udg_Boss_Random]\r\n\t\tset SecondBossType = DB_Boss_id[udg_Boss_LvL][SecondBossIndex]\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnBosses takes real x, real y returns nothing\r\n\t\tlocal unit boss = null\r\n\t    local unit boss2 = null\r\n\r\n\t\tif DoubleTrouble_IsEnabled() and udg_Boss_LvL != 1 then\r\n\t        set boss = BossSpawn_Create( Player(10), FirstBossType, x - 600, y, 270, udg_Boss_LvL, udg_Boss_Random )\r\n\t        set boss2 = BossSpawn_Create( Player(10), SecondBossType, x + 600, y, 270, udg_Boss_LvL, SecondBossIndex )\r\n\t        \r\n\t        set SecondBoss = boss2\r\n\t    else\r\n\t        set boss = BossSpawn_Create( Player(10), FirstBossType, x, y, 270, udg_Boss_LvL, udg_Boss_Random )\r\n\t    endif\r\n\t    set MainBoss = boss\r\n\t\r\n\t\tif boss != null then\r\n\t        set bossbar = boss\r\n\t    endif\r\n\t    if boss2 != null then\r\n\t        set bossbar1 = boss2\r\n\t    endif\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnIconFrame takes nothing returns nothing\r\n\t\tlocal integer data\r\n\t\r\n\t\tif udg_Boss_LvL < 10 then\r\n\t\t\tset data = Boss_Info[udg_Boss_LvL][udg_Boss_Random]\r\n\t        call IconFrame( \"boss\", BlzGetAbilityIcon(data), BlzGetAbilityTooltip(data, 0), BlzGetAbilityExtendedTooltip(data, 0) )\r\n        endif\r\n        \r\n        if SecondBossIndex != 0 then\r\n\t        set data = Boss_Info[udg_Boss_LvL][SecondBossIndex]\r\n\t        call IconFrame( \"second boss\", BlzGetAbilityIcon(data), BlzGetAbilityTooltip(data, 0), BlzGetAbilityExtendedTooltip(data, 0) )\r\n        endif\r\n\tendfunction\r\n\t\r\n\tprivate function FirstBattleInit takes nothing returns nothing\r\n\t\tif udg_Boss_LvL != 1 then\r\n\t\t\treturn\r\n\t    endif\r\n\t    \r\n\t    set udg_UntilFirstFight = false\r\n        set udg_LogicModes = false\r\n        call BlzFrameSetVisible( rpkmod, false)\r\n        call BlzFrameSetVisible( reselectionButton, false)\r\n\tendfunction\r\n\t\r\n\tfunction StartFight takes nothing returns nothing\r\n\t\r\n\t    set udg_fightmod[1] = true\r\n\t    call FightStart()\r\n\t    \r\n\t    call SetBossType()\r\n\t\tcall SetArenaType()\r\n\t\tcall SpawnHeroes()\r\n\t\tcall SpawnIconFrame()\r\n\t\r\n\t\tcall MainBattleHeroDeath_Enable()\r\n\t    call EnableTrigger( CalculateDPS_Trigger )\r\n\t    call EnableTrigger( gg_trg_MinionsTeleportation )\r\n\t    \r\n\t    call FirstBattleInit()\r\n\r\n\t\tcall SpawnBosses(BossSpawnX, BossSpawnY)\r\n\r\n\t    call AUI_TimerGo()\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tfunction InitTrig_StartFightWork takes nothing returns nothing\r\n\t    set gg_trg_StartFightWork = CreateTrigger(  )\r\n\t    call TriggerAddAction( gg_trg_StartFightWork, function StartFight )\r\n\tendfunction\r\n\t\r\nendscope",
