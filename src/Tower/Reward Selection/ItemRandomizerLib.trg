{
  "Id": 50332077,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "library ItemRandomizerLib initializer init requires SetRaritySpawnLib, Trigger, StartingBonus\r\n\r\n    globals \r\n        boolean IsItemsRefreshed = false\r\n\r\n        real Event_ItemRewardCreate_Real\r\n        unit Event_ItemRewardCreate_Hero\r\n        integer Event_ItemRewardCreate_Position\r\n        integer Event_ItemRewardCreate_ItemReward\r\n        \r\n        real Event_SpawnRewards_Real\r\n        player Event_SpawnRewards_Player\r\n        integer Event_SpawnRewards_Index\r\n        \r\n        constant integer ITEM_RARITY_COMMON = 1\r\n        constant integer ITEM_RARITY_RARE = 2\r\n        constant integer ITEM_RARITY_LEGENDARY = 3\r\n        \r\n        private constant integer REWARD_CHOISE_PER_PLAYER = 3\r\n        private constant integer MAX_REWARD_AMOUNT = REWARD_CHOISE_PER_PLAYER * 4\r\n        private constant integer AMOUNT_OF_REWARD_SELECTIONS_PER_ROUND = 1\r\n        \r\n        public item array Reward[13]\r\n        //private boolean array AnyRewardSelectedThisRound[4]\r\n        \r\n        private integer array RewardSelectionsAvailable[4]\r\n        private integer array IsFirstOption[4]\r\n    endglobals\r\n    \r\n    public function AddRewardSelectionOption takes player usedPlayer, integer valueToAdd returns nothing\r\n\t\tlocal integer playerId = GetPlayerId(usedPlayer)\r\n\t\t\r\n\t\tset RewardSelectionsAvailable[playerId] = RewardSelectionsAvailable[playerId] + valueToAdd\r\n\tendfunction\r\n\t\r\n\tpublic function GetAmountOfRewardSelectionOptions takes player usedPlayer returns integer\r\n\t\tlocal integer playerId = GetPlayerId(usedPlayer)\r\n\t\t\r\n\t\treturn RewardSelectionsAvailable[playerId]\r\n\tendfunction\r\n\t\r\n\tprivate function RarityToValue takes string rarity returns integer\r\n\t\tif rarity == \"legendary\" then\r\n            return 3\r\n        elseif rarity == \"rare\" then\r\n            return 2\r\n        elseif rarity == \"common\" then\r\n            return 1\r\n        endif\r\n        return 0\r\n    endfunction\r\n    \r\n    public function GetRandomRarity takes nothing returns integer\r\n    \tlocal integer rand = GetRandomInt(1, 100)\r\n        if rand <= udg_RarityChance[3] then\r\n            return 3\r\n        elseif rand > udg_RarityChance[3] and rand <= udg_RarityChance[2] then\r\n            return 2\r\n        elseif rand > udg_RarityChance[2] then\r\n            return 1\r\n        endif\r\n        call BJDebugMsg(\"Error! ItemRandomizerLib_GetRandomRarity: Value out of range: rand: \" + I2S(rand) + \", udg_RarityChance[3]: \" + I2S(udg_RarityChance[3]) + \", udg_RarityChance[2]: \" + I2S(udg_RarityChance[2]) + \", udg_RarityChance[1]: \" + I2S(udg_RarityChance[1]) )\r\n        return 0\r\n    endfunction\r\n    \r\n    private function IsItemExist takes integer rarity, integer index returns boolean\r\n        local integer i = 1\r\n\r\n        loop\r\n            exitwhen i > 4\r\n            if inv( udg_hero[i], DB_Items[rarity][index] ) > 0 then\r\n                return true\r\n            endif\r\n            set i = i + 1\r\n        endloop\r\n        return false\r\n    endfunction\r\n\r\n    function ItemCreate_ItemPosition takes integer c, integer index returns boolean\r\n        if index > 3 then\r\n            set index = 3\r\n        elseif index < 1 then\r\n            set index = 1\r\n        endif\r\n        return c == index or c == (3+index) or c == (6+index) or c == (9+index)\r\n    endfunction\r\n\r\n    function ItemCreate takes integer index, integer position /*1-3*/, integer globalPosition /*1-12*/ returns item\r\n        local real x = GetLocationX(udg_itemcentr[globalPosition])\r\n        local real y = GetLocationY(udg_itemcentr[globalPosition])\r\n        local integer currentIndex = index\r\n        \r\n        if IsBookOfLegendsActive == false then \r\n\t        set Event_ItemRewardCreate_Hero = udg_hero[position]\r\n\t        set Event_ItemRewardCreate_Position = globalPosition\r\n\t        set Event_ItemRewardCreate_ItemReward = 0\r\n\t        \r\n\t        set Event_ItemRewardCreate_Real = 0.00\r\n\t        set Event_ItemRewardCreate_Real = 1.00\r\n\t        set Event_ItemRewardCreate_Real = 0.00\r\n\t        \r\n\t        set currentIndex = Event_ItemRewardCreate_ItemReward\r\n\t        \r\n\t        if inv(udg_hero[position], 'I01I') > 0 and ItemCreate_ItemPosition(globalPosition, 2) then\r\n\t            set currentIndex = udg_DB_Item_Destroyed[GetRandomInt(1,udg_Database_NumberItems[29])]\r\n\t        elseif inv(udg_hero[position], 'I0FT') > 0 and ItemCreate_ItemPosition(globalPosition, 3) then\r\n\t            set currentIndex = DB_SetItems[7][GetRandomInt(1,udg_DB_SetItems_Num[7])]\r\n\t        elseif udg_FutureBall[position] != 0 then\r\n\t            set currentIndex = udg_FutureBall[position]\r\n\t            set udg_FutureBall[position] = 0\r\n\t            call ChangeToolItem( udg_hero[position], 'I0FH', \"Future: \", \")|r\", \"Nothing\" )\r\n\t        elseif currentIndex == 0 then\r\n\t            set currentIndex = index\r\n\t        endif\r\n        endif\r\n        \r\n        set Reward[globalPosition] = CreateItem( currentIndex, x, y)\r\n        \r\n        if GetItemType(Reward[globalPosition]) == ITEM_TYPE_ARTIFACT then\r\n            call SpecialEffectAngle( \"Abilities\\\\Spells\\\\Human\\\\Resurrect\\\\ResurrectCaster.mdl\", 270, x, y )\r\n        else\r\n            call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Polymorph\\\\PolyMorphDoneGround.mdl\", x, y ) )\r\n        endif\r\n        \r\n        if GetItemTypeId(Reward[globalPosition]) == 'I0FC' then\r\n            set udg_LastReward[globalPosition] = LoadInteger( udg_hash, GetHandleId(Reward[globalPosition]), StringHash( \"modbad25\" ) )\r\n        else\r\n            set udg_LastReward[globalPosition] = GetItemTypeId(Reward[globalPosition])\r\n        endif\r\n        return Reward[globalPosition]\r\n    endfunction\r\n\r\n    /*private function ItemSpawn takes boolean a, boolean b, boolean c, boolean d returns nothing\r\n        local integer array i\r\n        local boolean array k\r\n        local integer cyclA\r\n        local integer cyclB\r\n        local integer cyclBEnd\r\n        local integer cyclC\r\n        local boolean l\r\n        local integer j\r\n        local integer m\r\n        local boolean h\r\n        local integer f\r\n\r\n        set k[0] = a\r\n        set k[1] = b\r\n        set k[2] = c\r\n        set k[3] = d\r\n        \r\n        set cyclA = 1\r\n        loop\r\n            exitwhen cyclA > 4\r\n            if k[cyclA-1] then\r\n                set udg_ItemGetChoosed[cyclA] = false\r\n                set udg_ItemGetActive[cyclA] = true\r\n            endif\r\n            set cyclA = cyclA + 1\r\n        endloop\r\n        \r\n        //call BJDebugMsg(\"ItemSpawn udg_ItemGetActive[1]: \" + B2S(udg_ItemGetActive[1]))\r\n        \r\n        set i[1] = GetRandomInt(1, udg_Database_NumberItems[udg_itemrarity[1]])\r\n        set cyclA = 2\r\n        loop\r\n            exitwhen cyclA > MAX_REWARD_AMOUNT\r\n            set f = udg_itemrarity[cyclA]\r\n            set i[cyclA] = GetRandomInt(1, udg_Database_NumberItems[f])\r\n            if not(udg_Dublicate) and GetPlayerSlotState(Player((cyclA - 1)/3)) == PLAYER_SLOT_STATE_PLAYING then\r\n                set cyclB = 1\r\n                set cyclBEnd = cyclA - 1\r\n                loop\r\n                    exitwhen cyclB > cyclBEnd\r\n                    if i[cyclA] == i[cyclB] and f == udg_itemrarity[cyclB] and f != 0 then\r\n                        set cyclA = cyclA - 1\r\n                        set cyclB = cyclBEnd\r\n                    endif\r\n                    set cyclB = cyclB + 1\r\n                endloop\r\n            endif\r\n            set cyclA = cyclA + 1\r\n        endloop\r\n\r\n        set cyclA = 1\r\n        loop\r\n            exitwhen cyclA > MAX_REWARD_AMOUNT\r\n            set j = (cyclA - 1)/3\r\n            set f = udg_itemrarity[cyclA]\r\n            set m = 0\r\n            if GetPlayerSlotState(Player( j )) == PLAYER_SLOT_STATE_PLAYING and k[j] then\r\n                set cyclB = 1\r\n                loop\r\n                    exitwhen cyclB > 1\r\n                    set cyclC = 1\r\n                    set l = false\r\n                    loop\r\n                        exitwhen cyclC > MAX_REWARD_AMOUNT\r\n                        if GetItemTypeId(Reward[cyclC]) == DB_Items[f][i[cyclA]] then\r\n                            set l = true\r\n                            set cyclC = MAX_REWARD_AMOUNT\r\n                        endif\r\n                        set cyclC = cyclC + 1\r\n                    endloop\r\n                    set cyclC = 1\r\n                    loop\r\n                        exitwhen cyclC > 4\r\n                        if inv( udg_hero[cyclC], DB_Items[f][i[cyclA]] ) > 0 then\r\n                            set l = true\r\n                            set cyclC = 4\r\n                        endif\r\n                        set cyclC = cyclC + 1\r\n                    endloop\r\n                    if l and not(udg_Dublicate) and m < 10 then\r\n                        if i[cyclA] != 1 then\r\n                            set i[cyclA] = i[cyclA] - 1\r\n                            set m = m + 1\r\n                        else\r\n                            set i[cyclA] = udg_Database_NumberItems[f]\r\n                        endif\r\n                        set cyclB = cyclB - 1\r\n                    else\r\n                        call ItemCreate(DB_Items[f][i[cyclA]], j+1, cyclA )\r\n                    endif\r\n                    set cyclB = cyclB + 1\r\n                endloop\r\n            endif\r\n            set cyclA = cyclA + 1\r\n        endloop\r\n    endfunction*/\r\n\r\n    function ItemRandomizerAll takes unit caster, /*obsolete*/integer it returns item\r\n        local integer randl = GetRandomInt(1, 100)\r\n        local integer cyclA = 1\r\n        local integer rand\r\n        local integer rarity = 0\r\n\r\n        set udg_ItemBuf = null\r\n        if randl <= udg_RarityChance[3] then\r\n            set rarity = 3\r\n        elseif randl >= udg_RarityChance[3]+1 and randl <= udg_RarityChance[2] then\r\n            set rarity = 2\r\n        elseif randl >= udg_RarityChance[2]+1 then\r\n            set rarity = 1\r\n        endif\r\n        set rand = GetRandomInt(1, udg_Database_NumberItems[rarity])\r\n        set udg_ItemBuf = CreateItem(DB_Items[rarity][rand], GetUnitX(caster), GetUnitY(caster) )\r\n        \r\n        if udg_ItemBuf != null then\r\n            call UnitAddItem( caster, udg_ItemBuf )\r\n            set bj_lastCreatedItem = udg_ItemBuf\r\n        endif\r\n        set caster = null\r\n        return udg_ItemBuf\r\n    endfunction\r\n\r\n    function ItemRandomizer takes unit caster, string str returns item\r\n        local integer rand = GetRandomInt(1, 100)\r\n        local integer cyclA = 1\r\n        local integer i\r\n        local integer it\r\n        local integer r\r\n        local integer k = 0\r\n        \r\n        set bj_lastCreatedItem = null\r\n        if UnitInventoryCount(caster) < 6 then \r\n            set i = RarityToValue(str)\r\n            \r\n            set r = GetRandomInt(1, udg_Database_NumberItems[i])\r\n\t\t\tset it = DB_Items[i][r]\r\n            set bj_lastCreatedItem = CreateItem( it, GetUnitX(caster), GetUnitY(caster) )\r\n            call UnitAddItem( caster, bj_lastCreatedItem )\r\n        endif\r\n        set caster = null\r\n        return bj_lastCreatedItem\r\n    endfunction\r\n    \r\n    //Return item from the set\r\n    function ItemRandomizerSet takes unit caster, integer it, integer settag returns item\r\n        local integer rand = GetRandomInt(1, udg_DB_SetItems_Num[settag])\r\n        set udg_ItemBuf = null\r\n        set udg_ItemBuf = CreateItem(DB_SetItems[settag][rand], GetUnitX(caster), GetUnitY(caster) )\r\n        \r\n        if udg_ItemBuf != null then\r\n            call UnitAddItem( caster, udg_ItemBuf )\r\n            set bj_lastCreatedItem = udg_ItemBuf\r\n        endif\r\n        set caster = null\r\n        return udg_ItemBuf\r\n    endfunction\r\n\r\n    function ItemRandomizerItemId takes unit caster, string str returns integer\r\n        //local integer rand = GetRandomInt(1, 100)\r\n        local integer cyclA = 1\r\n        local integer i\r\n        local integer it = 0\r\n        local integer r\r\n        local integer k = 0\r\n        \r\n        set i = RarityToValue(str)\r\n        \r\n        set r = GetRandomInt(1, udg_Database_NumberItems[i])\r\n        set it = DB_Items[i][r]\r\n        \r\n        set caster = null\r\n        return it\r\n    endfunction\r\n    \r\n    \r\n    //================= New Version ================= \r\n    \r\n    //======= Spawn Reward =======\r\n    \r\n    private function GetItemRarity takes integer playerId, integer position returns integer\r\n    \tif IsBookOfLegendsActive then\r\n    \t\treturn ITEM_RARITY_LEGENDARY\r\n    \tendif\r\n    \tif position == 3 and inv( udg_hero[playerId + 1], 'I0BU' ) > 0 then\r\n    \t\treturn ITEM_RARITY_RARE\r\n    \tendif\r\n    \t\r\n    \treturn GetRandomRarity()\r\n    endfunction\r\n    \r\n    private function IsDublicate takes integer itemId, ListInt exceptions, player playerUsed returns boolean\r\n    \tlocal integer i\r\n    \tlocal integer iMax\r\n    \tif udg_Dublicate then\r\n    \t\treturn true\r\n    \tendif\r\n    \tif GetPlayerSlotState(playerUsed) != PLAYER_SLOT_STATE_PLAYING then\r\n    \t\treturn true\r\n    \tendif\r\n    \t\r\n    \tset i = 0\r\n    \tset iMax = exceptions.Size\r\n    \tloop\r\n    \t\texitwhen i >= iMax\r\n    \t\tif itemId == exceptions.GetIntegerByIndex(i) then\r\n    \t\t\treturn false\r\n    \t\tendif\r\n\t\t\tset i = i + 1\r\n\t\tendloop\r\n    \t\r\n    \treturn true\r\n    endfunction\r\n    \r\n    private function AddExceptions takes ListInt exceptions returns nothing\r\n    \tlocal integer i\r\n    \tlocal integer k\r\n    \tlocal item itemCheck\r\n    \t\r\n    \tset i = 1\r\n        loop\r\n            exitwhen i > 4\r\n            if GetPlayerSlotState(Player( i - 1 )) == PLAYER_SLOT_STATE_PLAYING then\r\n\t\t\t\tset k = 0\r\n                loop\r\n                    exitwhen k > 5\r\n                    set itemCheck = UnitItemInSlot( udg_hero[i], k )\r\n                    if itemCheck != null then\r\n                        call exceptions.Add(GetItemTypeId(itemCheck))\r\n                    endif\r\n                    set k = k + 1\r\n                endloop\r\n            endif\r\n            set i = i + 1\r\n        endloop\r\n\r\n    \tset itemCheck = null\r\n    endfunction\r\n    \r\n    private function GetItemId takes integer position, integer rawValue, player playerUsed, ListInt exceptions, integer itemRarity returns integer\r\n    \tlocal integer itemId = 0\r\n    \tlocal integer rand \r\n    \tloop \r\n    \t\tset rand = GetRandomInt(1, udg_Database_NumberItems[itemRarity])\r\n    \t\tset itemId = DB_Items[itemRarity][rand]\r\n    \t\t//call BJDebugMsg(\"itemId check: \" + I2S(itemId))\r\n    \t\tif IsDublicate(itemId, exceptions, playerUsed) then\r\n    \t\t\t//call BJDebugMsg(\"exitwhen true\")\r\n    \t\t\texitwhen true\r\n    \t\tendif\r\n\t\tendloop\r\n\t\t\r\n\t\t//call BJDebugMsg(\"itemId result: \" + I2S(itemId))\r\n\t\t\r\n\t\tcall exceptions.Add(itemId)\r\n\t\t\r\n\t\t//call BJDebugMsg(\"itemId end: \" + I2S(itemId))\r\n\t\treturn itemId\r\n    endfunction\r\n    \r\n    private function SpawnReward takes integer position, integer rawValue, player playerUsed, ListInt exceptions returns item\r\n    \tlocal integer playerId = GetPlayerId(playerUsed)\r\n    \tlocal integer rarity = GetItemRarity(playerId, position)\r\n    \tlocal item itemSpawned = null\r\n    \tlocal integer itemId = 0\r\n\r\n\t\t/*call BJDebugMsg(\"-----------------------------------\")\r\n\t\tcall BJDebugMsg(\"SpawnReward\")*/\r\n    \tset itemId = GetItemId(position, rawValue, playerUsed, exceptions, rarity)\r\n\t\tset itemSpawned = ItemCreate( itemId, position, rawValue)\r\n\r\n\t\t/*call BJDebugMsg(\"SpawnReward Result: \" + GetItemName(itemSpawned))\r\n\t\tcall BJDebugMsg(\"Rarity: \" + I2S(rarity))\r\n\t\tcall BJDebugMsg(\"position: \" + I2S(position))\r\n\t\tcall BJDebugMsg(\"rawValue: \" + I2S(rawValue))\r\n\t\tcall BJDebugMsg(\"itemId: \" + I2S(itemId))*/\r\n    \t\r\n    \treturn itemSpawned\r\n    endfunction\r\n   \r\n    \r\n    //======= Spawn Reward End =======\r\n    \r\n    \r\n    private function IsRewardValidToCreate takes integer position, unit hero, integer playerId returns boolean\r\n    \tif position == 2 and inv( hero, 'I0AC' ) > 0 and udg_logic[playerId + 1 + 26] == false then\r\n    \t\treturn false\r\n    \tendif\r\n    \treturn true\r\n    endfunction\r\n    \r\n    private function SpawnRewardsForPlayer takes player playerUsed, ListInt exceptions returns nothing\r\n    \tlocal integer i = 1\r\n    \tlocal integer playerId = GetPlayerId(playerUsed)\r\n    \tlocal integer rawValue\r\n    \tlocal unit hero = udg_hero[playerId + 1]\r\n    \tlocal integer currentAmountOfOptions = GetAmountOfRewardSelectionOptions(playerUsed)\r\n    \t\r\n    \t//call BJDebugMsg(\"SpawnRewardsForPlayer: \" + GetPlayerName(playerUsed))\r\n    \t\r\n    \tif GetPlayerSlotState(playerUsed) != PLAYER_SLOT_STATE_PLAYING then\r\n    \t\treturn\r\n    \tendif\r\n    \tset IsFirstOption[playerId + 1] = IsFirstOption[playerId + 1] - 1\r\n    \tif IsItemsRefreshed == false then\r\n\t    \tif currentAmountOfOptions <= 0 then\r\n\t    \t\tif IsFirstOption[playerId + 1] == 0 then\r\n\t\t\t        set Event_RewardsRefuse_Player = playerUsed\r\n\t\t\t        set Event_RewardsRefuse_Index = playerId + 1\r\n\t\t\t        \r\n\t\t\t        set Event_RewardsRefuse_Real = 0.00\r\n\t\t\t        set Event_RewardsRefuse_Real = 1.00\r\n\t\t\t        set Event_RewardsRefuse_Real = 0.00\r\n\t\t        endif\r\n\t\t        \r\n\t    \t\tset udg_ItemGetActive[playerId + 1] = false\r\n\t    \t\treturn\r\n\t\t\telse\r\n\t\t\t\tcall AddRewardSelectionOption(playerUsed, -1)\r\n\t    \tendif\r\n    \tendif\r\n    \t\r\n    \tloop\r\n    \t\texitwhen i > 3\r\n    \t\tset rawValue = ( playerId * 3 ) + i\r\n    \t\tif IsRewardValidToCreate(i, hero, playerId) then\r\n    \t\t\tcall SpawnReward(i, rawValue, playerUsed, exceptions)\r\n    \t\tendif\r\n    \t\tset i = i + 1\r\n\t\tendloop\r\n\t\t\r\n\t\tset Event_SpawnRewards_Player = playerUsed\r\n\t\tset Event_SpawnRewards_Index = playerId + 1\r\n        \r\n\t\tset Event_SpawnRewards_Real = 0.00\r\n\t\tset Event_SpawnRewards_Real = 1.00\r\n\t\tset Event_SpawnRewards_Real = 0.00\r\n\t\t\r\n\t\tset hero = null\r\n    endfunction\r\n    \r\n    //================= New Version END ================= \r\n\r\n    /*private function Randomizer takes boolean a, boolean b, boolean c, boolean d returns nothing\r\n        local integer i = 1\r\n        local integer cyclB\r\n        local integer rand\r\n        local integer j \r\n        local boolean l = false\r\n\r\n        if a and b and c and d then\r\n            set l = true\r\n        endif\r\n        \r\n        if l and udg_logic[98] and IsBookOfLegendsActive == false then\r\n            call SetRaritySpawn( udg_RarityChance[3]+20, udg_RarityChance[2]+20 )\r\n        endif\r\n\r\n        if not( udg_worldmod[1] ) and not( udg_worldmod[8] ) then\r\n            set i = 1\r\n            loop\r\n                exitwhen i > 12 \r\n                set j = ( ( i - 1 ) / 3 ) + 1\r\n                set udg_itemrarity[i] = 0\r\n                if GetPlayerSlotState(Player( j - 1 )) == PLAYER_SLOT_STATE_PLAYING and not( inv( udg_hero[j], 'I0AC' ) > 0 and not(udg_logic[GetPlayerId( GetOwningPlayer( udg_hero[j] ) ) + 1 + 26]) and ( i == 2 or i == 5 or i == 8 or i == 11 ) ) then\r\n                    set rand = GetRandomInt(1, 100)\r\n                    if rand <= udg_RarityChance[3] or ( IsBookOfLegendsActive and l ) then\r\n                        set udg_itemrarity[i] = 3\r\n                    elseif ( rand > udg_RarityChance[3] and rand <= udg_RarityChance[2] ) or ( inv( udg_hero[j], 'I0BU' ) > 0 and (i == 3 or i == 6 or i == 9 or i == 12) ) then\r\n                        set udg_itemrarity[i] = 2\r\n                    elseif rand > udg_RarityChance[2] then\r\n                        set udg_itemrarity[i] = 1\r\n                    endif\r\n                endif\r\n                set i = i + 1\r\n            endloop\r\n            call ItemSpawn( a,b,c,d)\r\n        endif\r\n        \r\n        if l and udg_logic[98] and IsBookOfLegendsActive == false then\r\n            set udg_logic[98] = false\r\n            call SetRaritySpawn( udg_RarityChance[3]-20, udg_RarityChance[2]-20 )\r\n            call IconFrameDel( \"Rarity\" )\r\n        endif\r\n        \r\n        if IsBookOfLegendsActive and l then\r\n            set IsBookOfLegendsActive = false\r\n            call IconFrameDel( \"LegBook\" )\r\n        endif\r\n    endfunction*/\r\n    \r\n    public function RemoveRewards takes player playerUsed returns nothing\r\n    \tlocal integer index = GetConvertedPlayerId(playerUsed)\r\n        local integer itemSlot\r\n        local item itemToDelete\r\n        local integer i = 0\r\n\r\n        loop\r\n            exitwhen i > 2\r\n            set itemSlot = ( 3 * index ) - i\r\n            set itemToDelete = Reward[itemSlot]\r\n            if Reward[itemSlot] != null then\r\n\t            call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Polymorph\\\\PolyMorphDoneGround.mdl\", GetItemX(itemToDelete), GetItemY(itemToDelete) ) )\r\n\t            call RemoveItem( itemToDelete )\r\n            endif\r\n            set Reward[itemSlot] = null\r\n            set i = i + 1\r\n        endloop\r\n        \r\n        set itemToDelete = null\r\n    endfunction\r\n    \r\n    public function AllRemoveRewards takes nothing returns nothing\r\n    \tlocal integer i = 0\r\n    \tlocal player PlayerCheck\r\n    \t\r\n    \tloop\r\n    \t\texitwhen i > 3\r\n    \t\tset PlayerCheck = Player(i)\r\n    \t\tif GetPlayerSlotState(PlayerCheck) == PLAYER_SLOT_STATE_PLAYING then\r\n    \t\t\tcall RemoveRewards(PlayerCheck)\r\n    \t\tendif\r\n    \t\tset i = i + 1\r\n\t\tendloop\r\n    \t\r\n    \tset PlayerCheck = null\r\n    endfunction\r\n\r\n    public function RefreshItems takes player playerUsed returns nothing\r\n    \tlocal integer index = GetConvertedPlayerId(playerUsed)\r\n    \tlocal ListInt exceptions = ListInt.create()\r\n    \t\r\n    \tcall AddExceptions(exceptions)\r\n        call RemoveRewards(playerUsed)\r\n        \r\n        set IsItemsRefreshed = true\r\n        call SpawnRewardsForPlayer(playerUsed, exceptions)\r\n        \r\n        /*if index == 1 then\r\n            call Randomizer(true,false,false,false)\r\n        elseif index == 2 then\r\n            call Randomizer(false,true,false,false)\r\n        elseif index == 3 then\r\n            call Randomizer(false,false,true,false)\r\n        elseif index == 4 then\r\n            call Randomizer(false,false,false,true)\r\n        endif*/\r\n        set IsItemsRefreshed = false\r\n        \r\n        call exceptions.destroy()\r\n        set exceptions = 0\r\n        set playerUsed = null\r\n\tendfunction\r\n\t\r\n\tpublic function TryToCreateItems takes player playerUsed returns nothing\r\n    \tlocal integer index = GetPlayerId(playerUsed) + 1\r\n    \tlocal ListInt exceptions = ListInt.create()\r\n    \t\r\n    \tset udg_ItemGetChoosed[index] = false\r\n        set udg_ItemGetActive[index] = true\r\n    \tcall AddExceptions(exceptions)\r\n        \r\n        call SpawnRewardsForPlayer(playerUsed, exceptions)\r\n\r\n        call exceptions.destroy()\r\n        set exceptions = 0\r\n        set playerUsed = null\r\n\tendfunction\r\n\t\r\n\tpublic function IsRewardExist takes player playerUsed returns boolean\r\n\t\tlocal integer index = GetPlayerId( playerUsed ) + 1\r\n\t\tlocal integer triple = REWARD_CHOISE_PER_PLAYER * index\r\n\t\tlocal integer i = 0\r\n\t\t\r\n\t\tset playerUsed = null\r\n\t\tloop\r\n\t\t\texitwhen i >= REWARD_CHOISE_PER_PLAYER\r\n\t\t\tif Reward[triple - i] != null then\r\n\t\t\t\treturn true\r\n\t\t\tendif\r\n\t\t\tset i = i + 1\r\n\t\tendloop\r\n\t\treturn false\r\n\tendfunction\r\n\t\r\n\tpublic function IsAnyRewardExist takes nothing returns boolean\r\n\t\tlocal integer i = 1\r\n\t\t\r\n\t\tloop\r\n\t\t\texitwhen i > MAX_REWARD_AMOUNT\r\n\t\t\tif Reward[i] != null then\r\n\t\t\t\treturn true\r\n\t\t\tendif\r\n\t\t\tset i = i + 1\r\n\t\tendloop\r\n\t\treturn false\r\n\tendfunction\r\n\t\r\n\t/*public function IsAnyRewardSelectedThisRound takes player playerUsed returns boolean\r\n\t\tlocal integer index = GetPlayerId( playerUsed )\r\n\t\treturn AnyRewardSelectedThisRound[index]\r\n\tendfunction*/\r\n\t\r\n\t//================================================================\r\n\tprivate function OnBossFightWin_Delay takes nothing returns nothing\r\n\t\tlocal ListInt exceptions = ListInt.create()\r\n\t\tlocal integer i\r\n\t\t\r\n\t\t//call BJDebugMsg(\"OnBossFightWin_Delay\")\r\n\t\tcall AddExceptions(exceptions)\r\n\t\t\r\n\t\tif udg_logic[98] and IsBookOfLegendsActive == false then\r\n            call SetRaritySpawn( udg_RarityChance[3] + 20, udg_RarityChance[2] + 20 )\r\n        endif\r\n\t\t\r\n\t\tset i = 0\r\n\t\tloop\r\n\t\t\texitwhen i >= 4\r\n\t\t\tset udg_ItemGetChoosed[i + 1] = false\r\n            set udg_ItemGetActive[i + 1] = true\r\n            set IsFirstOption[i + 1] = 1\r\n\t\t\t//set AnyRewardSelectedThisRound[i] = false\r\n\t\t\tcall AddRewardSelectionOption(Player(i), AMOUNT_OF_REWARD_SELECTIONS_PER_ROUND)\r\n\t\t\tif udg_Boss_LvL == 2 then\r\n\t\t\t\tcall StartingBonus_SpawnBonuses(Player(i))\r\n\t\t\telse\r\n\t\t\t\tcall SpawnRewardsForPlayer(Player(i), exceptions)\r\n\t\t\tendif\r\n\t\t\tset i = i + 1\r\n\t\tendloop\r\n\t\t\r\n\t\tif udg_logic[98] and IsBookOfLegendsActive == false then\r\n            set udg_logic[98] = false\r\n            call SetRaritySpawn( udg_RarityChance[3] - 20, udg_RarityChance[2] - 20 )\r\n            call IconFrameDel( \"Rarity\" )\r\n        endif\r\n        \r\n        if IsBookOfLegendsActive then\r\n            set IsBookOfLegendsActive = false\r\n            call IconFrameDel( \"LegBook\" )\r\n        endif\r\n\t\t\r\n\t\t//call Randomizer(true,true,true,true)\r\n\t\tcall exceptions.destroy()\r\n        set exceptions = 0\r\n\tendfunction\r\n\t\r\n\tprivate function OnBossFightWin takes nothing returns nothing\r\n\t\tcall TimerStart(CreateTimer(), 0.01, false, function OnBossFightWin_Delay )\r\n\tendfunction\r\n\t\r\n\t/*private function OnRewardTaken takes nothing returns nothing\r\n\t\tlocal integer index = GetPlayerId( Event_RewardTaken_Player )\r\n\t\tset AnyRewardSelectedThisRound[index] = true\r\n\tendfunction*/\r\n\t\r\n\tprivate function OnPlayerLeave takes nothing returns nothing\r\n\t\tcall RemoveRewards(Event_PlayerLeave_Player)\r\n\tendfunction\r\n\t\r\n\tprivate function init takes nothing returns nothing\r\n\t\tlocal integer i = 0\r\n\t\t\r\n\t\tloop\r\n\t\t\texitwhen i >= 4\r\n\t\t\tset RewardSelectionsAvailable[i] = 0\r\n\t\t\tset i = i + 1\r\n\t\tendloop\r\n\t\r\n\t\tcall CreateEventTrigger( \"Event_PlayerLeave_Real\", function OnPlayerLeave, null )\r\n\t\tcall CreateEventTrigger( \"Event_MainBattleWin\", function OnBossFightWin, null )\r\n\t\t//call CreateEventTrigger( \"Event_RewardTaken\", function OnRewardTaken, null )\r\n\tendfunction\r\n\t\r\nendlibrary",
