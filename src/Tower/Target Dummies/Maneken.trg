  "Script": "scope Maneken initializer init\r\n\tglobals\r\n\t\tprivate constant integer MANNEQUIN_TYPE_ID = 'A1JZ'\r\n\t\tprivate constant player PLAYER_TYPE = Player(PLAYER_NEUTRAL_AGGRESSIVE)\r\n\t\tprivate constant real RESPAWN_DELAY = 2\r\n\t\t\r\n\t\tprivate constant string SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Orc\\\\MirrorImage\\\\MirrorImageDeathCaster.mdl\"\r\n\t\tprivate constant string DESPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Orc\\\\MirrorImage\\\\MirrorImageDeathCaster.mdl\"\r\n\t\t\r\n\t\tprivate constant integer FRIENDLY_DUMMY_ID = 'h028'\r\n\t\tprivate constant player FRIENDLY_DUMMY_PLAYER = Player(4)\r\n\t\tprivate constant integer FRIENDLY_DUMMY_HP_PERCENT = 50\r\n\tendglobals\r\n\t\r\n\t/*private function Target_Conditions takes nothing returns boolean\r\n\t    return GetUnitTypeId(GetDyingUnit()) == 'h01F' and (RectContainsUnit(gg_rct_TargetRegion01, GetDyingUnit()) or RectContainsUnit(gg_rct_TargetRegion02, GetDyingUnit()))\r\n\tendfunction\r\n\t*/\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return /*GetUnitTypeId(GetDyingUnit()) == 'h009' or Target_Conditions()*/ GetUnitAbilityLevel(GetDyingUnit(), MANNEQUIN_TYPE_ID) > 0\r\n\tendfunction\r\n\t\r\n\tprivate function ManekenCast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit u = LoadUnitHandle( udg_hash, id, StringHash( \"mannequin\" ) )\r\n\t    \r\n\t    if IsUnitAlive( u ) then\r\n\t        call DestroyEffect( AddSpecialEffect( SPAWN_ANIMATION, GetUnitX( u ), GetUnitY( u ) ) )\r\n\t        call ShowUnit(u, true)\r\n\t        call UnitRemoveAbility( u, 'Avul' )\r\n\t    endif\r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t    \r\n\t    set u = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal unit diedUnit = GetDyingUnit()\r\n\t\tlocal unit newUnit \r\n\t\tlocal player playerId\r\n\t\tlocal integer unitType = GetUnitTypeId(diedUnit)\r\n\t\t\r\n\t\tif GetUnitTypeId(diedUnit) == FRIENDLY_DUMMY_ID then\r\n\t\t\tset playerId = FRIENDLY_DUMMY_PLAYER\r\n\t\telse\r\n\t\t\tset playerId = PLAYER_TYPE\r\n\t\tendif\r\n\t\t\r\n\t    set newUnit = CreateUnit( playerId, unitType, GetUnitX( diedUnit ), GetUnitY( diedUnit ), GetUnitFacing( diedUnit ) )\r\n\t    call DestroyEffect( AddSpecialEffect( DESPAWN_ANIMATION, GetUnitX( newUnit ), GetUnitY( newUnit ) ) )\r\n\t    \r\n\t    if unitType == 'h009' then\r\n\t    \tcall SetUnitAnimationWithRarity( newUnit, \"sleep\", RARITY_FREQUENT )\r\n\t    endif\r\n\t    if unitType == FRIENDLY_DUMMY_ID then\r\n\t    \tcall SetUnitLifePercentBJ( newUnit, FRIENDLY_DUMMY_HP_PERCENT )\r\n\t    endif\r\n\t    \r\n\t    call RemoveUnit(diedUnit)\r\n\t    call ShowUnit(newUnit, false)\r\n\t    call UnitAddAbility( newUnit, 'Avul' )\r\n\t\r\n\t    call InvokeTimerWithUnit(newUnit, \"mannequin\", RESPAWN_DELAY, false, function ManekenCast)\r\n\t    \r\n\t    set newUnit = null\r\n\t    set diedUnit = null\r\n\tendfunction\r\n\t\r\n\tprivate function OnBetween takes nothing returns nothing\r\n\t\tlocal group g = CreateGroup()\r\n\t    local unit u\r\n\t\r\n    \tcall GroupEnumUnitsInRect(g, gg_rct_Vision1, null)\r\n\t    loop\r\n\t        set u = FirstOfGroup(g)\r\n\t        exitwhen u == null\r\n\t        if GetUnitAbilityLevel(u, MANNEQUIN_TYPE_ID) > 0 then\r\n\t            call KillUnit( u )\r\n\t        endif\r\n\t        call GroupRemoveUnit(g,u)\r\n\t    endloop\r\n\t    \r\n\t    call DestroyGroup( g )\r\n\t    set u = null\r\n\t    set g = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function PvPCheck takes nothing returns boolean\r\n\t    return ExtraArenaGeneral_IsPvPActive() == false\r\n\tendfunction\r\n\t\r\n\tprivate function MannequinInvulChange takes boolean flag returns nothing\r\n\t\tlocal group g = CreateGroup()\r\n\t    local unit u\r\n\r\n    \tcall GroupEnumUnitsInRect(g, gg_rct_Vision1, null)\r\n\t    loop\r\n\t        set u = FirstOfGroup(g)\r\n\t        exitwhen u == null\r\n\t        if GetUnitAbilityLevel(u, MANNEQUIN_TYPE_ID) > 0 then\r\n\t            call SetUnitInvulnerable(u, flag)\r\n\t        endif\r\n\t        call GroupRemoveUnit(g,u)\r\n\t    endloop\r\n\t    \r\n\t    call DestroyGroup( g )\r\n\t    set u = null\r\n\t    set g = null\r\n\tendfunction\r\n\t\r\n\tprivate function OnBattleStart takes nothing returns nothing\r\n\t\tcall MannequinInvulChange(true)\r\n\tendfunction\r\n\t\r\n\tprivate function OnBattleEnd takes nothing returns nothing\r\n\t\tcall MannequinInvulChange(false)\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnStart takes nothing returns nothing\r\n\t\tlocal group g = CreateGroup()\r\n\t    local unit u\r\n\t\r\n\t\tcall SetUnitAnimationWithRarity( udg_UNIT_DUMMY_OGRE_1, \"sleep\", RARITY_FREQUENT )\r\n\t\tcall SetUnitAnimationWithRarity( udg_UNIT_DUMMY_OGRE_2, \"sleep\", RARITY_FREQUENT )\r\n\r\n\t\tset bj_groupEnumOwningPlayer = FRIENDLY_DUMMY_PLAYER\r\n    \tcall GroupEnumUnitsInRect(g, gg_rct_Vision1, filterGetUnitsInRectOfPlayer)\r\n\t    loop\r\n\t        set u = FirstOfGroup(g)\r\n\t        exitwhen u == null\r\n\t        if GetUnitTypeId(u) == FRIENDLY_DUMMY_ID then\r\n\t            call SetUnitLifePercentBJ( u, FRIENDLY_DUMMY_HP_PERCENT )\r\n\t        endif\r\n\t        call GroupRemoveUnit(g,u)\r\n\t    endloop\r\n\t    \r\n\t    call DestroyGroup( g )\r\n\t    set u = null\r\n\t    set g = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t\tlocal trigger trig = CreateTrigger(  )\r\n\t    call TriggerRegisterTimerExpireEvent( trig, udg_StartTimer )\r\n\t    call TriggerAddAction( trig, function OnStart )\r\n\t\r\n\t    set gg_trg_Maneken = CreateTrigger(  )\r\n\t    call TriggerRegisterAnyUnitEventBJ( gg_trg_Maneken, EVENT_PLAYER_UNIT_DEATH )\r\n\t    call TriggerAddCondition( gg_trg_Maneken, Condition( function condition ) )\r\n\t    call TriggerAddAction( gg_trg_Maneken, function action )\r\n\t    \r\n\t    call BetweenGlobal.AddListener(function OnBetween, null)\r\n\t    call BattleStartGlobal.AddListener(function OnBattleStart, function PvPCheck)\r\n\t    call BattleEndGlobal.AddListener(function OnBattleEnd, function PvPCheck)\r\n\t    \r\n\t    set trig = null\r\n\tendfunction\r\n\r\nendscope",
