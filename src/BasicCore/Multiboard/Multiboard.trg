{
  "Id": 50332192,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "library Multiboard initializer init requires Conditions\r\n\r\n    globals\r\n        private constant integer NAME_SYMBOLS_LIMIT = 10\r\n        \r\n        private constant integer ROWS = 15\r\n        private constant integer COLUMNS_INITIAL = 2\r\n        private constant integer COLUMNS_PER_PLAYER = 3\r\n        \r\n        private constant string INITIAL_HERO_ICON = \"ReplaceableTextures\\\\CommandButtons\\\\BTNSelectHeroOn.blp\"\r\n        \r\n        private integer RowAmount\r\n    endglobals\r\n    \r\n    public function GetRowAmount takes nothing returns integer\r\n    \treturn RowAmount\r\n    endfunction\r\n    \r\n    public function GetPlayerColumn takes integer index returns integer\r\n    \treturn udg_Multiboard_Position[index] * 3 - 1\r\n    endfunction\r\n\r\n    private function GetFixedPlayerName takes player playerCheck, integer index returns string\r\n    \tlocal string playerName = GetPlayerName(playerCheck)\r\n        local integer symbols = StringLength(playerName)\r\n        \r\n        if symbols > NAME_SYMBOLS_LIMIT and index < udg_Heroes_Amount then\r\n            return SubString(playerName, 0, NAME_SYMBOLS_LIMIT ) + \"...\"\r\n        endif\r\n\r\n        return playerName\r\n    endfunction\r\n    \r\n    public function MultiSetValue takes integer row, integer col, string val returns nothing\r\n        local multiboarditem mbitem = MultiboardGetItem( udg_multi, row - 1, col - 1 )\r\n        \r\n        call MultiboardSetItemValue( mbitem, val )\r\n        call MultiboardReleaseItem( mbitem )\r\n        \r\n        set mbitem = null\r\n    endfunction\r\n\r\n    public function MultiSetColor takes integer row, integer col, real red, real green, real blue, real transparency returns nothing\r\n        local multiboarditem mbitem = MultiboardGetItem( udg_multi, row - 1, col - 1 )\r\n        local integer array i\r\n        local integer cyclA = 0\r\n        \r\n        set i[0] = R2I( red * 2.25 )\r\n        set i[1] = R2I( green * 2.25 )\r\n        set i[2] = R2I( blue * 2.25 )\r\n        set i[3] = R2I( (100.-transparency) * 2.25 )\r\n        \r\n        loop\r\n            exitwhen cyclA > 3\r\n            if i[cyclA] < 0 then\r\n                set i[cyclA] = 0\r\n            elseif i[cyclA] > 225 then\r\n                set i[cyclA] = 225\r\n            endif\r\n            set cyclA = cyclA + 1\r\n        endloop\r\n        \r\n        call MultiboardSetItemValueColor(mbitem, i[0], i[1], i[2], i[3])\r\n        call MultiboardReleaseItem(mbitem)\r\n        \r\n        set mbitem = null\r\n    endfunction\r\n\r\n    public function MultiSetWidth takes integer row, integer col, real width returns nothing\r\n        local multiboarditem mbitem = MultiboardGetItem( udg_multi, row - 1, col - 1 )\r\n        \r\n        call MultiboardSetItemWidth(mbitem, width/100.0)\r\n        call MultiboardReleaseItem(mbitem)\r\n        \r\n        set mbitem = null\r\n    endfunction\r\n\r\n    public function MultiSetStyle takes integer row, integer col, boolean showValue, boolean showIcon returns nothing\r\n        local multiboarditem mbitem = MultiboardGetItem( udg_multi, row - 1, col - 1 )\r\n        \r\n        call MultiboardSetItemStyle(mbitem, showValue, showIcon)\r\n        call MultiboardReleaseItem(mbitem)\r\n        \r\n        set mbitem = null\r\n    endfunction\r\n\r\n    public function MultiSetIcon takes integer row, integer col, string iconFileName returns nothing\r\n        local multiboarditem mbitem = MultiboardGetItem( udg_multi, row - 1, col - 1 )\r\n        \r\n        call MultiboardSetItemIcon(mbitem, iconFileName)\r\n        call MultiboardReleaseItem(mbitem)\r\n        \r\n        set mbitem = null\r\n    endfunction\r\n\r\n\t//===========================================================================\r\n\tprivate function MakeMultiboard takes nothing returns nothing\r\n\t\tlocal integer i\r\n\t\t\r\n\t\tset udg_multi = CreateMultiboard()\r\n        set bj_lastCreatedMultiboard = udg_multi\r\n        call MultiboardSetRowCount( udg_multi, ROWS )\r\n        call MultiboardSetColumnCount( udg_multi, GetRowAmount() )\r\n        call MultiboardSetTitleText( udg_multi, \"Statistics [0:00:00]\")\r\n        call MultiboardDisplay( udg_multi, true)\r\n        call MultiSetValue( 2, 2, I2S(udg_Heroes_Ressurect) )\r\n        call MultiSetValue( 1, 3, udg_Version )\r\n        call MultiSetValue( 2, 3, \"Common +0\" )\r\n        call MultiSetValue( 1, 5, \"1/10\" )\r\n        call MultiSetValue( 1, 1, \"Attempts Left:\" )\r\n        call MultiSetValue( 2, 1, \"Resurrections:\" )\r\n        call MultiSetValue( 4, 1, \"Spell power\" )\r\n        call MultiSetValue( 5, 1, \"Luck\" )\r\n        call MultiSetValue( 6, 1, \"Damage Dealt (Game)\" )\r\n        call MultiSetValue( 7, 1, \"Damage Dealt (Fight)\" )\r\n        call MultiSetValue( 8, 1, \"DPS\" )\r\n        call MultiSetValue( 9, 1, \"Healing (Game)\" )\r\n        call MultiSetValue( 10, 1, \"Healing (Fight)\" )\r\n        call MultiSetValue( 11, 1, \"Mana (Game)\" )\r\n        call MultiSetValue( 12, 1, \"Mana (Fight)\" )\r\n        call MultiSetValue( 13, 1, \"Damage Taken (Game)\" )\r\n        call MultiSetValue( 14, 1, \"Damage Taken (Fight)\" )\r\n        call MultiSetValue( 15, 1, \"Sets\" )\r\n        call MultiSetValue( 2, 4, \"IA\" )\r\n        call MultiSetValue( 2, 5, \"AL\" )\r\n        call MultiSetValue( 1, 4, \"Level:\" )\r\n        call MultiSetColor( 1, 3, 100.00, 80.00, 0.00, 0.00 )\r\n        call MultiSetColor( 1, 4, 100.00, 80.00, 0.00, 0.00 )\r\n        call MultiSetColor( 2, 3, 100.00, 80.00, 0.00, 0.00 )\r\n\tendfunction\r\n\t\r\n\tprivate function SetupPlayer takes player playerCheck, integer playerColumn, integer index returns nothing\r\n\t\tlocal integer k\r\n\t\t\r\n        call MultiSetValue( 3, playerColumn, udg_Player_Color[index] + GetFixedPlayerName( playerCheck, index ) + \"|r\" )\r\n        call MultiSetIcon( 3, playerColumn, INITIAL_HERO_ICON )\r\n        call MultiSetValue( 4, playerColumn, \"0.00%\" )\r\n        call MultiSetValue( 5, playerColumn, \"0% (0)\" )\r\n        call MultiSetWidth( 15, playerColumn,  1.00 )\r\n        call MultiSetWidth( 15, playerColumn + 1,  1.00 )\r\n        call MultiSetWidth( 15, playerColumn + 2,  6.00 )\r\n        if playerColumn + 2 != 1 then\r\n            call MultiSetColor( 15, playerColumn + 2, 101, 67, 33, 0. )\r\n            call MultiSetValue( playerColumn + 2, 15, \"0\" )\r\n        endif\r\n        set k = 1\r\n        loop\r\n            exitwhen k > 14\r\n            call MultiSetWidth( k, playerColumn, 7.98 )\r\n            call MultiSetWidth( k, playerColumn + 1,  0.01 )\r\n            call MultiSetWidth( k, playerColumn + 2,  0.01 )\r\n            if k >= 6 then\r\n                call MultiSetValue( k, playerColumn, \"0\" )\r\n            endif\r\n            set k = k + 1\r\n        endloop\r\n    endfunction\r\n\t\r\n\tprivate function SetupPlayers takes nothing returns nothing\r\n\t\tlocal integer i\r\n\t\tlocal integer k\r\n\t\tlocal integer playerColumn\r\n\t\tlocal player playerCheck\r\n\t\t\r\n\t\tset i = 1\r\n\t\tloop\r\n            exitwhen i > 4\r\n        \tset playerCheck = Player(i - 1)\r\n            set playerColumn = COLUMNS_PER_PLAYER * udg_Multiboard_Position[i] - 1\r\n            if GetPlayerSlotState(playerCheck) == PLAYER_SLOT_STATE_PLAYING then\r\n                call SetupPlayer(playerCheck, playerColumn, i )\r\n            endif\r\n            set i = i + 1\r\n        endloop\r\n        \r\n        set playerCheck = null\r\n\tendfunction\r\n\t\r\n\tprivate function SetCellsStyle takes nothing returns nothing\r\n\t\tlocal integer i\r\n\t\tlocal integer iMax\r\n\t\tlocal integer k\r\n\t\r\n\t\tset i = 1\r\n        set iMax = GetRowAmount()\r\n        loop\r\n            exitwhen i > iMax\r\n            call MultiSetColor( 4, i, 100.00, 50.00, 100.00, 0.00 )\r\n            call MultiSetColor( 5, i, 90.00, 70.00, 35.00, 0.00 )\r\n            call MultiSetColor( 8, i, 85.00, 85.00, 0.00, 0.00 )\r\n            if i != 1 then\r\n                if i != GetRowAmount() then\r\n                    call MultiSetIcon( 15, i, \"ReplaceableTextures\\\\CommandButtons\\\\BTNCancel.blp\" )\r\n                else\r\n                    call MultiSetStyle( 15, i, true, false )\r\n                endif\r\n                call MultiSetStyle( 1, i, true, false )\r\n                call MultiSetStyle( 2, i, true, false )\r\n                if i != 3 and i != 4 then\r\n                    call MultiSetWidth( 1, i, 2.00 )\r\n                    call MultiSetWidth( 2, i, 2.00 )\r\n                else\r\n                    call MultiSetWidth( 1, i, 6 )\r\n                    call MultiSetWidth( 2, i, 6 )\r\n                endif\r\n                if i != 2 and i != 5 and i != 8 and i != 11 then\r\n                    call MultiSetStyle( 3, i, true, false )\r\n                endif\r\n                set k = 4\r\n                loop\r\n                    exitwhen k > 14\r\n                    call MultiSetStyle( k, i, true, false )\r\n                    set k = k + 1\r\n                endloop\r\n            endif\r\n            set i = i + 1\r\n        endloop\r\n        //First Column Setup\r\n        set i = 1\r\n        loop\r\n            exitwhen i > ROWS\r\n            call MultiSetWidth( i, 1, 14 )\r\n            call MultiSetStyle( i, 1, true, false )\r\n            set i = i + 1\r\n        endloop\r\n        \r\n        call MultiSetWidth( 1, 4, 6 )\r\n        call MultiSetWidth( 1, 5, 4 )\r\n        call MultiSetWidth( 2, 4, 2 )\r\n        call MultiSetWidth( 2, 3, 8 )\r\n        call MultiSetStyle( 3, GetRowAmount(), true, false )\r\n        call MultiSetColor( 2, 4, 0, 0, 0, 100.00 )\r\n        call MultiSetColor( 2, 5, 0, 0, 0, 100.00 )\r\n\tendfunction\r\n\t\r\n    private function Init_Multiboard takes nothing returns nothing\r\n        call DisableTrigger( GetTriggeringTrigger() )\r\n        \r\n        set RowAmount = COLUMNS_PER_PLAYER * udg_Heroes_Amount + COLUMNS_INITIAL\r\n        call MakeMultiboard()\r\n        call SetupPlayers()\r\n\t\tcall SetCellsStyle()\r\n\r\n        call MultiboardMinimize( udg_multi, true)\r\n    endfunction\r\n    \r\n    //===========================================================================\r\n    private function init takes nothing returns nothing\r\n\t\tlocal trigger trig = CreateTrigger()\r\n\t    call TriggerRegisterTimerEvent( trig, 1, false)\r\n\t    call TriggerAddAction( trig, function Init_Multiboard )\r\n\tendfunction\r\nendlibrary",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}