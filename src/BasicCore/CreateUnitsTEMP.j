	    set gg_unit_u00F_0006=BlzCreateUnitWithSkin(p, 'u00F', 2872.0, 5609.8, 270.000, 'u00F')
	    set u=BlzCreateUnitWithSkin(p, 'h028', 3595.6, 3242.2, 90.000, 'h028')
