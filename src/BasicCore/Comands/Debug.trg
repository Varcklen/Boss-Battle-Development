  "RunOnMapInit": false,
  "Script": "scope DebugCommand initializer init\r\n\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return IsDefeat == false\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function CheckPreparationTime takes nothing returns nothing\r\n\t\tlocal integer i = 1\r\n\t\tlocal unit hero\r\n\t\r\n\t\tif IsVictory == false and udg_Boss_LvL > 1 then\r\n            call BlzFrameSetVisible(fon,true)\r\n        \tcall BaseTooltip_Debug()\r\n        endif\r\n        \r\n        call UnitRemoveAbility( udg_UNIT_CUTE_BOB, 'A08B' )\r\n        call UnitRemoveAbility( udg_UNIT_CUTE_BOB, 'A0JQ' )\r\n        if not( IsDisabled_OverlordArena ) and ( not(IsExtraArenasAutomatic) or IsVictory ) and udg_Boss_LvL != 1 then\r\n            call UnitAddAbility( udg_UNIT_CUTE_BOB, 'A0JQ' )\r\n        endif\r\n        if not( IsDisabled_InfiniteArena ) and not( IsVictory ) and not(IsExtraArenasAutomatic) and udg_Boss_LvL != 1 then\r\n            call UnitAddAbility( udg_UNIT_CUTE_BOB, 'A08B' )\r\n        endif\r\n        \r\n        set i = 1\r\n        loop\r\n            exitwhen i > 4\r\n            set hero = udg_hero[i]\r\n            if hero != null then\r\n                call ReviveHeroLoc( hero, udg_point[i + 21], true )\r\n                call SetUnitPositionLoc(hero, udg_point[i + 21])\r\n                call SetUnitFacing(hero, 90)\r\n                call SetUnitOwner( hero, Player(i - 1), true )\r\n                call PanCameraToTimedLocForPlayer( GetOwningPlayer(hero), udg_point[i + 21], 0.25 )\r\n                call PauseUnit( hero, false)\r\n            endif\r\n            set i = i + 1\r\n        endloop\r\n        \r\n        set hero = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function MoveInsideArenaIfOutside takes unit target returns nothing\r\n\t\tif target == null then\r\n\t\t\treturn\r\n\t\tendif\r\n\t\tif RectContainsUnit(udg_Boss_Rect, target) then\r\n\t\t\treturn\r\n\t\tendif\r\n\t\r\n\t\tcall SetUnitPosition( target, GetRectCenterX( udg_Boss_Rect ), GetRectCenterY( udg_Boss_Rect ) )\r\n        call PanCameraToTimedForPlayer( GetOwningPlayer(target), GetUnitX(target), GetUnitY(target), 0.25 )\r\n\tendfunction\r\n\t\r\n\tprivate function IsDeadCheck takes unit hero returns boolean\r\n\t\tif hero == null then\r\n\t\t\treturn false\r\n\t\telseif IsUnitAlive(hero) then\r\n\t\t\treturn false\r\n\t\telseif GetUnitAbilityLevel( hero, 'A0EX') > 0 then\r\n\t\t\treturn false\r\n\t\tendif\r\n\t\treturn true\r\n\tendfunction\r\n\t\r\n\tprivate function DebugHero takes nothing returns boolean\r\n\t    local integer i = 1\r\n\t    local integer counter = 0\r\n\t    \r\n\t    loop\r\n\t        exitwhen i > 4\r\n\t        if IsDeadCheck(udg_hero[i]) then\r\n\t            set counter = counter + 1\r\n\t        endif\r\n\t        set i = i + 1\r\n\t    endloop\r\n\t    if counter >= 4 then\r\n\t        return true\r\n\t    endif\r\n\t    return false\r\n\tendfunction\r\n\t\r\n\tprivate function CheckBosses takes nothing returns nothing\r\n\t\tif IsUnitAlive(MainBoss) and BossCastLib_IsDisappear(MainBoss) == false then\r\n\t\t\tcall MoveInsideArenaIfOutside(MainBoss)\r\n\t\tendif\r\n\t\tif IsUnitAlive(SecondBoss) and BossCastLib_IsDisappear(MainBoss) == false then\r\n\t\t\tcall MoveInsideArenaIfOutside(SecondBoss)\r\n\t\tendif\r\n\tendfunction\r\n\t\r\n\tprivate function CheckBattle takes nothing returns nothing\r\n\t\tlocal boolean isHeroesFine = DebugHero()\r\n\t\tlocal integer i\r\n\t\r\n\t\tif udg_fightmod[3] then\r\n\t\t\tset i = 1\r\n            loop\r\n                exitwhen i > 4\r\n                if ExtraArenaGeneral_IsPvPFighter(udg_hero[i]) then\r\n                \tcall MoveInsideArenaIfOutside(udg_hero[i])\r\n                endif\r\n                set i = i + 1\r\n            endloop\r\n        else\r\n            set i = 1\r\n            loop\r\n                exitwhen i > 4\r\n                call MoveInsideArenaIfOutside(udg_hero[i])\r\n                set i = i + 1\r\n            endloop\r\n        endif\r\n        \r\n        if udg_fightmod[1] then\r\n        \tcall CheckBosses()\r\n        endif\r\n        \r\n        if udg_fightmod[1] and isHeroesFine then\r\n            call Between( \"res_boss\" )\r\n        elseif udg_fightmod[2] and isHeroesFine then\r\n            call Between( \"end_IA\" )\r\n        elseif udg_fightmod[3] and ( IsUnitDead( udg_unit[57]) or IsUnitDead( udg_unit[58]) ) then\r\n            call TriggerExecute( gg_trg_PA_End )\r\n        elseif udg_fightmod[4] and isHeroesFine then\r\n            call Between( \"end_AL\" )\r\n        endif\r\n        \r\n        //Для случаев софтлока на боссе (нет босса, но бой не закончился)\r\n\t    if udg_fightmod[1] and IsUnitGroupEmptyBJ(udg_Bosses) then\r\n\t        call Between( \"res_boss\" )\r\n\t    endif\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function CheckHeroesStatus takes nothing returns nothing\r\n\t\tlocal integer i = 1\r\n\t\tlocal unit hero\r\n\t\t\r\n\t\tset udg_Heroes_Amount = 0\r\n\t    loop\r\n\t        exitwhen i > 4\r\n\t        set hero = udg_hero[i]\r\n\t        if hero != null then\r\n\t            if BlzGetUnitMaxHP(hero) < 0.405 then\r\n\t                call BlzSetUnitMaxHP( hero, 100 )\r\n\t            endif\r\n\t            set udg_Heroes_Amount = udg_Heroes_Amount + 1\r\n\t        endif\r\n\t        set i = i + 1\r\n\t    endloop\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 5, \"An attempt to bug fixes has been made.\")\r\n\t    call CheckHeroesStatus()\r\n\t    if udg_fightmod[0] then\r\n\t    \tcall CheckBattle()\r\n\t    else\r\n\t        call CheckPreparationTime()\r\n\t    endif\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    local integer i = 0\r\n\t    set gg_trg_Debug = CreateTrigger(  )\r\n\t    loop\r\n\t        exitwhen i > 3\r\n\t        call TriggerRegisterPlayerChatEvent( gg_trg_Debug, Player(i), \"-debug\", true )\r\n\t        set i = i + 1\r\n\t    endloop\r\n\t    call TriggerAddCondition( gg_trg_Debug, Condition( function condition ) )\r\n\t    call TriggerAddAction( gg_trg_Debug, function action )\r\n\tendfunction\r\n\r\nendscope",
