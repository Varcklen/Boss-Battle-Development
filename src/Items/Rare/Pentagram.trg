  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Pentagram initializer init\r\n\r\n\tglobals\r\n\t\tprivate constant integer ITEM_ID = 'I0DL'\r\n\t\tprivate constant integer ABILITY_ID = 'A1JG'\r\n\t\tprivate constant integer UNIT_ID = 'u00J'\r\n\t\t\r\n\t\tprivate constant integer LIFE_TIME = 35\r\n\t\tprivate constant integer SUMMON_RANGE = 200\r\n\t\tprivate constant integer HEALTH_COST = 90\r\n\t\t\r\n\t\tprivate constant string ANIMATION = \"Abilities\\\\Spells\\\\Orc\\\\FeralSpirit\\\\feralspirittarget.mdl\"\r\n\t\tprivate constant string ANIMATION_CASTER = \"Blood Explosion.mdx\"\r\n\tendglobals\r\n\r\n\tprivate function OnSummon_Condition takes nothing returns boolean\r\n\t    return IsUnitAlive(AlliedMinionSummoned.TriggerUnit)\r\n\tendfunction\r\n\t\r\n\tprivate function OnSummon takes nothing returns nothing\r\n\t\tlocal unit caster = AlliedMinionSummoned.GetDataUnit(\"caster\")\r\n\t\tlocal unit minion = AlliedMinionSummoned.GetDataUnit(\"minion\")\r\n\t\tlocal integer hp \r\n\t    local item itemUsed = Trigger_GetItemUsed()\r\n\t\tlocal integer id = GetHandleId( itemUsed )\r\n\t    local integer counter = LoadInteger( udg_hash, id, StringHash( \"pent\" ) ) + 1\r\n\t    \r\n\t    if counter >= 4 then\r\n\t        set counter = 0\r\n\t        set hp = BlzGetUnitMaxHP(minion)\r\n\t    \tcall BlzSetUnitMaxHP( minion, BlzGetUnitMaxHP(minion) + hp )\r\n\t        call SetUnitLifeBJ( minion, GetUnitStateSwap(UNIT_STATE_LIFE, minion) + hp )\r\n\t    \tcall BlzSetUnitBaseDamage( minion, R2I(GetUnitDamage(minion) * 2) - GetUnitAvgDiceDamage(minion), 0 )\r\n\t    \tcall DestroyEffect( AddSpecialEffectTarget(\"Abilities\\\\Spells\\\\NightElf\\\\BattleRoar\\\\RoarCaster.mdl\", minion, \"origin\" ) )\r\n\t    else\r\n\t        call textst( \"|c005050FF \" + I2S( counter ) + \"/4\", caster, 64, GetRandomReal( 0, 360 ), 7, 1.5 )\r\n\t    endif\r\n\t    call SaveInteger( udg_hash, id, StringHash( \"pent\" ), counter )\r\n\t    \r\n\t    set minion = null\r\n\t    set itemUsed = null\r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID\r\n\tendfunction\r\n\t\r\n\tprivate function Summon takes unit caster returns nothing\r\n\t\tlocal real casterFacing = GetUnitFacing(caster)\r\n\t\tlocal location locSpawn = PolarProjectionBJ(GetUnitLoc(caster), SUMMON_RANGE, casterFacing)\r\n\t\tlocal unit unitSpawn\r\n\t\t\r\n\t\tset unitSpawn = CreateUnitAtLoc( GetOwningPlayer( caster ), UNIT_ID, locSpawn, casterFacing )\r\n        call UnitApplyTimedLife(unitSpawn, 'BTLF', LIFE_TIME )\r\n        call DestroyEffect( AddSpecialEffectTarget( ANIMATION, unitSpawn, \"origin\" ) )\r\n        \r\n        call RemoveLocation(locSpawn)\r\n        set locSpawn = null\r\n        set unitSpawn = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local unit caster\r\n\t    local integer cyclA = 1\r\n\t    local integer cyclAEnd \r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t    endif\r\n\t \r\n\t \tcall DestroyEffect( AddSpecialEffect(ANIMATION_CASTER, GetUnitX( caster ), GetUnitY( caster ) ) )\r\n\t    set cyclAEnd = eyest( caster )\r\n\t    loop\r\n\t        exitwhen cyclA > cyclAEnd\r\n\t        call Summon(caster)\r\n\t        set cyclA = cyclA + 1\r\n\t    endloop\r\n\t    \r\n\t    call SetUnitState( caster, UNIT_STATE_LIFE, RMaxBJ(0, GetUnitState( caster, UNIT_STATE_LIFE) - HEALTH_COST ) )\r\n\t    \r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    call RegisterDuplicatableItemTypeCustom( ITEM_ID, AlliedMinionSummoned, function OnSummon, function OnSummon_Condition, \"caster\" )\r\n\t    call CreateNativeEvent( EVENT_PLAYER_UNIT_SPELL_EFFECT, function action, function condition )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}