  "Id": 50332561,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope RubyDiamond initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer CAST_ID = 'A14E'\r\n\t\tprivate constant integer ITEM_ID = 'I01X'\r\n\t\r\n\t\tprivate constant integer DAMAGE = 300\r\n\t\tprivate constant integer EXTRA_DAMAGE = 100\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == CAST_ID\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer cyclA = 1\r\n\t    local integer cyclAEnd\r\n\t    local unit caster\r\n\t    local unit target\r\n\t    local real damage\r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = udg_Target\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = randomtarget( caster, 900, \"enemy\", 0, 0, 0 )\r\n\t        call textst( udg_string[0] + GetObjectName(CAST_ID), caster, 64, 90, 10, 1.5 )\r\n\t        if target == null then\r\n\t            set caster = null\r\n\t            return\r\n\t        endif\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set target = GetSpellTargetUnit()\r\n\t    endif\r\n\t\r\n\t    set damage = DAMAGE + Kills_GetPerBattle(caster) * EXTRA_DAMAGE\r\n\t    set cyclAEnd = eyest( caster )\r\n\t    call DestroyEffect( AddSpecialEffectTarget( \"Blood Explosion.mdx\", target, \"origin\") )\r\n\t    loop\r\n\t        exitwhen cyclA > cyclAEnd\r\n\t        call UnitDamageTarget( caster, target, damage, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)\r\n\t        set cyclA = cyclA + 1\r\n\t    endloop\r\n\t    \r\n\t    set caster = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnKill_Condition takes nothing returns boolean\r\n\t\tcall BJDebugMsg(\"inv: \" + I2S(inv(Event_Hero_Kill_Unit, ITEM_ID)) )\r\n\t    return inv(Event_Hero_Kill_Unit, ITEM_ID) > 0\r\n\tendfunction\r\n    \r\n\tprivate function OnKill takes nothing returns nothing\r\n\t\tlocal unit caster = Event_Hero_Kill_Unit\r\n\t\tlocal item itemCheck = GetItemOfTypeFromUnitBJ( caster, ITEM_ID)\r\n\t\tlocal integer kills = Kills_GetPerBattle(caster) * EXTRA_DAMAGE\r\n\t\tlocal string text\r\n\t\t\r\n\t\tcall BJDebugMsg(\"kills: \" + I2S(kills) )\r\n\t\tcall BJDebugMsg(\"item: \" + GetItemName(itemCheck) )\r\n\t\tset text = words( caster, BlzGetItemDescription(itemCheck), \"|cFF959697(\", \")|r\", I2S(kills) )\r\n\t\tcall BlzSetItemExtendedTooltip( itemCheck, text )\r\n\t\t\r\n\t\tset itemCheck = null\r\n\t\tset caster = null\r\n\tendfunction\r\n\r\n\r\n\t//===========================================================================\r\n    private function OnBattleEnd_Condition takes nothing returns boolean\r\n\t    return inv(BattleEnd.GetDataUnit(\"caster\"), ITEM_ID) > 0\r\n\tendfunction\r\n    \r\n\tprivate function OnBattleEnd takes nothing returns nothing\r\n\t\tlocal unit caster = BattleEnd.GetDataUnit(\"caster\")\r\n\t\tlocal item itemCheck = GetItemOfTypeFromUnitBJ( caster, ITEM_ID)\r\n\t\tlocal string text\r\n\r\n\t\tset text = words( caster, BlzGetItemDescription(itemCheck), \"|cFF959697(\", \")|r\", I2S(0) )\r\n\t\tcall BlzSetItemExtendedTooltip( itemCheck, text )\r\n\t\t\r\n\t\tset itemCheck = null\r\n\t\tset caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t\tcall CreateNativeEvent( EVENT_PLAYER_UNIT_SPELL_EFFECT, function action, function condition )\r\n\t    call CreateEventTrigger( \"Event_Hero_Kill_Real\", function OnKill, function OnKill_Condition )\r\n\t    call BattleEnd.AddListener(function OnBattleEnd, function OnBattleEnd_Condition)\r\n\tendfunction\r\n\t\r\nendscope",
