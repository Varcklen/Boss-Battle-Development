  "Script": "scope SheepTear initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ITEM_ID = 'I0DE'\r\n\t\tprivate constant integer ABILITY_COOLDOWN = 'A1J0'\r\n\t\t\r\n\t\tprivate constant integer COOLDOWN = 15\r\n\t\tprivate constant integer INVISIBILITY_DURATION = 2\r\n\t\t\r\n\t\tprivate constant integer DAMAGE = 100\r\n\t\tprivate constant integer RANGE = 300\r\n\t\tprivate constant string ANIMATION = \"war3mapImported\\\\ArcaneExplosion.mdx\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return UnitHasItemOfTypeBJ(AfterAttack.TargetUnit, ITEM_ID) and LoadBoolean( udg_hash, GetHandleId( AfterAttack.TargetUnit ), StringHash( \"sheep_tear_check\" ) ) == false\r\n\tendfunction\r\n\t\r\n\tprivate function End takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit u = LoadUnitHandle( udg_hash, id, StringHash( \"sheep_tear_target\" ) )\r\n\r\n\t\tcall SaveBoolean( udg_hash, GetHandleId( u ), StringHash( \"sheep_tear_check\" ), false )\r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t\r\n\t    set u = null\r\n\tendfunction\r\n\t\r\n\tprivate function Delay takes nothing returns nothing\r\n\t\tlocal integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local item itemUsed = LoadItemHandle( udg_hash, id, StringHash( \"sheep_tear_delay\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"sheep_tear_delay_target\" ) )\r\n\t    \r\n\t    if IsUnitAlive(target) then\r\n\t\t    call GroupAoE(target, GetUnitX( target ), GetUnitY( target ), DAMAGE, RANGE, TARGET_ENEMY, ANIMATION, null)\r\n\t\t\tcall InvisibilitySystem_Apply(target, null, INVISIBILITY_DURATION )\r\n\t\tendif\r\n\t\t\r\n\t\tcall FlushChildHashtable( udg_hash, id )\r\n\t\t\r\n\t\tset id = InvokeTimerWithItem( itemUsed, \"sheep_tear\", COOLDOWN, false, function End )\r\n\t\tcall SaveUnitHandle( udg_hash, id, StringHash( \"sheep_tear_target\" ), target ) \r\n\r\n\t    set itemUsed = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local unit target = AfterAttack.GetDataUnit(\"target\")\r\n\t    local item itemUsed = Trigger_GetItemUsed()\r\n\t    local integer id \r\n\r\n\t\tcall SaveBoolean( udg_hash, GetHandleId( target ), StringHash( \"sheep_tear_check\" ), true ) \r\n\t\tcall BlzStartUnitAbilityCooldown( target, ABILITY_COOLDOWN, COOLDOWN )\r\n\t\t\r\n\t\tset id = InvokeTimerWithItem( itemUsed, \"sheep_tear_delay\", 0.01, false, function Delay )\r\n\t\tcall SaveUnitHandle( udg_hash, id, StringHash( \"sheep_tear_delay_target\" ), target )\r\n\r\n\t\tset itemUsed = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnStart takes nothing returns nothing\r\n\t\tlocal unit target = BattleStart.GetDataUnit(\"caster\")\r\n\t\r\n\t\tcall SaveBoolean( udg_hash, GetHandleId( target ), StringHash( \"sheep_tear_check\" ), false ) \r\n\t\t\r\n\t\tset target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    call RegisterDuplicatableItemTypeCustom( ITEM_ID, AfterAttack, function action, function condition, \"target\" )\r\n\r\n\t    call RegisterDuplicatableItemTypeCustom( ITEM_ID, BattleStart, function OnStart, null, null)\r\n\tendfunction\r\n\t\r\nendscope\r\n",
