  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope WheelOfFortune initializer init\r\n\r\n\tglobals\r\n\t\tprivate constant integer ITEM_TYPE = 'I0A7'\r\n\t\tprivate constant integer REPICK_LIMIT = 20\r\n\t\r\n\t\tprivate constant string ANIMATION = \"Abilities\\\\Spells\\\\Human\\\\Polymorph\\\\PolyMorphDoneGround.mdl\"\r\n\t\t\r\n\t\tprivate constant integer HASH_KEY = StringHash(\"wheel_of_fortune\")\r\n\tendglobals\r\n\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetItemTypeId(GetManipulatedItem()) == ITEM_TYPE\r\n\tendfunction\r\n\t\r\n\tprivate function CastForge takes unit caster, item itemUsed, integer charges returns nothing\r\n\t\tlocal integer array itemType\r\n\t\tlocal integer i\r\n\t\tlocal integer repickLimit \r\n\t\tlocal integer indexCheck\r\n\t\r\n\t\tset i = 0\r\n\t\tset repickLimit = 1\r\n\t\tloop\r\n\t\t\texitwhen i >= 3 or repickLimit > REPICK_LIMIT\r\n\t\t\tset itemType[i] = ItemRandomizerLib_GetRandomItemType()\r\n\t\t\tset indexCheck = IMaxBJ(0, i - 1)\r\n\t\t\tif indexCheck == i or itemType[i] != itemType[indexCheck] then\r\n\t\t\t\tset i = i + 1\r\n\t\t\tendif\r\n\t\t\tset repickLimit = repickLimit + 1\r\n\t\tendloop\r\n\t\t\r\n\t\tcall BlzSetItemExtendedTooltip( itemUsed, words( caster, BlzGetItemDescription(itemUsed), \"|cFF959697(\", \")|r\", I2S(charges) ) )\r\n\t\tcall forge( caster, itemUsed, itemType[0], itemType[1], itemType[2], charges - 1 <= 0 )\r\n\tendfunction\r\n\t\r\n\tprivate function DestroyItems takes unit caster, item itemUsed returns nothing\r\n\t\tlocal integer i = 0\r\n\t    local item it\r\n\t    local integer charges = 0\r\n\t\r\n\t\tloop\r\n\t        exitwhen i > 5\r\n\t        set it = UnitItemInSlot( caster, i )\r\n\t        if it != null and it != itemUsed then\r\n\t            call RemoveItem(it)\r\n\t            set charges = charges + 1\r\n\t        endif\r\n\t        set i = i + 1\r\n\t    endloop\r\n\t    \r\n\t    call SaveInteger(udg_hash, GetHandleId(itemUsed), HASH_KEY, charges )\r\n\t    if charges != 0 then\r\n\t    \tcall CastForge( caster, itemUsed, charges )\r\n\t    endif\r\n\t    \r\n\t    call DestroyEffect( AddSpecialEffect( ANIMATION, GetUnitX( caster ), GetUnitY( caster ) ) )\r\n\r\n\t\tset it = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal item itemUsed = GetManipulatedItem()\r\n\t    local unit caster = GetManipulatingUnit()\r\n\t    local integer charges = LoadInteger(udg_hash, GetHandleId(itemUsed), HASH_KEY )\r\n\r\n\t    if charges > 0 then\r\n\t    \tcall CastForge( caster, itemUsed, charges )\r\n\t    else\r\n\t    \tcall DestroyItems(caster, itemUsed)\r\n\t    endif\r\n\r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function AfterForge_Condition takes nothing returns boolean\r\n\t    return Event_AfterForge_ForgedItem == ITEM_TYPE and Event_AfterForge_ForgedItem_Item != null\r\n\tendfunction\r\n\t\r\n\tprivate function AfterForge takes nothing returns nothing\r\n\t\tlocal unit caster = Event_AfterForge_Hero\r\n\t\tlocal item forgedItem = Event_AfterForge_ForgedItem_Item\r\n\t\tlocal integer counter\r\n\t\tlocal integer id = GetHandleId(forgedItem)\r\n\r\n\t\tset counter = LoadInteger( udg_hash, id, HASH_KEY ) - 1\r\n\t\tcall SaveInteger( udg_hash, id, HASH_KEY, counter )\r\n\t\tcall CastForge( caster, forgedItem, counter )\r\n\t\t\r\n\t    set caster = null\r\n\t    set forgedItem = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    call CreateNativeEvent( EVENT_PLAYER_UNIT_USE_ITEM, function action, function condition )\r\n\t    \r\n\t    call CreateEventTrigger( \"Event_AfterForge_Real\", function AfterForge, function AfterForge_Condition )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}