  "Id": 50332675,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope SheepMantle initializer init\r\n\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A0FK'\r\n\t\t\r\n\t\tprivate constant integer DURATION = 3\r\n\t\tprivate constant integer UNITS_TO_SUMMON = 2\r\n\t\tprivate constant integer UNIT_TYPE = 'n02L'\r\n\t\tprivate constant integer AREA_SIZE = 600\r\n\t\tprivate constant integer SUMMON_SCATTER_RANGE_MIN = 150\r\n\t\tprivate constant integer SUMMON_SCATTER_RANGE_MAX = 250\r\n\t\tprivate constant integer LIFE_TIME = 20\r\n\t\tprivate constant string ANIMATION = \"Abilities\\\\Spells\\\\Other\\\\Silence\\\\SilenceAreaBirth.mdl\"\r\n\tendglobals\r\n\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnUnit takes unit caster, location unitLoc returns nothing\r\n\t\tlocal real angle\r\n\t\tlocal location spawnLoc\r\n\t\tlocal unit newUnit\r\n\t\r\n\t\tset spawnLoc = PolarProjectionBJ( unitLoc, GetRandomReal(SUMMON_SCATTER_RANGE_MIN, SUMMON_SCATTER_RANGE_MAX), GetRandomDirectionDeg() )\r\n        set angle = AngleBetweenPoints(spawnLoc, unitLoc)\r\n        set newUnit = CreateUnitAtLoc( GetOwningPlayer( caster ), ID_SHEEP, spawnLoc, angle )\r\n        call DestroyEffect( AddSpecialEffectTarget( ANIMATION, newUnit, \"origin\" ) )\r\n        call UnitApplyTimedLife( newUnit, 'BTLF', LIFE_TIME)\r\n        \r\n        call RemoveLocation(spawnLoc)\r\n        set spawnLoc = null\r\n        set newUnit = null\r\n\tendfunction\r\n\t\r\n\tprivate function Use takes unit caster, real duration returns nothing\r\n\t\tlocal integer i\r\n\t    local integer iEnd\r\n\t    local group g \r\n\t    local unit u\r\n\t    local integer replayAmount\r\n\t    local location unitLoc\r\n\t\r\n\t\tset g = CreateGroup()\r\n\t\tset replayAmount = eyest( caster )\r\n        call GroupEnumUnitsInRange( g, GetUnitX( caster ), GetUnitY( caster ), AREA_SIZE, null )\r\n        loop\r\n            set u = FirstOfGroup(g)\r\n            exitwhen u == null\r\n            if unitst( u, caster, \"enemy\" ) then\r\n                call UnitPoly( caster, u, UNIT_TYPE, duration )\r\n                set unitLoc = GetUnitLoc(u)\r\n                set i = 1\r\n                set iEnd = replayAmount * UNITS_TO_SUMMON\r\n\t\t\t    loop\r\n\t\t\t        exitwhen i > iEnd\r\n\t\t\t        call SpawnUnit(caster, unitLoc)\r\n\t\t\t        set i = i + 1\r\n\t\t\t    endloop\r\n            endif\r\n            call GroupRemoveUnit(g,u)\r\n        endloop\r\n        \r\n        call DestroyGroup( g )\r\n\t    call RemoveLocation(unitLoc)\r\n\t    set u = null\r\n\t    set g = null\r\n\t    set unitLoc = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local unit caster\r\n\t    local real t\r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set t = udg_Time\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        call textst( udg_string[0] + GetObjectName(ABILITY_ID), caster, 64, 90, 10, 1.5 )\r\n\t        set t = udg_Time\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set t = DURATION\r\n\t    endif\r\n\t    \r\n\t    set t = timebonus(caster, t)\r\n\t    \r\n\t    call Use(caster, t)\r\n\r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Sheep_Mantle = CreateTrigger(  )\r\n\t    call TriggerRegisterAnyUnitEventBJ( gg_trg_Sheep_Mantle, EVENT_PLAYER_UNIT_SPELL_EFFECT )\r\n\t    call TriggerAddCondition( gg_trg_Sheep_Mantle, Condition( function condition ) )\r\n\t    call TriggerAddAction( gg_trg_Sheep_Mantle, function action )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}