{
  "Id": 50332579,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope CreditCard initializer init\r\n\r\n\tglobals\r\n\t\tprivate boolean IsCollectorsActive = false\r\n\t\tprivate boolean IsGoldBonusActive = false\r\n\t\t\r\n\t\tprivate constant integer ITEM_ID = 'I0CQ'\r\n\t\tprivate constant integer GOLD_GAIN = 350\r\n\t\tprivate constant string CAST_ANIMATION = \"Abilities\\\\Spells\\\\Human\\\\Resurrect\\\\ResurrectTarget.mdl\"\r\n\t\t\r\n\t\tprivate constant integer COLLECTOR_SPAWN_DELAY = 3\r\n\t\tprivate constant integer COLLECTOR_ID = 'n04D'\r\n\t\tprivate constant string SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\NightElf\\\\BattleRoar\\\\RoarCaster.mdl\"\r\n\t\t\r\n\t\tprivate constant integer VALUE_TO_ADD = 25\r\n\t\tprivate constant integer STAT_TYPE = STAT_GOLD_GAIN\r\n\tendglobals\r\n\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetItemTypeId(GetManipulatedItem()) == ITEM_ID\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal integer i\r\n\t\r\n\t\tcall moneyst( GetManipulatingUnit(), GOLD_GAIN )               \r\n\t\tcall IconFrame( \"Credit Card\", \"war3mapImported\\\\BTNINV_Misc_Map08.blp\", \"Credit Card\", \"Increases the gold received for all heroes by \" + I2S(VALUE_TO_ADD) + \"% until the end of the battle.\" )\r\n\t\tcall DisplayTimedTextToForce( bj_FORCE_ALL_PLAYERS, 5, \"|cffffcc00\" + GetItemName(GetManipulatedItem()) + \"|r is active! Gold received is increased by \" + I2S(VALUE_TO_ADD) + \"%.\" )\r\n\t\tset IsGoldBonusActive = true\r\n\t\tset IsCollectorsActive = true\r\n\t\r\n\t    call StartSound(gg_snd_QuestLog)\r\n\t    call DestroyEffect( AddSpecialEffectTarget( CAST_ANIMATION, GetManipulatingUnit(), \"origin\") )\r\n\t    call stazisst( GetManipulatingUnit(), GetManipulatedItem() )\r\n\t    \r\n\t    set i = 1\r\n\t    loop\r\n\t    \texitwhen i > 4\r\n\t    \tif udg_hero[i] != null then\r\n\t    \t\tcall StatSystem_Add( udg_hero[i], STAT_TYPE, VALUE_TO_ADD)\r\n    \t\tendif\r\n\t    \tset i = i + 1\r\n    \tendloop\r\n\tendfunction\r\n\r\n    //===========================================================================\r\n    private function OnBattleStart_Condition takes nothing returns boolean\r\n\t\treturn ExtraArenaGeneral_IsPvPActive() == false and IsCollectorsActive\r\n\tendfunction\r\n\t\r\n\tprivate function CoolectorsSpawn takes nothing returns nothing\r\n\t\tlocal integer i = 1\r\n\t\tlocal integer iEnd = udg_Boss_LvL\r\n\t\tlocal location unitSpawn\r\n\t\tlocal unit newUnit\r\n\t\r\n\t\tloop\r\n\t\t\texitwhen i > iEnd\r\n\t\t\tset unitSpawn = GetRandomLocInRect(udg_Boss_Rect)\r\n    \t\tset newUnit = CreateUnitAtLoc( Player(10), COLLECTOR_ID, unitSpawn, GetRandomPercentageBJ() )\r\n    \t\tcall DestroyEffect( AddSpecialEffectLoc( SPAWN_ANIMATION, unitSpawn ) )\r\n    \t\tcall IssueTargetOrder( newUnit, \"attackonce\", DeathSystem_GetRandomAliveHero() )\r\n    \t\t\r\n    \t\tcall RemoveLocation(unitSpawn)\r\n\t\t\tset i = i + 1\r\n\t\tendloop\r\n\t\t\r\n\t\tset newUnit = null\r\n\t\tset unitSpawn = null\r\n\tendfunction\r\n\t\r\n\tprivate function OnBattleStart takes nothing returns nothing\r\n\t\tset IsCollectorsActive = false\r\n     \tcall TimerStart( CreateTimer(), COLLECTOR_SPAWN_DELAY, false, function CoolectorsSpawn )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnBattleEnd_Condition takes nothing returns boolean\r\n\t\treturn ExtraArenaGeneral_IsPvPActive() == false and IsGoldBonusActive\r\n\tendfunction\r\n\t\r\n\tprivate function OnBattleEnd takes nothing returns nothing\r\n\t\tlocal integer i\r\n\t\r\n\t\tset IsGoldBonusActive = false\r\n        call IconFrameDel( \"Credit Card\" )\r\n        \r\n        set i = 1\r\n\t    loop\r\n\t    \texitwhen i > 4\r\n\t    \tif udg_hero[i] != null then\r\n\t    \t\tcall StatSystem_Add( udg_hero[i], STAT_TYPE, -VALUE_TO_ADD)\r\n    \t\tendif\r\n\t    \tset i = i + 1\r\n    \tendloop\r\n\tendfunction\r\n\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t\tcall CreateNativeEvent( EVENT_PLAYER_UNIT_USE_ITEM, function action, function condition )\r\n\t\tcall BattleStartGlobal.AddListener(function OnBattleStart, function OnBattleStart_Condition)\r\n\t\tcall BattleEndGlobal.AddListener(function OnBattleEnd, function OnBattleEnd_Condition)\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}