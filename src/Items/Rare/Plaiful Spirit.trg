{
  "Id": 50332656,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope PlayfulSpirit initializer init \r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ITEM_ID = 'I07L'\r\n\t\t\r\n\t\tprivate constant real SP_TO_GAIN = 4\r\n\t\tprivate constant integer MANA_TO_BURN = 12\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetItemTypeId(GetManipulatedItem()) == ITEM_ID\r\n\tendfunction\r\n\t\r\n\tfunction Naughty_SpiritCast takes nothing returns nothing \r\n\t\tlocal integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit u = LoadUnitHandle( udg_hash, id, StringHash( \"nght\" ) )\r\n\t\tlocal real r = MANA_TO_BURN * GetUnitSpellPower(u)\r\n\t    local item it = LoadItemHandle( udg_hash, id, StringHash( \"nghtt\" ) )\r\n\t    local real spellPowerGain = LoadReal( udg_hash, GetHandleId(u), StringHash( \"playful_spirit_gain\" ) )\r\n\t    \r\n\t    if not(UnitHasItem(u,it )) then\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    elseif GetUnitState( u, UNIT_STATE_MANA) >= r and IsUnitAlive(u) and combat( u, false, 0 ) then\r\n\t        call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Invisibility\\\\InvisibilityTarget.mdl\", GetUnitX( u ), GetUnitY( u ) ) )\r\n\t        call spdst( u, SP_TO_GAIN )\r\n\t        call OnManaSpend_Consume(u, r)\r\n\t        \r\n\t        set spellPowerGain = spellPowerGain + SP_TO_GAIN\r\n\t        call SaveReal( udg_hash, GetHandleId(u), StringHash( \"playful_spirit_gain\" ), spellPowerGain )\r\n\t    endif\r\n\t    \r\n\t    set it = null\r\n\t    set u = null\r\n\tendfunction \r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetManipulatedItem() )\r\n\t\r\n\t    if LoadTimerHandle( udg_hash, id, StringHash( \"nght\" ) ) == null  then\r\n\t        call SaveTimerHandle( udg_hash, id, StringHash( \"nght\" ), CreateTimer() )\r\n\t    endif \r\n\t\tset id = GetHandleId( LoadTimerHandle( udg_hash, id, StringHash( \"nght\" ) ) ) \r\n\t\tcall SaveUnitHandle( udg_hash, id, StringHash( \"nght\" ), GetManipulatingUnit() ) \r\n\t    call SaveItemHandle( udg_hash, id, StringHash( \"nghtt\" ), GetManipulatedItem() ) \r\n\t\tcall TimerStart( LoadTimerHandle( udg_hash, GetHandleId( GetManipulatedItem() ), StringHash( \"nght\" ) ), 10, true, function Naughty_SpiritCast )\r\n\tendfunction\r\n\t\r\n    //===========================================================================\r\n    private function OnBattleEnd_Condition takes nothing returns boolean\r\n\t    return LoadReal( udg_hash, GetHandleId( BattleEnd.GetDataUnit(\"caster\") ), StringHash( \"playful_spirit_gain\" ) ) != 0\r\n\tendfunction\r\n    \r\n\tprivate function OnBattleEnd takes nothing returns nothing\r\n\t\tlocal unit caster = BattleEnd.GetDataUnit(\"caster\")\r\n\t\tlocal real valueToLose = LoadReal( udg_hash, GetHandleId( caster ), StringHash( \"playful_spirit_gain\" ) )\r\n\t    \r\n\t    call spdst( caster, -valueToLose )\r\n        call SaveReal( udg_hash, GetHandleId(caster), StringHash( \"playful_spirit_gain\" ), 0 )\r\n\t    \r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Plaiful_Spirit = CreateTrigger(  )\r\n\t    call TriggerRegisterAnyUnitEventBJ( gg_trg_Plaiful_Spirit, EVENT_PLAYER_UNIT_PICKUP_ITEM )\r\n\t    call TriggerAddCondition( gg_trg_Plaiful_Spirit, Condition( function condition ) )\r\n\t    call TriggerAddAction( gg_trg_Plaiful_Spirit, function action )\r\n\t    \r\n\t    call BattleEnd.AddListener(function OnBattleEnd, function OnBattleEnd_Condition)\r\n\tendfunction\r\n\t\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}