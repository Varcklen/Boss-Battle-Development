  "Script": "scope SoulShard initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A13M'\r\n\t\tprivate constant integer ITEM_ID = 'I0BR'\r\n\t\t\r\n\t\tprivate constant integer BASE_DAMAGE = 200\r\n\t\tprivate constant integer BONUS_DAMAGE = 200\r\n\t\t\r\n\t\tprivate constant string SOUL_GAIN_ANIMATION = \"Abilities\\\\Spells\\\\Items\\\\TomeOfRetraining\\\\TomeOfRetrainingCaster.mdl\"\r\n\t\tprivate constant string ANIMATION = \"war3mapImported\\\\ForkedLightningOrange.mdx\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer cyclA\r\n\t    local integer cyclAEnd\r\n\t    local unit caster\r\n\t    local unit target\r\n\t    local real dmg\r\n\t    local integer index\r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = udg_Target\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = randomtarget( caster, 900, \"enemy\", 0, 0, 0 )\r\n\t        call textst( udg_string[0] + GetObjectName(ABILITY_ID), caster, 64, 90, 10, 1.5 )\r\n\t        if target == null then\r\n\t            set caster = null\r\n\t            return\r\n\t        endif\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set target = GetSpellTargetUnit()\r\n\t    endif\r\n\t    \r\n\t    set index = GetPlayerId(GetOwningPlayer( caster ) ) + 1\r\n\t    set dmg = BASE_DAMAGE + udg_Item_Souls[index]\r\n\t    if combat( caster, false, 0 ) and ExtraArenaGeneral_IsPvPActive() == false and IsUnitType( target, UNIT_TYPE_ANCIENT) then\r\n\t        set udg_Item_Souls[index] = 0\r\n\t        call ChangeToolItem( caster, ITEM_ID, \"|cffbe81f2\", \"|r\", I2S(BASE_DAMAGE) )\r\n\t    endif\r\n\r\n\t    call DestroyEffect( AddSpecialEffect( ANIMATION, GetUnitX( target ), GetUnitY( target ) ) )\r\n\t    set cyclA = 1\r\n\t    set cyclAEnd = eyest(caster)\r\n\t    loop\r\n\t        exitwhen cyclA > cyclAEnd\r\n\t        call UnitDamageTarget( caster, target, dmg, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)\r\n\t        set cyclA = cyclA + 1\r\n\t    endloop\r\n\t    \r\n\t    set caster = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n    //===========================================================================\r\n    private function OnKill_Condition takes nothing returns boolean\r\n    \tif IsUnitType( GetKillingUnit(), UNIT_TYPE_HERO) == false then\r\n\t\t\treturn false\r\n    \telseif inv(GetKillingUnit(), ITEM_ID) == 0 then\r\n    \t\treturn false\r\n\t\telseif IsUnitDead(GetKillingUnit()) then\r\n\t\t\treturn false\r\n\t\telseif ExtraArenaGeneral_IsPvPActive() then\r\n\t\t\treturn false\r\n\t\telseif combat( GetKillingUnit(), false, 0 ) == false then\r\n\t\t\treturn false\r\n\t\telseif IsUnitAlly(GetDyingUnit(), GetOwningPlayer(GetKillingUnit())) then\r\n\t\t\treturn false\r\n    \tendif\r\n\t    return true\r\n\tendfunction\r\n\t\r\n\tprivate function OnKill takes nothing returns nothing\r\n\t\tlocal unit caster = GetKillingUnit()\r\n\t\tlocal integer index = GetPlayerId( GetOwningPlayer(caster) ) + 1\r\n\r\n        set udg_Item_Souls[index] = udg_Item_Souls[index] + BONUS_DAMAGE\r\n        call ChangeToolItem( caster, ITEM_ID, \"|cffbe81f2\", \"|r\", I2S( BASE_DAMAGE + udg_Item_Souls[index] ) )\r\n        call DestroyEffect( AddSpecialEffect( SOUL_GAIN_ANIMATION, GetUnitX( caster ), GetUnitY( caster ) ) )\r\n\r\n\t\tset caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    call CreateNativeEvent( EVENT_PLAYER_UNIT_SPELL_EFFECT, function action, function condition )\r\n\t    call CreateNativeEvent( EVENT_PLAYER_UNIT_DEATH, function OnKill, function OnKill_Condition )\r\n\tendfunction\r\n\t\r\nendscope",
