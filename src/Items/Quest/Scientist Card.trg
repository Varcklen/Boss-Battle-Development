  "RunOnMapInit": false,
  "Script": "scope ScientistCard initializer init\r\n\r\n\tglobals \r\n\t\tprivate constant integer HASH_KEY = StringHash(\"scientist_catd_bonus\")\r\n\t\tprivate constant integer PERCHACES_REQUIRE = 2\r\n\t\t\r\n\t\tprivate ListInt Books\r\n\tendglobals\r\n\r\n\tfunction Trig_Scientist_Card_Conditions takes nothing returns boolean\r\n\t    return GetItemTypeId(GetManipulatedItem()) == 'I0EZ'\r\n\tendfunction\r\n\t\r\n\tfunction Trig_Scientist_Card_Actions takes nothing returns nothing                \r\n\t    call DestroyEffect( AddSpecialEffectTarget( \"Abilities\\\\Spells\\\\Human\\\\Resurrect\\\\ResurrectTarget.mdl\", GetManipulatingUnit(), \"origin\") )\r\n\t    call statst( GetManipulatingUnit(), 15, 15, 15, 0, true )\r\n\t    call SaveBoolean(udg_hash, GetHandleId(GetManipulatingUnit()), HASH_KEY, true )\r\n\t    call stazisst( GetManipulatingUnit(), GetManipulatedItem() )\r\n\tendfunction\r\n\t\r\n\t\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n    \treturn GetUnitTypeId(GetSellingUnit()) == 'h007' and LoadBoolean(udg_hash, GetHandleId(GetBuyingUnit()), HASH_KEY )\r\n\tendfunction\r\n\t\r\n\tprivate function GiveBook takes unit caster returns nothing\r\n\t\tlocal item itemGain\r\n\t\tlocal integer itemType = Books.GetRandomCell()\r\n\t\r\n\t\tset itemGain = CreateItem( itemType, GetUnitX( caster ), GetUnitY( caster ) )\r\n\t\tcall UnitAddItem( caster, itemGain )\r\n        call textst( \"|c00FFFFFF \" + GetItemName(itemGain) + \" received.\", caster, 64, 90, 10, 1.5 )\r\n        \r\n        set itemGain = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal unit caster = GetBuyingUnit()\r\n\t\tlocal integer id = GetHandleId( caster )\r\n\t    local integer count = LoadInteger( udg_hash, id, HASH_KEY ) + 1\r\n\t\r\n\t    if count >= PERCHACES_REQUIRE then\r\n\t        call SaveInteger( udg_hash, id, HASH_KEY, 0 )\r\n\t        call GiveBook(caster)\r\n\t    else\r\n\t        call SaveInteger( udg_hash, id, HASH_KEY, count )\r\n\t        //call textst( \"|c005050FF \" + I2S( count ) + \"/\" + I2S(PERCHACES_REQUIRE), GetBuyingUnit(), 64, GetRandomReal( 0, 360 ), 7, 1.5 )\r\n\t    endif\r\n\t    \r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Scientist_Card = CreateTrigger(  )\r\n\t    call TriggerRegisterAnyUnitEventBJ( gg_trg_Scientist_Card, EVENT_PLAYER_UNIT_USE_ITEM )\r\n\t    call TriggerAddCondition( gg_trg_Scientist_Card, Condition( function Trig_Scientist_Card_Conditions ) )\r\n\t    call TriggerAddAction( gg_trg_Scientist_Card, function Trig_Scientist_Card_Actions )\r\n\t    \r\n\t    call CreateNativeEvent( EVENT_PLAYER_UNIT_SELL_ITEM, function action, function condition )\r\n\t    \r\n\t    set Books = ListInt.create()\r\n\t    call Books.Add('I01N')\r\n\t    call Books.Add('I01R')\r\n\t    call Books.Add('I01Q')\r\n\t    call Books.Add('I01O')\r\n\t    call Books.Add('I01S')\r\n\t    call Books.Add('I05M')\r\n\t    call Books.Add('I03U')\r\n\t    call Books.Add('I05E')\r\n\t    call Books.Add('I01P')\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
