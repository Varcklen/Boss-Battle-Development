  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope CosmicReed initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A0T7'\r\n\t\tprivate constant integer ITEM_ID = 'I0E3'\r\n\t\tprivate constant real HEAL_AMOUNT = 0.5\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer cyclA = 1\r\n\t    local integer cyclAEnd\r\n\t    local integer i\r\n\t    local unit caster\r\n\t    local unit target\r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = udg_Target\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = randomtarget( caster, 900, \"enemy\", 0, 0, 0 )\r\n\t        call textst( udg_string[0] + GetObjectName(ABILITY_ID), caster, 64, 90, 10, 1.5 )\r\n\t        if target == null then\r\n\t            set caster = null\r\n\t            return\r\n\t        endif\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set target = GetSpellTargetUnit()\r\n\t    endif\r\n\t\r\n\t    set i = GetPlayerId(GetOwningPlayer(caster) ) + 1\r\n\t    set cyclAEnd = eyest( caster )\r\n\t    loop\r\n\t        exitwhen cyclA > cyclAEnd\r\n\t        call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\NightElf\\\\EntanglingRoots\\\\EntanglingRootsTarget.mdl\", GetUnitX( target ), GetUnitY( target ) ) )\r\n\t        call UnitDamageTarget( caster, target, HEAL_AMOUNT * udg_HealFight[i], true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)\r\n\t        set cyclA = cyclA + 1\r\n\t    endloop\r\n\t    \r\n\t    set caster = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\t\r\n\tprivate function OnHeal_Condition takes nothing returns boolean\r\n\t\treturn inv(Event_AfterHeal_Caster, ITEM_ID) > 0\r\n\tendfunction\r\n\t\r\n\tprivate function OnHeal takes nothing returns nothing\r\n\t\tlocal integer i = GetPlayerId( GetOwningPlayer( Event_AfterHeal_Caster ) ) + 1\r\n\t\tlocal integer value = R2I( HEAL_AMOUNT * udg_HealFight[i] )\r\n\t\r\n\t\tcall ChangeToolItem( Event_AfterHeal_Caster, ITEM_ID, \"|cffbe81f7\", \"|r\", I2S( value ) )\r\n\tendfunction\r\n    \r\n    //===========================================================================\r\n    private function OnStart takes nothing returns nothing\r\n\t\tlocal unit caster = BattleStart.GetDataUnit(\"caster\")\r\n\t\t\r\n        call ChangeToolItem( caster, ITEM_ID, \"|cffbe81f7\", \"|r\", \"0\" )\r\n\t\t\r\n    \tset caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t\tcall RegisterDuplicatableItemTypeCustom( ITEM_ID, BattleStart, function OnStart, null, null)\r\n\t\tcall CreateEventTrigger( \"Event_AfterHeal_Real\", function OnHeal, function OnHeal_Condition )\r\n\t    call CreateNativeEvent( EVENT_PLAYER_UNIT_SPELL_EFFECT, function action, function condition )\r\n\tendfunction\r\nendscope\r\n",
