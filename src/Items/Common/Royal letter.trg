{
  "Id": 50332509,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope RoyalLetter initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer HASH_KEY = StringHash(\"royal_letter\")\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetItemTypeId(GetManipulatedItem()) == 'I0CY'\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local unit caster = GetManipulatingUnit()\r\n\t    local integer itemType\r\n\t    local integer id = GetHandleId(caster)\r\n\t    local integer counter\r\n\t    \r\n\t    call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Polymorph\\\\PolyMorphDoneGround.mdl\", GetUnitX( caster ), GetUnitY( caster ) ) )\r\n\t    call stazisst( caster, GetManipulatedItem() )\r\n\t    \r\n\t    if ItemManipulation_IsInventoryFull(caster) == false then\r\n\t    \tset itemType = udg_DB_Item_Destroyed[GetRandomInt( 1, udg_Database_NumberItems[29] )]\r\n\t    \tcall UnitAddItem( caster, CreateItem( itemType, GetUnitX(caster), GetUnitY(caster) ) )\r\n\t    endif\r\n\t    set counter = LoadInteger(udg_hash, id, HASH_KEY) + 1\r\n\t    call SaveInteger(udg_hash, id, HASH_KEY, counter)\r\n\t    //call BJDebugMsg( \"counter: \" + I2S(counter) )\r\n\t    \r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnBattleEnd_Condition takes nothing returns boolean\r\n\t\t/*call BJDebugMsg( \"unit: \" + GetUnitName( BattleEnd.GetDataUnit(\"caster\") ) )\r\n\t\tcall BJDebugMsg(\"LoadInteger(): \" +  I2S(LoadInteger(udg_hash, GetHandleId( BattleEnd.GetDataUnit(\"caster\") ), HASH_KEY)))*/\r\n\t    return LoadInteger(udg_hash, GetHandleId( BattleEnd.GetDataUnit(\"caster\") ), HASH_KEY) > 0\r\n\tendfunction\r\n\t\r\n\tprivate function OnBattleEnd takes nothing returns nothing\r\n\t    local unit caster = BattleEnd.GetDataUnit(\"caster\")\r\n\t    local integer id = GetHandleId(caster)\r\n\t    local integer i\r\n\t    local integer iMax \r\n\t    \r\n\t    set i = 1\r\n\t    set iMax = LoadInteger(udg_hash, id, HASH_KEY)\r\n\t    loop\r\n\t    \texitwhen i > iMax or ItemManipulation_IsInventoryFull(caster)\r\n\t    \t//call BJDebugMsg(\"Add\")\r\n\t\t\tcall UnitAddItem( caster, CreateItem( 'I0CY', GetUnitX(caster), GetUnitY(caster) ) )\r\n\t\t\tset i = i + 1\r\n\t\tendloop\r\n\t\tcall SaveInteger(udg_hash, id, HASH_KEY, 0)\r\n\t\t//call BJDebugMsg(\"End\")\r\n\t    \r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Royal_letter = CreateTrigger(  )\r\n\t    call TriggerRegisterAnyUnitEventBJ( gg_trg_Royal_letter, EVENT_PLAYER_UNIT_USE_ITEM )\r\n\t    call TriggerAddCondition( gg_trg_Royal_letter, Condition( function condition ) )\r\n\t    call TriggerAddAction( gg_trg_Royal_letter, function action )\r\n\t    \r\n\t    call BattleEnd.AddListener(function OnBattleEnd, function OnBattleEnd_Condition)\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}