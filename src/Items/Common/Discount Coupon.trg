{
  "Id": 50333058,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope DiscountCoupon initializer init\r\n\r\n    globals\r\n        private constant integer ITEM_ID = 'I0A3'\r\n        private constant integer GOLD_BONUS = 150\r\n        \r\n        private constant integer MAX_CHARGES = 3\r\n        \r\n        private constant integer CHARGE_KEY = StringHash( \"discount_coupon_charges\" )\r\n    endglobals\r\n    \r\n    private function IsEnoughCharges takes unit caster, item itemInitiator returns boolean\r\n\t\tlocal integer chargesUsed = LoadInteger(udg_hash, GetHandleId(itemInitiator), CHARGE_KEY)\r\n\t\treturn MAX_CHARGES - chargesUsed > 0\r\n\tendfunction\r\n\r\n    private function condition takes nothing returns boolean\r\n        return GetItemType(BeforeItemSplit.GetDataItem(\"item_used\")) != ITEM_TYPE_POWERUP and GetItemType(BeforeItemSplit.GetDataItem(\"item_used\")) != ITEM_TYPE_PURCHASABLE\r\n    endfunction\r\n    \r\n    private function action takes nothing returns nothing\r\n    \tlocal unit caster = BeforeItemSplit.GetDataUnit(\"caster\")\r\n    \tlocal item itemInitiator = Trigger_GetItemUsed()\r\n    \tlocal integer id = GetHandleId(itemInitiator)\r\n    \tlocal integer chargesUsed = LoadInteger(udg_hash, id, CHARGE_KEY)\r\n\t\tlocal string newText\r\n\t\r\n    \tif IsEnoughCharges(caster, itemInitiator) == false then\r\n    \t\treturn\r\n    \tendif\r\n    \t\r\n    \tcall moneyst( caster, GOLD_BONUS )\r\n    \tset chargesUsed = chargesUsed + 1\r\n\t    call SaveInteger(udg_hash, id, CHARGE_KEY, chargesUsed)\r\n\t    set newText = words( caster, BlzGetItemDescription(itemInitiator), \"|cffffffff\", \"|r\", I2S(MAX_CHARGES - chargesUsed) )\r\n\t    call BlzSetItemExtendedTooltip( itemInitiator, newText )\r\n\r\n        set itemInitiator = null\r\n        set caster = null\r\n    endfunction\r\n    \r\n    //===========================================================================\r\n\tprivate function condition_battle_end takes nothing returns boolean\r\n\t\treturn udg_fightmod[3] == false\r\n\tendfunction\r\n\r\n\tprivate function action_battle_end takes nothing returns nothing\r\n\t\tlocal unit caster = BattleEnd.GetDataUnit(\"caster\")\r\n\t\tlocal item itemInitiator = Trigger_GetItemUsed()\r\n\t\tlocal integer id = GetHandleId(itemInitiator)\r\n\t\tlocal string newText\r\n\r\n\t    call SaveInteger(udg_hash, id, CHARGE_KEY, 0)\r\n\t    set newText = words( caster, BlzGetItemDescription(itemInitiator), \"|cffffffff\", \"|r\", I2S(MAX_CHARGES) )\r\n\t    call BlzSetItemExtendedTooltip( itemInitiator, newText )\r\n\t\r\n\t\tset caster = null\r\n\t\tset itemInitiator = null\r\n\tendfunction\r\n\r\n\t//===========================================================================\r\n    private function init takes nothing returns nothing\r\n    \tcall RegisterDuplicatableItemTypeCustom( ITEM_ID, BeforeItemSplit, function action, function condition, null )\r\n        //call CreateEventTrigger( \"Event_ItemSplit_Real\", function ItemSplit, function ItemSplit_Conditions )\r\n        call RegisterDuplicatableItemTypeCustom( ITEM_ID, BattleEnd, function action_battle_end, function condition_battle_end, null )\r\n    endfunction\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}