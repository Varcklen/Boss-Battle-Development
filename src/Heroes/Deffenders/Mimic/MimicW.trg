{
  "Id": 50333024,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope MimicW\r\n\r\n\tfunction Trig_MimicW_Conditions takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == 'A099'\r\n\tendfunction\r\n\t\r\n\tprivate function DealDamage takes unit caster, unit target, real damage returns nothing\r\n\t\tlocal integer rand\r\n\t\t\r\n\t\tcall DestroyEffect( AddSpecialEffectTarget( \"Objects\\\\Spawnmodels\\\\NightElf\\\\NECancelDeath\\\\NECancelDeath.mdl\", target, \"origin\" ) )\r\n\t    call UnitDamageTarget(caster, target, damage, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)\r\n\t    \r\n\t    if not( udg_fightmod[3] ) and combat( caster, false, 0 ) and IsUnitDead(target) then\r\n\t        set rand = GetRandomInt(1, 3)\r\n\t        if rand == 1 then\r\n\t            call statst( caster, 1, 0, 0, 220, true )\r\n\t            call textst( \"|c00FF2020 +1 strength\", caster, 64, 90, 10, 1 )\r\n\t        elseif rand == 2 then\r\n\t            call statst( caster, 0, 1, 0, 224, true )\r\n\t            call textst( \"|c0020FF20 +1 agility\", caster, 64, 90, 10, 1 )\r\n\t        elseif rand == 3 then\r\n\t            call statst( caster, 0, 0, 1, 228, true )\r\n\t            call textst( \"|c002020FF +1 intelligence\", caster, 64, 90, 10, 1 )\r\n\t        endif\r\n\t    endif\r\n\tendfunction\r\n\t\r\n\tfunction Trig_MimicW_Actions takes nothing returns nothing\r\n\t    local unit caster\r\n\t    local unit target\r\n\t    local integer lvl\r\n\t    local real damage\r\n\t    local integer i\r\n\t    local integer iEnd\r\n\t    local integer index\r\n\t    local unit randomTarget\r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = udg_Target\r\n\t        set lvl = udg_Level\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = randomtarget( caster, 300, \"enemy\", 0, 0, 0 )\r\n\t        set lvl = udg_Level\r\n\t        call textst( udg_string[0] + GetObjectName('A099'), caster, 64, 90, 10, 1.5 )\r\n\t        if target == null then\r\n\t            set caster = null\r\n\t            return\r\n\t        endif\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set target = GetSpellTargetUnit()\r\n\t        set lvl = GetUnitAbilityLevel(GetSpellAbilityUnit(), GetSpellAbilityId())\r\n\t    endif\r\n\t    set damage = 40 + (40 * lvl)\r\n\t    \r\n\t    call DealDamage(caster, target, damage)\r\n\t\r\n\t    set index = CorrectPlayer(caster)\r\n\t    if udg_Set_Cristall_Number[index] > 0 then\r\n\t    \tset i = 1\r\n\t\t\tset iEnd = udg_Set_Cristall_Number[index]\r\n\t\t\tloop\r\n\t\t\t\tset randomTarget = randomtarget( caster, 300, \"enemy\", 0, 0, 0 )\r\n\t\t\t\texitwhen i > iEnd or randomTarget == null\r\n\t\t\t\tcall DealDamage(caster, randomTarget, damage)\r\n\t\t\t\tset i = i + 1\r\n\t\t\tendloop\r\n\t    endif\r\n\t\r\n\t    set target = null\r\n\t    set caster = null\r\n\t    set randomTarget = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tfunction InitTrig_MimicW takes nothing returns nothing\r\n\t    set gg_trg_MimicW = CreateTrigger(  )\r\n\t    call TriggerRegisterAnyUnitEventBJ( gg_trg_MimicW, EVENT_PLAYER_UNIT_SPELL_EFFECT )\r\n\t    call TriggerAddCondition( gg_trg_MimicW, Condition( function Trig_MimicW_Conditions ) )\r\n\t    call TriggerAddAction( gg_trg_MimicW, function Trig_MimicW_Actions )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}