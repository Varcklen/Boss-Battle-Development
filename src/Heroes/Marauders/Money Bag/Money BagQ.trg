  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope MoneyBagQ initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A17T'\r\n\t\t\r\n\t\tprivate constant integer DAMAGE_INITIAL = 100\r\n\t\tprivate constant integer DAMAGE_PER_LEVEL = 50\r\n\t\tprivate constant real STUN_DURATION = 1\r\n\t\tprivate constant integer UNIT_LIFE_TIME = 15\r\n\t\t\r\n\t\tprivate constant integer FLY_HEIGHT_SPEED = 600\r\n\t\tprivate constant integer MAX_HEIGHT = 1500\r\n\t\t\r\n\t\tprivate constant integer JUMP_SPEED = 30\r\n\t\tprivate constant real TICK_RATE = 0.02\r\n\t\t\r\n\t\tprivate constant integer INVUL_ABILITY = 'A1IR'\r\n\t\tprivate constant string ANIMATION = \"Abilities\\\\Weapons\\\\ChimaeraAcidMissile\\\\ChimaeraAcidMissile.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID\r\n\tendfunction\r\n\t\r\n\tprivate function JumpEnd takes unit projectile, unit target, integer id returns nothing\r\n\t\tlocal unit caster = LoadUnitHandle( udg_hash, id, StringHash( \"money_bag_q_caster\" ) )\r\n\t\tlocal real h = LoadReal( udg_hash, id, StringHash( \"money_bag_q_default_height\" ) )\r\n\t    local real flyHeight = LoadReal ( udg_hash, id, StringHash( \"money_bag_q_height\" ) )\r\n\t    local real damage = LoadReal( udg_hash, id, StringHash( \"money_bag_q_damage\" ))\r\n\t\r\n\t\tcall SetUnitPathing( projectile, true )\r\n        call SetUnitFlyHeight( projectile, h, flyHeight )\r\n\t\tcall UnitRemoveAbility( projectile, 'Amrf' )\r\n\t\tcall PauseUnit( projectile, false)\r\n\t\tcall UnitRemoveAbility( projectile, INVUL_ABILITY )\r\n\t\t\r\n        if IsUnitAlive(target) then\r\n            call UnitStun(caster, target, STUN_DURATION )\r\n            call UnitDamageTarget( caster, target, damage, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)\r\n        endif\r\n\tendfunction\r\n\t\r\n\tprivate function Jump takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit projectile = LoadUnitHandle( udg_hash, id, StringHash( \"money_bag_q\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"money_bag_q_target\" ) )\r\n\t    local integer counter = LoadInteger( udg_hash, id, StringHash( \"money_bag_q_counter\" ) ) + 1\r\n\t    local real x = GetUnitX( target )\r\n\t    local real y = GetUnitY( target )\r\n\t    local real angle = Atan2( y - GetUnitY( projectile ), x - GetUnitX( projectile ) )\r\n\t    local real NewX = GetUnitX( projectile ) + JUMP_SPEED * Cos( angle )\r\n\t    local real NewY = GetUnitY( projectile ) + JUMP_SPEED * Sin( angle )\r\n\r\n\t    if counter == 10 then\r\n\t        call SetUnitFlyHeight( projectile, -FLY_HEIGHT_SPEED, MAX_HEIGHT )\r\n\t    endif\r\n\t\r\n\t    if counter == 20 or IsUnitDead(projectile) then\r\n\t\t\tcall JumpEnd(projectile, target, id)\r\n\t        call FlushChildHashtable( udg_hash, id ) \r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else \r\n\t        call SaveInteger( udg_hash, id, StringHash( \"money_bag_q_counter\" ), counter )\r\n\t        call SetUnitPosition( projectile, NewX, NewY )\r\n\t    endif\r\n\t    \r\n\t    set projectile = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function Use takes unit caster, unit target, integer lvl returns nothing\r\n\t    local integer id\r\n\t    local integer damage\r\n\t    local real unitDefaultFlyHeight\r\n\t    local real unitFlyHeight\r\n\t    local unit newUnit\r\n\t    local integer unitType\r\n\t    \r\n\t    set damage = DAMAGE_INITIAL + lvl * DAMAGE_PER_LEVEL\r\n\t    set unitDefaultFlyHeight = GetUnitDefaultFlyHeight(caster)\r\n\t    set unitFlyHeight = GetUnitFlyHeight(caster)\r\n\t\t\r\n\t\tset unitType = udg_Database_RandomUnit[GetRandomInt(1, udg_Database_NumberItems[5])]\r\n\t\tset newUnit = CreateUnit( GetOwningPlayer(caster), unitType, GetUnitX( caster ), GetUnitY( caster ), GetUnitFacing(caster) )\r\n        call DestroyEffect( AddSpecialEffect( ANIMATION, GetUnitX( newUnit ), GetUnitY( newUnit ) ) )\r\n\t\tcall UnitApplyTimedLife( newUnit, 'BTLF', UNIT_LIFE_TIME)\r\n\t\t\r\n\t\tcall PauseUnit( newUnit, true )\r\n\t\tcall UnitAddAbility( newUnit, INVUL_ABILITY )\r\n\t\tcall UnitAddAbility( newUnit, 'Amrf' )\r\n\t\tcall SetUnitFlyHeight( newUnit, FLY_HEIGHT_SPEED, MAX_HEIGHT )\r\n\t\tcall SetUnitPathing( newUnit, false )\r\n\t\t\r\n\t\tset id = InvokeTimerWithUnit( newUnit, \"money_bag_q\", TICK_RATE, true, function Jump )\r\n\t\tcall SaveUnitHandle( udg_hash, id, StringHash( \"money_bag_q_caster\" ), caster)\r\n\t\tcall SaveUnitHandle( udg_hash, id, StringHash( \"money_bag_q_target\" ), target )\r\n\t\tcall SaveReal( udg_hash, id, StringHash( \"money_bag_q_damage\" ), damage)\r\n\t    call SaveReal( udg_hash, id, StringHash( \"money_bag_q_default_height\" ), unitDefaultFlyHeight)\r\n\t    call SaveReal( udg_hash, id, StringHash( \"money_bag_q_height\" ), unitFlyHeight )\r\n\r\n\t\tset newUnit = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer lvl\r\n\t    local unit caster\r\n\t    local unit target\r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = udg_Target\r\n\t        set lvl = udg_Level\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = randomtarget( caster, 900, \"enemy\", 0, 0, 0 )\r\n\t        set lvl = udg_Level\r\n\t        call textst( udg_string[0] + GetObjectName(ABILITY_ID), caster, 64, 90, 10, 1.5 )\r\n\t        if target == null then\r\n\t            set caster = null\r\n\t            return\r\n\t        endif\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set target = GetSpellTargetUnit()\r\n\t        set lvl = GetUnitAbilityLevel(caster, GetSpellAbilityId())\r\n\t    endif\r\n\t    \r\n\t    call Use(caster, target, lvl)\r\n\t    \r\n\t    set caster = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Money_BagQ = CreateNativeEvent( EVENT_PLAYER_UNIT_SPELL_EFFECT, function action, function condition )\r\n\tendfunction\r\n\t\r\nendscope",
