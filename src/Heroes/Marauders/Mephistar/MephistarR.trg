  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope MephistarR initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A161'\r\n\t\tprivate constant integer ITEM_TYPE_ID = 'I02U'\r\n\t\t\r\n\t    private constant integer DAMAGE_INITIAL = 5\r\n\t    private constant integer DAMAGE_PER_LEVEL = 20\r\n\t    \r\n\t    private constant integer CHANCE_INITIAL = 2\r\n\t    private constant integer CHANCE_PER_LEVEL = 4\r\n\t    \r\n\t    private constant integer ITEM_SPAWN_CHANCE = 25\r\n\t    \r\n\t    private constant integer ITEM_SPAWN_DEVIATION = 200\r\n\t    private constant integer AREA_SIZE = 300\r\n\t    private constant string CAST_ANIMATION = \"war3mapImported\\\\ArcaneExplosion.mdx\"\r\n\t    private constant string ITEM_SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Orc\\\\FeralSpirit\\\\feralspirittarget.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t\tif udg_IsDamageSpell then\r\n\t\t\t//call BJDebugMsg(\"udg_IsDamageSpell\")\r\n\t\t\treturn false\r\n\t\tendif\r\n\t\tif IsUnitAlly( AfterAttack.TriggerUnit, GetOwningPlayer( AfterAttack.TargetUnit ) ) then\r\n\t\t\t//call BJDebugMsg(\"IsUnitAlly\")\r\n\t\t\treturn false\r\n\t\tendif\r\n\t\tif GetUnitAbilityLevel( udg_DamageEventSource, ABILITY_ID) == 0 then\r\n\t\t\t//call BJDebugMsg(\"GetUnitAbilityLevel( udg_DamageEventSource, ABILITY_ID) == 0\")\r\n\t\t\treturn false\r\n\t\tendif\r\n\t\tif LuckChance( AfterAttack.TriggerUnit, CHANCE_INITIAL + CHANCE_PER_LEVEL * GetUnitAbilityLevel( AfterAttack.TriggerUnit, ABILITY_ID) ) then\r\n\t\t\t//call BJDebugMsg(\"luck\")\r\n\t\t\treturn true\r\n\t\tendif\r\n\t\t//call BJDebugMsg(\"unluck\")\r\n\t    return false\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnItem takes unit caster, unit groupTarget returns nothing\r\n\t\tlocal item itedCreated\r\n\t\r\n\t\tif combat( caster, false, 0 ) == false or ExtraArenaGeneral_IsPvPActive() then\r\n\t\t\treturn\r\n\t\tendif\r\n\t\tif LuckChance( caster, ITEM_SPAWN_CHANCE ) == false then\r\n\t\t\treturn\r\n\t\tendif\r\n\t\tset itedCreated = CreateItem( ITEM_TYPE_ID, Math_GetUnitRandomX( groupTarget, ITEM_SPAWN_DEVIATION ), Math_GetUnitRandomY( groupTarget, ITEM_SPAWN_DEVIATION ) )\r\n        call DestroyEffect( AddSpecialEffect( ITEM_SPAWN_ANIMATION, GetItemX( itedCreated ), GetItemY( itedCreated ) ) )\r\n        \r\n        set itedCreated = null\r\n\tendfunction\r\n\t\r\n\tprivate function Cast takes nothing returns nothing\r\n\t\tlocal integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit target = LoadUnitHandle(udg_hash, id, StringHash(\"mephistar_r_target\") )\r\n\t    local unit caster = LoadUnitHandle(udg_hash, id, StringHash(\"mephistar_r\") )\r\n\t    local integer lvl = GetUnitAbilityLevel( caster, ABILITY_ID)\r\n\t    local real dmg = DAMAGE_INITIAL + DAMAGE_PER_LEVEL * lvl\r\n\t    local group g = CreateGroup()\r\n\t    local unit u\r\n\t    \r\n\t    call GroupEnumUnitsInRange( g, GetUnitX( target ), GetUnitY( target ), AREA_SIZE, null )\r\n\t    loop\r\n\t        set u = FirstOfGroup(g)\r\n\t        exitwhen u == null\r\n\t        if unitst( u, caster, \"enemy\" ) then\r\n\t            call SpawnItem(caster, u)\r\n\t            call UnitDamageTarget( caster, u, dmg, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS )\r\n\t        elseif unitst( u, caster, \"ally\" ) then\r\n\t            call SpawnItem(caster, u)\r\n\t            call healst(caster, u, dmg )\r\n\t        endif\r\n\t        call GroupRemoveUnit(g,u)\r\n\t    endloop\r\n\t\r\n\t    call DestroyGroup( g )\r\n\t    set u = null\r\n\t    set g = null\r\n\t    set caster = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local unit caster = AfterAttack.GetDataUnit(\"caster\")\r\n\t    local unit target = AfterAttack.GetDataUnit(\"target\")\r\n\t    local integer id\r\n\t    \r\n\t    //call BJDebugMsg(\"cast\")\r\n\t    call DestroyEffect( AddSpecialEffect( CAST_ANIMATION, GetUnitX(target), GetUnitY(target) ) )\r\n\t    set id = InvokeTimerWithUnit( caster, \"mephistar_r\", 0.01, false, function Cast )\r\n\t    call SaveUnitHandle(udg_hash, id, StringHash(\"mephistar_r_target\"), target)\r\n\t    \r\n\t    set caster = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_MephistarR = AfterAttack.AddListener(function action, function condition)\r\n\tendfunction\r\n\t\r\nendscope\r\n",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}