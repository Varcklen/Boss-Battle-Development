  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope WagonE initializer init\r\n\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A0DN'\r\n\t\tprivate constant integer TICK = 6\r\n\t\t\r\n\t\tprivate constant integer GOLD_BOOST = 1\r\n\t\tprivate constant integer HEAL_BOOST = 2\r\n\tendglobals\r\n\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetLearnedSkill() == ABILITY_ID\r\n\tendfunction\r\n\t\r\n\tprivate function Check takes unit caster returns boolean\r\n\t\tif IsUnitDead(caster) then\r\n\t\t\treturn true\r\n\t\telseif IsUnitLoaded( caster ) then\r\n\t\t\treturn true\r\n\t\telseif combat( caster, false, 0 ) == false then\r\n\t\t\treturn true\r\n\t\tendif\r\n\t\treturn false\r\n\tendfunction\r\n\t\r\n\tprivate function WagonECast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit caster = LoadUnitHandle( udg_hash, id, StringHash( \"wagon_w\" ) )\r\n\t    local integer heroId = GetHandleId(caster)\r\n\t    \r\n\t    local integer money = LoadInteger( udg_hash, id, StringHash( \"wagon_w_money\" ) )\r\n\t    local integer moneySum = LoadInteger( udg_hash, heroId, StringHash( \"wagon_w_sum_money\" ) )\r\n\t    \r\n\t    local integer heal = LoadInteger( udg_hash, id, StringHash( \"wagon_w_heal\" ) )\r\n\t    local integer healSum = LoadInteger( udg_hash, heroId, StringHash( \"wagon_w_sum_heal\" ) )\r\n\r\n\t\tif Check(caster) then\r\n\t\t\tset caster = null\r\n\t\t\treturn\r\n\t\tendif\r\n\t\t\r\n\t\tset heal = heal + healSum\r\n\t\tset money = money + moneySum\r\n\r\n\t    if GetUnitAbilityLevel( caster, ABILITY_ID) > 0 then\r\n            call BlzStartUnitAbilityCooldown( caster, ABILITY_ID, TICK )\r\n        endif\r\n        if udg_fightmod[3] == false then\r\n            call moneyst( caster, money )\r\n        endif\r\n        call healst( caster, null, heal )\r\n        call SaveInteger( udg_hash, heroId, StringHash( \"wagon_w_sum_money\" ), moneySum + GOLD_BOOST )\r\n        call SaveInteger( udg_hash, heroId, StringHash( \"wagon_w_sum_heal\" ), healSum + HEAL_BOOST )\r\n\t    \r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal unit caster = GetLearningUnit()\r\n\t    local integer id = GetHandleId( caster )\r\n\t    local integer level = GetUnitAbilityLevel( caster, ABILITY_ID )\r\n\t    local integer money = 1 + level\r\n\t    local integer heal = 4 + 2 * level\r\n\t    \r\n\t    set id = InvokeTimerWithUnit( caster, \"wagon_w\", TICK, true, function WagonECast )\r\n\t    call SaveInteger( udg_hash, id, StringHash( \"wagon_w_money\" ), money )\r\n\t    call SaveInteger( udg_hash, id, StringHash( \"wagon_w_heal\" ), heal )\r\n\t    \r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnAbilityRemove_Condition takes nothing returns boolean\r\n\t    return GetUnitAbilityLevel( udg_Event_NullingAbility_Unit, ABILITY_ID ) > 0\r\n\tendfunction\r\n\t\r\n\tprivate function OnAbilityRemove takes nothing returns nothing\r\n\t\tlocal integer id = GetHandleId( udg_Event_NullingAbility_Unit )\r\n\t\tlocal timer timerUsed = LoadTimerHandle( udg_hash, id, StringHash( \"wagon_w\" ) )\r\n\t\tlocal integer timerId = GetHandleId(timerUsed)\r\n\t\t\r\n\t\tcall SaveInteger( udg_hash, id, StringHash( \"wagon_w_sum_money\" ), 0 )\r\n        call SaveInteger( udg_hash, id, StringHash( \"wagon_w_sum_heal\" ), 0 )\r\n\t\tcall FlushChildHashtable( udg_hash, timerId )\r\n\t\tcall DestroyTimer(timerUsed)\r\n\t\t\r\n\t\tset timerUsed = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n    private function OnBattleEnd_Condition takes nothing returns boolean\r\n\t    return GetUnitAbilityLevel( BattleEnd.GetDataUnit(\"caster\"), ABILITY_ID ) > 0\r\n\tendfunction\r\n    \r\n\tprivate function OnBattleEnd takes nothing returns nothing\r\n\t\tlocal unit caster = BattleEnd.GetDataUnit(\"caster\")\r\n\t\tlocal integer heroId = GetHandleId(caster)\r\n\r\n        call SaveInteger( udg_hash, heroId, StringHash( \"wagon_w_sum_money\" ), 0 )\r\n        call SaveInteger( udg_hash, heroId, StringHash( \"wagon_w_sum_heal\" ), 0 )\r\n\t    \r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_WagonE = CreateNativeEvent( EVENT_PLAYER_HERO_SKILL, function action, function condition )\r\n\t    call CreateEventTrigger( \"udg_Event_NullingAbility_Real\", function OnAbilityRemove, function OnAbilityRemove_Condition )\r\n\t    \r\n\t    call BattleEnd.AddListener(function OnBattleEnd, function OnBattleEnd_Condition)\r\n\tendfunction\r\n\r\nendscope",
