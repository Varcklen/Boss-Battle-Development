{
  "Id": 50332965,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope AdventurerQ initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A12J'\r\n\t\t\r\n\t\tprivate constant integer DAMAGE_INITIAL = 100\r\n\t\tprivate constant integer DAMAGE_PER_LEVEL = 50\r\n\t\t\r\n\t\tprivate constant real TICK = 0.04\r\n\t\tprivate constant integer MIN_RANGE_TO_TARGET = 100\r\n\t\tprivate constant integer SPEED = 30\r\n\t\t\r\n\t\tprivate constant string ANIMATION_SHOOT = \"Abilities\\\\Weapons\\\\FrostWyrmMissile\\\\FrostWyrmMissile.mdl\"\r\n\t\tprivate constant string ANIMATION_IMPACT = \"Abilities\\\\Weapons\\\\FrostWyrmMissile\\\\FrostWyrmMissile.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID and combat( GetSpellAbilityUnit(), true, GetSpellAbilityId() ) and ExtraArenaGeneral_IsPvPActive() == false\r\n\tendfunction\r\n\t\r\n\tprivate function Impact takes unit target, integer id returns nothing\r\n\t\tlocal real damage = LoadReal( udg_hash, id, StringHash( \"adventurer_q_damage\" ) )\r\n\t\tlocal unit caster = LoadUnitHandle( udg_hash, id, StringHash( \"adventurer_q_caster\" ) )\r\n\t\r\n\t\tcall DestroyEffect( AddSpecialEffect( ANIMATION_IMPACT, GetUnitX( target ), GetUnitY( target ) ) )\r\n        call UnitDamageTarget( caster, target, damage, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS )\r\n        \r\n        set caster = null\r\n\tendfunction\r\n\t\r\n\tprivate function AdventurerQMotion takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"adventurer_q_target\" ) )\r\n\t    local unit projectile = LoadUnitHandle( udg_hash, id, StringHash( \"adventurer_q\" ) )\r\n\t    local real x = GetUnitX( target )\r\n\t    local real y = GetUnitY( target )\r\n\t    local real angle = Atan2( y - GetUnitY( projectile ), x - GetUnitX( projectile ) )\r\n\t    local real NewX = GetUnitX( projectile ) + SPEED * Cos( angle )\r\n\t    local real NewY = GetUnitY( projectile ) + SPEED * Sin( angle )\r\n\t    local real IfX = ( x - GetUnitX( projectile ) ) * ( x - GetUnitX( projectile ) )\r\n\t    local real IfY = ( y - GetUnitY( projectile ) ) * ( y - GetUnitY( projectile ) )\r\n\t    \r\n\t    if SquareRoot( IfX + IfY ) > MIN_RANGE_TO_TARGET and IsUnitAlive( target ) and IsUnitAlive( projectile ) then\r\n\t        call SetUnitPosition( projectile, NewX, NewY )\r\n\t    else\r\n\t    \tif IsUnitAlive( target ) then\r\n\t    \t\tcall Impact(target, id)\r\n    \t\tendif\r\n\t        call RemoveUnit( projectile )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    endif\r\n\t    \r\n\t    set projectile = null\r\n\t    set target = null\r\n\tendfunction \r\n\t\r\n\tprivate function Shoot takes unit caster, real damage returns nothing\r\n\t\tlocal group g = CreateGroup()\r\n\t    local unit u\r\n\t    local unit projectile\r\n\t    local integer id\r\n\t\r\n\t\tcall GroupEnumUnitsOfPlayer(g, Player(10), null )\r\n        loop\r\n            set u = FirstOfGroup(g)\r\n            exitwhen u == null\r\n            if IsUnitType( u, UNIT_TYPE_ANCIENT) and IsUnitAlive( u ) and RectContainsUnit( udg_Boss_Rect, u ) then\r\n                set projectile = CreateUnit( GetOwningPlayer( caster), 'u000', GetUnitX(caster), GetUnitY(caster), GetUnitFacing(caster) )\r\n                call UnitAddAbility(projectile, 'A12K')\r\n\r\n                set id = InvokeTimerWithUnit( projectile, \"adventurer_q\", TICK, true, function AdventurerQMotion )\r\n                call SaveUnitHandle( udg_hash, id, StringHash( \"adventurer_q_target\" ), u )\r\n                call SaveUnitHandle( udg_hash, id, StringHash( \"adventurer_q_caster\" ), caster )\r\n                call SaveReal( udg_hash, id, StringHash( \"adventurer_q_damage\" ), damage )\r\n            endif\r\n            call GroupRemoveUnit(g,u)\r\n        endloop\r\n\t\r\n\t\tcall DestroyGroup( g )\r\n\t    set g = null\r\n\t    set u = null\r\n\t    set projectile = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer id \r\n\t    local unit caster\r\n\t    local integer lvl\r\n\t    local real damage\r\n\t    local real extraDamage\r\n\r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set lvl = udg_Level\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set lvl = udg_Level\r\n\t        call textst( udg_string[0] + GetObjectName(ABILITY_ID), caster, 64, 90, 10, 1.5 )\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set lvl = GetUnitAbilityLevel(GetSpellAbilityUnit(), GetSpellAbilityId())\r\n\t    endif\r\n\r\n\t\tset id = GetHandleId(caster)\r\n\t\tset extraDamage = LoadReal( udg_hash, id, StringHash(\"adventurer_q_extra_damage\") )\r\n\t    set damage = DAMAGE_INITIAL + DAMAGE_PER_LEVEL * lvl\r\n\t    call DestroyEffect( AddSpecialEffect( ANIMATION_SHOOT, GetUnitX( caster ), GetUnitY( caster ) ) )\r\n\t    \r\n\t    if IsUnitGroupEmptyBJ(udg_Bosses) then\r\n\t        set extraDamage = extraDamage + damage\r\n\t        call textst( \"|c00FFcc00\" + I2S( R2I( extraDamage ) ) + \" damage\", caster, 64, 90, 12, 2.5 )\r\n\t    else\r\n\t        call Shoot(caster, damage + extraDamage)\r\n\t        set extraDamage = 0\r\n\t    endif\r\n\t\tcall SaveReal( udg_hash, id, StringHash(\"adventurer_q_extra_damage\"), extraDamage )\r\n\t    \r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t\tset gg_trg_AdventurerQ = CreateNativeEvent( EVENT_PLAYER_UNIT_SPELL_EFFECT, function action, function condition )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}