{
  "Id": 503330601,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope DogQ initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A154'\r\n\t\t\r\n\t\tprivate constant real EXTRA_DAMAGE_MULTIPLIER = 3 \r\n\t\tprivate constant integer DAMAGE_INITIAL = 50\r\n\t\tprivate constant integer DAMAGE_PER_LEVEL = 50\r\n\t\t\r\n\t\tprivate constant string ATTACK_ANIMATION = \"Abilities\\\\Spells\\\\Other\\\\Stampede\\\\StampedeMissileDeath.mdl\"\r\n\t\tprivate constant string KILL_ANIMATION = \"war3mapImported\\\\SoulRitual.mdx\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID\r\n\tendfunction\r\n\t\r\n\tprivate function DogQCast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit caster = LoadUnitHandle( udg_hash, id, StringHash( \"dogq\" ) )\r\n\t    local integer abilityUsed = LoadInteger( udg_hash, id, StringHash( \"dogq\" ) )\r\n\r\n\t\tcall UnitReduceAbilityCooldownPercent( caster, abilityUsed, 100 )\r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t\r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\tprivate function GetExtraDamageValue takes unit target returns real\r\n\t\tlocal real percent = GetUnitLifePercent(target) / 100.0\r\n\t\treturn ( 1 - percent ) * EXTRA_DAMAGE_MULTIPLIER\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer lvl\r\n\t    local unit caster\r\n\t    local unit target\r\n\t    local real dmg\r\n\t    local integer id\r\n\t    local real extraDamage\r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = udg_Target\r\n\t        set lvl = udg_Level\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set lvl = udg_Level\r\n\t        set target = randomtarget( caster, 300, \"all\", RT_NOT_CASTER, 0, 0 )\r\n\t        call textst( udg_string[0] + GetObjectName(ABILITY_ID), caster, 64, 90, 10, 1.5 )\r\n\t        if target == null then\r\n\t            set caster = null\r\n\t            return\r\n\t        endif\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set target = GetSpellTargetUnit()\r\n\t        set lvl = GetUnitAbilityLevel(GetSpellAbilityUnit(), GetSpellAbilityId())\r\n\t    endif\r\n\t    \r\n\t    set extraDamage = GetExtraDamageValue(target)\r\n\t    set dmg = DAMAGE_INITIAL + DAMAGE_PER_LEVEL * lvl\r\n\t    if extraDamage > 0 then\r\n\t        set dmg = dmg + dmg * extraDamage\r\n\t    endif\r\n\t    \r\n\t    //call BJDebugMsg(\"Extra: \" + R2S(extraDamage) )\r\n\t    \r\n\t    call DestroyEffect( AddSpecialEffect( ATTACK_ANIMATION, GetUnitX( target ), GetUnitY( target ) ) )\r\n\t    call UnitDamageTarget( caster, target, dmg, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)\r\n\t    call healst( caster, null, dmg )\r\n\t     \r\n\t    if IsUnitDead(target) and GetSpellAbilityId() == ABILITY_ID then\r\n\t        call DestroyEffect( AddSpecialEffect( KILL_ANIMATION, GetUnitX( caster ), GetUnitY( caster ) ) )\r\n\r\n\t        set id = InvokeTimerWithUnit( caster, \"dogq\", 0.05, false, function DogQCast )\r\n\t        call SaveInteger( udg_hash, id, StringHash( \"dogq\" ), GetSpellAbilityId() )\r\n\t    endif\r\n\t     \r\n\t    set caster = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_DogQ = CreateTrigger(  )\r\n\t    call TriggerRegisterAnyUnitEventBJ( gg_trg_DogQ, EVENT_PLAYER_UNIT_SPELL_EFFECT )\r\n\t    call TriggerAddCondition( gg_trg_DogQ, Condition( function condition ) )\r\n\t    call TriggerAddAction( gg_trg_DogQ, function action )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}