  "Id": 503330561,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope OgreQ initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A0ET'\r\n\t\t\r\n\t\tprivate constant integer DURATION = 3\r\n\t\t\r\n\t\tprivate constant integer EFFECT_ID = 'A0DP'\r\n\t\tprivate constant integer BUFF_ID = 'B067'\r\n\t\t\r\n\t\tprivate constant integer EXTRA_DAMAGE_INITIAL = 0\r\n\t\tprivate constant integer EXTRA_DAMAGE_PER_LEVEL = 20\r\n\t\t\r\n\t\tprivate constant string CAST_ANIMATION = \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID\r\n\tendfunction\r\n\t\r\n\tprivate function OgreQEnd takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit u = LoadUnitHandle( udg_hash, id, StringHash( \"ogrq\" ) )\r\n\t\r\n\t    call UnitRemoveAbility( u, EFFECT_ID )\r\n\t    call UnitRemoveAbility( u, BUFF_ID )\r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t\r\n\t    set u = null\r\n\tendfunction\r\n\t\r\n\tprivate function AddAbility takes unit caster, unit target, real duration returns nothing\r\n\t    call bufallst( caster, target, EFFECT_ID, 0, 0, 0, 0, BUFF_ID, \"ogrq\", duration )\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local unit caster\r\n\t    local unit target\r\n\t    local integer lvl\r\n\t    local real extraDamage\r\n\t    local real t\r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = udg_Target\r\n\t        set lvl = udg_Level\r\n\t        set t = udg_Time\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = randomtarget( caster, 300, \"enemy\", 0, 0, 0 )\r\n\t        set lvl = udg_Level\r\n\t        set t = DURATION\r\n\t        call textst( udg_string[0] + GetObjectName(ABILITY_ID), caster, 64, 90, 10, 1.5 )\r\n\t        if target == null then\r\n\t            set caster = null\r\n\t            return\r\n\t        endif\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set target = GetSpellTargetUnit()\r\n\t        set lvl = GetUnitAbilityLevel(GetSpellAbilityUnit(), GetSpellAbilityId())\r\n\t        set t = DURATION\r\n\t    endif\r\n\t    set t = timebonus(caster, t)\r\n\t    set extraDamage = EXTRA_DAMAGE_INITIAL + EXTRA_DAMAGE_PER_LEVEL * lvl\r\n\t    \r\n\t    call DestroyEffect( AddSpecialEffect( CAST_ANIMATION, GetUnitX( target ), GetUnitY( target )) )\r\n\t    call AddAbility(caster, target, t)\r\n\t    call SetUnitAbilityLevel( target, 'A0DM', lvl )\r\n\t    call SaveReal( udg_hash, GetHandleId(target), StringHash( \"ogre_q_extra_damage\" ), extraDamage )\r\n\t    call SaveUnitHandle( udg_hash, GetHandleId(target), StringHash( \"ogre_q_caster\" ), caster )\r\n\t    \r\n\t    set caster = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function AfterDamage_Condition takes nothing returns boolean\r\n\t\treturn udg_IsDamageSpell == false and GetUnitAbilityLevel( udg_DamageEventTarget, EFFECT_ID) > 0\r\n\tendfunction\r\n\t\r\n\tprivate function AfterDamage takes nothing returns nothing\r\n\t\tlocal unit caster = udg_DamageEventSource\r\n\t\tlocal unit target = udg_DamageEventTarget\r\n\t\tlocal integer id = GetHandleId( target )\r\n\t\tlocal real extraDamage\r\n\t\t\r\n\t\tif LoadUnitHandle( udg_hash, id, StringHash( \"ogre_q_caster\" ) ) != caster then\r\n\t\t\tset caster = null\r\n        \tset target = null\r\n\t\t\treturn\r\n\t\tendif\r\n\t\tset extraDamage = LoadReal( udg_hash, id, StringHash( \"ogre_q_extra_damage\" ) )\r\n\t\tset udg_DamageEventAmount = udg_DamageEventAmount + extraDamage\r\n\t\tcall AddAbility( caster, target, timebonus(caster, DURATION) )\r\n  \r\n        set caster = null\r\n        set target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_OgreQ = CreateNativeEvent( EVENT_PLAYER_UNIT_SPELL_EFFECT, function action, function condition )\r\n\t    call CreateEventTrigger( \"udg_DamageModifierEvent\", function AfterDamage, function AfterDamage_Condition )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}