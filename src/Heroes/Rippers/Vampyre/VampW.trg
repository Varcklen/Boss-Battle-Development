{
  "Id": 50333040,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope VampW initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A0AB'\r\n\t\t\r\n\t\tprivate constant integer DAMAGE_INITIAL = 60\r\n\t\tprivate constant integer DAMAGE_PER_LEVEL = 40\r\n\t\tprivate constant integer AREA = 250\r\n\t\tprivate constant real STUN_DURATION = 1\r\n\t\t\r\n\t\tprivate constant integer ABILITY_COST = 60\r\n\t\tprivate constant integer BEHIND_MOVE_RANGE = 100\r\n\t\t\r\n\t\tprivate constant string ANIMATION = \"Blood Explosion.mdx\"\r\n\t\t\r\n\t\tpublic trigger Trigger = null\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID and combat( GetSpellAbilityUnit(), true, GetSpellAbilityId() )\r\n\tendfunction\r\n\t\r\n\tprivate function VampWCast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit caster = LoadUnitHandle( udg_hash, id, StringHash( \"vampire_w\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"vampire_w_target\" ) )\r\n\t    local real damage = LoadReal( udg_hash, id, StringHash( \"vampire_w_damage\" ) )\r\n\t\tlocal location moveLoc = LoadLocationHandle( udg_hash, id, StringHash( \"vampire_w_loc\" ) )\r\n\t    \r\n\t    call SetUnitPositionLoc( caster, moveLoc )\r\n\t    call SetUnitFacing( caster, GetUnitFacing( target ) )\r\n\t    \r\n\t    if IsUnitEnemy(target, GetOwningPlayer(caster) ) then\r\n\t    \tcall UnitStun(caster, target, STUN_DURATION )\r\n\t    endif\r\n\t    call GroupAoE( caster, GetUnitX(caster), GetUnitY(caster), damage, AREA, \"enemy\", ANIMATION, null )\r\n\t    \r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\r\n\t\tcall RemoveLocation(moveLoc)\r\n\t\tset moveLoc = null\r\n\t\tset target = null\r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\tprivate function GetLocationMove takes unit target returns location\r\n\t\tlocal real angle = GetUnitFacing(target)\r\n\t\tlocal location unitLoc = GetUnitLoc(target)\r\n\t\tlocal location moveLoc = PolarProjectionBJ(unitLoc, -BEHIND_MOVE_RANGE, angle )\r\n\t\t\r\n\t\tcall RemoveLocation(unitLoc)\r\n\t\tset unitLoc = null\r\n\t\treturn moveLoc\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local unit caster\r\n\t    local unit target\r\n\t    local integer id\r\n\t    local real damage \r\n\t    local integer lvl\r\n\t    local location moveLoc\r\n\t\r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = udg_Target\r\n\t        set lvl = udg_Level\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = randomtarget( caster, 900, \"enemy\", 0, 0, 0 )\r\n\t        set lvl = udg_Level\r\n\t        call textst( udg_string[0] + GetObjectName(ABILITY_ID), caster, 64, 90, 10, 1.5 )\r\n\t        if target == null then\r\n\t            set caster = null\r\n\t            return\r\n\t        endif\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set target = GetSpellTargetUnit()\r\n\t        set lvl = GetUnitAbilityLevel(GetSpellAbilityUnit(), GetSpellAbilityId())\r\n\t    endif\r\n\t    \r\n\t    set moveLoc = GetLocationMove(target)\r\n\t    \r\n\t    if combat( caster, false, 0 ) and not( RectContainsLoc( udg_Boss_Rect, moveLoc ) ) then\r\n\t        set caster = null\r\n\t        set target = null\r\n\t        return\r\n\t    endif\r\n\t    \r\n\t    set damage = DAMAGE_INITIAL + DAMAGE_PER_LEVEL * lvl\r\n\t    \r\n\t    set id = InvokeTimerWithUnit( caster, \"vampire_w\", 0.01, false, function VampWCast )\r\n\t    call SaveUnitHandle( udg_hash, id, StringHash( \"vampire_w_target\" ), target )\r\n\t    call SaveReal( udg_hash, id, StringHash( \"vampire_w_damage\" ), damage )\r\n\t    call SaveLocationHandle( udg_hash, id, StringHash( \"vampire_w_loc\" ), moveLoc )\r\n\t    \r\n\t\tcall SetUnitState( caster, UNIT_STATE_LIFE, RMaxBJ(0, GetUnitState( caster, UNIT_STATE_LIFE) - ABILITY_COST ) )\r\n\t    \r\n\t    set caster = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set Trigger = CreateNativeEvent( EVENT_PLAYER_UNIT_SPELL_EFFECT, function action, function condition )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}