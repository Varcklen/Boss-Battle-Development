  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope PeacelockW initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A03J'\r\n\t\tprivate constant integer TARGET_EFFECT = 'A04I'\r\n\t\tprivate constant integer TARGET_BUFF = 'B010'\r\n\t\tprivate constant integer ENEMY_EFFECT = 'A04P'\r\n\t\tprivate constant integer ENEMY_BUFF = 'B012'\r\n\t\t\r\n\t\tprivate constant string ANIMATION = \"Abilities\\\\Spells\\\\Orc\\\\MirrorImage\\\\MirrorImageCaster.mdl\"\r\n\t\tprivate constant real TICK = 0.02\r\n\t\t\r\n\t\tprivate constant real HEAL_PERCENT_INITIAL = 0.1\r\n\t\tprivate constant real HEAL_PERCENT_PER_LEVEL = 0.05\r\n\t\tprivate constant integer SEARCH_RANGE = 600\r\n\t\t\r\n\t\tprivate boolean isLoop = false\r\n\t\tpublic trigger Trigger = null\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID\r\n\tendfunction\r\n\t\r\n\tprivate function PeacelockWMove takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit caster = LoadUnitHandle( udg_hash, id, StringHash( \"pckw1\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"pckw1t\" ) )\r\n\t    local lightning l = LoadLightningHandle( udg_hash, id, StringHash( \"pckw1l\" ) )\r\n\t\r\n\t    if caster != target and IsUnitAlive( caster ) and IsUnitAlive( target ) and GetUnitAbilityLevel(caster, TARGET_BUFF) > 0 and GetUnitAbilityLevel(target, ENEMY_BUFF) > 0 then\r\n\t    \tcall MoveLightningUnits( l, caster, target )\r\n\t    else\r\n\t        call UnitRemoveAbility( caster, TARGET_EFFECT )\r\n\t        call UnitRemoveAbility( caster, TARGET_BUFF )\r\n\t        call UnitRemoveAbility( target, ENEMY_EFFECT )\r\n\t        call UnitRemoveAbility( target, ENEMY_BUFF )\r\n\t    \tcall DestroyLightning( l )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    endif\r\n\t    \r\n\t    set caster = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer id \r\n\t    local unit caster\r\n\t    local unit target\r\n\t    local unit targetRandomEnemy\r\n\t    local real bindPower\r\n\t    local integer lvl\r\n\t    local lightning ray\r\n\t    local real t\r\n\t    local timer timerUsed\r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = udg_Target\r\n\t        set lvl = udg_Level\r\n\t        set t = udg_Time\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = randomtarget( caster, 900, \"ally\", 0, 0, 0 )\r\n\t        set lvl = udg_Level\r\n\t        call textst( udg_string[0] + GetObjectName(ABILITY_ID), caster, 64, 90, 10, 1.5 )\r\n\t        set t = 12\r\n\t        if target == null then\r\n\t            set caster = null\r\n\t            return\r\n\t        endif\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set target = GetSpellTargetUnit()\r\n\t        set lvl = GetUnitAbilityLevel(GetSpellAbilityUnit(), GetSpellAbilityId())\r\n\t        set t = 12\r\n\t    endif\r\n\t    set t = timebonus(caster, t)\r\n\t    set targetRandomEnemy = randomtarget( target, SEARCH_RANGE, \"enemy\", 0, 0, 0 )\r\n\t    \r\n\t    if targetRandomEnemy != null then\r\n\t        set bindPower = HEAL_PERCENT_INITIAL + HEAL_PERCENT_PER_LEVEL * lvl\r\n\t\r\n\t        call bufst( caster, target, TARGET_EFFECT, TARGET_BUFF, \"pckw\", t )\r\n\t\r\n\t        call bufst( caster, targetRandomEnemy, ENEMY_EFFECT, ENEMY_BUFF, \"pckw\", t )\r\n\t        \r\n\t        call DestroyEffect( AddSpecialEffectTarget( ANIMATION, target, \"origin\" ) )\r\n\t        call DestroyEffect( AddSpecialEffectTarget( ANIMATION, targetRandomEnemy, \"origin\" ) )\r\n\t        \r\n\t        call SaveUnitHandle( udg_hash, GetHandleId( targetRandomEnemy ), StringHash( \"pckw2\" ), target )\r\n\t        call SaveUnitHandle( udg_hash, GetHandleId( targetRandomEnemy ), StringHash( \"pckw2c\" ), caster )\r\n\t        call SaveReal( udg_hash, GetHandleId( targetRandomEnemy ), StringHash( \"pckw2\" ), bindPower )\r\n\r\n\t\t\tset timerUsed = LoadTimerHandle( udg_hash, GetHandleId( target ), StringHash( \"pckw1\" ) )\r\n\t    \tif timerUsed == null then\r\n\t    \t\tset ray = Lightning_CreateToUnits(\"DRAL\", target, targetRandomEnemy, 0)\r\n\t        else\r\n\t            set ray = LoadLightningHandle( udg_hash, GetHandleId( timerUsed ), StringHash( \"pckw1l\" ) )\r\n\t    \tendif\r\n\t    \tset id = InvokeTimerWithUnit( target, \"pckw1\", TICK, true, function PeacelockWMove )\r\n\t    \tcall SaveUnitHandle( udg_hash, id, StringHash( \"pckw1t\" ), targetRandomEnemy )\r\n\t        call SaveLightningHandle( udg_hash, id, StringHash( \"pckw1l\" ), ray )\r\n\t    endif\r\n\t    \r\n\t    set caster = null\r\n\t    set target = null\r\n\t    set targetRandomEnemy = null\r\n\t    set ray = null\r\n\t    set timerUsed = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n    private function DeleteBuff_Conditions takes nothing returns boolean\r\n        return GetUnitAbilityLevel( Event_DeleteBuff_Unit, TARGET_EFFECT) > 0\r\n    endfunction\r\n    \r\n    private function DeleteBuff takes nothing returns nothing\r\n        local unit hero = Event_DeleteBuff_Unit\r\n\r\n\t\tcall UnitRemoveAbility( hero, TARGET_EFFECT )\r\n        call UnitRemoveAbility( hero, TARGET_BUFF )\r\n\r\n        set hero = null\r\n    endfunction\r\n    \r\n    private function DeleteBuffTarget_Conditions takes nothing returns boolean\r\n        return GetUnitAbilityLevel( Event_DeleteBuff_Unit, ENEMY_EFFECT) > 0\r\n    endfunction\r\n    \r\n    private function DeleteBuffTarget takes nothing returns nothing\r\n        local unit hero = Event_DeleteBuff_Unit\r\n\r\n\t\tcall UnitRemoveAbility( hero, ENEMY_EFFECT )\r\n        call UnitRemoveAbility( hero, ENEMY_BUFF )\r\n\r\n        set hero = null\r\n    endfunction\r\n    \r\n    //===========================================================================\r\n\tprivate function AfterDamage_Conditions takes nothing returns boolean\r\n        return GetUnitAbilityLevel( udg_DamageEventTarget, ENEMY_BUFF ) > 0 and isLoop == false\r\n    endfunction\r\n    \r\n    private function AfterDamage takes nothing returns nothing\r\n    \tlocal unit damagedUnit = udg_DamageEventTarget\r\n    \tlocal unit target = LoadUnitHandle( udg_hash, GetHandleId( damagedUnit ), StringHash( \"pckw2\" ) )\r\n\t    local unit caster = LoadUnitHandle( udg_hash, GetHandleId( damagedUnit ), StringHash( \"pckw2c\" ) )\r\n\t    local real percent = LoadReal( udg_hash, GetHandleId( damagedUnit ), StringHash( \"pckw2\" ) )\r\n\t\r\n\t    if target != null then\r\n\t    \tset isLoop = true\r\n\t        call healst(caster, target, percent * udg_DamageEventAmount )\r\n\t        set isLoop = false\r\n\t    endif\r\n\t\r\n\t    set target = null\r\n\t    set caster = null\r\n    \tset damagedUnit = null\r\n    endfunction\r\n    \r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set Trigger = CreateNativeEvent( EVENT_PLAYER_UNIT_SPELL_EFFECT, function action, function condition )\r\n\t    \r\n\t    call CreateEventTrigger( \"Event_DeleteBuff_Real\", function DeleteBuff, function DeleteBuff_Conditions )\r\n\t    call CreateEventTrigger( \"Event_DeleteBuff_Real\", function DeleteBuffTarget, function DeleteBuffTarget_Conditions )\r\n\t    call CreateEventTrigger( \"udg_AfterDamageEvent\", function AfterDamage, function AfterDamage_Conditions )\r\n\tendfunction\r\n\t\r\nendscope",
