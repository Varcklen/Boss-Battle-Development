  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope RealBroR initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A1BH'\r\n\t\tprivate constant integer UNIT_TYPE_PRIORITY = 'n030'\r\n\t\t\r\n\t\tprivate constant integer PROJECTILE_SEARCH_AREA = 400\r\n\t\tprivate constant integer MAX_COUNTER = 50\r\n\t\t\r\n\t\tprivate constant integer DAMAGE_INITIAL = 100\r\n\t\tprivate constant integer DAMAGE_PER_LEVEL = 50\r\n\t\tprivate constant integer DAMAGE_AREA = 50\r\n\t\t\r\n\t\tprivate constant real TICK = 0.02\r\n\t\tprivate constant real HALF_TIME = 0.5\r\n\t\tprivate constant real SPEED = 30\r\n\t\t\r\n\t\tprivate constant string LAND_ANIMATION = \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\"\r\n\t\t\r\n\t\tpublic trigger Trigger = null\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID and combat( GetSpellAbilityUnit(), true, GetSpellAbilityId() )\r\n\tendfunction\r\n\t\r\n\r\n\tprivate function RealBroRCast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit caster = LoadUnitHandle( udg_hash, id, StringHash( \"rlbrc\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"rlbrt\" ) )\r\n\t    local real h \r\n\t    local unit projectile = LoadUnitHandle( udg_hash, id, StringHash( \"rlbr\" ) )\r\n\t    local real x = LoadReal( udg_hash, id, StringHash( \"rlbrx\" ) )\r\n\t    local real y = LoadReal( udg_hash, id, StringHash( \"rlbry\" ) )\r\n\t    local real xc = GetUnitX( projectile )\r\n\t    local real yc = GetUnitY( projectile )\r\n\t    local real angle = Atan2( y - yc, x - xc )\r\n\t    local real NewX = xc + SPEED * Cos( angle )\r\n\t    local real NewY = yc + SPEED * Sin( angle )\r\n\t\tlocal real dmg = LoadReal( udg_hash, id, StringHash( \"rlbr\" ))\r\n\t    local real IfX = ( x - xc ) * ( x - xc )\r\n\t    local real IfY = ( y - yc ) * ( y - yc )\r\n\t    local real IfS = SquareRoot( IfX + IfY )\r\n\t    local boolean l = LoadBoolean( udg_hash, id, StringHash( \"rlbr\" ))\r\n\t    local real halftime = LoadReal( udg_hash, id, StringHash( \"rlbrht\" ) )\r\n\t    local real time = LoadReal( udg_hash, id, StringHash( \"rlbrp\" ) ) + TICK\r\n\t\r\n\t    if IfS < MAX_COUNTER or IsUnitDead( projectile ) or combat( caster, false, 0 ) == false then\r\n\t    \tset h = LoadReal( udg_hash, id, StringHash( \"rlbrh\" ) )\r\n\t    \r\n\t        call SetUnitFlyHeight( projectile, h, 0 )\r\n\t\t\tcall SetUnitPathing( projectile, true )\r\n\t\t\tcall UnitRemoveAbility( projectile, 'Amrf' )\r\n\t\t\tcall pausest( projectile, -1 )\r\n\t        call UnitRemoveAbility(projectile, 'A1BI')\r\n\t        if IsUnitAlive( projectile ) then\r\n\t            call GroupAoE( caster, xc, yc, dmg, PROJECTILE_SEARCH_AREA, \"enemy\", LAND_ANIMATION, \"\" )\r\n\t        endif\r\n\t        call FlushChildHashtable( udg_hash, id ) \r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else \r\n\t        call SetUnitPosition( projectile, NewX, NewY )\r\n\t    endif\r\n\t    if time >= halftime and not(l) then\r\n\t        call SetUnitFlyHeight( projectile, -600, 1500 )\r\n\t        call SaveBoolean( udg_hash, id, StringHash( \"rlbr\" ), true )\r\n\t    else\r\n\t        call SaveReal( udg_hash, id, StringHash( \"rlbrp\" ), time )\r\n\t    endif\r\n\t    \r\n\t    set projectile = null\r\n\t    set target = null\r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\tprivate function FindBunny takes unit caster returns unit\r\n\t\tlocal group g = CreateGroup()\r\n\t    local unit n\r\n\t\r\n\t\tcall GroupEnumUnitsInRange( g, GetUnitX( caster ), GetUnitY( caster ), PROJECTILE_SEARCH_AREA, null )\r\n\t    loop\r\n\t        set n = FirstOfGroup(g)\r\n\t        exitwhen n == null\r\n\t        if GetUnitTypeId( n ) == UNIT_TYPE_PRIORITY then\r\n\t        \tcall DestroyGroup(g)\r\n\t        \tset g = null\r\n\t            return n\r\n\t        endif\r\n\t        call GroupRemoveUnit(g,n)\r\n\t    endloop\r\n\t    \r\n\t    call DestroyGroup(g)\r\n    \tset g = null\r\n    \tset n = null\r\n\t    return null\r\n\tendfunction\r\n\t\r\n\tprivate function Cast takes unit caster, unit target, integer level returns nothing\r\n\t\tlocal integer id \r\n\t    local unit projectile = null\r\n\t    local real damage\r\n\t    local real flyHeight\r\n\t    local real distanceToTarget\r\n\t    local integer lvl\r\n\t    local real halftime\r\n\t    \r\n\t\tset projectile = FindBunny(caster)\r\n\r\n\t    if projectile == null then\r\n\t        set projectile = randomtarget( caster, PROJECTILE_SEARCH_AREA, \"all\", RT_NOT_CASTER, RT_CAN_MOVE, RT_VULNERABLE )\r\n\t    endif\r\n\t    \r\n\t    if projectile == null then\r\n\t    \tcall LaunchShortCooldown(caster, GetSpellAbilityId(), level)\r\n\t    \treturn\r\n\t    endif\r\n\t    \r\n        set damage = DAMAGE_INITIAL + level * DAMAGE_PER_LEVEL\r\n        set flyHeight = GetUnitDefaultFlyHeight(projectile)\r\n        set distanceToTarget = DistanceBetweenUnits( target, projectile )\r\n        set halftime = TICK * HALF_TIME * distanceToTarget / SPEED\r\n \r\n        if GetUnitAbilityLevel(projectile, 'A1BI') == 0 then\r\n            call pausest( projectile, 1 )\r\n        endif\r\n        call UnitAddAbility(projectile, 'A1BI')\r\n        call UnitAddAbility( projectile, 'Amrf' )\r\n        call SetUnitFlyHeight( projectile, 600, 1500 )\r\n        call SetUnitPathing( projectile, false )\r\n        \r\n        set id = InvokeTimerWithUnit( projectile, \"rlbr\", TICK, true, function RealBroRCast )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"rlbrc\" ),caster)\r\n        call SaveReal( udg_hash, id, StringHash( \"rlbrx\" ), GetUnitX(target) )\r\n        call SaveReal( udg_hash, id, StringHash( \"rlbry\" ), GetUnitY(target) )\r\n        call SaveReal( udg_hash, id, StringHash( \"rlbr\" ), damage )\r\n        call SaveReal( udg_hash, id, StringHash( \"rlbrht\" ), halftime )\r\n        call SaveReal( udg_hash, id, StringHash( \"rlbrh\" ), flyHeight)\r\n\r\n\t    set projectile = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local unit caster\r\n\t    local unit target\r\n\t    local integer lvl\r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = udg_Target\r\n\t        set lvl = udg_Level\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = randomtarget( caster, 900, \"all\", RT_NOT_CASTER, 0, 0 )\r\n\t        set lvl = udg_Level\r\n\t        call textst( udg_string[0] + GetObjectName(ABILITY_ID), caster, 64, 90, 10, 1.5 )\r\n\t        if target == null then\r\n\t            set caster = null\r\n\t            return\r\n\t        endif\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set target = GetSpellTargetUnit()\r\n\t        set lvl = GetUnitAbilityLevel(GetSpellAbilityUnit(), GetSpellAbilityId())\r\n\t    endif\r\n\t    \r\n\t    if target == null or RectContainsUnit(udg_Boss_Rect, target) == false then\r\n\t    \tcall LaunchShortCooldown(caster, GetSpellAbilityId(), lvl)\r\n\t        set caster = null\r\n\t        set target = null\r\n\t        return\r\n\t    endif\r\n\t    \r\n\t    call Cast(caster, target, lvl)\r\n\t    \r\n\t    set caster = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t\tset Trigger = CreateNativeEvent( EVENT_PLAYER_UNIT_SPELL_EFFECT, function action, function condition )\r\n\tendfunction\r\n\t\r\nendscope",
  "Events": [],
