  "Id": 50333196,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope MonkQ initializer init\r\n\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A0U3'\r\n\t\tprivate constant integer EFFECT = 'A0UA'\r\n\t\tprivate constant integer BUFF = 'B01N'\r\n\t\t\r\n\t\tprivate constant integer DURATION = 10\r\n\t\t\r\n\t\tprivate constant integer BONUS_DAMAGE_INITIAL = 70\r\n\t\tprivate constant integer BONUS_DAMAGE_PER_LEVEL = 10\r\n\t\tprivate constant integer BONUS_DAMAGE_DEGRADATION = 10\r\n\t\t\r\n\t\tprivate constant integer HASH_KEY = StringHash(\"monk_q_target\")\r\n\tendglobals\r\n\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId( ) == ABILITY_ID\r\n\tendfunction\r\n\t\r\n\tprivate function Cast takes unit caster, unit target, integer level, real duration returns nothing\r\n\t\tlocal integer id = GetHandleId(target)\r\n\t\tlocal integer damageBoost = BONUS_DAMAGE_INITIAL + BONUS_DAMAGE_PER_LEVEL * level\r\n\t\t\r\n\t\tcall bufallst( caster,  target, EFFECT, 0, 0, 0, 0, BUFF, \"monk_q\", duration )\r\n\t\tcall DestroyEffect( AddSpecialEffectTarget( \"Abilities\\\\Spells\\\\Other\\\\StrongDrink\\\\BrewmasterMissile.mdl\", target, \"origin\" ) )\r\n\t\t\r\n\t\tcall SaveInteger(udg_hash, id, HASH_KEY, damageBoost)\r\n\t\tcall SaveUnitHandle(udg_hash, id, HASH_KEY, caster)\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer id \r\n\t    local unit caster\r\n\t    local unit target\r\n\t    local integer lvl\r\n\t    local real t\r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = udg_Target\r\n\t        set lvl = udg_Level\r\n\t        set t = udg_Time \r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set target = randomtarget( caster, 900, \"enemy\", 0, 0, 0 )\r\n\t        set lvl = udg_Level\r\n\t        call textst( udg_string[0] + GetObjectName(ABILITY_ID), caster, 64, 90, 10, 1.5 )\r\n\t        set t = DURATION\r\n\t        if target == null then\r\n\t            set caster = null\r\n\t            return\r\n\t        endif\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set target = GetSpellTargetUnit()\r\n\t        set lvl = GetUnitAbilityLevel(GetSpellAbilityUnit(), GetSpellAbilityId())\r\n\t        set t = DURATION\r\n\t    endif\r\n\t    set t = timebonus(caster, t)\r\n\t    \r\n\t    call Cast(caster, target, lvl, t)\r\n\t\r\n\t    set caster = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnDamageDeal_Condition takes nothing returns boolean\r\n\t\treturn GetUnitAbilityLevel(udg_DamageEventTarget, BUFF) > 0 and udg_IsDamageSpell == false and LoadUnitHandle(udg_hash, GetHandleId(udg_DamageEventTarget), HASH_KEY) == udg_DamageEventSource\r\n\tendfunction\r\n\t\r\n\tprivate function OnDamageDeal takes nothing returns nothing\r\n\t\tlocal unit caster = udg_DamageEventSource\r\n\t\tlocal unit target = udg_DamageEventTarget\r\n\t\tlocal integer id = GetHandleId(target)\r\n\t\tlocal integer damageBoost = LoadInteger(udg_hash, id, HASH_KEY )\r\n\t\t\r\n\t\tset udg_DamageEventAmount = udg_DamageEventAmount + damageBoost\r\n\t\r\n\t\tset damageBoost = damageBoost - BONUS_DAMAGE_DEGRADATION\r\n\t\tcall SaveInteger(udg_hash, id, HASH_KEY, damageBoost)\r\n\t\tif damageBoost <= 0 then\r\n\t\t\tcall UnitRemoveAbility(target, EFFECT)\r\n\t\t\tcall UnitRemoveAbility(target, BUFF)\r\n\t\tendif\r\n\t\t\r\n\t\tset caster = null\r\n\t\tset target = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_MonkQ = CreateTrigger(  )\r\n\t    call TriggerRegisterAnyUnitEventBJ( gg_trg_MonkQ, EVENT_PLAYER_UNIT_SPELL_EFFECT )\r\n\t    call TriggerAddCondition( gg_trg_MonkQ, Condition( function condition ) )\r\n\t    call TriggerAddAction( gg_trg_MonkQ, function action )\r\n\t    \r\n\t    call CreateEventTrigger( \"udg_DamageModifierEvent\", function OnDamageDeal, function OnDamageDeal_Condition )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}