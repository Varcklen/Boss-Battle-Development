  "RunOnMapInit": false,
  "Script": "scope MonkW initializer init\r\n\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A093'\r\n\t\t\r\n\t\tprivate constant integer DAMAGE_INITIAL = 60\r\n\t\tprivate constant integer DAMAGE_PER_LEVEL = 40\r\n\t\t\r\n\t\tprivate constant integer HEAL_INITIAL = 12\r\n\t\tprivate constant integer HEAL_PER_LEVEL = 8\r\n\t\t\r\n\t\tprivate constant real AREA = 300\r\n\t\tprivate constant integer JUMP_HEIGHT = 1200\r\n\t\tprivate constant integer JUMP_SPEED = 600\r\n\t\t\r\n\t\tprivate constant integer SPEED = 1000\r\n\t\tprivate constant real TICK = 0.02\r\n\t\tprivate constant real SPEED_TICK = SPEED * TICK\r\n\tendglobals\r\n\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID and combat( GetSpellAbilityUnit(), true, GetSpellAbilityId() )\r\n\tendfunction\r\n\r\n\tprivate function AoE takes unit caster, integer id, real x, real y returns nothing\r\n\t\tlocal real damage = LoadReal( udg_hash, id, StringHash( \"monk_w_damage\" ) )\r\n\t\tlocal real heal = LoadReal( udg_hash, id, StringHash( \"monk_w_heal\" ) )\r\n\t\tlocal real healsum = 0\r\n\t    local group g = CreateGroup()\r\n\t    local unit u\r\n\t\r\n\t\tcall GroupEnumUnitsInRange( g, x, y, AREA, null )\r\n\t    loop\r\n\t        set u = FirstOfGroup(g)\r\n\t        exitwhen u == null\r\n\t        if unitst( u, caster, \"enemy\" ) then\r\n\t            call UnitDamageTarget(caster, u, damage, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)\r\n\t            set healsum = healsum + heal\r\n\t        endif\r\n\t        call GroupRemoveUnit(g,u)\r\n\t    endloop\r\n\t\r\n\t    if healsum > 0 then\r\n\t    \tcall healst( caster, null, healsum )\r\n\t        call spectimeunit( caster, \"Abilities\\\\Spells\\\\Human\\\\Heal\\\\HealTarget.mdl\", \"origin\", 2 )\r\n\t    endif \r\n\t    \r\n\t    call DestroyGroup( g )\r\n\t    set caster = null\r\n\t    set u = null\r\n\tendfunction\r\n\t\r\n\tprivate function Land takes unit caster, integer id, real x, real y returns nothing\r\n\t\tlocal real baseHeight = LoadReal( udg_hash, id, StringHash( \"monk_w_height\" ) )\r\n\t\t//local real flyHeight = LoadReal( udg_hash, id, StringHash( \"monk_w_fly_height\" ) )\r\n\t\r\n\t\tcall SetUnitPathing( caster, true )\r\n        call SetUnitFlyHeight( caster, baseHeight, 0 )\r\n\t\tcall UnitRemoveAbility( caster, 'Amrf' )\r\n\t\tcall PauseUnit( caster, false)\r\n\r\n        if IsUnitAlive(caster) then\r\n            call AoE(caster, id, x, y)\r\n            call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\", x, y ) )\r\n        endif\t\r\n\tendfunction\r\n\t\r\n\tprivate function Motion takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit caster = LoadUnitHandle( udg_hash, id, StringHash( \"monk_w\" ) )\r\n\t    local integer counter = LoadInteger( udg_hash, id, StringHash( \"monk_w\" ) ) + 1\r\n\t    local real x = LoadReal( udg_hash, id, StringHash( \"monk_w_x\" ) )\r\n\t    local real y = LoadReal( udg_hash, id, StringHash( \"monk_w_y\" ) )\r\n\t    local real angle = LoadReal( udg_hash, id, StringHash( \"monk_w_angle\" ) )\r\n\t    local location currentLoc = GetUnitLoc(caster)\r\n\t    local location newLoc\r\n\t    local integer tickMax = LoadInteger( udg_hash, id, StringHash( \"monk_w_ticks\" ) )\r\n\t    \r\n\t    /*local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"dogwtrg\" ) )\r\n\t    \r\n\t    local real x = GetUnitX( target )\r\n\t    local real y = GetUnitY( target )\r\n\t    local real angle = Atan2( y - GetUnitY( caster ), x - GetUnitX( caster ) )\r\n\t    local real NewX = GetUnitX( caster ) + 30 * Cos( angle )\r\n\t    local real NewY = GetUnitY( caster ) + 30 * Sin( angle )\r\n\t    local group g = CreateGroup()\r\n\t    local unit u\r\n\t\tlocal integer id1\r\n\t\tlocal real dmg = LoadReal( udg_hash, id, StringHash( \"dogw\" ))\r\n\t\tlocal real dmgac = LoadReal( udg_hash, id, StringHash( \"dogwac\" ))\r\n\t    local real h = LoadReal( udg_hash, id, StringHash( \"dogwh\" ) )\r\n\t    local real flyHeight = LoadReal ( udg_hash, id, StringHash( \"dogwf\" ) )*/\r\n\r\n\t    if counter == tickMax / 2 then\r\n\t        call SetUnitFlyHeight( caster, -JUMP_SPEED, JUMP_HEIGHT )\r\n\t    endif\r\n\t    \r\n\t    if counter >= tickMax or IsUnitDead(caster) then\r\n\t    \tcall Land(caster, id, x, y)\r\n\t        call FlushChildHashtable( udg_hash, id ) \r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else \r\n\t        call SaveInteger( udg_hash, id, StringHash( \"monk_w\" ), counter )\r\n\t        set newLoc = PolarProjectionBJ( currentLoc, SPEED_TICK, angle )\r\n\t        call SetUnitPositionLoc( caster, newLoc )\r\n\t    endif\r\n\t   \r\n\t   \tcall RemoveLocation(currentLoc)\r\n\t\tcall RemoveLocation(newLoc)\r\n\t\tset currentLoc = null\r\n\t\tset newLoc = null\r\n\t    set caster = null\r\n\tendfunction\r\n\r\n\t\r\n\tprivate function Cast takes unit caster, integer level, real x, real y returns nothing\r\n\t\tlocal integer id \r\n\t\tlocal real baseHeight\r\n\t\t//local real flyHeight\r\n\t\tlocal real damage\r\n\t\tlocal real heal\r\n\t\tlocal real angle\r\n\t\tlocal location unitLoc = GetUnitLoc( caster )\r\n\t\tlocal location targetLoc = Location( x, y )\r\n\t\tlocal real range = DistanceBetweenPoints(unitLoc, targetLoc)\r\n\t\tlocal integer ticks = R2I( range / SPEED_TICK )\r\n\r\n\t    set damage = DAMAGE_INITIAL + DAMAGE_PER_LEVEL * level\r\n\t    set heal = HEAL_INITIAL + HEAL_PER_LEVEL * level\r\n\t    set baseHeight = GetUnitDefaultFlyHeight(caster)\r\n\t    //set flyHeight = GetUnitFlyHeight(caster)\r\n\t    set id = GetHandleId( caster )\r\n\t    set angle = AngleBetweenPoints( unitLoc, targetLoc )\r\n\t    \r\n\t    /*call BJDebugMsg(\"x: \" + R2S(x))\r\n\t    call BJDebugMsg(\"y: \" + R2S(y))\r\n\t    call BJDebugMsg(\"angle: \" + R2S(angle))\r\n\t    call BJDebugMsg(\"range: \" + R2S(range))*/\r\n\t    \r\n\t\tcall PauseUnit( caster, true )\r\n\t\tcall UnitAddAbility( caster, 'Amrf' )\r\n\t\tcall SetUnitFlyHeight( caster, JUMP_SPEED, JUMP_HEIGHT )\r\n\t\tcall SetUnitPathing( caster, false )\r\n\t\t\r\n\t\tset id = InvokeTimerWithUnit( caster, \"monk_w\", TICK, true, function Motion )\r\n\t\tcall SaveReal( udg_hash, id, StringHash( \"monk_w_x\" ), x)\r\n\t\tcall SaveReal( udg_hash, id, StringHash( \"monk_w_y\" ), y)\r\n\t\tcall SaveReal( udg_hash, id, StringHash( \"monk_w_damage\" ), damage)\r\n\t\tcall SaveReal( udg_hash, id, StringHash( \"monk_w_heal\" ), heal)\r\n\t\tcall SaveReal( udg_hash, id, StringHash( \"monk_w_height\" ), baseHeight)\r\n\t\t//call SaveReal( udg_hash, id, StringHash( \"monk_w_fly_height\" ), flyHeight)\r\n\t\tcall SaveReal( udg_hash, id, StringHash( \"monk_w_angle\" ), angle)\r\n\t\tcall SaveInteger( udg_hash, id, StringHash( \"monk_w_ticks\" ), ticks)\r\n\t\t\r\n\t\tcall RemoveLocation(unitLoc)\r\n\t\tcall RemoveLocation(targetLoc)\r\n\t\tset unitLoc = null\r\n\t\tset targetLoc = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer lvl\r\n\t    local unit caster\r\n\t    local real x\r\n\t    local real y\r\n\t    local real dist\r\n\t    local real angle\r\n\t    \r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set lvl = udg_Level\r\n\t        set x = GetSpellTargetX()\r\n\t        set y = GetSpellTargetY()\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set lvl = udg_Level\r\n\t        call textst( udg_string[0] + GetObjectName('A0Q0'), caster, 64, 90, 10, 1.5 )\r\n\t        set dist = GetRandomReal( 0, 600 )\r\n\t        set angle = GetRandomReal( 0, 360 ) * bj_DEGTORAD\r\n\t        set x = GetUnitX( caster ) + dist * Cos( angle )\r\n\t        set y = GetUnitY( caster ) + dist * Sin( angle )\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set lvl = GetUnitAbilityLevel(caster, GetSpellAbilityId())\r\n\t        set x = GetSpellTargetX()\r\n\t        set y = GetSpellTargetY()\r\n\t    endif\r\n\r\n\t    if RectContainsCoords(udg_Boss_Rect, x, y) == false then\r\n\t        set caster = null\r\n\t        return\r\n\t    endif\r\n\t    \r\n\t    call Cast(caster, lvl, x, y)\r\n\r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_MonkW = CreateTrigger(  )\r\n\t    call TriggerRegisterAnyUnitEventBJ( gg_trg_MonkW, EVENT_PLAYER_UNIT_SPELL_EFFECT )\r\n\t    call TriggerAddCondition( gg_trg_MonkW, Condition( function condition ) )\r\n\t    call TriggerAddAction( gg_trg_MonkW, function action )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
