  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope DryadQ initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ABILITY_ID = 'A0HW'\r\n\t\tprivate constant string ANIMATION = \"Abilities\\\\Spells\\\\Orc\\\\FeralSpirit\\\\feralspirittarget.mdl\"\r\n\t\t\r\n\t\tprivate constant integer SUMMON_RANGE = 150\r\n\t\tprivate constant integer UNIT_TYPES = 4\r\n\t\tprivate constant real SIZE_INCREASE = 0.07\r\n\t\t\r\n\t\tprivate integer array MinionTypes[UNIT_TYPES]\r\n\t\tprivate integer array MinionHP[UNIT_TYPES]\r\n\t\tprivate integer array MinionAT[UNIT_TYPES]\r\n\tendglobals\r\n\t\r\n\tprivate function SetData takes nothing returns nothing\r\n\t    set MinionTypes[0] = 'n02Z'\r\n\t    set MinionTypes[1] = 'n037'\r\n\t    set MinionTypes[2] = 'n03H'\r\n\t    set MinionTypes[3] = 'n03W'\r\n\t    \r\n\t    set MinionHP[0] = 50\r\n\t    set MinionHP[1] = 75\r\n\t    set MinionHP[2] = 75\r\n\t    set MinionHP[3] = 125\r\n\t    \r\n\t    set MinionAT[0] = 6\r\n\t    set MinionAT[1] = 7\r\n\t    set MinionAT[2] = 5\r\n\t    set MinionAT[3] = 6\r\n\tendfunction\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetSpellAbilityId() == ABILITY_ID\r\n\tendfunction\r\n\t\r\n\tprivate function GetMinionIndex takes unit caster returns integer\r\n\t\tlocal integer minionIndex = -1\r\n\t\tlocal ListInt units = ListInt.create()\r\n\t\tlocal integer i\r\n\t\tlocal player owner = GetOwningPlayer(caster)\r\n\t\r\n\t\tset i = 0\r\n\t    loop\r\n\t        exitwhen i >= UNIT_TYPES\r\n\t        if CountLivingPlayerUnitsOfTypeId(MinionTypes[i], owner ) == 0 then\r\n\t            call units.Add(i)\r\n\t        endif\r\n\t        set i = i + 1\r\n\t    endloop\r\n\t    \r\n\t    if units.Size > 0 then\r\n\t    \tset minionIndex = units.GetRandomCell()\r\n\t    endif\r\n\t    \r\n\t    set owner = null\r\n\t    return minionIndex\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnUnit takes unit caster, integer minionType, integer index, integer level returns nothing\r\n\t\tlocal real casterFacing\r\n\t\tlocal location petSpawn\r\n\t\tlocal unit summon\r\n\t\tlocal real size\r\n\t\tlocal integer newValue\r\n\t\r\n\t\tset casterFacing = GetUnitFacing(caster)\r\n\t\tset petSpawn = PolarProjectionBJ( GetUnitLoc(caster), SUMMON_RANGE, casterFacing)\r\n        \r\n        set summon = CreateUnitAtLoc( GetOwningPlayer(caster), minionType, petSpawn, casterFacing)\r\n        call DestroyEffect( AddSpecialEffectTarget( ANIMATION, summon, \"origin\" ) )\r\n        call SaveUnitHandle(udg_hash, GetHandleId(summon), StringHash(\"dryad_q_hero\"), caster )\r\n\r\n        set newValue = R2I( BlzGetUnitMaxHP(summon) + ( ( level - 1 ) * MinionHP[index] ) )\r\n        call BlzSetUnitMaxHP( summon, newValue )\r\n        call SetUnitState( summon, UNIT_STATE_LIFE, GetUnitState( summon, UNIT_STATE_MAX_LIFE) )\r\n        \r\n        set newValue = R2I( BlzGetUnitBaseDamage(summon, 0) + ( ( level - 1 ) * MinionAT[index] ) )\r\n        call BlzSetUnitBaseDamage( summon, newValue, 0 )\r\n        \r\n        call BlzSetUnitArmor( summon, level )\r\n        \r\n        set size = BlzGetUnitRealField(summon, UNIT_RF_SCALING_VALUE) + ( SIZE_INCREASE * level )\r\n        call SetUnitScale( summon, size, size, size )\r\n        \r\n        call RemoveLocation(petSpawn)\r\n\t\tset petSpawn = null\r\n\t\tset summon = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer lvl\r\n\t    local unit caster\r\n\t    local integer minionIndex\r\n\r\n\t    if CastLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set lvl = udg_Level\r\n\t    elseif RandomLogic() then\r\n\t        set caster = udg_Caster\r\n\t        set lvl = udg_Level\r\n\t        call textst( udg_string[0] + GetObjectName(ABILITY_ID), caster, 64, 90, 10, 1.5 )\r\n\t    else\r\n\t        set caster = GetSpellAbilityUnit()\r\n\t        set lvl = GetUnitAbilityLevel(GetSpellAbilityUnit(), GetSpellAbilityId())\r\n\t    endif\r\n\r\n\t\tset minionIndex = GetMinionIndex(caster)\r\n\t\t//call BJDebugMsg(\"minionIndex: \" + I2S(minionIndex))\r\n\t\t//call BJDebugMsg(\"udg_DryadMinion[minionIndex]: \" + I2S(MinionTypes[minionIndex]))\r\n\t    if minionIndex == -1 then\r\n\t    \tcall DestroyEffect( AddSpecialEffectTarget( ANIMATION, caster, \"origin\" ) ) \r\n\t    \t\r\n\t    else\r\n\t        call SpawnUnit(caster, MinionTypes[minionIndex], minionIndex, lvl)\r\n\t        if GetSpellAbilityId() == ABILITY_ID then\r\n    \t\t\tcall LaunchShortCooldown(caster, GetSpellAbilityId(), lvl)\r\n\t\t\tendif\r\n\t    endif\r\n\t    \r\n\t    set caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    call CreateNativeEvent( EVENT_PLAYER_UNIT_SPELL_EFFECT, function action, function condition )\r\n\r\n\t    call SetData()\r\n\tendfunction\r\n\t\r\nendscope",
  "Events": [],
