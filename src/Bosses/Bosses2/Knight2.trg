  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Knight2 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer DASH_SPEED = 30\r\n\t\tprivate constant integer STOP_DISTANCE = 100 \r\n\t\tprivate constant integer STOP_ITERATION = 150\r\n\t\tprivate constant real STUN_DURATION = 0.75\r\n\t\tprivate constant real DAMAGE = 100\r\n\t\tprivate constant integer DASH_RANGE_CHECK = 700\r\n\t\tprivate constant integer EFFECT = 'A0RO'\r\n\t\tprivate constant integer BUFF ='B01G'\r\n\t\tprivate constant real COOLDOWN = 2\r\n\t\tprivate constant real TICK = 0.02\r\n\t\t\r\n\t\tprivate constant string DASH_ANIMATION = \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\"\r\n\t\tprivate constant real DASH_ANIMATION_SIZE = 0.25 \r\n\t\tprivate constant string BUFF_ANIMATION = \"Abilities\\\\Spells\\\\Human\\\\Avatar\\\\AvatarCaster.mdl\"\r\n\t\t\r\n\t\tprivate constant integer ARMOR_BONUS_LEVEL = 2\r\n\t\t\r\n\t\tprivate unit TempUnit = null\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'h000' and GetUnitLifePercent(udg_DamageEventTarget) <= 75\r\n\tendfunction\r\n\r\n\tprivate function Knight2End takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local integer counter = LoadInteger( udg_hash, id, StringHash( \"bskn1\" ) )\r\n\t    local real x = LoadReal( udg_hash, id, StringHash( \"bskn1x\" ) )\r\n\t    local real y = LoadReal( udg_hash, id, StringHash( \"bskn1y\" ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bskn1\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"bskn1t\" ) )\r\n\t    local real angle = Atan2( y - GetUnitY( boss ), x - GetUnitX( boss ) )\r\n\t    local real NewX = GetUnitX( boss ) + DASH_SPEED * Cos( angle )\r\n\t    local real NewY = GetUnitY( boss ) + DASH_SPEED * Sin( angle )\r\n\t    local real IfX = ( x - GetUnitX( boss ) ) * ( x - GetUnitX( boss ) )\r\n\t    local real IfY = ( y - GetUnitY( boss ) ) * ( y - GetUnitY( boss ) )\r\n\t    local effect dashAnimation\r\n\t    \r\n\t    if IsUnitDead(boss) or not( udg_fightmod[0] ) then\r\n\t    \tcall FlushChildHashtable( udg_hash, id )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    elseif SquareRoot( IfX + IfY ) > STOP_DISTANCE and counter < STOP_ITERATION then\r\n\t        call SetUnitPosition( boss, NewX, NewY )\r\n\t        call SaveInteger( udg_hash, id, StringHash( \"bskn1\" ), counter + 1 )\r\n\t    else\r\n\t        call SetUnitPathing( boss, true )\r\n\t        call pausest( boss, -1 )\r\n\t        call UnitRemoveAbility( boss, EFFECT )\r\n\t        call UnitRemoveAbility( boss, BUFF )\r\n\t        \r\n\t        if counter < STOP_ITERATION then\r\n\t        \tcall UnitStun(boss, target, STUN_DURATION )\r\n\t        \tcall UnitDamageTarget( boss, target, DAMAGE, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS )\r\n\t        \tset dashAnimation = AddSpecialEffect( DASH_ANIMATION, GetUnitX(target), GetUnitY(target) )\r\n\t        \tcall BlzSetSpecialEffectScale(dashAnimation, DASH_ANIMATION_SIZE )\r\n\t        \tcall DestroyEffect( dashAnimation )\r\n        \tendif\r\n        \tcall FlushChildHashtable( udg_hash, id )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    endif\r\n\t    \r\n\t    set dashAnimation = null\r\n\t    set target = null\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function FindTarget takes unit boss returns unit\r\n\t\tlocal group heroes = DeathSystem_GetAliveHeroGroupCopy()\r\n\t\tlocal group validTargets = CreateGroup()\r\n\t\tlocal location bossLoc = GetUnitLoc(boss)\r\n\t\tlocal unit u\r\n\r\n        loop\r\n            set u = FirstOfGroup(heroes)\r\n            exitwhen u == null\r\n            if DistanceBetweenPoints( bossLoc, GetUnitLoc(u) ) > DASH_RANGE_CHECK and InvisibilitySystem_IsActive(u) == false then\r\n                call GroupAddUnit(validTargets, u)\r\n            endif\r\n            call GroupRemoveUnit(heroes,u)\r\n        endloop\r\n\t\tset TempUnit = GroupPickRandomUnit( validTargets )\r\n\t\tcall DestroyGroup(heroes)\r\n\t\tcall DestroyGroup(validTargets)\r\n\t\tcall RemoveLocation(bossLoc)\r\n\t\tset u = null\r\n\t\treturn TempUnit\r\n\tendfunction\r\n\t\r\n\tprivate function Knight2Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bskn\" ) )\r\n\t    local unit target\r\n\t\r\n\t    if IsUnitDead( boss ) or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        set target = FindTarget( boss )\r\n\t        if target != null then\r\n\t            call UnitAddAbility( boss, EFFECT )\r\n\t    \t\tcall pausest( boss, 1 )\r\n\t            call SetUnitPathing( boss, false )\r\n\t            call SetUnitFacing( boss, bj_RADTODEG * Atan2(GetUnitY(target) - GetUnitY(boss), GetUnitX(target) - GetUnitX(boss) ) )\r\n\t            call SetUnitAnimationWithRarity( boss, \"walk\", RARITY_FREQUENT )\r\n\t            \r\n\t            set id = InvokeTimerWithUnit( boss, \"bskn1\", TICK, true, function Knight2End )\r\n\t            call SaveUnitHandle( udg_hash, id, StringHash( \"bskn1t\" ), target )\r\n\t            call SaveReal( udg_hash, id, StringHash( \"bskn1x\" ), GetUnitX( target ) )\r\n\t            call SaveReal( udg_hash, id, StringHash( \"bskn1y\" ), GetUnitY( target ) )\r\n\t        endif\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal unit boss = udg_DamageEventTarget\r\n\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call SetUnitAbilityLevel( boss, 'A03D', ARMOR_BONUS_LEVEL)\r\n\t    call SetUnitAbilityLevel( boss, 'A01E', ARMOR_BONUS_LEVEL)\r\n\t    call SetUnitAnimation( boss, \"stand victory\" )\r\n\t    call DestroyEffect(AddSpecialEffectTarget( BUFF_ANIMATION, boss, \"origin\") )\r\n\t    \r\n\t    if GetOwningPlayer(boss) == Player(10) then\r\n\t    \tcall InvokeTimerWithUnit( boss, \"bskn\", COOLDOWN, true, function Knight2Cast )\r\n    \tendif\r\n\t\t\r\n\t\tset boss = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Knight2 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Knight2 )\r\n\tendfunction\r\n\r\nendscope",
