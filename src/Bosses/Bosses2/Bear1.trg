  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Bear1 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer COOLDOWN = 15\r\n\t\tprivate constant integer TARGET_SEARCH_RANGE = 900\r\n\t\tprivate constant integer LAND_POINT_DEVIATION = 150\r\n\t\tprivate constant integer Z_MOVEMENT_SPEED = 600\r\n\t\tprivate constant integer FLY_HEIGHT = 1500\r\n\t\tprivate constant real JUMP_TICK = 0.02\r\n\t\tprivate constant integer JUMP_SPEED = 30\r\n\t\tprivate constant real STUN_DURATION = 0.6\r\n\t\tprivate constant string LAND_ANIMATION = \"Abilities\\\\Spells\\\\Human\\\\ThunderClap\\\\ThunderClapCaster.mdl\" \r\n\t\t\r\n\t\tprivate constant string HUG_ANIMATION = \"Abilities\\\\Spells\\\\Other\\\\Stampede\\\\StampedeMissileDeath.mdl\" \r\n\t\tprivate constant real HUG_ANIMATION_SPEED = 160\r\n\t\tprivate constant real HUG_TICK = 0.5\r\n\t\tprivate constant real HUG_DURATION = 4\r\n\t\tprivate constant real HUG_TICKS = HUG_DURATION / HUG_TICK\r\n\t\tprivate constant integer DAMAGE = 40\r\n\t\tprivate constant integer HUG_RANGE_REQUIRED = 225\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n010' and GetUnitLifePercent(udg_DamageEventTarget) <= 95\r\n\tendfunction\r\n\t\r\n\tprivate function IsUnderControl takes unit boss returns boolean\r\n\t\tif GetUnitAbilityLevel( boss, 'BPSE' ) > 0 then//Stun\r\n\t\t\treturn true\r\n\t\telseif GetUnitAbilityLevel( boss, 'B043' ) > 0 then//Polymorph\r\n\t\t\treturn true\r\n\t\telseif GetUnitAbilityLevel( boss, 'BEer' ) > 0 then//Entagled Roots\r\n\t\t\treturn true\r\n\t\telseif GetUnitAbilityLevel( boss, 'B059' ) > 0 then//Taunt\r\n\t\t\treturn true\r\n\t\tendif\r\n\t\treturn false\r\n\tendfunction\r\n\t\r\n\tprivate function IsInvalid takes unit boss, unit target returns boolean\r\n\t\tif IsUnitDead(target) then\r\n\t\t\treturn true\r\n\t\telseif IsUnitDead(boss) then\r\n\t\t\treturn true\r\n\t\telseif udg_fightmod[0] == false then\r\n\t\t\treturn true\r\n\t\telseif InvisibilitySystem_IsActive(target) then\r\n\t\t\treturn true\r\n\t\telseif BlzIsUnitInvulnerable(target) then\r\n\t\t\treturn true\r\n\t\telseif IsUnderControl(boss) then\r\n\t\t\treturn true\r\n\t\telseif DistanceBetweenPoints( GetUnitLoc(boss), GetUnitLoc(target) ) > HUG_RANGE_REQUIRED then\r\n\t\t\treturn true\r\n\t\tendif\r\n\t\treturn false\r\n\tendfunction\r\n\t\r\n\tprivate function Hug takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"boss_bear_hug\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"boss_bear_hug_target\" ) )\r\n\t    local integer counter = LoadInteger( udg_hash, id, StringHash( \"boss_bear_hug_counter\" ) ) + 1\r\n\t    \r\n\t    if counter > HUG_TICKS or IsInvalid(boss, target) then\r\n\t    \tcall SetUnitTimeScalePercent( boss, 100 )\r\n\t    \tcall pausest( boss, -1 )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n        \tcall SetUnitAnimation( boss, \"attack\" )\r\n        \tcall DestroyEffect( AddSpecialEffectTarget( HUG_ANIMATION, target, \"origin\" ) )\r\n        \tcall UnitStun(boss, target, STUN_DURATION )\r\n        \tcall UnitDamageTarget( boss, target, DAMAGE, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS )\r\n        \tcall SaveInteger( udg_hash, id, StringHash( \"boss_bear_hug_counter\" ), counter )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\t    set target = null\r\n    endfunction\r\n\r\n\t//===========================================================================\r\n\tprivate function JumpEnd takes unit boss, unit target, real x, real y returns nothing\r\n\t\tlocal integer id\r\n\t\tlocal real angle = AngleBetweenPoints( GetUnitLoc(boss), GetUnitLoc(target) )\r\n\t\r\n\t\tcall SetUnitPathing( boss, true )\r\n        call UnitRemoveAbility( boss, 'Amrf' )\r\n\t\tcall SetUnitTimeScalePercent( boss, HUG_ANIMATION_SPEED )\r\n\t\tcall SetUnitFacing( boss, angle )\r\n        call DestroyEffect( AddSpecialEffect( LAND_ANIMATION, x, y ) )\r\n        call UnitStun(boss, target, STUN_DURATION )\r\n        \r\n        set id = InvokeTimerWithUnit( boss, \"boss_bear_hug\", HUG_TICK, true, function Hug )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"boss_bear_hug_target\" ), target )\r\n    endfunction\r\n\t\r\n\tprivate function BearRun takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsbr1\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"bsbr1trg\" ) )\r\n\t    local integer counter = LoadInteger( udg_hash, id, StringHash( \"bsbr1\" ) ) + 1\r\n\t    local real x = GetUnitX( target )\r\n\t    local real y = GetUnitY( target )\r\n\t    local real angle = Atan2( y - GetUnitY( boss ), x - GetUnitX( boss ) )\r\n\t    local real NewX = GetUnitX( boss ) + JUMP_SPEED * Cos( angle )\r\n\t    local real NewY = GetUnitY( boss ) + JUMP_SPEED * Sin( angle )\r\n\t    \r\n\t    if counter == 10 then\r\n\t        call SetUnitFlyHeight( boss, -Z_MOVEMENT_SPEED, FLY_HEIGHT )\r\n\t    endif\r\n\t\r\n\t    if counter == 20 or IsUnitDead(boss) or not( udg_fightmod[0] ) then\r\n\t        if IsUnitAlive(boss) then\r\n\t            call JumpEnd(boss, target, NewX, NewY)\r\n\t        endif\r\n\t        call DestroyTimer( GetExpiredTimer() ) \r\n\t    else \r\n\t        call SaveInteger( udg_hash, id, StringHash( \"bsbr1\" ), counter )\r\n\t        call SetUnitPosition( boss, NewX, NewY )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function Jump takes unit boss returns nothing\r\n\t\tlocal integer id\r\n\t    local unit target\r\n\t\tlocal real x\r\n\t    local real y\r\n\t    \r\n\t    set target = randomtarget( boss, TARGET_SEARCH_RANGE, \"enemy\", RT_VULNERABLE, 0, 0 )\r\n        if target == null then\r\n            return\r\n        endif\r\n        \r\n        set x = GetUnitX( target ) + GetRandomReal(-LAND_POINT_DEVIATION, LAND_POINT_DEVIATION)\r\n        set y = GetUnitY( target ) + GetRandomReal(-LAND_POINT_DEVIATION, LAND_POINT_DEVIATION)\r\n        call SetUnitFacing( boss, Atan2( y - GetUnitY( target ), x - GetUnitX( target ) ) )\r\n\t\tcall pausest( boss, 1 )\r\n        call UnitAddAbility( boss, 'Amrf' )\r\n        call SetUnitFlyHeight( boss, Z_MOVEMENT_SPEED, FLY_HEIGHT )\r\n        call SetUnitPathing( boss, true )\r\n        \r\n        set id = InvokeTimerWithUnit( boss, \"bsbr1\", JUMP_TICK, true, function BearRun )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bsbr1trg\" ), target ) \r\n        \r\n        set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function BearCast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsbr\" ))\r\n\t    \r\n\t    if IsUnitDead(boss) or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else\r\n        \tcall Jump(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer id = GetHandleId( udg_DamageEventTarget )\r\n\t\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call Jump(udg_DamageEventTarget)\r\n\t    call InvokeTimerWithUnit( udg_DamageEventTarget, \"bsbr\", bosscast(COOLDOWN), true, function BearCast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Bear1 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Bear1 )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
