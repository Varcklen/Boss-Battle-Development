{
  "Id": 50333552,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Paladin02 initializer init\r\n\r\n    globals\r\n        private constant integer PALADIN_HEALTH_CHECK = 70\r\n    \r\n    \tprivate constant integer COOLDOWN = 12\r\n        private constant integer DAMAGE = 400\r\n        private constant integer AREA = 700\r\n        private constant real BIG_ANIMATION_SCALE = 10\r\n        \r\n        private constant integer DELAY = 3\r\n        \r\n        private constant string ANIMATION_PREPARATION = \"Abilities\\\\Spells\\\\Items\\\\VampiricPotion\\\\VampPotionCaster.mdl\"\r\n        private constant string ANIMATION_EXPLOSION = \"Abilities\\\\Spells\\\\Orc\\\\WarStomp\\\\WarStompCaster.mdl\"\r\n    endglobals\r\n\r\n    private function condition takes nothing returns boolean\r\n        return GetUnitTypeId( udg_DamageEventTarget ) == 'h00M' and GetUnitLifePercent(udg_DamageEventTarget) <= PALADIN_HEALTH_CHECK\r\n    endfunction\r\n    \r\n    private function UnitsCheck takes unit boss, location areaSpawn returns nothing\r\n\t\tlocal location unitLoc\r\n\t\tlocal real range\r\n\t\tlocal group g = CreateGroup()\r\n\t    local unit u\r\n\r\n\t    call GroupEnumUnitsInRect(g, udg_Boss_Rect, null )\r\n        loop\r\n            set u = FirstOfGroup(g)\r\n            exitwhen u == null\r\n            if unitst( u, boss, \"enemy\" ) then\r\n            \tset unitLoc = GetUnitLoc(u)\r\n            \tset range = DistanceBetweenPoints(unitLoc, areaSpawn)\r\n            \tif range > AREA then\r\n            \t\tcall UnitDamageTarget( boss, u, DAMAGE, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS )\r\n                endif\r\n            endif\r\n            call GroupRemoveUnit(g,u)\r\n        endloop\r\n\r\n\t\tcall RemoveLocation(unitLoc)\r\n\t    call DestroyGroup( g )\r\n\t    set unitLoc = null\r\n\t    set g = null\r\n\t    set u = null\r\n\tendfunction\r\n\r\n    private function Paladin2AoE takes nothing returns nothing\r\n    \tlocal integer id = GetHandleId( GetExpiredTimer( ) )\r\n        local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"boss_paladin_1_delay\" ) )\r\n        local real x = LoadReal(udg_hash, id, StringHash(\"boss_paladin_1_delay_x\") )\r\n    \tlocal real y = LoadReal(udg_hash, id, StringHash(\"boss_paladin_1_delay_y\") )\r\n    \tlocal effect bigEffect = LoadEffectHandle(udg_hash, id, StringHash(\"boss_paladin_1_delay_effect\") )\r\n    \tlocal effect explosion\r\n    \t\r\n    \tset explosion = AddSpecialEffect(ANIMATION_EXPLOSION, x, y )\r\n    \tcall BlzSetSpecialEffectScale(explosion, BIG_ANIMATION_SCALE )\r\n    \tcall DestroyEffect(explosion)\r\n\r\n        call UnitsCheck(boss, Location(x,y) )\r\n        \r\n        call DestroyEffect(bigEffect)\r\n        call FlushChildHashtable( udg_hash, id )\r\n    \r\n    \tset explosion  =null\r\n        set boss = null\r\n    endfunction\r\n    \r\n    private function SpawnArea takes unit boss returns nothing\r\n    \tlocal real x = GetUnitX(boss)\r\n    \tlocal real y = GetUnitY(boss)\r\n    \tlocal integer id\r\n    \tlocal effect bigEffect\r\n    \t\r\n    \tset bigEffect = AddSpecialEffect(ANIMATION_PREPARATION, x, y )\r\n    \tcall BlzSetSpecialEffectScale(bigEffect, BIG_ANIMATION_SCALE )\r\n    \t\r\n    \tcall DangerArea_CreateReverse( x, y, AREA, DELAY )\r\n    \t\r\n    \tcall IndicatorSystem_Create( INDICATOR_SAFE, x, y, AREA, DELAY, boss )\r\n    \tset id = InvokeTimerWithUnit(boss, \"boss_paladin_1_delay\", DELAY, false, function Paladin2AoE)\r\n    \tcall SaveReal(udg_hash, id, StringHash(\"boss_paladin_1_delay_x\"), x )\r\n    \tcall SaveReal(udg_hash, id, StringHash(\"boss_paladin_1_delay_y\"), y )\r\n    \tcall SaveEffectHandle(udg_hash, id, StringHash(\"boss_paladin_1_delay_effect\"), bigEffect )\r\n    \t\r\n    \tset bigEffect = null\r\n    endfunction\r\n    \r\n    private function Paladin2Cast takes nothing returns nothing\r\n        local integer id = GetHandleId( GetExpiredTimer( ) )\r\n        local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bspl1\" ) )\r\n        \r\n        if IsUnitDead( boss) or udg_fightmod[0] == false then\r\n            call DestroyTimer( GetExpiredTimer() )\r\n        else\r\n            call SpawnArea(boss)\r\n        endif\r\n        \r\n        set boss = null\r\n    endfunction\r\n\r\n    private function action takes nothing returns nothing\r\n        call DisableTrigger( GetTriggeringTrigger() )\r\n        call SpawnArea(udg_DamageEventTarget)\r\n        call InvokeTimerWithUnit(udg_DamageEventTarget, \"bspl1\", bosscast(COOLDOWN), true, function Paladin2Cast)\r\n    endfunction\r\n\r\n    //===========================================================================\r\n    private function init takes nothing returns nothing\r\n        set gg_trg_Paladin2 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n        call DisableTrigger( gg_trg_Paladin2 )\r\n    endfunction\r\n\r\nendscope\r\n",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}