  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Crab1 initializer init\r\n\r\n\tglobals\r\n\t\tprivate constant integer COOLDOWN = 5\r\n\t\tprivate constant integer DELAY = 3\r\n\t\tprivate constant integer AREA_SIZE = 300\r\n\t\tprivate constant real AREA_SIZE_MULTIPLIER = AREA_SIZE / 100.\r\n\t\tprivate constant integer AREAS_IN_COLUMN = 7\r\n\t\tprivate constant integer RANGE_BETWEEN_AREAS = 500\r\n\t\tprivate constant integer STARTING_POINT_VALUE = 1860\r\n\t\t\r\n\t\tprivate constant integer DAMAGE = 500\r\n\t\tprivate constant real STUN_DURATION = 1\r\n\t\tprivate constant integer BUFF_ID = 'A0KJ'\r\n\t\tprivate constant integer BUFF_DURATION = 10\r\n\t\tprivate constant string EXPLODE_ANIMATION = \"Objects\\\\Spawnmodels\\\\Naga\\\\NagaDeath\\\\NagaDeath.mdl\"\r\n\t\t\r\n\t\tprivate integer WaveAmount = 0\r\n\tendglobals\r\n\t\r\n\tpublic function SetAmountOfWaves takes integer amount returns nothing\r\n\t\tset WaveAmount = amount\r\n\tendfunction\r\n\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId( udg_DamageEventTarget ) == 'n009'\r\n\tendfunction\r\n\t\r\n\tprivate function Crab1End takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bscr1u\" ) )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bscr1d\" ) )\r\n\t    local group g = CreateGroup()\r\n\t    local unit u\r\n\r\n\t    call DestroyEffect( AddSpecialEffect( EXPLODE_ANIMATION, GetUnitX( dummy ), GetUnitY( dummy ) + 100 ) )\r\n\t    call DestroyEffect( AddSpecialEffect( EXPLODE_ANIMATION, GetUnitX( dummy ) + 140, GetUnitY( dummy ) - 140 ) )\r\n\t    call DestroyEffect( AddSpecialEffect( EXPLODE_ANIMATION, GetUnitX( dummy ) - 140, GetUnitY( dummy ) - 140 ) )\r\n\t    \r\n\t    call GroupEnumUnitsInRange( g, GetUnitX( dummy ), GetUnitY( dummy ), AREA_SIZE, null )\r\n\t    loop\r\n\t        set u = FirstOfGroup(g)\r\n\t        exitwhen u == null\r\n\t        if unitst( u, boss, \"enemy\" ) then\r\n\t            call UnitStun(boss, u, STUN_DURATION )\r\n\t            call UnitDamageTarget( boss, u, DAMAGE, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)\r\n\t            call bufallst( boss, u, BUFF_ID, 0, 0, 0, 0, 0, \"bscr2\", BUFF_DURATION )\r\n\t        endif\r\n\t        call GroupRemoveUnit(g,u)\r\n\t    endloop\r\n\t    \r\n\t    call RemoveUnit( dummy )\r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t    \r\n\t    call DestroyGroup( g )\r\n\t    set u = null\r\n\t    set g = null\r\n\t    set boss = null\r\n\t    set dummy = null\r\n\tendfunction \r\n\t\r\n\tprivate function SpawnArea takes unit boss, integer column, integer row returns nothing\r\n\t\tlocal integer id\r\n\t\tlocal unit area \r\n\t\tlocal real x = GetRectCenterX(udg_Boss_Rect) - STARTING_POINT_VALUE + RANGE_BETWEEN_AREAS * row\r\n\t\tlocal real y = GetRectCenterY(udg_Boss_Rect) - STARTING_POINT_VALUE + RANGE_BETWEEN_AREAS * column\r\n\t\t\r\n\t\tset area = CreateUnit( GetOwningPlayer( boss ), 'u000', x, y, 270 )\r\n        call SetUnitScale(area, AREA_SIZE_MULTIPLIER, AREA_SIZE_MULTIPLIER, AREA_SIZE_MULTIPLIER )\r\n        call UnitAddAbility( area, 'A136')\r\n\r\n        set id = InvokeTimerWithUnit( area, \"bscr1d\", bosscast(DELAY), false, function Crab1End )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bscr1u\" ), boss )\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnAreas takes unit boss, integer id returns nothing\r\n\t\tlocal integer i\r\n\t    local integer k\r\n\t    local integer spawnDeviation\r\n\t\r\n\t\tset spawnDeviation = GetRandomInt( -1, 3 )\r\n        set k = 1\r\n        loop\r\n            exitwhen k > WaveAmount\r\n            set i = 0\r\n            loop\r\n                exitwhen i > AREAS_IN_COLUMN\r\n                call SpawnArea(boss, i, spawnDeviation + k )\r\n                set i = i + 1\r\n            endloop\r\n            set k = k + 1\r\n        endloop\r\n\tendfunction\r\n\t\r\n\tprivate function Crab1Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bscr1\" ) )\r\n\r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call SpawnAreas(boss, id)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call SetAmountOfWaves(1)\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bscr1\", bosscast(COOLDOWN), true, function Crab1Cast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Crab1 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Crab1 )\r\n\tendfunction\r\n\r\nendscope",
