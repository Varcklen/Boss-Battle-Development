{
  "Id": 50333557,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Turtle3 initializer init\r\n\t\r\n\tglobals\r\n\t    private constant real AOE_DAMAGE = 350\r\n\t    private constant real AOE_RANGE = 200\r\n\t    private constant real SPAWN_DEVIATION = 600\r\n\t    \r\n\t    private constant real COOLDOWN = 1.5\r\n\t    private constant real EXPLODE_DELAY = 3\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId( udg_DamageEventTarget ) == 'h01R' and GetUnitLifePercent(udg_DamageEventTarget) <= 70\r\n\tendfunction\r\n\r\n\tprivate function Turtle3End takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bstt3u\" ) )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bstt3d\" ) )\r\n\t    \r\n\t    call DestroyEffect( AddSpecialEffect( \"Objects\\\\Spawnmodels\\\\Naga\\\\NagaDeath\\\\NagaDeath.mdl\", GetUnitX( dummy ), GetUnitY( dummy ) ) )\r\n\t    \r\n\t    call GroupAoE(boss, GetUnitX( dummy ), GetUnitY( dummy ), AOE_DAMAGE, AOE_RANGE, TARGET_ENEMY, null, null)\r\n\t    \r\n\t    call RemoveUnit( dummy )\r\n\t    \r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t\r\n\t    set boss = null\r\n\t    set dummy = null\r\n\tendfunction \r\n\t\r\n\tprivate function Turtle3Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bstt3\" ) )\r\n\t\r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    elseif RectContainsUnit( udg_Boss_Rect, boss ) then\r\n\t        set bj_lastCreatedUnit = CreateUnit( GetOwningPlayer( boss ), 'u000', GetUnitX( boss ) + GetRandomReal(-SPAWN_DEVIATION, SPAWN_DEVIATION), GetUnitY( boss ) + GetRandomReal(-SPAWN_DEVIATION, SPAWN_DEVIATION), 270 )\r\n\t        \r\n\t        call IndicatorSystem_Create( INDICATOR_SKULL, GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), AOE_RANGE, bosscast(EXPLODE_DELAY), boss )\r\n\r\n\t        set id = InvokeTimerWithUnit( bj_lastCreatedUnit, \"bstt3d\", bosscast(EXPLODE_DELAY), false, function Turtle3End )\r\n\t        call SaveUnitHandle( udg_hash, id, StringHash( \"bstt3u\" ), boss )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bstt3\", bosscast(COOLDOWN), true, function Turtle3Cast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Turtle3 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Turtle3 )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}