  "Id": 50333539,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Mechanic1 initializer init\r\n\r\n\tglobals\r\n\t\tprivate constant integer UNIT_TYPE = 'n05H'\r\n\t\tprivate constant integer SPAWN_DEVIATION = 300\r\n\t\tprivate constant string SPAWN_ANIMATION = \"birth\"\r\n\t\t\r\n\t\tprivate constant integer ROBOT_TO_SUMMON = 4\r\n\t\tprivate constant integer ROBOT_SPAWN_DEVIATION = 500\r\n\t\tprivate constant integer ROBOT_TYPE = 'n012'\r\n\t\tprivate constant string ROBOT_SPAWN_ANIMATION = \"birth\"\r\n\t\t\r\n\t\tpublic trigger Trigger = null\r\n\t\tpublic trigger Trigger75 = null\r\n\t\tpublic trigger Trigger50 = null\r\n\t\tpublic trigger Trigger25 = null\r\n\tendglobals\r\n\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'h010'\r\n\tendfunction\r\n\t\r\n\tpublic function SummonRobots takes unit caster returns nothing\r\n\t\tlocal integer i\r\n\t\tlocal real angle\r\n\t\tlocal unit newUnit\r\n\t\tlocal location bossLoc\r\n\t\tlocal location newLoc\r\n\t\t\r\n\t\tset bossLoc = GetUnitLoc(caster)\r\n\t\tset i = 1\r\n\t\tloop\r\n\t        exitwhen i > ROBOT_TO_SUMMON\r\n\t        set angle = 45 + 90 * i\r\n\t        set newLoc = PolarProjectionBJ(bossLoc, ROBOT_SPAWN_DEVIATION, angle )\r\n\t\t\tset newUnit = CreateUnitAtLoc( GetOwningPlayer( caster ), ROBOT_TYPE, newLoc, -angle )\r\n\t\t\tcall SetUnitAnimation(newUnit, ROBOT_SPAWN_ANIMATION)\r\n\t\t\tcall RemoveLocation(newLoc)\r\n\t        set i = i + 1\r\n\t    endloop\r\n\t    \r\n\t    call RemoveLocation(bossLoc)\r\n\t\t\r\n\t\tset newUnit = null\r\n\t\tset bossLoc = null\r\n\t\tset newLoc = null\r\n\tendfunction\r\n\t\r\n\tpublic function SummonFactory takes unit boss returns nothing\r\n\t\tlocal integer amount = CountLivingPlayerUnitsOfTypeId( UNIT_TYPE, GetOwningPlayer(boss) )\r\n\t\tlocal unit newUnit\r\n\t\tlocal location bossLoc\r\n\t\tlocal location newLoc\r\n\t\t\r\n\t\tif amount > 0 then\r\n\t\t\treturn\r\n\t\tendif\r\n\t\t\r\n\t\tset bossLoc = GetUnitLoc(boss)\r\n\t\tset newLoc = PolarProjectionBJ(bossLoc, SPAWN_DEVIATION, GetRandomDirectionDeg() )\r\n\t\tset newUnit = CreateUnitAtLoc( GetOwningPlayer( boss ), UNIT_TYPE, newLoc, 270 )\r\n\t\tcall SetUnitAnimation(newUnit, SPAWN_ANIMATION)\r\n\t\t\r\n\t\tcall RemoveLocation(bossLoc)\r\n\t\tcall RemoveLocation(newLoc)\r\n\t\tset newUnit = null\r\n\t\tset bossLoc = null\r\n\t\tset newLoc = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call SummonFactory(udg_DamageEventTarget)\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function condition75 takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'h010' and GetUnitLifePercent(udg_DamageEventTarget) <= 75\r\n\tendfunction\r\n\r\n\tprivate function condition50 takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'h010' and GetUnitLifePercent(udg_DamageEventTarget) <= 50\r\n\tendfunction\r\n\r\n\tprivate function condition25 takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'h010' and GetUnitLifePercent(udg_DamageEventTarget) <= 25\r\n\tendfunction\r\n\t\r\n\tprivate function HPSpawn takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call SummonFactory(udg_DamageEventTarget)\r\n\t    call SummonRobots(udg_DamageEventTarget)\r\n\tendfunction\r\n\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t\tset Trigger = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t\tcall DisableTrigger(Trigger)\r\n\t\t\r\n\t\tset Trigger75 = CreateEventTrigger( \"udg_AfterDamageEvent\", function HPSpawn, function condition75 )\r\n\t\tcall DisableTrigger(Trigger75)\r\n\t\t\r\n\t\tset Trigger50 = CreateEventTrigger( \"udg_AfterDamageEvent\", function HPSpawn, function condition50 )\r\n\t\tcall DisableTrigger(Trigger50)\r\n\t\t\r\n\t\tset Trigger25 = CreateEventTrigger( \"udg_AfterDamageEvent\", function HPSpawn, function condition25 )\r\n\t\tcall DisableTrigger(Trigger25)\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
