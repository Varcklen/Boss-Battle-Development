  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Turtle4 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer UNIT_TYPE = 'h01S'\r\n\t\tprivate constant integer EGGS_TO_SPAWN = 4\r\n\t\tprivate constant integer SPAWN_DEVIATION = 600\r\n\t\tprivate constant real ANGLE_DEVIATION = 360. / EGGS_TO_SPAWN\r\n\t\tprivate constant real EXTRA_ANGLE = 45\r\n\t\tprivate constant integer HATCH_TIME = 10\r\n\t\t\r\n\t\tprivate constant integer BEHIND_MOVE_RANGE = 100\r\n\t\tprivate constant integer BOSS_APPEARERNCE_TIME = 8\r\n\t\tprivate constant string BOSS_ANIMATION = \"Objects\\\\Spawnmodels\\\\Naga\\\\NagaDeath\\\\NagaDeath.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId( udg_DamageEventTarget ) == 'h01R' and GetUnitLifePercent(udg_DamageEventTarget) <= 50\r\n\tendfunction\r\n\t\r\n\tprivate function EggHatch takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit egg = LoadUnitHandle( udg_hash, id, StringHash( \"bstt4\" ) )\r\n\t    \r\n\t    if IsUnitAlive( egg ) and udg_fightmod[0] then\r\n\t        set bj_lastCreatedUnit = CreateUnit( GetOwningPlayer( egg ), 'n03S', GetUnitX( egg ), GetUnitY( egg ), GetRandomReal( 0, 360 ) )\r\n\t        call DestroyEffect( AddSpecialEffectTarget( \"Abilities\\\\Spells\\\\Orc\\\\MirrorImage\\\\MirrorImageDeathCaster.mdl\", bj_lastCreatedUnit, \"origin\") )\r\n\t        call KillUnit( egg )\r\n\t    endif\r\n\t    \r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t\r\n\t    set egg = null\r\n\tendfunction\r\n\t\r\n\tprivate function GetLocationMove takes unit target returns location\r\n\t\tlocal real angle = GetUnitFacing(target)\r\n\t\tlocal location unitLoc = GetUnitLoc(target)\r\n\t\tlocal location moveLoc = PolarProjectionBJ(unitLoc, -BEHIND_MOVE_RANGE, angle )\r\n\t\t\r\n\t\tcall RemoveLocation(unitLoc)\r\n\t\tset unitLoc = null\r\n\t\treturn moveLoc\r\n\tendfunction\r\n\t\r\n\tprivate function BossAppear takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"boss_turtle_4_appear\" ) )\r\n\t    local unit target = DeathSystem_GetRandomAliveHero()\r\n\t\r\n\t    if IsUnitAlive( boss ) and udg_fightmod[0] then\r\n\t    \tif target != null then\r\n\t    \t\tcall SetUnitPositionLoc( boss, GetLocationMove(target) )\r\n\t    \telse\r\n\t    \t\tcall SetUnitPosition( boss, GetRectCenterX(udg_Boss_Rect), GetRectCenterY(udg_Boss_Rect) )\r\n\t    \tendif\r\n\t        call DestroyEffect( AddSpecialEffect( BOSS_ANIMATION, GetUnitX( boss ), GetUnitY( boss ) ) )\r\n\t        call ShowUnit( boss, true )\r\n\t        call PauseUnit( boss, false )\r\n\t        call BossCastLib_SetDisappear(boss, false)\r\n\t        call IssueImmediateOrder( boss, \"stop\" )\r\n\t    endif\r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t    \r\n\t    set boss = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tpublic function SpawnEggs takes unit boss returns nothing\r\n\t    local integer i \r\n\t    local real x\r\n\t    local real y\r\n\t    local real angle\r\n\t    local unit newUnit\r\n\t\r\n\t\tset i = 1\r\n\t\tloop\r\n\t        exitwhen i > EGGS_TO_SPAWN\r\n\t        set angle = EXTRA_ANGLE + ANGLE_DEVIATION * i\r\n            set x = GetUnitX( boss ) + SPAWN_DEVIATION * Cos( angle * bj_DEGTORAD )\r\n            set y = GetUnitY( boss ) + SPAWN_DEVIATION * Sin( angle * bj_DEGTORAD )\r\n            set newUnit = CreateUnit( GetOwningPlayer( boss ), UNIT_TYPE, x, y, -angle )\r\n\r\n            call InvokeTimerWithUnit( newUnit, \"bstt4\", HATCH_TIME, false, function EggHatch )\r\n\t        set i = i + 1\r\n\t    endloop\r\n\t    \r\n\t    call DestroyEffect( AddSpecialEffect( BOSS_ANIMATION, GetUnitX( boss ), GetUnitY( boss ) ) )\r\n\t    call SetUnitPosition( boss, GetRectCenterX( gg_rct_HeroesTp ), GetRectCenterY( gg_rct_HeroesTp ) )\r\n\t    call IssueImmediateOrder( boss, \"stop\" )\r\n\t    call ShowUnit( boss, false )\r\n\t    call PauseUnit( boss, true )\r\n\t    call BossCastLib_SetDisappear(boss, true)\r\n\t    call InvokeTimerWithUnit( boss, \"boss_turtle_4_appear\", BOSS_APPEARERNCE_TIME, false, function BossAppear )\r\n\t    \r\n\t    set newUnit = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call SpawnEggs(udg_DamageEventTarget)\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Turtle4 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Turtle4 )\r\n\tendfunction\r\n\r\nendscope",
