  "Script": "scope Berserk1 initializer init \r\n\r\n\tglobals\r\n\t\tprivate constant integer TOTEM_ID = 'o023'\r\n\t\t\r\n\t\tprivate constant integer SPAWN_DEVIATION = 250\r\n\t\tprivate constant integer COOLDOWN = 18\r\n\t\tprivate constant integer DELAY = 10\r\n\t\tprivate constant integer DURATION = 8\r\n\t\t\r\n\t\tprivate constant integer RAY_STARTING_POINT_Z = 150\r\n\t\tprivate constant string RAY_TYPE = \"DRAL\"\r\n\t\tprivate constant string BERSERK_CAST_ANIMATION = \"Abilities\\\\Spells\\\\NightElf\\\\BattleRoar\\\\RoarCaster.mdl\"\r\n\t\tprivate constant string BERSERK_END_ANIMATION = \"Abilities\\\\Spells\\\\Human\\\\DispelMagic\\\\DispelMagicTarget.mdl\"\r\n\t\t\r\n\t\tprivate unit TempUnit = null\r\n\tendglobals\r\n\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'e00F'\r\n\tendfunction\r\n\t\r\n\tprivate function BerserkEnd takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"boss_berserk_rage\" ) )\r\n\r\n\t    call berserk( target, -1 )\r\n\t    call DestroyEffect( AddSpecialEffect( BERSERK_END_ANIMATION, GetUnitX( target ), GetUnitY( target ) ) )\r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t    \r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function RageActivation takes nothing returns nothing\r\n\t\tlocal integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit totem = LoadUnitHandle( udg_hash, id, StringHash( \"boss_berserk_totem\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"boss_berserk_totem_target\" ) )\r\n\t    local lightning ray = LoadLightningHandle( udg_hash, GetHandleId( totem ), StringHash(\"boss_berserk_totem_ray\") )\r\n\t\r\n\t\tcall FlushChildHashtable( udg_hash, id )\r\n\t\tcall DestroyLightning( ray )\r\n\t\tset ray = null\r\n\t\t\r\n\t\tif IsUnitDead(totem) then\r\n\t\t\treturn\r\n\t\tendif\r\n\t\r\n\t\tcall KillUnit( totem )\r\n\t\tif GetOwningPlayer(target) != Player(10) then\r\n            call berserk( target, 1 )\r\n        endif\r\n        call DestroyEffect( AddSpecialEffect( BERSERK_CAST_ANIMATION, GetUnitX( target ), GetUnitY( target ) ) )\r\n        call InvokeTimerWithUnit( target, \"boss_berserk_rage\", DURATION, false, function BerserkEnd )\r\n        \r\n        set totem = null\r\n        set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function FingTarget takes unit boss returns unit\r\n\t\tlocal group heroes = DeathSystem_GetAliveHeroGroupCopy()\r\n\t\tlocal group potentialTarget = CreateGroup()\r\n\t\tlocal unit u\r\n\t\t\r\n\t\tloop\r\n\t\t\tset u = FirstOfGroup(heroes)\r\n\t\t\texitwhen u == null\r\n\t\t\tif GetOwningPlayer(u) != Player(10) then\r\n\t\t\t\tcall GroupAddUnit(potentialTarget, u )\r\n\t\t\tendif\r\n\t\t\tcall GroupRemoveUnit(heroes, u)\r\n\t\tendloop\r\n\t\r\n\t\tset TempUnit = GroupPickRandomUnit(potentialTarget)\r\n\t\tcall DestroyGroup(potentialTarget)\r\n\t\tcall DestroyGroup(heroes)\r\n\t\tset potentialTarget = null\r\n\t\tset heroes = null\r\n\t\tset u = null\r\n\t\treturn TempUnit\r\n    endfunction\r\n\t\r\n\tprivate function SpawnTotem takes unit boss returns nothing\r\n\t\tlocal integer id\r\n\t    local unit target\r\n\t    local unit totem\r\n\t    local location spawnLoc\r\n\t    local location bossLoc\r\n\t    local lightning ray\r\n\r\n\t    set target = FingTarget(boss)\r\n\t    \r\n\t    if target == null then\r\n\t    \treturn\r\n\t    endif\r\n\r\n\t\tset bossLoc = GetUnitLoc( boss )\r\n\t\tset spawnLoc = GetArenaSpawnLocation( bossLoc, SPAWN_DEVIATION, GetRandomDirectionDeg() )\r\n\t\tset totem = CreateUnitAtLoc( GetOwningPlayer(boss), TOTEM_ID, spawnLoc, 270 )\r\n\t\t\r\n\t\tset ray = Lightning_CreateFollowingRayWithZ( RAY_TYPE, totem, RAY_STARTING_POINT_Z, target, GetUnitFlyHeight(target), false )\r\n\t\t\r\n        set id = InvokeTimerWithUnit( totem, \"boss_berserk_totem\", DELAY, false, function RageActivation )\r\n\t\tcall SaveUnitHandle( udg_hash, id, StringHash(\"boss_berserk_totem_target\"), target )\r\n\t\tcall SaveLightningHandle( udg_hash, GetHandleId( totem ), StringHash(\"boss_berserk_totem_ray\"), ray )\r\n\r\n\t\tcall RemoveLocation(bossLoc)\r\n\t\tcall RemoveLocation(spawnLoc)\r\n\t\tset bossLoc = null\r\n\t\tset spawnLoc = null\r\n\t    set target = null\r\n\t    set ray = null\r\n\tendfunction\r\n\t\r\n\tfunction BerserkCast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsbk\" ) )\r\n\t    \r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call SpawnTotem(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction \r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bsbk\", bosscast(COOLDOWN), true, function BerserkCast )\r\n\t\tcall SpawnTotem(udg_DamageEventTarget)\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Berserk1 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Berserk1 )\r\n\tendfunction\r\n\t\r\nendscope",
