  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Woodo1 initializer init\r\n\t\r\n\tprivate struct Totem\r\n\t\treadonly integer typeId\r\n\t\treadonly trigger startAction\r\n\t\t\r\n\t\tpublic static method create takes integer typeId, trigger startAction returns Totem\r\n            local Totem this = Totem.allocate()\r\n            set .typeId = typeId\r\n            set .startAction = startAction\r\n            return this\r\n        endmethod\r\n\tendstruct\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer TOTEMS_MAX = 5\r\n\t\tprivate Totem array Totems[TOTEMS_MAX]\r\n\t\t\r\n\t\tprivate constant integer SPAWN_DEVIATION = 300\r\n\t\tprivate constant integer COOLDOWN = 6\r\n\t\t\r\n\t\tpublic unit TriggerTotem = null\r\n\t\tpublic unit TriggerBoss = null\r\n\tendglobals\r\n\t\r\n\tprivate function SetData takes nothing returns nothing\r\n\t\tset Totems[0] = Totem.create('o001', null )\r\n\t\tset Totems[1] = Totem.create('o002', EarthTotem_Trigger )\r\n\t\tset Totems[2] = Totem.create('o003', AirTotem_Trigger )\r\n\t\tset Totems[3] = Totem.create('o004', null )\r\n\t\tset Totems[4] = Totem.create('o005', HexTotem_Trigger )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'o000'\r\n\tendfunction\r\n\r\n\tpublic function SummonRandomVoodoTotem takes unit boss returns nothing\r\n\t\tlocal ListInt summonType = ListInt.create()\r\n\t    local integer i = 0\r\n\t    local Totem totemType\r\n\t    local integer index\r\n\t    local player owner = GetOwningPlayer(boss)\r\n\t    local unit totem\r\n\t\t\r\n\t\tloop\r\n\t        exitwhen i >= TOTEMS_MAX\r\n\t        set totemType = Totems[i]\r\n\t        if CountLivingPlayerUnitsOfTypeId( totemType.typeId, owner ) == 0 then\r\n\t            call summonType.Add(i)\r\n\t        endif\r\n\t        set i = i + 1\r\n\t    endloop\r\n\t    \r\n\t    if summonType.IsEmpty() == false then\r\n\t    \tset index = summonType.GetRandomCell()\r\n\t    \tset totemType = Totems[index]\r\n\t    \tset totem = CreateUnit( GetOwningPlayer( boss ), totemType.typeId, GetUnitX( boss ) + GetRandomReal( -SPAWN_DEVIATION, SPAWN_DEVIATION ), GetUnitY( boss ) + GetRandomReal( -SPAWN_DEVIATION, SPAWN_DEVIATION ), 270 )\r\n\t    \tif totemType.startAction != null then\r\n\t    \t\tset TriggerBoss = boss\r\n\t    \t\tset TriggerTotem = totem\r\n\t    \t\tcall TriggerExecute(totemType.startAction)\r\n\t    \tendif\r\n\t    endif\r\n\t    \r\n\t    call summonType.destroy()\r\n\t    set owner = null\r\n\t    set totem = null\r\n\tendfunction\r\n\t\r\n\tpublic function SpawnTotemTimer takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bswd\" ) )\r\n\t\r\n\t    if IsUnitDead( boss) or udg_fightmod[0] == false then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else\r\n\t        call SetUnitAnimation( boss, \"spell\" )\r\n\t        call SummonRandomVoodoTotem(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bswd\", bosscast(COOLDOWN), true, function SpawnTotemTimer )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Woodo1 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Woodo1 )\r\n\t    call SetData()\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}