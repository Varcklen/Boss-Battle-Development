  "Id": 50333587,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Berserk2 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer PROJECTILE_ID = 'u00L'\r\n\t\tprivate constant real TARGET_CHECK = 0.2\r\n\t\tprivate constant integer SEARCH_RANGE = 650\r\n\t\tprivate constant integer CLOSE_RANGE_LIMIT = 70\r\n\t\t\r\n\t\tprivate unit TempUnit = null\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'e00F' and GetUnitLifePercent(udg_DamageEventTarget) <= 75\r\n\tendfunction\r\n\t\r\n\tprivate function FindTarget takes unit projectile, unit exception returns unit\r\n\t\tlocal unit boss = LoadUnitHandle( udg_hash, GetHandleId( projectile ), StringHash( \"boss_berserk_glaive_owner\" ) )\r\n\t\tlocal group units = CreateGroup()\r\n\t\tlocal group potentialTarget = CreateGroup()\r\n\t\tlocal unit u\r\n\t\t\r\n\t\tcall GroupEnumUnitsInRange( units, GetUnitX(projectile), GetUnitY(projectile), SEARCH_RANGE, null )\r\n\t\tloop\r\n\t\t\tset u = FirstOfGroup(units)\r\n\t\t\texitwhen u == null\r\n\t\t\tif u != exception and IsMinion(u) == false then\r\n\t\t\t\tcall GroupAddUnit(potentialTarget, u )\r\n\t\t\tendif\r\n\t\t\tcall GroupRemoveUnit(units, u)\r\n\t\tendloop\r\n\r\n\t\tset TempUnit = GroupPickRandomUnit(potentialTarget)\r\n\t\tif TempUnit == null then\r\n\t\t\tset TempUnit = boss\r\n\t\tendif\r\n\t\t\r\n\t\tcall DestroyGroup(potentialTarget)\r\n\t\tcall DestroyGroup(units)\r\n\t\tset units = null\r\n\t\tset potentialTarget = null\r\n\t\tset u = null\r\n\t\tset boss = null\r\n\t\treturn TempUnit\r\n\tendfunction\r\n\t\r\n\tprivate function CheckTarget takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"boss_berserk_glaive_owner\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"boss_berserk_glaive_target\" ) )\r\n\t    local unit projectile = LoadUnitHandle( udg_hash, id, StringHash( \"boss_berserk_glaive\" ) )\r\n\t    local real rangeToTarget = DistanceBetweenUnits(projectile, target)\r\n\t    \r\n\t    if not( udg_fightmod[0] ) or IsUnitDead( boss ) then\r\n\t        call RemoveUnit( projectile )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t    \tcall IssuePointOrder( projectile, \"move\", GetUnitX(target), GetUnitY(target) )\r\n\t    \tif rangeToTarget < CLOSE_RANGE_LIMIT then\r\n\t    \t\tset target = FindTarget(projectile, target)\r\n\t    \t\tcall SaveUnitHandle( udg_hash, id, StringHash( \"boss_berserk_glaive_target\" ), target )\r\n\t        \tcall IssuePointOrder( projectile, \"move\", GetUnitX(target), GetUnitY(target) )\r\n\t    \tendif\r\n\t    endif\r\n\t    \r\n\t    set projectile = null\r\n\t    set target = null\r\n\t    set boss = null\r\n\tendfunction   \r\n\t    \r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal unit boss = udg_DamageEventTarget\r\n\t    local integer id\r\n\t    local unit projectile\r\n\t    local unit target\r\n\t\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    \r\n\t    set projectile = CreateUnit( GetOwningPlayer( boss ), PROJECTILE_ID, GetUnitX( boss ), GetUnitY( boss ), 270 )\r\n\t    call UnitAddAbility( projectile, 'A0Y5')\r\n\r\n\t    set target = FindTarget(projectile, boss)\r\n\t    call IssuePointOrder( projectile, \"move\", GetUnitX(target), GetUnitY(target) )\r\n\t    \r\n\t\tset id = InvokeTimerWithUnit( projectile, \"boss_berserk_glaive\", TARGET_CHECK, true, function CheckTarget )\r\n\t\tcall SaveUnitHandle( udg_hash, id, StringHash( \"boss_berserk_glaive_target\" ), target )\r\n\t\tcall SaveUnitHandle( udg_hash, id, StringHash( \"boss_berserk_glaive_owner\" ), boss )\r\n\t\tcall SaveUnitHandle( udg_hash, GetHandleId( projectile ), StringHash( \"boss_berserk_glaive_owner\" ), boss )\r\n\t    \r\n\t    set boss = null\r\n\t    set projectile = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Berserk2 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Berserk2 )\r\n\tendfunction\r\n\r\nendscope",
