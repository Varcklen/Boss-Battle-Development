  "Script": "scope Golem1 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer UNIT_TYPE = 'n00S'\r\n\t\tprivate constant integer TOTEMS_TO_SUMMON = 4\r\n\t\tprivate constant integer SPAWN_RANGE = 700\r\n\t\tprivate constant integer EXTRA_ANGLE = 45\r\n\t\tprivate constant integer INVUL_ABILITY = 'A06O'\r\n\t\tprivate constant integer INVUL_EFFECT = 'A06Q'\r\n\t\tprivate constant real CHECK_TICK = 0.5\r\n\t\tprivate constant real RAY_UPDATE_TICK = 0.02\r\n\t\t\r\n\t\tprivate constant integer SPAWN_COOLDOWN = 6\r\n\t\tprivate constant integer AREA_SPAWN_DEVIATION = 400\r\n\t\tprivate constant integer AREA_SIZE = 200\r\n\t\tprivate constant real AREA_SIZE_MULTIPLIER = AREA_SIZE / 100.\r\n\t\tprivate constant integer AREA_DAMAGE = 40\r\n\t\tprivate constant integer AREA_LIFE_TIME = 120\r\n\t\tprivate constant real AREA_TICK = 1\r\n\t\tprivate constant string AREA_SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Other\\\\Monsoon\\\\MonsoonBoltTarget.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n00R' and GetUnitLifePercent(udg_DamageEventTarget) <= 75\r\n\tendfunction\r\n\t\r\n\tprivate function GolemElectro1Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit area = LoadUnitHandle( udg_hash, id, StringHash( \"bsigE2\" ))\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsigE2c\" ) )\r\n\t    local effect areaEffect = LoadEffectHandle( udg_hash, id, StringHash( \"bsigE2e\" ) )\r\n\t    \r\n\t    if IsUnitDead( area ) or IsUnitDead( boss ) or not( udg_fightmod[0] ) then\r\n\t    \tcall IndicatorSystem_Remove( areaEffect )\r\n\t    \tcall RemoveUnit(area)\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else\r\n\t        call GroupAoE( boss, GetUnitX( area ), GetUnitY( area ), AREA_DAMAGE, AREA_SIZE, \"enemy\", null, null )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\t    set area = null\r\n\t    set areaEffect = null\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnArea takes unit boss returns nothing\r\n\t\tlocal unit area\r\n\t\tlocal integer id\r\n\t    local real x\r\n\t    local real y\r\n\t    local effect areaEffect\r\n\t\r\n\t\tset x = GetUnitX( boss ) + GetRandomReal(-AREA_SPAWN_DEVIATION, AREA_SPAWN_DEVIATION)\r\n    \tset y = GetUnitY( boss ) + GetRandomReal(-AREA_SPAWN_DEVIATION, AREA_SPAWN_DEVIATION)\r\n    \r\n    \tset areaEffect = IndicatorSystem_Create( INDICATOR_AIM, x, y, AREA_SIZE, AREA_LIFE_TIME, boss )\r\n    \r\n        set area = CreateUnit( GetOwningPlayer( boss ), 'u000', x, y, 270 )\r\n        call UnitAddAbility( area, 'A072')\r\n        call SetUnitScale(area, AREA_SIZE_MULTIPLIER, AREA_SIZE_MULTIPLIER, AREA_SIZE_MULTIPLIER )\r\n        call UnitApplyTimedLife( area, 'BTLF', AREA_LIFE_TIME)\r\n        call DestroyEffect( AddSpecialEffectTarget( AREA_SPAWN_ANIMATION, area, \"origin\") )\r\n        \r\n        set id = InvokeTimerWithUnit( area, \"bsigE2\", AREA_TICK, true, function GolemElectro1Cast )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bsigE2c\" ), boss )\r\n        call SaveEffectHandle( udg_hash, id, StringHash( \"bsigE2e\" ), areaEffect )\r\n        \r\n        set area = null\r\n        set areaEffect = null\r\n    endfunction\r\n        \r\n\t\r\n\tprivate function GolemAreasTimer takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsigE\" ))\r\n\t    \r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t    \t call SpawnArea(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function TotemsLeftCheck takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsig2\" ) )\r\n\t    local integer totemsLeft = CountLivingPlayerUnitsOfTypeId( UNIT_TYPE, GetOwningPlayer(boss) )\r\n\t     \r\n\t    if totemsLeft == 0 then\r\n\t        call UnitRemoveAbility( boss, INVUL_ABILITY )\r\n\t        call UnitRemoveAbility( boss, INVUL_EFFECT )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function GolemMoveRay takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit caster = LoadUnitHandle( udg_hash, id, StringHash( \"boss_golem_ray_boss\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"boss_golem_ray_target\" ) )\r\n\t    local lightning ray = LoadLightningHandle( udg_hash, id, StringHash( \"boss_golem_ray\" ) )\r\n\t    \r\n\t    if IsUnitAlive( caster ) and IsUnitAlive( target ) then\r\n\t        call MoveLightningUnits( ray, caster, target )\r\n\t    else\r\n\t    \tcall DestroyLightning( ray )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    endif\r\n\t    \r\n\t    set caster = null\r\n\t    set target = null\r\n\t    set ray = null\r\n\tendfunction\r\n\t\r\n\tpublic function SummonTotems takes unit boss, integer amount returns nothing\r\n\t\tlocal integer id\r\n\t    local integer i\r\n\t    local real x\r\n\t    local real y\r\n\t    local lightning ray\r\n\t    local unit totem\r\n\t    local real degree = 360. / amount\r\n\t    local location unitLoc = GetUnitLoc(boss)\r\n\t    local location spawnLoc\r\n\t    local real angle\r\n\t    local player owner = GetOwningPlayer(boss)\r\n\t\r\n\t\tcall UnitAddAbility( boss, INVUL_ABILITY )\r\n\t\tcall UnitAddAbility( boss, INVUL_EFFECT )\r\n\t\t\r\n\t\tset i = 1\r\n\t\tloop\r\n\t        exitwhen i > amount\r\n\t        set angle = EXTRA_ANGLE + degree * i\r\n\t        set spawnLoc = GetArenaSpawnLocation( unitLoc, SPAWN_RANGE, angle )\r\n\r\n\t        set totem = CreateUnitAtLoc( owner, UNIT_TYPE, spawnLoc, 270 )\r\n\r\n\t        set ray = AddLightningEx(\"DRAM\", true, GetUnitX(totem), GetUnitY(totem), GetUnitFlyHeight(totem) , GetUnitX(boss), GetUnitY(boss), GetUnitFlyHeight(boss) )\r\n\r\n\t        set id = InvokeTimerWithUnit( totem, \"boss_golem_ray_target\", RAY_UPDATE_TICK, true, function GolemMoveRay )\r\n\t        call SaveLightningHandle( udg_hash, id, StringHash( \"boss_golem_ray\" ), ray )\r\n\t        call SaveUnitHandle( udg_hash, id, StringHash( \"boss_golem_ray_boss\" ), boss )\r\n\t        set i = i + 1\r\n\t    endloop\r\n\t    \r\n\t\tcall InvokeTimerWithUnit( boss, \"bsig2\", CHECK_TICK, true, function TotemsLeftCheck )\r\n\t\t\r\n\t\tcall RemoveLocation(unitLoc)\r\n\t\tcall RemoveLocation(spawnLoc)\r\n\t\tset unitLoc = null\r\n\t\tset spawnLoc = null\r\n\t\tset ray = null\r\n\t    set boss = null\r\n\t    set totem = null\r\n\t    set owner = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal unit boss = udg_DamageEventTarget\r\n\t\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    \r\n\t    //Summon Totems\r\n\t    call SummonTotems(boss, TOTEMS_TO_SUMMON)\r\n\t    \r\n\t    //Attack Speed Boost\r\n\t    call UnitAddAbility( udg_DamageEventTarget, 'A0B0' )\r\n\t    call DestroyEffect(AddSpecialEffectTarget( \"Abilities\\\\Spells\\\\Orc\\\\WarStomp\\\\WarStompCaster.mdl\", udg_DamageEventTarget, \"origin\") )\r\n\r\n\t\t//Spawn Areas\r\n\t\tcall InvokeTimerWithUnit( boss, \"bsigE\", bosscast( SPAWN_COOLDOWN ), true, function GolemAreasTimer )\r\n\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Golem1 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\tendfunction\r\n\r\nendscope",
