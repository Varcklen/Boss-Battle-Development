  "Id": 50333523,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Manipulator2 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer COOLDOWN = 6\r\n\t\tprivate constant integer LIFETIME = 60\r\n\t\tprivate constant integer SPAWN_DEVIATION = 600\r\n\t\tprivate constant integer AREA = 150\r\n\t\tprivate constant real TICK = 1\r\n\t\tprivate constant real MANA_TO_BURN = 0.04\r\n\t\t\r\n\t\tprivate constant string AREA_SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Demon\\\\DarkPortal\\\\DarkPortalTarget.mdl\"\r\n\t\tprivate constant string AREA_BURN_ANIMATION = \"Abilities\\\\Spells\\\\Undead\\\\ReplenishMana\\\\ReplenishManaCaster.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId( udg_DamageEventTarget ) == 'n02W' and GetUnitLifePercent(udg_DamageEventTarget) <= 80\r\n\tendfunction\r\n\t\r\n\tfunction ManipSquad takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bsmn1\" ))\r\n\t    local effect areaEffect = LoadEffectHandle( udg_hash, id, StringHash( \"bsmn1e\" ) )\r\n\t    local real manaBurn\r\n\t    local group g = CreateGroup()\r\n\t    local unit u\r\n\t    \r\n\t     if IsUnitDead( dummy ) or not( udg_fightmod[0] ) then\r\n\t     \tcall IndicatorSystem_Remove( areaEffect )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t    \tset manaBurn = MANA_TO_BURN * SpellPower_GetBossSpellPower()\r\n\t        call GroupEnumUnitsInRange( g, GetUnitX(dummy), GetUnitY(dummy), AREA, null )\r\n\t        loop\r\n\t            set u = FirstOfGroup(g)\r\n\t            exitwhen u == null\r\n\t            if unitst( u, dummy, \"enemy\" ) then\r\n\t                call SetUnitState( u, UNIT_STATE_MANA, RMaxBJ( 0,GetUnitState( u, UNIT_STATE_MANA ) - GetUnitState( u, UNIT_STATE_MAX_MANA ) * manaBurn  ) )\r\n\t                call DestroyEffect( AddSpecialEffectTarget( AREA_BURN_ANIMATION, u, \"origin\") )\r\n\t            endif\r\n\t            call GroupRemoveUnit(g,u)\r\n\t        endloop\r\n\t    endif\r\n\r\n\t    call DestroyGroup( g )\r\n\t    set areaEffect = null\r\n\t    set g = null\r\n\t    set u = null\r\n\t    set dummy = null\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnArea takes unit boss returns nothing\r\n\t\tlocal unit area\r\n\t\tlocal effect areaEffect\r\n\t\tlocal integer id\r\n\t\tlocal real x = GetUnitX( boss ) + GetRandomReal(-SPAWN_DEVIATION, SPAWN_DEVIATION)\r\n\t\tlocal real y = GetUnitY( boss ) + GetRandomReal(-SPAWN_DEVIATION, SPAWN_DEVIATION)\r\n\t\r\n\t\tset area = CreateUnit( GetOwningPlayer( boss ), 'u000', x, y, 270 )\r\n        call UnitAddAbility( area, 'A076')\r\n        call UnitApplyTimedLife( area, 'BTLF', LIFETIME)\r\n        call DestroyEffect( AddSpecialEffectTarget( AREA_SPAWN_ANIMATION, area, \"origin\") )\r\n        \r\n        set areaEffect = IndicatorSystem_Create( INDICATOR_AIM, x, y, AREA, LIFETIME, area )\r\n        \r\n        set id = InvokeTimerWithUnit( area, \"bsmn1\", TICK, true, function ManipSquad )\r\n        call SaveEffectHandle( udg_hash, id, StringHash( \"bsmn1e\" ), areaEffect )\r\n        \r\n        set areaEffect = null\r\n        set area = null\r\n\tendfunction\r\n\t\r\n\tprivate function ManipCast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsmn\" ) )\r\n\r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call SpawnArea(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call SpawnArea(udg_DamageEventTarget)\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bsmn\", bosscast(COOLDOWN), true, function ManipCast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Manipulator2 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Manipulator2 )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}