  "Script": "scope Salamander1 initializer init\r\n\r\n\tglobals\r\n\t\tprivate constant real ACCELERATION_X = 0.3\r\n\t\tprivate constant real ACCELERATION_Y = 0.3\r\n\tendglobals\r\n\r\n\tfunction Trig_Salamander1_Conditions takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n041'\r\n\tendfunction\r\n\t\r\n\tprivate function At50 takes unit boss, real BossPosx, real BossPosy returns nothing\r\n\t\tset udg_counter[2] = udg_counter[2] + 1\r\n        if udg_counter[2] < 450 and RAbsBJ(BossPosx-udg_BossPos[0]) + RAbsBJ(BossPosy-udg_BossPos[1])>320  then//поджог земли при перемещении в течении 14 секунд потом 14 секунд отдыха абилка стандартная\r\n            set udg_BossPos[0]=BossPosx\r\n            set udg_BossPos[1]=BossPosy \r\n            call dummyspawn( boss, 1, 'A0JT',0, 0)\r\n            call IssuePointOrder( bj_lastCreatedUnit, \"flamestrike\", GetUnitX( boss ), GetUnitY( boss ) )\r\n        endif\r\n        if udg_counter[2] > 900 then\r\n            set udg_counter[2] = 0\r\n        endif\r\n\tendfunction\r\n\t\r\n\tprivate function At75 takes unit boss, real BossPosx, real BossPosy returns nothing\r\n\t\tlocal integer i\r\n\t\tlocal group g = null\r\n\t    local unit u\r\n\t\r\n\t\tset udg_counter[1] = udg_counter[1] + 1\r\n\t\tif udg_counter[1] > 300 then\r\n\t        set i = 1\r\n\t        loop\r\n\t        \texitwhen i > 4\r\n\t        \t\r\n\t            if udg_hero[i] != null and RAbsBJ(BossPosx - GetUnitX(udg_hero[i])) + RAbsBJ(BossPosy - GetUnitY(udg_hero[i])) < 250 then\r\n\t            \tset g = CreateGroup()\r\n\t                call GroupEnumUnitsInRange( g, GetUnitX( boss ), GetUnitY( boss ), 300, null )\r\n\t                call DestroyEffect( AddSpecialEffect( \"Abilities\\\\Spells\\\\Human\\\\ThunderClap\\\\ThunderClapCaster.mdl\", BossPosx, BossPosy ) )\r\n\t                loop\r\n\t                    set u = FirstOfGroup(g)\r\n\t                \texitwhen u == null\r\n\t                    if unitst( u, boss, \"enemy\" ) then\r\n\t                        call UnitStun(boss, u, 1.5 )\r\n\t                        call UnitDamageTarget( boss, u, 125, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)//оглушение героев если они близко раз в 9 секунд абилка взята от медведя\r\n\t                    endif\r\n\t                    call GroupRemoveUnit(g,u)\r\n\t                endloop\r\n\t                call DestroyGroup( g )\r\n\t                set udg_counter[1] = 0\r\n\t                exitwhen true\r\n\t            endif\r\n\t            \r\n\t            set i = i + 1\r\n\t        endloop\r\n        endif\r\n\r\n\t    set u = null\r\n\t    set g = null\r\n\tendfunction\r\n\t\r\n\tprivate function IsCanMove takes unit boss returns boolean\r\n\t\tif GetUnitAbilityLevel( boss, 'BEer' ) > 0 then\r\n\t\t\treturn false\r\n\t\telseif GetUnitAbilityLevel( boss, 'BPSE' ) > 0 then\r\n\t\t\treturn false\r\n\t\telseif GetUnitAbilityLevel( boss, 'B043' ) > 0 then\r\n\t\t\treturn false\r\n\t\telseif IsUnitPaused(boss) then\r\n\t\t\treturn false\r\n\t\tendif\r\n\t\treturn true\r\n\tendfunction\r\n\t\r\n\tprivate function Interaction takes unit boss returns nothing\r\n\t    local real SalamanderSpeedx = 0 //скорость саламандры глобальная переменная массив integer\r\n\t    local real SalamanderSpeedy = 0\r\n\t    local real BossPosx = 0.00\r\n\t    local real BossPosy = 0.00\r\n\t    local real hp = GetUnitLifePercent(boss)\r\n\t    \r\n        if IsCanMove(boss) then//внести сюда все станящие абилки, так же при стане не кдшатся скилы боса\r\n            set SalamanderSpeedx = udg_SalamanderSpeed[0] + ACCELERATION_X * CosBJ (GetUnitFacing (boss))\r\n            set SalamanderSpeedy = udg_SalamanderSpeed[1] + ACCELERATION_Y * SinBJ (GetUnitFacing (boss))\r\n            \r\n            set SalamanderSpeedy = RMinBJ(SalamanderSpeedy, 12)//максимальная скорость\r\n            set SalamanderSpeedy = RMaxBJ(SalamanderSpeedy, -12)\r\n            \r\n            set SalamanderSpeedx = RMinBJ(SalamanderSpeedx, 12)\r\n            set SalamanderSpeedx = RMaxBJ(SalamanderSpeedx, -12)\r\n\r\n            set BossPosx = GetUnitX(boss) + SalamanderSpeedx\r\n            set BossPosy = GetUnitY(boss) + SalamanderSpeedy\r\n            \r\n            if IsTerrainPathable(BossPosx, BossPosy, PATHING_TYPE_WALKABILITY) == FALSE then //проверка проходимости\r\n                call SetUnitX (boss,BossPosx)\r\n                call SetUnitY (boss,BossPosy)\r\n            else\r\n                set SalamanderSpeedx = 0//сброс скорости если непроходимо\r\n                set SalamanderSpeedy = 0\r\n            endif\r\n            \r\n            if hp <= 75 then\r\n                call At75(boss, BossPosx, BossPosy)\r\n            endif\r\n            if hp <= 50 then\r\n                call At50(boss, BossPosx, BossPosy)\r\n            endif\r\n            \r\n            set udg_SalamanderSpeed[0] = SalamanderSpeedx\r\n            set udg_SalamanderSpeed[1] = SalamanderSpeedy\r\n        endif\r\n\tendfunction\r\n\t\r\n\tfunction Salamander1_Movement takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"cerf\" ) )\r\n\r\n\t    if IsUnitDead(boss) or udg_fightmod[0] == false  then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call Interaction(boss)\r\n\t    endif\r\n\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tfunction Trig_Salamander1_Actions takes nothing returns nothing\r\n\t    local integer id = GetHandleId( udg_DamageEventTarget )\r\n\t\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\r\n\t    if LoadTimerHandle( udg_hash, id, StringHash( \"cerf\" ) ) == null  then\r\n\t        call SaveTimerHandle( udg_hash, id, StringHash( \"cerf\" ), CreateTimer() )\r\n\t    endif\r\n\t\tset id = GetHandleId( LoadTimerHandle( udg_hash, id, StringHash( \"cerf\" ) ) ) \r\n\t    call SaveUnitHandle( udg_hash, id, StringHash( \"cerf\" ), udg_DamageEventTarget )\r\n\t\tcall TimerStart( LoadTimerHandle( udg_hash, GetHandleId( udg_DamageEventTarget ), StringHash( \"cerf\" ) ), 0.03, true, function Salamander1_Movement )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Salamander1 = CreateTrigger(  )\r\n\t    call DisableTrigger( gg_trg_Salamander1 )\r\n\t    call TriggerRegisterVariableEvent( gg_trg_Salamander1, \"udg_AfterDamageEvent\", EQUAL, 1.00 )\r\n\t    call TriggerAddCondition( gg_trg_Salamander1, Condition( function Trig_Salamander1_Conditions ) )\r\n\t    call TriggerAddAction( gg_trg_Salamander1, function Trig_Salamander1_Actions )\r\n\tendfunction\r\n\r\nendscope",
