  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Voidlord1 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer COOLDOWN = 15\r\n\t\tprivate constant integer STASIS_ID = 'h008'\r\n\t\tprivate constant integer WARNING_DURATION = 2\r\n\t\tprivate constant string SPAWN_ANIMATION = \"CallOfAggression.mdx\"\r\n\t\tprivate constant string WARNING_MODEL = \"Abilities\\\\Spells\\\\Other\\\\TalkToMe\\\\TalkToMe\"\r\n\t\tprivate constant string WARNING_MODEL_ATTACHMENT_POINT = \"overhead\"\r\n\t\tprivate constant real WARNING_MODEL_SIZE = 3\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n00C'\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnStasis takes nothing returns nothing\r\n\t\tlocal integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"boss_voidlord_stasis\" ) )\r\n\t\tlocal location unitLoc = GetUnitLoc(target)\r\n\t\tlocal unit stasis\r\n\t\tlocal effect warning = LoadEffectHandle( udg_hash, id, StringHash( \"boss_voidlord_stasis_model\" ) )\r\n\t\r\n\t\tif IsUnitAlive(target) and IsUnitHiddenBJ(target) == false then\r\n\t\t\tcall DelBuff( target, false )\r\n\t        call PauseUnit( target, true )\r\n\t        call ShowUnitHide( target )\r\n\t        set stasis = CreateUnitAtLoc( Player(PLAYER_NEUTRAL_AGGRESSIVE), STASIS_ID, unitLoc, 270 )\r\n\t        call SaveUnitHandle( udg_hash, GetHandleId( stasis ), StringHash( \"egg\" ), target )\t\r\n\t        call DestroyEffect( AddSpecialEffectLoc( SPAWN_ANIMATION, unitLoc ) )\r\n        endif\r\n        call DestroyEffect(warning)\r\n        call FlushChildHashtable( udg_hash, id )\r\n        \r\n        call RemoveLocation(unitLoc)\r\n        set unitLoc = null\r\n        set target = null\r\n        set warning = null\r\n        set stasis = null\r\n\tendfunction\r\n\t\r\n\tprivate function CreateStasisDelay takes unit boss returns nothing\r\n\t\tlocal unit target \r\n\t    local integer cyclA = 1\r\n\t    local boolean isAnyHeroHidden = false\r\n\t    local unit hero\r\n\t    local effect warning\r\n\t    local integer id\r\n\t    \r\n\t\tloop\r\n            exitwhen cyclA > 4\r\n            set hero = udg_hero[cyclA]\r\n            if hero != null and IsUnitHiddenBJ(hero) then\r\n                set isAnyHeroHidden = true\r\n                exitwhen true\r\n            endif\r\n            set cyclA = cyclA + 1\r\n        endloop\r\n        \r\n        set hero = null\r\n        if isAnyHeroHidden then\r\n        \treturn\r\n        endif\r\n        \r\n        set target = DeathSystem_GetRandomAliveHero()\r\n        if target == null then\r\n            return\r\n        endif\r\n        set warning = AddSpecialEffectTarget(WARNING_MODEL, target, WARNING_MODEL_ATTACHMENT_POINT )\r\n        call BlzSetSpecialEffectScale( warning, WARNING_MODEL_SIZE )\r\n        \r\n        set id = InvokeTimerWithUnit( target, \"boss_voidlord_stasis\", WARNING_DURATION, false, function SpawnStasis )\r\n        call SaveEffectHandle( udg_hash, id, StringHash( \"boss_voidlord_stasis_model\" ), warning )\r\n        \r\n        set target = null\r\n        set warning = null\r\n\tendfunction\r\n\t\r\n\tprivate function Voidlord1Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bbvd\" ))\r\n\t    \r\n\t    if IsUnitDead( boss ) or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call CreateStasisDelay(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bbvd\", bosscast(COOLDOWN), true, function Voidlord1Cast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Voidlord1 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Voidlord1 )\r\n\tendfunction\r\n\r\nendscope",
