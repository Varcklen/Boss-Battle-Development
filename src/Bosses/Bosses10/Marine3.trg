{
  "Id": 50333682,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Marine3 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant string RAY_TYPE = \"CLPB\"//\"PISU\"\r\n\t\t\r\n\t\tprivate constant real BASE_COOLDOWN = 10\r\n\t\tprivate constant real SHOOT_DELAY = 3\r\n\t\tprivate constant real SPEED = 38\r\n\t\tprivate constant integer DAMAGE = 400\r\n\t\tprivate constant integer COUNTER = 30\r\n\t\tprivate constant real PROJECTILE_TICK = 0.04\r\n\t\tprivate constant real RAY_UPDATE_TICK = 0.04\r\n\t\tprivate constant integer RAY_COUNTER = R2I( SHOOT_DELAY / RAY_UPDATE_TICK )\r\n\t\tprivate constant real MOVE_DISTANCE = PROJECTILE_TICK * SPEED\r\n\t\tprivate constant integer HIT_AREA = 125\r\n\t\t\r\n\t\tprivate constant integer MARK_ID = 'A0S4'\r\n\t\tprivate constant integer BUFF_ID = 'B07X'\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId( udg_DamageEventTarget ) == 'n04N' and GetUnitLifePercent(udg_DamageEventTarget) <= 98\r\n\tendfunction\r\n\t\r\n\tprivate function DealDamage takes unit boss, unit dummy, integer id returns nothing\r\n\t\tlocal group nodmg = LoadGroupHandle( udg_hash, id, StringHash( \"boss_marine_proj_group\" ) )\r\n\t    local group g = CreateGroup()\r\n\t    local unit u\r\n\t    \r\n        call GroupEnumUnitsInRange( g, GetUnitX( dummy ), GetUnitY( dummy ), HIT_AREA, null )\r\n        loop\r\n            set u = FirstOfGroup(g)\r\n            exitwhen u == null\r\n            if unitst( u, boss, \"enemy\" ) and not( IsUnitInGroup( u, nodmg ) ) then\r\n                call UnitDamageTarget( boss, u, DAMAGE, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS )\r\n                call GroupAddUnit( nodmg, u )\r\n            endif\r\n            call GroupRemoveUnit(g,u)\r\n        endloop\r\n        call SaveGroupHandle( udg_hash, id, StringHash( \"bsmr6g\" ), nodmg )\r\n        \r\n        call DestroyGroup( g )\r\n\t    set g = null\r\n\t    set nodmg = null\r\n\t    set u = null\r\n\tendfunction\r\n\t\r\n\tprivate function ChangePosition takes unit projectile returns nothing\r\n\t\tlocal location projLoc = GetUnitLoc(projectile)\r\n\t\tlocal location newLoc = PolarProjectionBJ(projLoc, SPEED, GetUnitFacing( projectile ) )\r\n\r\n        call SetUnitPositionLoc( projectile, newLoc )\r\n\r\n\t\tcall RemoveLocation(projLoc)\r\n\t\tcall RemoveLocation(newLoc)\r\n\t\tset projLoc = null\r\n\t\tset newLoc = null\r\n    endfunction\r\n    \r\n\tprivate function Marine3Wave takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local integer counter = LoadInteger( udg_hash, id, StringHash( \"boss_marine_proj_counter\" ) ) + 1\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"boss_marine_proj\" ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"boss_marine_proj_boss\" ) )\r\n\t    local group nodmg\r\n\t    \r\n\t    call BJDebugMsg(\"counter \" + I2S(counter) )\r\n\t    call BJDebugMsg(\"dummy \" + GetUnitName(dummy) )\r\n\t    \r\n\t    if counter >= COUNTER or IsUnitDead( dummy ) then\r\n\t    \tcall BJDebugMsg(\"END\")\r\n\t        call RemoveUnit( dummy )\r\n\t        set nodmg = LoadGroupHandle( udg_hash, id, StringHash( \"boss_marine_proj_group\" ) )\r\n\t        call DestroyGroup( nodmg )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t    \tcall BJDebugMsg(\"MOVE \" )\r\n\t    \tcall ChangePosition( dummy )\r\n\t        call DealDamage(boss, dummy, id)\r\n\t        call SaveInteger( udg_hash, id, StringHash( \"boss_marine_proj_counter\" ), counter )\r\n\t    endif\r\n\t    \r\n\t    set nodmg = null\r\n\t    set dummy = null\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function Marine3End takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"boss_marine_delay_boss\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"boss_marine_delay\" ) )\r\n\t    local real x = GetUnitX( boss )\r\n\t    local real y = GetUnitY( boss )\r\n\t    local unit projectile\r\n\t    \r\n\t    call UnitRemoveAbility( target, MARK_ID)\r\n\t    call UnitRemoveAbility( target, BUFF_ID)\r\n\t    \r\n\t\r\n\t    if IsUnitAlive( boss ) and udg_fightmod[0] then\r\n\t        set projectile = CreateUnit( GetOwningPlayer( boss ), 'u000', x, y, AngleBetweenUnits(boss, target) )\r\n\t        call UnitAddAbility( projectile, 'A0S5')\r\n\t        \r\n\t        set id = InvokeTimerWithUnit( projectile, \"boss_marine_proj\", PROJECTILE_TICK, true, function Marine3Wave )\r\n\t        call SaveUnitHandle( udg_hash, id, StringHash( \"boss_marine_proj_boss\" ), boss )\r\n\t        call SaveGroupHandle( udg_hash, id, StringHash( \"boss_marine_proj_group\" ), CreateGroup() )\r\n\t     \r\n\t        if IsUnitHasAbility( boss, 'A0SE') == false then\r\n\t        \tcall IssueImmediateOrder( boss, \"stop\" )\r\n\t        \tcall SetUnitAnimation( boss, \"attack slam\" )\r\n\t    \tendif\r\n\t    endif\r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t    \r\n\t\tset projectile = null\r\n\t    set boss = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function UpdateRayPositions takes lightning ray, unit boss, unit target returns nothing\r\n\t\tlocal location endLoc\r\n\t\tlocal location bossLoc = GetUnitLoc(boss)\r\n\t\tlocal real angle = AngleBetweenUnits(boss, target)\r\n\t\t\r\n\t\tset endLoc = PolarProjectionBJ(bossLoc, MOVE_DISTANCE, angle )\r\n\t\t//call MoveLightningLoc(ray, bossLoc, endLoc )\r\n\t\tcall MoveLightningEx(ray, true, GetLocationX(bossLoc), GetLocationY(bossLoc), 30, GetLocationX(endLoc), GetLocationY(endLoc), 30)\r\n\t\t\r\n\t\tcall BJDebugMsg(\"bossx: \" + R2S(GetLocationX(bossLoc) ) )\r\n\t\tcall BJDebugMsg(\"bossy: \" + R2S(GetLocationY(bossLoc) ))\r\n\t\tcall BJDebugMsg(\"endx: \" + R2S(GetLocationX(endLoc) ))\r\n\t\tcall BJDebugMsg(\"endy: \" + R2S(GetLocationY(endLoc) ))\r\n\t\t\r\n\t\tcall RemoveLocation(endLoc)\r\n\t\tcall RemoveLocation(bossLoc)\r\n\t\tset endLoc = null\r\n\t\tset bossLoc = null\r\n\tendfunction\r\n\t\r\n\tprivate function RayUpdate takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"boss_marine_ray_update_boss\" ) ) \r\n\t\tlocal lightning ray = LoadLightningHandle( udg_hash, id, StringHash( \"boss_marine_ray_update_ray\" ) )\r\n\t\tlocal unit target\r\n\t\tlocal integer counter = LoadInteger( udg_hash, id, StringHash( \"boss_marine_ray_update_counter\" ) ) + 1\r\n\r\n\t    if ray == null or IsUnitDead( boss ) or not( udg_fightmod[0] ) or counter >= RAY_COUNTER then\r\n\t    \tcall BJDebugMsg(\"end\")\r\n\t    \tcall DestroyLightning(ray)\r\n\t    \tcall FlushChildHashtable( udg_hash, id )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else\r\n\t    \tcall BJDebugMsg(\"update\")\r\n\t    \tset target = LoadUnitHandle( udg_hash, id, StringHash( \"boss_marine_ray_update\" ) )\r\n\t        call UpdateRayPositions(ray, boss, target)\r\n\t        call SaveInteger( udg_hash, id, StringHash( \"boss_marine_ray_update_counter\" ), counter )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\t    set ray = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function ProjectilePreparation takes unit boss returns nothing\r\n\t\tlocal unit target = DeathSystem_GetRandomAliveHero()\r\n\t    local integer id\r\n\t    local lightning ray\r\n\t    \r\n\t\tif target == null or GetUnitAbilityLevel( boss, 'A0SE') > 0 then\r\n\t\t\treturn\r\n\t\tendif\r\n\t\tcall UnitAddAbility( target, MARK_ID )\r\n\t\t\r\n        set ray = AddLightning( RAY_TYPE, true, 0, 0, 1, 1 )\r\n\t\tcall UpdateRayPositions(ray, boss, target)\r\n   \r\n        set id = InvokeTimerWithUnit( target, \"boss_marine_delay\", SHOOT_DELAY, false, function Marine3End )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"boss_marine_delay_boss\" ), boss )\r\n\r\n        set id = InvokeTimerWithUnit( target, \"boss_marine_ray_update\", RAY_UPDATE_TICK, true, function RayUpdate )\r\n        call SaveLightningHandle( udg_hash, id, StringHash( \"boss_marine_ray_update_ray\" ), ray )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"boss_marine_ray_update_boss\" ), boss )\r\n        \r\n        set ray = null\r\n        set target = null\r\n\tendfunction\r\n\t\r\n\tfunction Marine3Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsmr4\" ) ) \r\n\r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else\r\n\t        call ProjectilePreparation(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer id = GetHandleId( udg_DamageEventTarget )\r\n\t\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    \r\n\t    if LoadTimerHandle( udg_hash, id, StringHash( \"bsmr4\" ) ) == null  then\r\n\t        call SaveTimerHandle( udg_hash, id, StringHash( \"bsmr4\" ), CreateTimer() )\r\n\t    endif\r\n\t    set id = GetHandleId( LoadTimerHandle( udg_hash, id, StringHash( \"bsmr4\" ) ) ) \r\n\t    call SaveUnitHandle( udg_hash, id, StringHash( \"bsmr4\" ), udg_DamageEventTarget )\r\n\t\tcall TimerStart( LoadTimerHandle( udg_hash, GetHandleId( udg_DamageEventTarget ), StringHash( \"bsmr4\" ) ), bosscast(BASE_COOLDOWN), true, function Marine3Cast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Marine3 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Marine3 )\r\n\tendfunction\r\n\t\r\nendscope",
  "Events": [],
