  "Script": "scope VoidLord5 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer DURATION = 10\r\n\t\t\r\n\t\tprivate constant integer EFFECT_ID = 'A092'\r\n\t\tprivate constant integer BUFF_ID = 'B05B'\r\n\t\tprivate constant integer DAMAGE = 1500\r\n\t\tprivate constant string HIT_ANIMATION = \"CallOfAggression.mdx\"\r\n\t\tprivate constant integer DAMAGE_TO_REMOVE = 1000\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId( udg_DamageEventTarget ) == 'n00C' and GetUnitLifePercent(udg_DamageEventTarget) <= 25\r\n\tendfunction\r\n\t\r\n\tprivate function Voidlord5End takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"boss_voidlord_mark\" ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"boss_voidlord_mark_boss\" ) )\r\n\t    \r\n\t    if GetUnitAbilityLevel(target, BUFF_ID) > 0 then\r\n\t        if IsUnitHiddenBJ(target) == false then\r\n\t            call DestroyEffect( AddSpecialEffect( HIT_ANIMATION, GetUnitX( target ), GetUnitY( target ) ) )\r\n\t            call UnitDamageTarget( boss, target, DAMAGE, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)\r\n\t        endif\r\n\t\t\tcall UnitRemoveAbility( target, EFFECT_ID )\r\n\t        call UnitRemoveAbility( target, BUFF_ID )\r\n\t    endif\r\n\t    \r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t\r\n\t    set target = null\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function ApplyMark takes unit boss, unit target returns nothing\r\n\t\tlocal integer id\r\n\t\t\r\n\t\tcall UnitAddAbility( target, EFFECT_ID)\r\n\t\t\r\n\t\tset id = InvokeTimerWithUnit( target, \"boss_voidlord_mark\", DURATION, false, function Voidlord5End )\r\n\t\tcall SaveUnitHandle( udg_hash, id, StringHash( \"boss_voidlord_mark_boss\" ), boss )\r\n\tendfunction\r\n\t\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal unit boss = udg_DamageEventTarget\r\n\t    local group heroes = DeathSystem_GetAliveHeroGroupCopy()\r\n\t    local unit u\r\n\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call TransmissionFromUnitWithNameBJ( bj_FORCE_ALL_PLAYERS, udg_DamageEventTarget, GetUnitName(udg_DamageEventTarget), null, \"To the Void!\", bj_TIMETYPE_SET, 3, false )\r\n\t    \r\n\t    loop\r\n\t    \tset u = FirstOfGroup(heroes)\r\n\t    \texitwhen u == null\r\n\t    \tcall ApplyMark(boss, u)\r\n\t    \tcall GroupRemoveUnit(heroes, u)\r\n\t\tendloop\r\n\t\t\r\n\t\tcall DestroyGroup(heroes)\r\n\t\tset heroes = null\r\n\t\tset boss = null\r\n\t\tset u = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnDamageDealt_Condition takes nothing returns boolean\r\n\t    return GetUnitAbilityLevel(udg_DamageEventSource, BUFF_ID) > 0 and GetUnitTypeId( udg_DamageEventTarget ) == 'n00C'\r\n\tendfunction\r\n\t\r\n\tprivate function OnDamageDealt takes nothing returns nothing\r\n\t\tlocal unit caster = udg_DamageEventSource\r\n\t\tlocal integer id = GetHandleId(caster)\r\n\t\tlocal real totalDamage = LoadReal( udg_hash, id, StringHash( \"boss_voidlord_mark_damage\" ) )\r\n\t\t\r\n\t\tset totalDamage = totalDamage + udg_DamageEventAmount\r\n\t\tif totalDamage >= DAMAGE_TO_REMOVE then\r\n\t\t\tcall UnitRemoveAbility( caster, EFFECT_ID )\r\n\t        call UnitRemoveAbility( caster, BUFF_ID )\r\n\t        set totalDamage = 0\r\n        endif\r\n        call SaveReal( udg_hash, id, StringHash( \"boss_voidlord_mark_damage\" ), totalDamage )\r\n\t\t\r\n\t\tset caster = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Voidlord5 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Voidlord5 )\r\n\t    \r\n\t    call CreateEventTrigger( \"udg_AfterDamageEvent\", function OnDamageDealt, function OnDamageDealt_Condition )\r\n\tendfunction\r\n\r\nendscope",
