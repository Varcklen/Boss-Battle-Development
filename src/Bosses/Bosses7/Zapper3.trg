{
  "Id": 50333577,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Zapper3 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer DAMAGE = 125\r\n\t\tpublic constant integer AREA_SIZE = 1200\r\n\t\tpublic constant integer AREA_SIZE_CENTER = 600\r\n\t\t\r\n\t\tprivate constant integer DURATION = 25\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n00Q' and GetUnitLifePercent(udg_DamageEventTarget) <= 60\r\n\tendfunction\r\n\t\r\n\tprivate function Zapper3End takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bszp3\" ) )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bszp3d\" ) )\r\n\t    local integer i = LoadInteger( udg_hash, id, StringHash( \"bszp3\" ) ) + 1\r\n\t    local real size = LoadReal( udg_hash, id, StringHash( \"bszp3\" ) )\r\n\t    local group g = CreateGroup()\r\n\t    local unit u\r\n\t\r\n\t    if IsUnitDead( dummy ) or IsUnitDead( boss ) or not( udg_fightmod[0] ) or i > DURATION then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call SaveInteger( udg_hash, id, StringHash( \"bszp3\" ), i )\r\n\t        call GroupAoE( boss, GetUnitX( dummy ), GetUnitY( dummy ), DAMAGE, size, \"enemy\", null, null )\r\n\t    endif\r\n\t\r\n\t    call DestroyGroup( g )\r\n\t    set u = null\r\n\t    set g = null\r\n\t    set dummy = null\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tpublic function MakeExplode takes unit boss, real x, real y, real size returns nothing\r\n\t\tlocal integer id\r\n\t\tlocal unit dummy\r\n\t\r\n\t\tset dummy = dummyspawn( boss, DURATION, 'A139', 0, 0 )\r\n\t    call SetUnitPosition( dummy, x, y )\r\n\t    call IssuePointOrder( dummy, \"flamestrike\", x, y )\r\n\t    \r\n\t    set id = InvokeTimerWithUnit( dummy, \"bszp3d\", 1, true, function Zapper3End )\r\n\t    call SaveUnitHandle( udg_hash, id, StringHash( \"bszp3\" ), boss )\r\n\t    call SaveReal( udg_hash, id, StringHash( \"bszp3\" ), size )\r\n\t    \r\n\t    call IndicatorSystem_Create( INDICATOR_AIM, x, y, size, DURATION, boss )\r\n\r\n\t    set dummy = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local unit boss = udg_DamageEventTarget\r\n\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call MakeExplode(boss, GetRectCenterX(udg_Boss_Rect) + 1100, GetRectCenterY(udg_Boss_Rect) + 1000, AREA_SIZE )\r\n\t    call MakeExplode(boss, GetRectCenterX(udg_Boss_Rect) - 1100, GetRectCenterY(udg_Boss_Rect) + 1000, AREA_SIZE )\r\n\t    call MakeExplode(boss, GetRectCenterX(udg_Boss_Rect), GetRectCenterY(udg_Boss_Rect), AREA_SIZE_CENTER )\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Zapper3 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Zapper3 )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}