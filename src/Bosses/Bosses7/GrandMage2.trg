  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope GrandMage2 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer COOLDOWN = 8\r\n\t\tprivate constant integer DAMAGE = 350\r\n\t\tprivate constant integer AREA = 200\r\n\t\tprivate constant integer DELAY = 3\r\n\t\tprivate constant integer PROJECTILE_AMOUNT = 2\r\n\t\t\r\n\t\tprivate constant string START_ANIMATION = \"Abilities\\\\Weapons\\\\Bolt\\\\BoltImpact.mdl\"\r\n\t\tprivate constant string EXPLODE_ANIMATION = \"Abilities\\\\Spells\\\\Other\\\\Incinerate\\\\FireLordDeathExplode.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId( udg_DamageEventTarget ) == 'h003' and GetUnitLifePercent(udg_DamageEventTarget) <= 95\r\n\tendfunction\r\n\t\r\n\tprivate function GrandMage2Exp takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bsgm1exp\" ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsgm1c\" ) )\r\n\t    \r\n\t    call GroupAoE( boss, GetUnitX( dummy ), GetUnitY( dummy ), DAMAGE, AREA, \"enemy\", EXPLODE_ANIMATION, null )\r\n\r\n\t    call RemoveUnit( dummy )\r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t    \r\n\t    set boss = null\r\n\t    set dummy = null\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnBolts takes unit boss returns nothing\r\n\t\tlocal integer i\r\n\t\tlocal integer id\r\n\t\tlocal group targets = DeathSystem_GetAliveHeroGroupCopy()\r\n\t\tlocal unit target\r\n\r\n\t\tset i =  1\r\n\t\tloop\r\n\t\t\texitwhen i > PROJECTILE_AMOUNT\r\n\t\t\tset target = GroupPickRandomUnit(targets)\r\n\t\t\t\r\n\t\t\tif target == null then\r\n\t\t\t\texitwhen true\r\n\t\t\tendif\r\n\t\t\t\r\n\t\t\tcall dummyspawn( boss, 5, 'A07D', 0, 'A136' )\r\n\t        call IssuePointOrder( bj_lastCreatedUnit, \"move\", GetUnitX( target ), GetUnitY( target ) )\r\n\t\r\n\t        set id = InvokeTimerWithUnit( bj_lastCreatedUnit, \"bsgm1exp\", bosscast(DELAY), false, function GrandMage2Exp )\r\n\t        call SaveUnitHandle( udg_hash, id, StringHash( \"bsgm1c\" ), boss )\r\n\t        \r\n\t        call GroupRemoveUnit(targets, target)\r\n\t\t\tset i = i + 1\r\n\t\tendloop\r\n\t\t\r\n\t\tcall DestroyGroup(targets)\r\n\t\tset targets = null\r\n        set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function GrandMage2Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsgm1\" ) )\r\n\t    \r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call SpawnBolts(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal unit boss = udg_DamageEventTarget\r\n\t\t\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call SpawnBolts(boss)\r\n\t\tcall DestroyEffect( AddSpecialEffectTarget( START_ANIMATION, boss, \"origin\") )\r\n\t\tcall InvokeTimerWithUnit( boss, \"bsgm1\", bosscast(COOLDOWN), true, function GrandMage2Cast )\r\n\t\t\r\n\t\tset boss = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_GrandMage2 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_GrandMage2 )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}