  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Succubus1 initializer init\r\n\t\r\n\tglobals\r\n\t\tpublic constant integer COOLDOWN = 6\r\n\t\tprivate constant integer SEARCH_RANGE = 600\r\n\t\tprivate constant integer NEW_HEIGHT = 200\r\n\t\tprivate constant integer HEIGHT_RATE = 200\r\n\t\tprivate constant real TICK_RATE = 0.02\r\n\t\tprivate constant integer COUNTER = 20\r\n\t\tprivate constant integer COUNTER_HALF_POINT = COUNTER / 2\r\n\t\tprivate constant integer SPEED = 30\r\n\t\t\r\n\t\tprivate constant integer DAMAGE = 60\r\n\t\tprivate constant integer HEAL = 60\r\n\t\tprivate constant integer SUMMON_LIMIT = 15\r\n\t\tprivate constant integer UNIT_TYPE_ID = 'n036'\r\n\t\tprivate constant string HIT_ANIMATION = \"Objects\\\\Spawnmodels\\\\Human\\\\HumanLargeDeathExplode\\\\HumanLargeDeathExplode.mdl\"\r\n\t\tprivate constant string SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Other\\\\Doom\\\\DoomDeath.mdl\"\r\n\t\tprivate constant integer SPAWN_DEVIATION = 400 \r\n\t\t\r\n\t\tprivate constant real MINION_JUMP_COOLDOWN_MIN = 7\r\n\t\tprivate constant real MINION_JUMP_COOLDOWN_MAX = 9\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n01S'\r\n\tendfunction\r\n\t\r\n\tprivate function JumpEnd takes unit boss, unit target, integer id returns nothing\r\n\t    local integer unitAmount\r\n\t    local unit newUnit\r\n\t    local player owner\r\n\t\r\n\t\tcall SetUnitPathing( boss, true )\r\n        call UnitRemoveAbility( boss, 'Amrf' )\r\n        call pausest( boss, -1 )\r\n        \r\n        if IsUnitDead( target) then\r\n        \treturn\r\n    \tendif\r\n\r\n        call SetUnitState( boss, UNIT_STATE_LIFE, GetUnitState( boss, UNIT_STATE_LIFE) + HEAL * SpellPower_GetBossSpellPower() )\r\n        call UnitDamageTarget( boss, target, DAMAGE, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)\r\n        call DestroyEffect( AddSpecialEffect( HIT_ANIMATION, GetUnitX( target ), GetUnitY( target ) ) )\r\n        \r\n        set owner = GetOwningPlayer( boss )\r\n        set unitAmount = CountLivingPlayerUnitsOfTypeId( UNIT_TYPE_ID, owner )\r\n        if unitAmount <= SUMMON_LIMIT then\r\n            set newUnit = CreateUnit( owner, UNIT_TYPE_ID, Math_GetUnitRandomX(target, SPAWN_DEVIATION), Math_GetUnitRandomY(target, SPAWN_DEVIATION), GetRandomDirectionDeg() )\r\n            call DestroyEffect( AddSpecialEffectTarget( SPAWN_ANIMATION, newUnit, \"origin\") )\r\n            call Succubus1_EnableJump.evaluate(newUnit, GetRandomReal(MINION_JUMP_COOLDOWN_MIN, MINION_JUMP_COOLDOWN_MAX) )\r\n            //set udg_DamageEventTarget = newUnit\r\n            //call TriggerExecute( gg_trg_Succubus1 )\r\n        endif\r\n        \r\n        set owner = null\r\n        set newUnit = null\r\n\tendfunction\r\n\t\r\n\tprivate function SucRun takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bssc1\" ) )\r\n\t    local unit target = LoadUnitHandle( udg_hash, id, StringHash( \"bssc1t\" ) )\r\n\t    local integer counter = LoadInteger( udg_hash, id, StringHash( \"bssc1\" ) ) + 1\r\n\t    local real x = GetUnitX( target )\r\n\t    local real y = GetUnitY( target )\r\n\t    local real angle = Atan2( y - GetUnitY( boss ), x - GetUnitX( boss ) )\r\n\t    local real NewX = GetUnitX( boss ) + SPEED * Cos( angle )\r\n\t    local real NewY = GetUnitY( boss ) + SPEED * Sin( angle )\r\n\r\n\t\tif counter == COUNTER_HALF_POINT then\r\n\t        call SetUnitFlyHeight( boss, -NEW_HEIGHT, HEIGHT_RATE )\r\n\t    endif\r\n\t\r\n\t    if counter == COUNTER or IsUnitDead( boss ) or not( udg_fightmod[0] ) then\r\n\t        call JumpEnd(boss, target, id)\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id ) \r\n\t    else \r\n\t        call SaveInteger( udg_hash, id, StringHash( \"bssc1\" ), counter )\r\n\t        call SetUnitPosition( boss, NewX, NewY )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function Jump takes unit boss returns nothing\r\n\t\tlocal integer id = GetHandleId( boss )\r\n\t    local unit target\r\n\t    local real angle \r\n\t\r\n\t\tset target = randomtarget( boss, SEARCH_RANGE, \"enemy\", 0, 0, 0 )\r\n        if target == null then\r\n        \treturn\r\n    \tendif\r\n        set angle = AngleBetweenUnits(target, boss)\r\n        call SetUnitFacing( boss, angle )\r\n        call pausest( boss, 1 )\r\n        call UnitAddAbility( boss, 'Amrf' )\r\n        call SetUnitFlyHeight( boss, NEW_HEIGHT, HEIGHT_RATE )\r\n        call SetUnitPathing( boss, true )\r\n\r\n        set id = InvokeTimerWithUnit( boss, \"bssc1\", TICK_RATE, true, function SucRun )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bssc1t\" ), target )\r\n\r\n        set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function SucCast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bssc\" ))\r\n\t    \r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call Jump(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tpublic function EnableJump takes unit caster, real cooldown returns nothing\r\n\t\tcall InvokeTimerWithUnit( caster, \"bssc\", bosscast(cooldown), true, function SucCast )\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\tcall EnableJump(udg_DamageEventTarget, COOLDOWN)\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Succubus1 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Succubus1 )\r\n\tendfunction\r\n\r\nendscope",
