  "Id": 50333564,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope GrandMage4 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer COOLDOWN = 4\r\n\t\tprivate constant integer AREA = 300\r\n\t\tprivate constant integer DAMAGE = 250\r\n\t\tprivate constant integer SPAWN_DEVIATION = 400\r\n\t\t\r\n\t\tprivate constant real EXPLOSION_DELAY = 1.5\r\n\t\t\r\n\t\tprivate constant string START_ANIMATION = \"Abilities\\\\Weapons\\\\Bolt\\\\BoltImpact.mdl\"\r\n\t\tprivate constant string EXPLOSION_ANIMATION = \"Abilities\\\\Spells\\\\Other\\\\HowlOfTerror\\\\HowlCaster.mdl\"\r\n\t\tprivate constant real AREA_MULTIPLIER = AREA / 150.\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId( udg_DamageEventTarget ) == 'h003' and GetUnitLifePercent(udg_DamageEventTarget) <= 40\r\n\tendfunction\r\n\t\r\n\tprivate function Explosion takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"boss_mage_arcane_epxlosion_boss\" ) )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"boss_mage_arcane_epxlosion\" ) )\r\n\t\tlocal effect explosion\r\n\r\n\t\tset explosion = AddSpecialEffect(EXPLOSION_ANIMATION, GetUnitX(dummy), GetUnitY(dummy) )\r\n        call BlzSetSpecialEffectScale(explosion, AREA_MULTIPLIER)\r\n        call DestroyEffect(explosion)\r\n        \r\n\t\tcall GroupAoE( boss, GetUnitX(dummy), GetUnitY(dummy), DAMAGE, AREA, \"enemy\", null, null )\r\n\t\tcall RemoveUnit(dummy)\r\n\t\tcall FlushChildHashtable( udg_hash, id )\r\n\r\n\t\tset explosion = null\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function Spawn takes unit boss returns nothing\r\n\t\tlocal real x = GetUnitX( boss ) + GetRandomReal( -SPAWN_DEVIATION, SPAWN_DEVIATION )\r\n\t    local real y = GetUnitY( boss ) + GetRandomReal( -SPAWN_DEVIATION, SPAWN_DEVIATION )\r\n\t    local unit explosion\r\n\t    local integer id\r\n\r\n\t    set explosion = CreateUnit( GetOwningPlayer(boss), 'u000', x, y, 270 )\r\n\r\n        call IndicatorSystem_Create( INDICATOR_SKULL, x, y, AREA, EXPLOSION_DELAY, boss )\r\n\t    \r\n\t    set id = InvokeTimerWithUnit( explosion, \"boss_mage_arcane_epxlosion\", bosscast(EXPLOSION_DELAY), false, function Explosion )\r\n\t    call SaveUnitHandle(udg_hash, id, StringHash(\"boss_mage_arcane_epxlosion_boss\"), boss )\r\n\tendfunction\r\n\t\r\n\tprivate function CastTimer takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsgm3\" ) )\r\n\t    \r\n\t    if IsUnitDead(boss) or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call Spawn(boss)\r\n\t    endif\r\n\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\tcall DestroyEffect( AddSpecialEffectTarget( START_ANIMATION, udg_DamageEventTarget, \"origin\") )\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bsgm3\", bosscast(COOLDOWN), true, function CastTimer )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_GrandMage4 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_GrandMage4 )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}