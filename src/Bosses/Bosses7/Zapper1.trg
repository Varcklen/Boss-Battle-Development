{
  "Id": 50333575,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Zapper1 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer BOMB_DAMAGE = 125\r\n\t\tprivate constant integer BOMB_AREA = 125\r\n\tendglobals\r\n\t\r\n\tfunction Trig_Zapper1_Conditions takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n00Q'\r\n\tendfunction\r\n\t\r\n\tfunction Zapper1Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local real r = LoadReal( udg_hash, id, StringHash( \"bszp1\" ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bszp1\" ) )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bszp1d\" ) )\r\n\t    local real xc = LoadReal( udg_hash, id, StringHash( \"bszp1x\" ) )\r\n\t    local real yc = LoadReal( udg_hash, id, StringHash( \"bszp1y\" ) )\r\n\t    local real x\r\n\t    local real y\r\n\t    \r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call RemoveUnit( dummy )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        set x = xc + 1000 * Cos( r * bj_DEGTORAD)\r\n\t        set y = yc + 1000 * Sin( r * bj_DEGTORAD)\r\n\t        call SaveReal( udg_hash, id, StringHash( \"bszp1\" ), r + 1 )\r\n\t        call SetUnitPosition( dummy, x, y )\r\n\t        call SetUnitFacing( dummy, 90 + r )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\t    set dummy = null\r\n\tendfunction\r\n\t\r\n\tfunction Zapper2Fire takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit projectile = LoadUnitHandle( udg_hash, id, StringHash( \"bszpfire\" ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bszpfireu\" ) )\r\n\t    local unit t = LoadUnitHandle( udg_hash, id, StringHash( \"bszpfiret\" ) )\r\n\t    local location areaLoc = LoadLocationHandle( udg_hash, id, StringHash( \"bszpfire_area\" ) )\r\n\t    local location projectileLoc = GetUnitLoc(projectile)\r\n\t    local real direction = AngleBetweenPoints(projectileLoc, areaLoc)\r\n\t    local real distance = DistanceBetweenPoints(projectileLoc, areaLoc)\r\n\t    local real moveRange = LoadReal( udg_hash, id, StringHash( \"bszpfire\" ) )\r\n\t    local location newLoc = null\r\n\t    local boolean isBossAlive = IsUnitAlive(boss)\r\n\t    \r\n\t    if distance <= 35 or isBossAlive == false or udg_fightmod[0] == false then\r\n\t        if isBossAlive then\r\n\t            call GroupAoE( boss, GetLocationX(areaLoc), GetLocationY(areaLoc), BOMB_DAMAGE, BOMB_AREA, \"enemy\", \"Abilities\\\\Spells\\\\Other\\\\Incinerate\\\\FireLordDeathExplode.mdl\", null )\r\n\t        endif\r\n\t        call RemoveUnit( t )\r\n\t        call RemoveUnit( projectile )\r\n\t        call RemoveLocation(areaLoc)\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else \r\n\t    \tset newLoc = PolarProjectionBJ( projectileLoc, 0.03 * moveRange, direction )\r\n\t    \tcall SetUnitPositionLoc(projectile, newLoc)\r\n\t    endif\r\n\t    \r\n\t    call RemoveLocation(projectileLoc)\r\n\t    call RemoveLocation(newLoc)\r\n\t    set areaLoc = null\r\n\t    set projectileLoc = null\r\n\t    set newLoc = null\r\n\t    set boss = null\r\n\t    set t = null\r\n\t    set projectile = null\r\n\tendfunction\r\n\t\r\n\tfunction Zapper2CreateProjectile takes unit u returns nothing\r\n\t    local unit targetPoint\r\n\t    local unit projectile\r\n\t    local real r\r\n\t    local real x\r\n\t    local real y\r\n\t    local integer id\r\n\t    local unit target\r\n\t    local location areaLoc\r\n\t    local location targetLoc\r\n\t\r\n\t    set target = DeathSystem_GetRandomAliveHero()\r\n\t    if target != null and GetRandomInt(1, 5) == 1 then\r\n\t    \tset targetLoc = GetUnitLoc(target)\r\n\t    \tset areaLoc = PolarProjectionBJ( targetLoc, 75, GetRandomInt( 0, 360) )\r\n\t    else\r\n\t    \tset targetLoc = GetUnitLoc(u)\r\n\t    \tset areaLoc = PolarProjectionBJ( targetLoc, 900, GetRandomInt( 0, 360) )\r\n\t    endif\r\n\t    \r\n\t    set targetPoint = CreateUnitAtLoc( GetOwningPlayer( u ), 'u000', areaLoc, 270 )\r\n\t    call UnitAddAbility( targetPoint, 'A136')\r\n\t    \r\n\t    set projectile = dummyspawn( u, 0, 'A07D', 0, 0 )\r\n\t    set x = GetUnitX(projectile) - GetLocationX(areaLoc)\r\n\t    set y = GetUnitY(projectile) - GetLocationY(areaLoc)\r\n\t    set r = SquareRoot(x * x + y * y)\r\n\t    call SetUnitFlyHeight( projectile, 500, -r / ( r * 0.04 ) )\r\n\t    \r\n\t    set id = InvokeTimerWithUnit( projectile, \"bszpfire\", 0.04, true, function Zapper2Fire )\r\n\t\tcall SaveLocationHandle( udg_hash, id, StringHash( \"bszpfire_area\" ), areaLoc ) \r\n\t    call SaveReal( udg_hash, id, StringHash( \"bszpfire\" ), r )\r\n\t    call SaveUnitHandle( udg_hash, id, StringHash( \"bszpfiret\" ), targetPoint )\r\n\t    call SaveUnitHandle( udg_hash, id, StringHash( \"bszpfireu\" ), u )\r\n\t        \r\n\t    call RemoveLocation(targetLoc)\r\n\t    set areaLoc = null\r\n\t    set targetLoc = null\r\n\t    set target = null\r\n\t    set targetPoint = null\r\n\t    set projectile = null\r\n\tendfunction\r\n\t\r\n\tfunction Zapper2Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit u = LoadUnitHandle( udg_hash, id, StringHash( \"bszp\" ) )\r\n\t\r\n\t    if GetUnitState( u, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else\r\n\t        call Zapper2CreateProjectile(u)\r\n\t    endif\r\n\tendfunction\r\n\t\r\n\tfunction Trig_Zapper1_Actions takes nothing returns nothing\r\n\t    local integer id \r\n\t    local real x = GetRectCenterX(udg_Boss_Rect)\r\n\t    local real y = GetRectCenterY(udg_Boss_Rect) + 300\r\n\t\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    set bj_lastCreatedUnit = CreateUnit( GetOwningPlayer( udg_DamageEventTarget ), 'u005', x, y, GetUnitFacing(udg_DamageEventTarget) )\r\n\t    \r\n\t    set id = GetHandleId( bj_lastCreatedUnit )\r\n\t    if LoadTimerHandle( udg_hash, id, StringHash( \"bszp\" ) ) == null  then\r\n\t        call SaveTimerHandle( udg_hash, id, StringHash( \"bszp\" ), CreateTimer() )\r\n\t    endif\r\n\t\tset id = GetHandleId( LoadTimerHandle( udg_hash, id, StringHash( \"bszp\" ) ) ) \r\n\t    call SaveUnitHandle( udg_hash, id, StringHash( \"bszp\" ), bj_lastCreatedUnit )\r\n\t\tcall TimerStart( LoadTimerHandle( udg_hash, GetHandleId( bj_lastCreatedUnit ), StringHash( \"bszp\" ) ), 0.5, true, function Zapper2Cast )\r\n\t    \r\n\t    set id = GetHandleId( udg_DamageEventTarget )\r\n\t    if LoadTimerHandle( udg_hash, id, StringHash( \"bszp1\" ) ) == null  then\r\n\t        call SaveTimerHandle( udg_hash, id, StringHash( \"bszp1\" ), CreateTimer() )\r\n\t    endif\r\n\t\tset id = GetHandleId( LoadTimerHandle( udg_hash, id, StringHash( \"bszp1\" ) ) ) \r\n\t    call SaveUnitHandle( udg_hash, id, StringHash( \"bszp1\" ), udg_DamageEventTarget )\r\n\t    call SaveUnitHandle( udg_hash, id, StringHash( \"bszp1d\" ), bj_lastCreatedUnit )\r\n\t    call SaveReal( udg_hash, id, StringHash( \"bszp1x\" ), x )\r\n\t    call SaveReal( udg_hash, id, StringHash( \"bszp1y\" ), y )\r\n\t\tcall TimerStart( LoadTimerHandle( udg_hash, GetHandleId( udg_DamageEventTarget ), StringHash( \"bszp1\" ) ), 0.02, true, function Zapper1Cast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Zapper1 = CreateTrigger(  )\r\n\t    call DisableTrigger( gg_trg_Zapper1 )\r\n\t    call TriggerRegisterVariableEvent( gg_trg_Zapper1, \"udg_AfterDamageEvent\", EQUAL, 1.00 )\r\n\t    call TriggerAddCondition( gg_trg_Zapper1, Condition( function Trig_Zapper1_Conditions ) )\r\n\t    call TriggerAddAction( gg_trg_Zapper1, function Trig_Zapper1_Actions )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
