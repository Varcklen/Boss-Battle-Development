  "Id": 50333576,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Zapper2 initializer init\r\n\r\n\tglobals\r\n\t\tprivate constant integer SAW_ID = 'u00K'\r\n\t\t\r\n\t\tprivate constant integer COOLDOWN = 10\r\n\t\tprivate constant integer SAW_LIFETIME = 7\r\n\t\tprivate constant integer DESTINATION_RANGE = 100\r\n\t\t\r\n\t\tprivate constant string SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Orc\\\\MirrorImage\\\\MirrorImageDeathCaster.mdl\"\r\n\t\tprivate constant string DESTROY_ANIMATION = \"Abilities\\\\Spells\\\\Orc\\\\MirrorImage\\\\MirrorImageDeathCaster.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n00Q'\r\n\tendfunction\r\n\t\r\n\tprivate function Zapper2Move takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local integer counter\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bszp2b\" ) )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bszp2\" ) )\r\n\r\n\t    if IsUnitDead( dummy ) or IsUnitDead( boss ) or not( udg_fightmod[0] ) then\r\n\t        call RemoveUnit( dummy )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t    \tset counter = LoadInteger( udg_hash, id, StringHash( \"bszp2\" ) ) + 1\r\n\t    \tif counter >= SAW_LIFETIME then\r\n\t    \t\tcall DestroyEffect( AddSpecialEffect( DESTROY_ANIMATION, GetUnitX(dummy), GetUnitY(dummy) ) )\r\n\t\t        call RemoveUnit( dummy )\r\n\t\t        call DestroyTimer( GetExpiredTimer() )\r\n\t\t        call FlushChildHashtable( udg_hash, id )\r\n\t        else\r\n\t        \tcall SaveInteger( udg_hash, id, StringHash( \"bszp2\" ), counter )\r\n\t    \tendif\r\n\t    endif\r\n\t    \r\n\t    set dummy = null\r\n\t    set boss = null\r\n\tendfunction   \r\n\t\r\n\tprivate function SpawnSaw takes unit boss returns nothing\r\n\t\tlocal unit target = DeathSystem_GetRandomAliveHero()\r\n\t    local real x \r\n\t    local real y \r\n\t    local unit saw\r\n\t    local integer id\r\n\t    \r\n\t    if target == null then\r\n\t    \treturn\r\n\t    endif\r\n\t    \r\n\t    set x = GetUnitX( target )\r\n\t    set y = GetUnitY( target )\r\n\t\r\n\t\tcall SetUnitAnimation( boss, \"attack\" )\r\n        call DestroyEffect( AddSpecialEffect( SPAWN_ANIMATION, GetUnitX(boss), GetUnitY(boss) ) )\r\n\t\t\r\n\t\tset saw = CreateUnit( GetOwningPlayer(boss), SAW_ID, GetUnitX(boss), GetUnitY(boss), GetUnitFacing(boss) )\r\n        call UnitAddAbility(saw, 'A138' )\r\n\r\n        call IssuePointOrder( saw, \"move\", x, y )\r\n        \r\n        set id = InvokeTimerWithUnit( saw, \"bszp2\", 1, true, function Zapper2Move )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bszp2b\" ), boss )\r\n        \r\n        set target = null\r\n        set saw = null\r\n\tendfunction\r\n\t\r\n\tprivate function Zapper2Saw takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bszp2\" ) )\r\n\r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call SpawnSaw(boss)\r\n\t    endif\r\n\r\n\t    set boss = null\r\n\tendfunction\r\n\t    \r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bszp2\", bosscast(COOLDOWN), true, function Zapper2Saw )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Zapper2 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Zapper2 )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}