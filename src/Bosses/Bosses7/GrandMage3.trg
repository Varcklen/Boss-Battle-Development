  "Id": 50333563,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope GrandMage3 initializer init \r\n\t\r\n\tglobals\r\n\t\tprivate constant integer COOLDOWN = 6\r\n\t\tprivate constant integer SPAWN_DEVIATION = 600\r\n\t\tprivate constant integer AREA_SIZE = 400\r\n\t\tprivate constant integer DAMAGE = 100\r\n\t\tprivate constant integer TICK = 1\r\n\t\t\r\n\t\tprivate constant integer DURATION = 6\r\n\t\t\r\n\t\tprivate constant string EEFECT_MODEL = \"war3mapImported\\\\Sleet Storm.mdx\"\r\n\t\tprivate constant real AREA_MULTIPLIER = AREA_SIZE / 175.\r\n\t\tprivate constant string START_ANIMATION = \"Abilities\\\\Weapons\\\\Bolt\\\\BoltImpact.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId( udg_DamageEventTarget ) == 'h003' and GetUnitLifePercent(udg_DamageEventTarget) <= 70\r\n\tendfunction\r\n\t\r\n\tprivate function Blizzard takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"boss_mage_blizzard_boss\" ) )\r\n\t    local effect blizzard = LoadEffectHandle( udg_hash, id, StringHash( \"boss_mage_blizzard\" ) )\r\n\t    local integer counter = LoadInteger(udg_hash, id, StringHash( \"boss_mage_blizzard_counter\" ) ) + 1\r\n\t\tlocal real x = LoadReal(udg_hash, id, StringHash( \"boss_mage_blizzard_x\" ) )\r\n\t    local real y = LoadReal(udg_hash, id, StringHash( \"boss_mage_blizzard_y\" ) )\r\n\t\t\r\n\t\tif IsUnitAlive(boss) then\r\n\t\t\tcall GroupAoE( boss, x, y, DAMAGE, AREA_SIZE, \"enemy\", null, null )\r\n\t\tendif\r\n\t\t\r\n\t\tif IsUnitDead(boss) or not( udg_fightmod[0] ) or counter >= DURATION then\r\n\t\t\tcall DestroyEffect(blizzard)\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n        else\r\n        \tcall SaveInteger(udg_hash, id, StringHash( \"boss_mage_blizzard_counter\" ), counter )\r\n\t    endif\r\n\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function Spawn takes unit boss returns nothing\r\n\t\tlocal real x\r\n\t    local real y\r\n\t    local effect blizzard\r\n\t    local integer id\r\n\t\r\n\t\tset x = GetUnitX( boss ) + GetRandomReal( -SPAWN_DEVIATION, SPAWN_DEVIATION )\r\n    \tset y = GetUnitY( boss ) + GetRandomReal( -SPAWN_DEVIATION, SPAWN_DEVIATION )\r\n        set blizzard = AddSpecialEffect(EEFECT_MODEL, x, y )\r\n        call BlzSetSpecialEffectScale(blizzard, AREA_MULTIPLIER)\r\n        call IndicatorSystem_Create( INDICATOR_AIM, x, y, AREA_SIZE, DURATION, boss )\r\n        \r\n        set id = InvokeTimerWithEffect( blizzard, \"boss_mage_blizzard\", TICK, true, function Blizzard )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"boss_mage_blizzard_boss\" ), boss )\r\n        call SaveReal(udg_hash, id, StringHash( \"boss_mage_blizzard_x\" ), x)\r\n        call SaveReal(udg_hash, id, StringHash( \"boss_mage_blizzard_y\" ), y)\r\n        \r\n        set blizzard = null\r\n\tendfunction\r\n\t\r\n\tprivate function GrandMage3Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsgm2\" ) )\r\n\t    \r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t    \tcall Spawn(boss)\r\n\t    endif\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\tcall DestroyEffect( AddSpecialEffectTarget( START_ANIMATION, udg_DamageEventTarget, \"origin\") )\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bsgm2\", bosscast(COOLDOWN), true, function GrandMage3Cast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_GrandMage3 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_GrandMage3 )\r\n\tendfunction\r\n\t\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}