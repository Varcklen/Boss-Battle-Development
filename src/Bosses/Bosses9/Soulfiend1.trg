  "Script": "scope Soulfiend1 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer COOLDOWN = 12\r\n\t\tprivate constant integer SPAWN_DEVIATION = 650\r\n\t\t\r\n\t\tprivate constant real HP_CONSUMPTION_PERCENT = 0.1\r\n\t\tprivate constant integer AREA_TICK = 1\r\n\t\tprivate constant integer AREA_SIZE = 250\r\n\t\t\r\n\t\tprivate constant real MODEL_SIZE = AREA_SIZE / 100.\r\n\t\tprivate constant string SPAWN_ANIMATION = \"CallOfAggression.mdx\"\r\n\t\tprivate constant string HIT_ANIMATION = \"Abilities\\\\Spells\\\\Items\\\\AIil\\\\AIilTarget.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n04F'\r\n\tendfunction\r\n\t\r\n\tprivate function Soulfiend1End takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local group g = CreateGroup()\r\n\t    local unit u\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bssf2b\" ) )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bssf2\" ) )\r\n\t    local effect warningArea \r\n\t\r\n\t    if GetUnitState( dummy, UNIT_STATE_LIFE) <= 0.405 or GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t    \tset warningArea = LoadEffectHandle( udg_hash, id, StringHash( \"bssf2m\" ) )\r\n\t    \tcall IndicatorSystem_Remove( warningArea )\r\n\t        call RemoveUnit( dummy )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        set warningArea = null\r\n\t    else\r\n\t        call GroupEnumUnitsInRange( g, GetUnitX( dummy ), GetUnitY( dummy ), AREA_SIZE, null )\r\n\t        loop\r\n\t            set u = FirstOfGroup(g)\r\n\t            exitwhen u == null\r\n\t            if unitst( u, boss, \"enemy\" ) then\r\n\t                call DestroyEffect( AddSpecialEffect( HIT_ANIMATION, GetUnitX( u ), GetUnitY( u ) ) )\r\n\t                call SetUnitState( u, UNIT_STATE_LIFE, RMaxBJ(0,GetUnitState( u, UNIT_STATE_LIFE) - GetUnitState( u, UNIT_STATE_MAX_LIFE) * HP_CONSUMPTION_PERCENT ) )\r\n\t            endif\r\n\t            call GroupRemoveUnit( g, u )\r\n\t        endloop\r\n\t    endif\r\n\t    \r\n\t    call DestroyGroup( g )\r\n\t    set u = null\r\n\t    set g = null\r\n\t    set dummy = null\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnArea takes unit boss returns nothing\r\n\t\tlocal integer id\r\n\t\tlocal effect warningArea \r\n\t\tlocal unit dummy\r\n\t\tlocal location bossLoc = GetUnitLoc(boss)\r\n\t\tlocal location spawnLoc = GetArenaSpawnLocation( bossLoc, SPAWN_DEVIATION, GetRandomDirectionDeg() )\r\n\t\r\n\t\tset warningArea = IndicatorSystem_Create( INDICATOR_AIM, GetLocationX(spawnLoc), GetLocationY(spawnLoc), AREA_SIZE, 0, boss )\r\n\t\r\n\t\tset dummy = CreateUnitAtLoc( GetOwningPlayer( boss ), 'u000', spawnLoc, GetRandomDirectionDeg() )\r\n    \tcall DestroyEffect( AddSpecialEffectLoc( SPAWN_ANIMATION, spawnLoc ) )\r\n    \tcall SetUnitScale( dummy, MODEL_SIZE, MODEL_SIZE, MODEL_SIZE )\r\n        call UnitAddAbility( dummy, 'A170')\r\n\r\n        set id = InvokeTimerWithUnit( dummy, \"bssf2\", AREA_TICK, true, function Soulfiend1End )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bssf2b\" ), boss )\r\n        call SaveEffectHandle( udg_hash, id, StringHash( \"bssf2m\" ), warningArea )\r\n        \r\n        call RemoveLocation(spawnLoc)\r\n        call RemoveLocation(bossLoc)\r\n        set spawnLoc = null\r\n        set bossLoc = null\r\n        set warningArea = null\r\n        set dummy = null\r\n\tendfunction\r\n\t\r\n\tpublic function Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bssf1\" ))\r\n\t    \r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t    \tcall SpawnArea(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call InvokeTimerWithUnit( udg_DamageEventTarget, \"bssf1\", bosscast(COOLDOWN), true, function Cast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Soulfiend1 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Soulfiend1 )\r\n\tendfunction\r\n\r\nendscope",
