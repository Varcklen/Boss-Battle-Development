  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Pyromant3 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer CAST_DURATION = 12\r\n\t\tprivate constant integer COUNTDOWN_TICK = 1\r\n\t\tprivate constant string START_CAST_ANIMATION = \"Abilities\\\\Spells\\\\Human\\\\MassTeleport\\\\MassTeleportCaster.mdl\"\r\n\t\t\r\n\t\tprivate constant integer EXPLOSION_DURATION = 25\r\n\t\tprivate constant integer EXPLOSION_TICK = 1\r\n\t\tprivate constant integer AREA_SIZE = 2000\r\n\t\tprivate constant integer DAMAGE = 200\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'h00Z' and GetUnitLifePercent(udg_DamageEventTarget) <= 25\r\n\tendfunction\r\n\t\r\n\tprivate function Pyro3End takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bspr4\" ) )\r\n\t    local integer i = LoadInteger( udg_hash, id, StringHash( \"bspr4\" ) ) + 1\r\n\t\r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not(udg_fightmod[0]) or i > EXPLOSION_DURATION then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else\r\n\t        call SaveInteger( udg_hash, id, StringHash( \"bspr4\" ), i )\r\n\t        call GroupAoE( boss, GetRectCenterX(udg_Boss_Rect), GetRectCenterY(udg_Boss_Rect), DAMAGE, AREA_SIZE, \"enemy\", null, null )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function Explosion takes unit boss returns nothing\r\n\t\tlocal integer id\r\n\t\r\n\t\tcall pausest( boss, -1 )\r\n        call SetUnitAnimation( boss, \"stand\")\r\n        call dummyspawn( boss, EXPLOSION_DURATION, 'A0KW', 0, 0 )\r\n        call IssuePointOrder( bj_lastCreatedUnit, \"flamestrike\", GetUnitX( boss ), GetUnitY( boss ) )\r\n        call dummyspawn( boss, EXPLOSION_DURATION, 'A0KW', 0, 0 )\r\n        call IssuePointOrder( bj_lastCreatedUnit, \"flamestrike\", GetUnitX( boss ), GetUnitY( boss ) )\r\n        \r\n        call InvokeTimerWithUnit( boss, \"bspr4\", EXPLOSION_TICK, true, function Pyro3End )\r\n\tendfunction\r\n\t\r\n\tprivate function CastTick takes unit boss, integer id, timer timerUsed returns nothing\r\n\t\tlocal integer counter = LoadInteger( udg_hash, id, StringHash( \"bspr2\" ) ) + 1\r\n\t\r\n\t\tif counter >= CAST_DURATION then\r\n\t\t\tcall Explosion(boss)\r\n\t\t\tcall DestroyTimer( timerUsed )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t\t\treturn\r\n\t\tendif\r\n\t\tcall SetUnitAnimationWithRarity( boss, \"spell channel\", RARITY_FREQUENT )\r\n\t\tcall textst( \"|cffffff00\" + I2S(CAST_DURATION - counter), boss, 64, 90, 16, 1 )\r\n\t\tcall SaveInteger( udg_hash, id, StringHash( \"bspr2\" ), counter )\r\n\tendfunction\r\n\t\r\n\tprivate function Pyro3Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bspr2\" ) )\r\n\r\n\t\tif GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t\t\tcall CastTick(boss, id, GetExpiredTimer() )\r\n\t    endif\r\n\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal unit boss = udg_DamageEventTarget\r\n\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call SetUnitFacing( boss, 270 )\r\n\t    call DestroyEffect( AddSpecialEffectTarget( START_CAST_ANIMATION, boss, \"origin\") ) \r\n\t    call pausest( boss, 1 )\r\n\t    call SetUnitAnimationWithRarity( boss, \"spell channel\", RARITY_FREQUENT )\r\n\r\n\t\tcall InvokeTimerWithUnit( boss, \"bspr2\", COUNTDOWN_TICK, true, function Pyro3Cast )\r\n\t\t\r\n\t\tset boss = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Pyromant3 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Pyromant3 )\r\n\tendfunction\r\n\r\nendscope",
