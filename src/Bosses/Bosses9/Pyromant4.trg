  "Id": 50333633,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Pyromant4 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer COOLDOWN = 12\r\n\t\t\r\n\t\tprivate constant integer DURATION = 10\r\n\t\tprivate constant real TICK = 0.5\r\n\t\tprivate constant integer COUNTER = R2I( DURATION / TICK )\r\n\t\tprivate constant integer DAMAGE = 150\r\n\t\tprivate constant real DAMAGE_PER_TICK = DAMAGE * TICK\r\n\t\tprivate constant integer AREA_SIZE = 400\r\n\t\tprivate constant integer SPAWN_DEVIATION = 500\r\n\t\t\r\n\t\tprivate constant string SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Human\\\\FlameStrike\\\\FlameStrike1.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'h00Z'\r\n\tendfunction\r\n\t\r\n\tfunction Pyromant4Cast1 takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bspr6b\" ) )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bspr6\" ) )\r\n\t    local integer counter = LoadInteger( udg_hash, id, StringHash( \"bspr6\" ) ) + 1\r\n\t    local real x \r\n\t    local real y\r\n\t    \r\n\t    if counter >= COUNTER or not(udg_fightmod[0]) then\r\n\t        call RemoveUnit( dummy )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else\r\n\t    \tset x = LoadReal( udg_hash, id, StringHash( \"bspr6x\" ) )\r\n\t    \tset y = LoadReal( udg_hash, id, StringHash( \"bspr6y\" ) )\r\n\t        call SaveInteger( udg_hash, id, StringHash( \"bspr6\" ), counter )\r\n\t        call GroupAoE( boss, x, y, DAMAGE_PER_TICK, AREA_SIZE, \"enemy\" , null, null )\r\n\t    endif\r\n\r\n\t    set dummy = null\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function CastStorm takes unit boss returns nothing\r\n\t\tlocal integer id\r\n\t    local real x\r\n\t    local real y\r\n\t    local unit dummy\r\n\t    \r\n\t    set x = GetUnitX(boss) + GetRandomReal( -SPAWN_DEVIATION, SPAWN_DEVIATION )\r\n        set y = GetUnitY(boss) + GetRandomReal( -SPAWN_DEVIATION, SPAWN_DEVIATION )\r\n        set dummy = CreateUnit( GetOwningPlayer(boss), 'u000', x, y , 270 )\r\n        call UnitAddAbility( dummy, 'A0XE' )\r\n        call IssuePointOrder( dummy, \"flamestrike\", x, y )\r\n        \r\n        call spectime( SPAWN_ANIMATION, x, y, DURATION )\r\n        call IndicatorSystem_Create( INDICATOR_AIM, x, y, AREA_SIZE, DURATION, boss )\r\n\r\n        set id = InvokeTimerWithUnit( dummy, \"bspr6\", TICK, true, function Pyromant4Cast1 )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bspr6b\" ), boss )\r\n        call SaveReal( udg_hash, id, StringHash( \"bspr6x\" ), x )\r\n        call SaveReal( udg_hash, id, StringHash( \"bspr6y\" ), y )\r\n        \r\n        set dummy = null\r\n\tendfunction\r\n\t    \r\n\tfunction Pyromant4Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bspr5\" ))\r\n\t    \r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call CastStorm(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bspr5\", bosscast(COOLDOWN), true, function Pyromant4Cast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Pyromant4 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Pyromant4 )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}