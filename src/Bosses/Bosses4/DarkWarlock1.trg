  "Script": "scope DarkWarlock1 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer AREA = 128\r\n\t\tprivate constant integer DAMAGE = 45\r\n\t\tprivate constant real DELAY = 1\r\n\t\tprivate constant real TICK = 1\r\n\t\tprivate constant string HIT_ANIMATION = \"Abilities\\\\Spells\\\\Undead\\\\DeathPact\\\\DeathPactTarget.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId( udg_DamageEventTarget ) == 'e00D'\r\n\tendfunction\r\n\t\r\n\tprivate function DarkWarDamage takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bsdwd\" ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsdwdb\" ) )\r\n\r\n\t    if IsUnitDead(dummy) or not( udg_fightmod[0] ) or IsUnitDead(boss)  then\r\n\t        call RemoveUnit(dummy)\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else\r\n\t    \tcall GroupAoE(boss, GetUnitX( dummy ), GetUnitY( dummy ), DAMAGE, AREA, \"enemy\", null, HIT_ANIMATION )\r\n\t    endif\r\n\r\n\t    set dummy = null\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function Delay takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsdwd_delay_boss\" ) )\r\n\t    local unit area = LoadUnitHandle( udg_hash, id, StringHash( \"bsdwd_delay\" ) )\r\n\t    \r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t    if IsUnitDead( boss ) or not( udg_fightmod[0] ) then\r\n\t    \tcall RemoveUnit(area)\r\n\t\t\treturn\r\n\t    endif\r\n\t    call UnitAddAbility( area, 'A07O' )\r\n\t    set id = InvokeTimerWithUnit( area, \"bsdwd\", TICK, true, function DarkWarDamage )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bsdwdb\" ), boss )\r\n\t    \r\n\t    set boss = null\r\n\t    set area = null\r\n\tendfunction\r\n\t\r\n\tpublic function Spawn takes unit boss, real x, real y returns nothing\r\n\t\tlocal unit area \r\n\t\tlocal integer id\r\n\t\t\r\n\t\tset area = CreateUnit( GetOwningPlayer( boss ), 'u000', x, y, 270 )\r\n        \r\n        call IndicatorSystem_Create( INDICATOR_WARNING, x, y, AREA, DELAY, boss )\r\n        \r\n        set id = InvokeTimerWithUnit( area, \"bsdwd_delay\", DELAY, false, function Delay )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bsdwd_delay_boss\" ), boss )\r\n        \r\n        set area = null\r\n    endfunction\r\n\t\r\n\tprivate function DarkWarSpawn takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsdw\" ) )\r\n\t    local unit target = DeathSystem_GetRandomAliveHero()\r\n\t    \r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n             call Spawn( boss, GetUnitX( target ), GetUnitY( target ) )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bsdw\", bosscast(6), true, function DarkWarSpawn )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_DarkWarlock1 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_DarkWarlock1 )\r\n\tendfunction\r\n\r\nendscope",
