  "RunOnMapInit": false,
  "Script": "scope Blademaster3 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer DAMAGE = 100\r\n\t\tprivate constant integer BUFF_DURATION = 5\r\n\t\tprivate constant integer COOLDOWN = 6\r\n\t\tprivate constant real TRAP_CHECK_TICK = 0.5\r\n\t\tprivate constant string SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Orc\\\\MirrorImage\\\\MirrorImageDeathCaster.mdl\"\r\n\t\tprivate constant string TRAP_USE_ANIMATION = \"Abilities\\\\Spells\\\\Orc\\\\MirrorImage\\\\MirrorImageDeathCaster.mdl\"\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'e001' and GetUnitLifePercent(udg_DamageEventTarget) <= 80\r\n\tendfunction\r\n\t\r\n\tprivate function Blade2End takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bsbmd1\" ) )\r\n\t    local boolean l = false\r\n\t    local group g = CreateGroup()\r\n\t    local unit u\r\n\t    local effect indicator\r\n\t    local unit boss\r\n\t    \r\n\t    if IsUnitDead( dummy ) or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t    \tset boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsbmd1b\" ) )\r\n\t        call GroupEnumUnitsInRange( g, GetUnitX( dummy ), GetUnitY( dummy ), 128, null )\r\n\t        loop\r\n\t            set u = FirstOfGroup(g)\r\n\t            exitwhen u == null\r\n\t            if unitst( u, boss, \"enemy\" ) then\r\n\t                call DestroyEffect(AddSpecialEffectTarget( TRAP_USE_ANIMATION, u, \"origin\") )\r\n\t                call bufallst( boss, u, 'A06V', 0, 0, 0, 0, 'B011', \"bsbmd2\", BUFF_DURATION )\r\n\t                call UnitDamageTarget( boss, u, DAMAGE, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)\r\n\t                set l = true\r\n\t            endif\r\n\t            call GroupRemoveUnit(g,u)\r\n\t        endloop\r\n\t        if l then\r\n\t        \tset indicator = LoadEffectHandle( udg_hash, id, StringHash( \"bsbmd1i\" ) )\r\n\t        \tcall IndicatorSystem_Remove(indicator)\r\n\t            call RemoveUnit( dummy )\r\n\t            call DestroyTimer( GetExpiredTimer() )\r\n\t            call FlushChildHashtable( udg_hash, id )\r\n\t        endif\r\n\t    endif\r\n\t\r\n\t    call DestroyGroup( g )\r\n\t    set u = null\r\n\t    set g = null\r\n\t    set dummy = null\r\n\t    set indicator = null\r\n\tendfunction\r\n\t\r\n\tprivate function CreateTrap takes unit boss returns nothing\r\n\t\tlocal integer id\r\n\t    local effect indicator\r\n\t    local unit trap\r\n\t\r\n\t\tset trap = CreateUnit( GetOwningPlayer( boss ), 'u000', GetUnitX( boss ) + GetRandomReal(-900, 900), GetUnitY( boss ) + GetRandomReal(-400, 400), 270 )\r\n        call UnitAddAbility( trap, 'A0WA')\r\n        call DestroyEffect( AddSpecialEffectTarget( SPAWN_ANIMATION, trap, \"origin\") )\r\n\r\n        set indicator = IndicatorSystem_Create( INDICATOR_AIM, GetUnitX(trap), GetUnitY(trap), 128, 0, boss )\r\n        \r\n        set id = InvokeTimerWithUnit( trap, \"bsbmd1\", TRAP_CHECK_TICK, true, function Blade2End )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bsbmd1b\" ), boss )\r\n        call SaveEffectHandle( udg_hash, id, StringHash( \"bsbmd1i\" ), indicator )\r\n        \r\n        set indicator = null\r\n        set trap = null\r\n\tendfunction\r\n\t\r\n\tprivate function Blade2Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsbm3\" ) )\r\n\t\r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call CreateTrap(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal unit boss = udg_DamageEventTarget\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    \r\n\t    call CreateTrap(boss)\r\n\t    call InvokeTimerWithUnit( boss, \"bsbm3\", bosscast(COOLDOWN), true, function Blade2Cast )\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Blademaster3 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Blademaster3 )\r\n\tendfunction\r\n\r\nendscope",
