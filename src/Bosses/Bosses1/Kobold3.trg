  "Script": "scope Kobold3 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer COOLDOWN = 7\r\n\t\tprivate constant integer BOMB_SPAWN_DEVIATION = 300\r\n\t\tprivate constant real EXPLODE_DELAY = 2\r\n\t\tprivate constant real DAMAGE = 200\r\n\t\tprivate constant real AREA = 200\r\n\t\t\r\n\t\tprivate constant string SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Orc\\\\MirrorImage\\\\MirrorImageDeathCaster.mdl\"\r\n\t\tprivate constant string EXPLODE_ANIMATION = \"Objects\\\\Spawnmodels\\\\Human\\\\HCancelDeath\\\\HCancelDeath.mdl\"\r\n\t\tprivate constant real BOMB_SIZE_SCALE = 2\r\n\t\tprivate constant integer BOMB_MODEL_ABILITY = 'A13P'\r\n\t\t\r\n\t\tprivate location unitLoc = null\r\n\t\tprivate location spawnLoc = null\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n00P' and GetUnitLifePercent( udg_DamageEventTarget ) <= 75\r\n\tendfunction\r\n\t\r\n\tprivate function Cobold3End takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bscb2\" ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bscb2c\" ) )\r\n\r\n\t    call GroupAoE(boss, GetUnitX( dummy ), GetUnitY( dummy ), DAMAGE, AREA, TARGET_ENEMY, EXPLODE_ANIMATION, null)\r\n\t    call RemoveUnit( dummy )\r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\r\n\t    set dummy = null\r\n\t    set boss = null\r\n\tendfunction \r\n\t\r\n\tprivate function CreateBomb takes unit boss returns nothing\r\n\t\tlocal integer id\r\n\t\tlocal unit bomb\r\n\r\n\t\t//globals\r\n\t\tset unitLoc = GetUnitLoc(boss)\r\n\t    set spawnLoc = PolarProjectionBJ( unitLoc, BOMB_SPAWN_DEVIATION, GetRandomDirectionDeg() )\r\n\t\r\n    \tcall IndicatorSystem_Create( INDICATOR_WARNING, GetLocationX(spawnLoc), GetLocationY(spawnLoc), AREA, EXPLODE_DELAY, boss )\r\n        set bomb = CreateUnitAtLoc( GetOwningPlayer( boss ), 'u000', spawnLoc, 270 )\r\n        call UnitAddAbility( bomb, BOMB_MODEL_ABILITY )\r\n        call SetUnitScale( bomb, BOMB_SIZE_SCALE, BOMB_SIZE_SCALE, BOMB_SIZE_SCALE )\r\n        call DestroyEffect( AddSpecialEffectLoc( SPAWN_ANIMATION, spawnLoc ) )\r\n\r\n        set id = InvokeTimerWithUnit( bomb, \"bscb2\", EXPLODE_DELAY, false, function Cobold3End )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bscb2c\" ), boss )\r\n\tendfunction\r\n\t\r\n\tprivate function Cobold3Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bscb1\" ) )\r\n\t\r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t    else\r\n\t    \tcall CreateBomb(boss)\r\n\t    endif\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal unit boss = udg_DamageEventTarget\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call CreateBomb(boss)\r\n\t\tcall InvokeTimerWithUnit( boss, \"bscb1\", bosscast(COOLDOWN), true, function Cobold3Cast )\r\n\t\t\r\n\t\tset boss = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Kobold3 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Kobold3 )\r\n\tendfunction\r\n\r\nendscope",
