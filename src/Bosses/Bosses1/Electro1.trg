  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Electro1 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer AREA_DAMAGE = 35\r\n\t\tprivate constant integer AREA_SIZE = 120\r\n\t\tprivate constant integer AREA_DURATION = 60\r\n\t\tprivate constant integer AREA_SPAWN_DEVIATION = 400\r\n\t\tprivate constant integer AREA_PARTICLE_ABILITY = 'A072'\r\n\t\tprivate constant real AREA_COOLDOWN = 1\r\n\t\tprivate constant string AREA_SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Other\\\\Monsoon\\\\MonsoonBoltTarget.mdl\"\r\n\t\t\r\n\t\tpublic constant real SPAWN_COOLDOWN = 4\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId( udg_DamageEventTarget ) == 'n00Z'\r\n\tendfunction\r\n\t\r\n\tprivate function Electro1Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bsel2\" ))\r\n\t    local unit caster = LoadUnitHandle( udg_hash, id, StringHash( \"bsel2c\" ) )\r\n\t    local group g = CreateGroup()\r\n\t    local unit u\r\n\t    \r\n\t    if GetUnitState( dummy, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call GroupEnumUnitsInRange( g, GetUnitX( dummy ), GetUnitY( dummy ), AREA_SIZE, null )\r\n\t        loop\r\n\t            set u = FirstOfGroup(g)\r\n\t            exitwhen u == null\r\n\t            if unitst( u, caster, \"enemy\" ) then\r\n\t                call UnitDamageTarget( caster, u, AREA_DAMAGE, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS )\r\n\t            endif\r\n\t            call GroupRemoveUnit(g,u)\r\n\t        endloop\r\n\t    endif\r\n\t    \r\n\t    call DestroyGroup( g )\r\n\t    set caster = null\r\n\t    set u = null\r\n\t    set g = null\r\n\t    set dummy = null\r\n\tendfunction\r\n\t\r\n\tfunction Electro_CreateField takes unit boss, real x, real y, real duration, boolean spawnIgnore returns nothing\r\n\t\tlocal integer id\r\n\t\tlocal unit target\r\n\t\t\r\n\t\tif spawnIgnore == false and GetRandomInt(1, 5) == 1 then\r\n\t\t\tset target = DeathSystem_GetRandomAliveHero()\r\n\t\t\tif target != null then\r\n\t\t\t\tset x = GetUnitX(target)\r\n\t\t\t\tset y = GetUnitY(target)\r\n\t\t\tendif\r\n\t\tendif\r\n\t\t\r\n\t\tcall IndicatorSystem_Create( INDICATOR_AIM, x, y, AREA_SIZE, duration, boss )\r\n\t\r\n\t    set bj_lastCreatedUnit = CreateUnit( GetOwningPlayer( boss ), 'u000', x, y, 270 )\r\n\t    call UnitAddAbility( bj_lastCreatedUnit, AREA_PARTICLE_ABILITY)\r\n\t    call UnitApplyTimedLife( bj_lastCreatedUnit, 'BTLF', duration)\r\n\t    call DestroyEffect( AddSpecialEffectTarget( AREA_SPAWN_ANIMATION, bj_lastCreatedUnit, \"origin\") )\r\n\t\r\n\t    set id = InvokeTimerWithUnit( bj_lastCreatedUnit, \"bsel2\", AREA_COOLDOWN, true, function Electro1Cast )\r\n\t    call SaveUnitHandle( udg_hash, id, StringHash( \"bsel2c\" ), boss )\r\n\t    \r\n\t    set target = null\r\n\tendfunction\r\n\t\r\n\tfunction ElectroCast1 takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsel1\" ))\r\n\t    \r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t    \tcall Electro_CreateField( boss, GetUnitX( boss ) + GetRandomReal(-AREA_SPAWN_DEVIATION, AREA_SPAWN_DEVIATION), GetUnitY( boss ) + GetRandomReal(-AREA_SPAWN_DEVIATION, AREA_SPAWN_DEVIATION), AREA_DURATION, false )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bsel1\", bosscast(SPAWN_COOLDOWN), true, function ElectroCast1 )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Electro1 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Electro1 )\r\n\tendfunction\r\n\r\nendscope",
