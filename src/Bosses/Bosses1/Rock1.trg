  "Id": 50333426,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Rock1 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer SPAWN_COOLDOWN = 5\r\n\t\tprivate constant integer SPAWN_DEVIATION = 400\r\n\t\tprivate constant string SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Orc\\\\AncestralSpirit\\\\AncestralSpiritCaster.mdl\"\r\n\t\tprivate constant integer ATTACK_GAIN = 10\r\n\t\t\r\n\t\tpublic trigger Trigger2 = null\r\n\t\tprivate unit Boss = null\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n03J'\r\n\tendfunction\r\n\t\r\n\tpublic function SpawnPebble takes unit boss, real x, real y returns nothing\r\n\t    local integer i = 0\r\n\t    local integer rand \r\n\t    local item it\r\n\t\r\n\t\tset rand = GetRandomInt( 0, 2 )\r\n\t\tloop\r\n            exitwhen i > 30\r\n            set it = CreateItem( 'III1' + rand, x, y )\r\n            if RectContainsItem( it, udg_Boss_Rect ) then\r\n                call spectime( SPAWN_ANIMATION, x, y, 2 )\r\n                call BlzSetUnitBaseDamage( boss, BlzGetUnitBaseDamage(boss, 0) + ATTACK_GAIN, 0 )\r\n                exitwhen true\r\n            else\r\n                call RemoveItem( it )\r\n            endif\r\n            set i = i + 1\r\n        endloop\r\n        \r\n        set it = null\r\n\tendfunction\r\n\t\r\n\tprivate function Rock1Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsrk\" ) )\r\n\t    \r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call SpawnPebble(boss, GetUnitX( boss ) + GetRandomReal( -SPAWN_DEVIATION, SPAWN_DEVIATION ), GetUnitY( boss ) + GetRandomReal( -SPAWN_DEVIATION, SPAWN_DEVIATION ) )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer id = GetHandleId( udg_DamageEventTarget )\r\n\t\r\n\t\tset Boss = udg_DamageEventTarget\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\r\n\t    if LoadTimerHandle( udg_hash, id, StringHash( \"bsrk\" ) ) == null  then\r\n\t        call SaveTimerHandle( udg_hash, id, StringHash( \"bsrk\" ), CreateTimer() )\r\n\t    endif\r\n\t\tset id = GetHandleId( LoadTimerHandle( udg_hash, id, StringHash( \"bsrk\" ) ) ) \r\n\t    call SaveUnitHandle( udg_hash, id, StringHash( \"bsrk\" ), udg_DamageEventTarget )\r\n\t\tcall TimerStart( LoadTimerHandle( udg_hash, GetHandleId( udg_DamageEventTarget ), StringHash( \"bsrk\" ) ), bosscast(SPAWN_COOLDOWN), true, function Rock1Cast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnGain_Condition takes nothing returns boolean\r\n\t    return BlzGetItemAbility( GetManipulatedItem(), 'A1JM' ) != null//IsPebble\r\n\tendfunction\r\n\t\r\n\tprivate function OnGain takes nothing returns nothing\r\n\t\t//call BJDebugMsg(\"Boss: \" + GetUnitName(Boss))\r\n\t\tif Boss != null then\r\n\t\t\tcall BlzSetUnitBaseDamage( Boss, BlzGetUnitBaseDamage(Boss, 0) - ATTACK_GAIN, 0 )\r\n\t\tendif\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Rock1 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Rock1 )\r\n\t    \r\n\t    set Trigger2 = CreateNativeEvent( EVENT_PLAYER_UNIT_PICKUP_ITEM, function OnGain, function OnGain_Condition )\r\n\t    call DisableTrigger( Trigger2 )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}