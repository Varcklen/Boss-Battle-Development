  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope DrunkMan1 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer ATTACK_GAIN = 5\r\n\t\tprivate constant integer ATTACK_GAIN_COOLDOWN = 10\r\n\t\tprivate constant string ATTACK_GAIN_ANIMATION = \"Abilities\\\\Spells\\\\Items\\\\AIam\\\\AIamTarget.mdl\"\r\n\t\t\r\n\t\tprivate constant integer HAZE_COOLDOWN = 5\r\n\t\tprivate constant integer HAZE_SEARCH_RANGE = 900\r\n\t\tprivate constant integer HAZE_STUN_CHANCE = 25\r\n\t\tprivate constant integer HAZE_ABILITY = 'A0XQ'\r\n\t\tprivate constant real STUN_DURATION = 1\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n02U'\r\n\tendfunction\r\n\t\r\n\tprivate function PowerUp takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsdm2\" ) )\r\n\t\r\n\t    if IsUnitDead( boss ) or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call DestroyEffect( AddSpecialEffect( ATTACK_GAIN_ANIMATION, GetUnitX( boss ), GetUnitY( boss ) ) )\r\n\t    \tcall BlzSetUnitBaseDamage( boss, BlzGetUnitBaseDamage(boss, 0) + ATTACK_GAIN, 0 )\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function DrunkMan1Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsdm1\" ) )\r\n\t    local unit u = randomtarget( boss, HAZE_SEARCH_RANGE, \"enemy\", 0, 0, 0 )\r\n\t\r\n\t    if GetUnitState( boss, UNIT_STATE_LIFE) <= 0.405 or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    elseif u != null then\r\n\t        call SetUnitAnimation( boss, \"attack\" )    \r\n\t        call dummyspawn( boss, 1, HAZE_ABILITY, 0, 0 )\r\n\t        call IssueTargetOrder( bj_lastCreatedUnit, \"drunkenhaze\", u )\r\n\t    endif\r\n\t    \r\n\t    set u = null\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call InvokeTimerWithUnit( udg_DamageEventTarget, \"bsdm1\", bosscast(HAZE_COOLDOWN), true, function DrunkMan1Cast )\r\n\t    call InvokeTimerWithUnit( udg_DamageEventTarget, \"bsdm2\", bosscast(ATTACK_GAIN_COOLDOWN), true, function PowerUp )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnCast_Condition takes nothing returns boolean\r\n\t\treturn GetUnitAbilityLevel( GetSpellAbilityUnit(), 'BNdh') > 0 and LuckChance(GetSpellAbilityUnit(), HAZE_STUN_CHANCE)\r\n\tendfunction\r\n\t\r\n\tprivate function OnCast takes nothing returns nothing\r\n\t\tcall UnitStun(GetSpellAbilityUnit(), GetSpellAbilityUnit(), STUN_DURATION )\r\n\tendfunction\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_DrunkMan1 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_DrunkMan1 )\r\n\t    call CreateNativeEvent( EVENT_PLAYER_UNIT_SPELL_EFFECT, function OnCast, function OnCast_Condition )\r\n\tendfunction\r\n\r\nendscope",
