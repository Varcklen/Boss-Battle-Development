  "RunOnMapInit": false,
  "Script": "scope Rock2 initializer init\r\n\r\n\tglobals\r\n\t\tprivate constant real DURATION = 3\r\n\t\tprivate constant real TICK = 0.5\r\n\t\tprivate constant real TICK_AMOUNT = DURATION / TICK\r\n\t\tprivate constant integer DAMAGE = 40\r\n\t\tprivate constant integer AREA = 800\r\n\t\tprivate constant integer SPAWN_DEVIATION = 400\r\n\t\tprivate constant string ANIMATION = \"Abilities\\\\Spells\\\\Human\\\\Thunderclap\\\\ThunderClapCaster.mdl\"\r\n\t\tprivate constant real ANIMATION_SIZE = AREA / 300\r\n\t\r\n\t\tpublic trigger Trigger2 = null\r\n\tendglobals\r\n\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n03J' and GetUnitLifePercent(udg_DamageEventTarget) <= 80\r\n\tendfunction\r\n\t\r\n\tprivate function condition2 takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n03J' and GetUnitLifePercent(udg_DamageEventTarget) <= 40\r\n\tendfunction\r\n\t\r\n\tprivate function Rock2Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsrk2\" ) )\r\n\t    local real counter = LoadReal( udg_hash, id, StringHash( \"bsrk2\" ) ) + 1\r\n\t    local effect particle\r\n\r\n\t    if IsUnitDead(boss) or not( udg_fightmod[0] ) or counter > TICK_AMOUNT then\r\n\t    \tcall pausest( boss, -1 )\r\n\t    \tcall SetUnitTimeScalePercent( boss, 100 )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t    \tcall SetUnitAnimation( boss, \"spell slam\" )\r\n\t        call GroupAoE(boss, GetUnitX( boss ), GetUnitY( boss ), DAMAGE, AREA, TARGET_ENEMY, null, null)\r\n\t        call Rock1_SpawnPebble(boss, GetUnitX( boss ) + GetRandomReal( -SPAWN_DEVIATION, SPAWN_DEVIATION ), GetUnitY( boss ) + GetRandomReal( -SPAWN_DEVIATION, SPAWN_DEVIATION ) )\r\n\t        call SaveReal( udg_hash, id, StringHash( \"bsrk2\" ), counter )\r\n\t        \r\n\t        set particle = AddSpecialEffect( ANIMATION, GetUnitX( boss ), GetUnitY( boss ) )\r\n\t        call BlzSetSpecialEffectScale( particle, ANIMATION_SIZE )\r\n\t        call DestroyEffect( particle )\r\n\t    endif\r\n\t    \r\n\t    set particle = null\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t\r\n\t\tcall pausest( udg_DamageEventTarget, 1 )\r\n\t\tcall SetUnitTimeScalePercent( udg_DamageEventTarget, 150 )\r\n\t\tcall CommonTimer_CreateAnotherCopy()\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bsrk2\", TICK, true, function Rock2Cast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Rock2 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Rock2 )\r\n\t    \r\n\t    set Trigger2 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition2 )\r\n\t    call DisableTrigger( Trigger2 )\r\n\tendfunction\r\n\r\nendscope",
