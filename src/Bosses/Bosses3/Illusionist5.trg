  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Illusionist5 initializer init\r\n\r\n\tglobals\r\n\t\tprivate constant string ANIMATION = \"Abilities\\\\Spells\\\\Undead\\\\ReplenishMana\\\\ReplenishManaCasterOverhead.mdl\"\r\n\t\tprivate constant integer EFFECT = 'A1EY'\r\n\t\tprivate constant integer BUFF = 'B0AK'\r\n\t\tprivate constant integer DELAY = 3\r\n\t\tprivate constant integer COOLDOWN = 12\r\n\tendglobals\r\n\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'h020' and GetUnitLifePercent(udg_DamageEventTarget) <= 80\r\n\tendfunction\r\n\r\n\tprivate function EndSwap takes nothing returns nothing\r\n\t\tlocal integer id = GetHandleId( GetExpiredTimer() )\r\n\t\tlocal unit hero = LoadUnitHandle( udg_hash, id, StringHash(\"illusionist_hp_swap_hero\") )\r\n\t\tlocal real hp\r\n\t    local real mp\r\n\t\t\r\n\t\tif IsUnitAlive(hero) and UnitHasBuffBJ(hero, BUFF) then\r\n\t\t\tset hp = GetUnitState( hero, UNIT_STATE_LIFE)/GetUnitState( hero, UNIT_STATE_MAX_LIFE)\r\n\t\t\tset mp = GetUnitState( hero, UNIT_STATE_MANA)/GetUnitState( hero, UNIT_STATE_MAX_MANA)\r\n\t\t\tcall SetUnitState( hero, UNIT_STATE_LIFE, GetUnitState( hero, UNIT_STATE_MAX_LIFE) * mp )\r\n\t\t\tcall SetUnitState( hero, UNIT_STATE_MANA, GetUnitState( hero, UNIT_STATE_MAX_MANA) * hp )\r\n\t        call DestroyEffect( AddSpecialEffectTarget(ANIMATION, hero, \"origin\") )\r\n\t\tendif\r\n\t\tcall UnitRemoveAbility( hero, EFFECT )\r\n\t    call UnitRemoveAbility( hero, BUFF )\r\n\t\t\r\n\t\tcall FlushChildHashtable( udg_hash, id )\r\n\t\t\r\n\t\tset hero = null\r\n\tendfunction\r\n\r\n\tprivate function StartHealthManaSwap takes unit hero returns nothing\r\n\t\tlocal integer id\r\n\t\r\n\t\tcall UnitAddAbility( hero, EFFECT )\r\n\t\tset id = InvokeTimerWithUnit( hero, \"illusionist_hp_swap\", DELAY, false, function EndSwap )\r\n\t\tcall SaveUnitHandle( udg_hash, id, StringHash(\"illusionist_hp_swap_hero\"), hero )\r\n\tendfunction\r\n\t\r\n\tprivate function Swap takes unit boss returns nothing\r\n\t\tlocal integer i = 1\r\n\t\tlocal unit hero\r\n\t\r\n\t\tloop\r\n\t        exitwhen i > 4\r\n\t        set hero = udg_hero[i]\r\n\t\t\tif IsUnitAlive(hero) and unitst( hero, boss, \"enemy\" ) then\r\n\t\t\t\tcall StartHealthManaSwap(hero)\r\n\t\t\tendif\r\n\t        set i = i + 1\r\n\t    endloop\r\n\t    set hero = null\r\n\tendfunction\r\n\r\n\t//===========================================================================\r\n\tprivate function SwapUse takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"boss_illusionist_swap_cooldown\" ) )\r\n\r\n\t    if IsUnitDead( boss ) or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t        call Swap(boss)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t\tlocal unit boss = udg_DamageEventTarget\r\n\t\t\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call Swap(boss)\r\n\t    call InvokeTimerWithUnit( boss, \"boss_illusionist_swap_cooldown\", bosscast(COOLDOWN), true, function SwapUse )\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Illusionist5 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Illusionist5 )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}