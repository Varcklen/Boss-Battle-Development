  "Id": 50333454,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Sheep2 initializer init\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'n007' and GetUnitLifePercent(udg_DamageEventTarget) <= 75.\r\n\tendfunction\r\n\t\r\n\tprivate function SheepHealthChange takes nothing returns nothing\r\n\t\tlocal integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local group sheeps = LoadGroupHandle( udg_hash, id, StringHash( \"boss_sheep_summons_group\" ) )\r\n\t    local real percent = LoadReal(udg_hash, id, StringHash(\"boss_sheep_summons_percent\") )\r\n\t    local unit u\r\n\t    \r\n\t    loop\r\n\t    \tset u = FirstOfGroup(sheeps)\r\n\t    \texitwhen u == null\r\n\t    \tcall SetUnitState(u, UNIT_STATE_LIFE, GetUnitState(u, UNIT_STATE_MAX_LIFE) * percent)\r\n\t    \tcall GroupRemoveUnit(sheeps, u)\r\n\t    endloop\r\n\t    \r\n\t    call DestroyGroup(sheeps)\r\n\t    set sheeps = null\r\n\t    set u = null\r\n\tendfunction\r\n\r\n\tpublic function SheepSummon takes unit boss returns nothing\r\n\t    local integer i = 1\r\n\t    local real percent = GetUnitState(boss, UNIT_STATE_LIFE) / RMaxBJ( 1, GetUnitState(boss, UNIT_STATE_MAX_LIFE) )\r\n\t    local unit newUnit\r\n\t    local group sheeps = CreateGroup()\r\n\t    local integer id\r\n\t\r\n\t\t/*call BJDebugMsg(\"UNIT_STATE_LIFE: \" + R2S(GetUnitState(boss, UNIT_STATE_LIFE)) )\r\n\t\tcall BJDebugMsg(\"UNIT_STATE_MAX_LIFE: \" + R2S(GetUnitState(boss, UNIT_STATE_MAX_LIFE)) )\r\n\t\tcall BJDebugMsg(\"percent: \" + R2S(percent) )*/\r\n\t\t\r\n\t\t//================ Skip Hero Action ====================\r\n\t\tset i = 1\r\n\t    loop\r\n\t        exitwhen i > 4\r\n\t        if IsUnitAlive( udg_hero[i]) then\r\n\t            call IssueImmediateOrder( udg_hero[i], \"stop\" )\r\n\t        endif\r\n\t        set i = i + 1\r\n\t    endloop\r\n\t    \r\n\t    //================ Summon ====================\r\n\t    call DestroyEffect(AddSpecialEffectTarget( \"Abilities\\\\Spells\\\\Other\\\\Silence\\\\SilenceAreaBirth.mdl\", boss, \"origin\") )\r\n\t    set i = 1\r\n\t    loop\r\n\t        exitwhen i > 12\r\n            set newUnit = CreateUnit( GetOwningPlayer( boss ), 'n00E', GetUnitX( boss ) + GetRandomReal( -500, 500 ), GetUnitY( boss ) + GetRandomReal( -500, 500 ), GetRandomReal( 0, 360 ) )\r\n            call UnitAddAbility( newUnit, 'A0D8')\r\n            call BlzSetUnitMaxHP( newUnit, BlzGetUnitMaxHP(newUnit) + 100 )\r\n            call GroupAddUnit(sheeps, newUnit )\r\n            \r\n            /*if i == 1 then\r\n            \tcall BJDebugMsg(\"------------\" )\r\n\t            call BJDebugMsg(\"UNIT_STATE_LIFE newUnit: \" + R2S(GetUnitState(newUnit, UNIT_STATE_LIFE)) )\r\n\t\t\t\tcall BJDebugMsg(\"UNIT_STATE_MAX_LIFE newUnit: \" + R2S(GetUnitState(newUnit, UNIT_STATE_MAX_LIFE)) )\r\n\t\t\t\tcall BJDebugMsg(\"percent: \" + R2S(percent) )\r\n\t\t\tendif*/\r\n            if not( RectContainsUnit( udg_Boss_Rect, newUnit) ) then\r\n                call SetUnitPositionLoc( newUnit, GetRectCenter( udg_Boss_Rect ) )\r\n            endif\r\n\t        set i = i + 1\r\n\t    endloop\r\n\t    \r\n\t    set id = InvokeTimerWithUnit( boss, \"boss_sheep_summons\", 0.01, false, function SheepHealthChange )\r\n\t    call SaveReal(udg_hash, id, StringHash(\"boss_sheep_summons_percent\"), percent )\r\n\t    call SaveGroupHandle(udg_hash, id, StringHash(\"boss_sheep_summons_group\"), sheeps )\r\n\t    \r\n\t    //================ Boss Move ====================\r\n\t    call SetUnitPosition( boss, GetUnitX( boss ) + GetRandomReal( -200, 200 ), GetUnitY( boss ) + GetRandomReal( -200, 200 ) )\r\n\t    if not( RectContainsUnit( udg_Boss_Rect, boss) ) then\r\n\t        call SetUnitPositionLoc( boss, GetRectCenter( udg_Boss_Rect ) )\r\n\t    endif\r\n\t    \r\n\t    set sheeps = null\r\n\t    set newUnit = null\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call SheepSummon(udg_DamageEventTarget)\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Sheep2 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Sheep2 )\r\n\tendfunction\r\n\t\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}