{
  "Id": 50333475,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope Illusionist2 initializer init\r\n\t\r\n\tglobals\r\n\t\tprivate constant string \tDANGER_AREA_ANIMATION = \"Abilities\\\\Spells\\\\Undead\\\\DeathCoil\\\\DeathCoilSpecialArt.mdl\"\r\n\t\tprivate constant string \tFRIENDLY_AREA_ANIMATION = \"Abilities\\\\Spells\\\\Human\\\\Resurrect\\\\ResurrectTarget.mdl\"\r\n\t\tprivate constant integer \tAREA_ANIMATION_DEVIATION = 140\r\n\t\tprivate constant integer \tAREA_ANIMATION_AMOUNT = 3\r\n\t\tprivate constant integer \tAREA_ANIMATION_ANGLE_DEVIATION = 360 / AREA_ANIMATION_AMOUNT\r\n\t\tprivate constant integer \tAREA_ANIMATION_STARTING_POINT_DEGREE = 90\r\n\t\t\r\n\t\tprivate constant integer \tCOOLDOWN = 5\r\n\t\tprivate constant integer \tSPAWN_DEVIATION_RANGE = 300\r\n\t\tprivate constant integer \tBASE_SPAWN_AMOUNT = 2\r\n\t\tprivate constant real \t\tSPAWN_ANGLE = 90\r\n\t\tprivate constant real \t\tSPAWN_EXTRA_LINE_ADDITIONAL_RANGE_MULTIPLIER = 0.85\r\n\t\tprivate constant real \t\tSPAWN_EXTRA_LINE_EXTRA_ANGLE = 45\r\n\t\tprivate constant integer \tSPAWN_EXTRA_LINE_AFTER_AMOUNT = 2\r\n\t\t\r\n\t\tprivate constant integer \tEXPLODE_DELAY = 3\r\n\t\tprivate constant integer \tAREA_SIZE = 200\r\n\t\tprivate constant integer \tDAMAGE = 300\r\n\t\tprivate constant integer \tHP_HEAL = 100\r\n\t\tprivate constant integer \tMP_HEAL = 30\r\n\tendglobals\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId( udg_DamageEventTarget ) == 'h020'\r\n\tendfunction\r\n\t\r\n\t//Areas\r\n\t//===========================================================================\r\n\tprivate function AreaAnimation takes unit dummy, string animation returns nothing\r\n\t\tlocal integer i\r\n\t\tlocal real angle\r\n\t\tlocal location effectLoc\r\n\t\tlocal location dummyLoc = GetUnitLoc( dummy )\r\n\t\t\r\n\t\tset i = 0\r\n\t\tloop\r\n\t\t\texitwhen i >= AREA_ANIMATION_AMOUNT\r\n\t\t\tset angle = AREA_ANIMATION_STARTING_POINT_DEGREE + AREA_ANIMATION_ANGLE_DEVIATION * i\r\n\t\t\tset effectLoc = PolarProjectionBJ( dummyLoc, AREA_ANIMATION_DEVIATION, angle )\r\n\t\t\tcall DestroyEffect( AddSpecialEffectLoc( animation, effectLoc ) )\r\n\t\t\tset i = i + 1\r\n\t\tendloop\r\n\t\r\n\t    call RemoveLocation(effectLoc)\r\n\t    call RemoveLocation(dummyLoc)\r\n\t    set effectLoc = null\r\n\t    set dummyLoc = null\r\n\tendfunction\r\n\t\r\n\tprivate function UnitEffect takes unit boss, unit target, boolean isFriendly, boolean isTwisted returns nothing\r\n\t\tlocal boolean isDamage = ( isFriendly == false and isTwisted == false ) or ( isFriendly and isTwisted )\r\n\t\r\n\t\tif isDamage then\r\n            call UnitDamageTarget( boss, target, DAMAGE, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)\r\n        else\r\n            call healst( target, null, HP_HEAL * SpellPower_GetBossSpellPower() )\r\n            call manast( target, null, MP_HEAL * SpellPower_GetBossSpellPower() )\r\n        endif\r\n\tendfunction\r\n\t\r\n\tprivate function Illusionist2End takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsil2u\" ) )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bsil2\" ) )\r\n\t    local boolean isTwisted = LoadBoolean( udg_hash, id, StringHash( \"bsil2\" ) )\r\n\t    local group g = CreateGroup()\r\n\t    local unit u\r\n\t    local integer i\r\n\t    \r\n\t    call AreaAnimation(dummy, DANGER_AREA_ANIMATION)\r\n\r\n\t    call GroupEnumUnitsInRange( g, GetUnitX( dummy ), GetUnitY( dummy ), AREA_SIZE, null )\r\n\t    loop\r\n\t        set u = FirstOfGroup(g)\r\n\t        exitwhen u == null\r\n\t        if unitst( u, boss, \"enemy\" ) then\r\n\t            call UnitEffect(boss, u, false, isTwisted)\r\n\t        endif\r\n\t        call GroupRemoveUnit(g,u)\r\n\t    endloop\r\n\t    \r\n\t    call RemoveUnit( dummy )\r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t    \r\n\t    call DestroyGroup( g )\r\n\t    set u = null\r\n\t    set g = null\r\n\t    set boss = null\r\n\t    set dummy = null\r\n\tendfunction \r\n\t\r\n\tprivate function Illusionist2HEnd takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsil3u\" ) )\r\n\t    local unit dummy = LoadUnitHandle( udg_hash, id, StringHash( \"bsil3\" ) )\r\n\t    local boolean isTwisted = LoadBoolean( udg_hash, id, StringHash( \"bsil3\" ) )\r\n\t    local group g = CreateGroup()\r\n\t    local unit u\r\n\t    \r\n\t    call AreaAnimation(dummy, FRIENDLY_AREA_ANIMATION)\r\n\t    call GroupEnumUnitsInRange( g, GetUnitX( dummy ), GetUnitY( dummy ), AREA_SIZE, null )\r\n\t    loop\r\n\t        set u = FirstOfGroup(g)\r\n\t        exitwhen u == null\r\n\t        if unitst( u, boss, \"enemy\" ) then\r\n\t            call UnitEffect(boss, u, true, isTwisted)\r\n\t        endif\r\n\t        call GroupRemoveUnit(g,u)\r\n\t    endloop\r\n\t    \r\n\t    call RemoveUnit( dummy )\r\n\t    call FlushChildHashtable( udg_hash, id )\r\n\t    \r\n\t    call DestroyGroup( g )\r\n\t    set u = null\r\n\t    set g = null\r\n\t    set boss = null\r\n\t    set dummy = null\r\n\tendfunction \r\n\t\r\n\tprivate function SpawnDangerArea takes unit boss, location spawnLoc, boolean isTwisted returns nothing\r\n\t\tlocal integer id \r\n\t\r\n\t\tset bj_lastCreatedUnit = CreateUnitAtLoc( GetOwningPlayer( boss ), 'u000', spawnLoc, 270 )\r\n        call IndicatorSystem_Create( INDICATOR_SKULL, GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit), AREA_SIZE, bosscast(EXPLODE_DELAY), boss )\r\n        \r\n        set id = InvokeTimerWithUnit( bj_lastCreatedUnit, \"bsil2\", bosscast(EXPLODE_DELAY), false, function Illusionist2End )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bsil2u\" ), boss )\r\n    \tcall SaveBoolean( udg_hash, id, StringHash( \"bsil2\" ), isTwisted )\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnFriendlyArea takes unit boss, location spawnLoc, boolean isTwisted returns nothing\r\n\t\tlocal integer id \r\n\t\tlocal real areaMultiplier = AREA_SIZE / 90.\r\n\t\r\n\t\tset bj_lastCreatedUnit = CreateUnitAtLoc( GetOwningPlayer( boss ), 'u000', spawnLoc, 270 )\r\n        call SetUnitScale(bj_lastCreatedUnit, areaMultiplier, areaMultiplier, areaMultiplier )\r\n        call UnitAddAbility( bj_lastCreatedUnit, 'A0BY')\r\n        \r\n        set id = InvokeTimerWithUnit( bj_lastCreatedUnit, \"bsil3\", bosscast(EXPLODE_DELAY), false, function Illusionist2HEnd )\r\n        call SaveUnitHandle( udg_hash, id, StringHash( \"bsil3u\" ), boss )\r\n    \tcall SaveBoolean( udg_hash, id, StringHash( \"bsil3\" ), isTwisted )\r\n\tendfunction\r\n\t\r\n\tprivate function SpawnArea takes unit boss, location spawnLoc, boolean isFriendly, boolean isTwisted returns nothing\r\n\t\tif isFriendly then\r\n\t\t\tcall SpawnFriendlyArea( boss, spawnLoc, isTwisted ) \r\n\t\t\treturn\r\n\t\tendif\r\n\t\tcall SpawnDangerArea( boss, spawnLoc, isTwisted )\r\n\tendfunction\r\n\t\r\n\t//AreaSpawn\r\n\t//===========================================================================\r\n\tprivate function AreaSpawn takes unit boss, boolean isTwisted returns nothing\r\n\t\tlocal integer extraAreas = ( 1 + LoadInteger(udg_hash, GetHandleId(boss), StringHash( \"boss_illusionist_extra_area\" ) ) ) * 2\r\n\t\tlocal integer i\r\n\t\tlocal real angle = GetRandomDirectionDeg()\r\n\t\tlocal real range\r\n\t\tlocal location bossLoc = GetUnitLoc(boss)\r\n\t\tlocal location spawnLoc\r\n\t\tlocal boolean isFriendly = true\r\n\t\tlocal integer line\r\n\t\t//local integer switch\r\n\t\t\r\n\t\t//call BJDebugMsg(\"==================\")\r\n\t\tset range = SPAWN_DEVIATION_RANGE\r\n\t\tset i = 1\r\n\t\tset line = 0\r\n\t\t//set switch = 0\r\n\t\tloop\r\n\t\t\texitwhen i > extraAreas\r\n\t\t\t//call BJDebugMsg(\"---------------------------\")\r\n\t\t\tif angle > 360 then\r\n\t\t\t\tset angle = angle - 360\r\n\t\t\tendif\r\n\t\t\tset line = line + 1\r\n\t\t\t//set switch = switch + 1\r\n\t\t\t//call BJDebugMsg(\"line: \" + R2S(line))\r\n\t\t\t/*call BJDebugMsg(\"switch: \" + R2S(switch))\r\n\t\t\tif switch > BASE_SPAWN_AMOUNT then\r\n\t\t\t\tcall BJDebugMsg(\"switch\")\r\n\t\t\t\tset switch = switch - BASE_SPAWN_AMOUNT\r\n\t\t\t\tset angle = angle + EXTRA_SWITCH\r\n\t\t\tendif*/\r\n\t\t\tif line > BASE_SPAWN_AMOUNT * SPAWN_EXTRA_LINE_AFTER_AMOUNT then\r\n\t\t\t\t//call BJDebugMsg(\"line\")\r\n\t\t\t\tset line = line - BASE_SPAWN_AMOUNT * SPAWN_EXTRA_LINE_AFTER_AMOUNT\r\n\t\t\t\tset range = range + SPAWN_DEVIATION_RANGE * SPAWN_EXTRA_LINE_ADDITIONAL_RANGE_MULTIPLIER\r\n\t\t\t\tset angle = angle + SPAWN_EXTRA_LINE_EXTRA_ANGLE\r\n\t\t\tendif\r\n\t\t\tset spawnLoc = PolarProjectionBJ( bossLoc, range, angle )\r\n\t\t\tif RectContainsLoc(udg_Boss_Rect, spawnLoc) then\r\n\t\t\t\tcall SpawnArea( boss, spawnLoc, isFriendly, isTwisted )\r\n\t\t\tendif\r\n\t\t\t\r\n\t\t\t//call BJDebugMsg(\"range: \" + R2S(range))\r\n\t\t\t//call BJDebugMsg(\"angle: \" + R2S(angle))\r\n\t\t\t\r\n\t\t\tset isFriendly = isFriendly == false\r\n\t\t\tset angle = angle + SPAWN_ANGLE\r\n\t\t\tset i = i + 1\r\n\t\tendloop\r\n\t\tcall SpawnArea( boss, null/*location spawnLoc*/, isFriendly, isTwisted ) //500\r\n\t\t\r\n\t\t\r\n\t\tcall RemoveLocation(bossLoc)\r\n\t    call RemoveLocation(spawnLoc)\r\n\t    set bossLoc = null\r\n\t    set spawnLoc = null\r\n\tendfunction\r\n\t\r\n\tprivate function Illusionist2Cast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local integer id1\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"bsil1\" ) )\r\n\t    local boolean isTwisted = LoadBoolean( udg_hash, GetHandleId( boss ), StringHash( \"bsilb\" ) )\r\n\t\r\n\t    if IsUnitDead( boss ) or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t    \tcall AreaSpawn(boss, isTwisted)\r\n\t    endif\r\n\t    \r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    local integer id = GetHandleId( udg_DamageEventTarget )\r\n\t\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    call SaveBoolean( udg_hash, GetHandleId( udg_DamageEventTarget ), StringHash( \"bsilb\" ), false )\r\n\r\n\t\tcall InvokeTimerWithUnit( udg_DamageEventTarget, \"bsil1\", bosscast(COOLDOWN), true, function Illusionist2Cast )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Illusionist2 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Illusionist2 )\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}