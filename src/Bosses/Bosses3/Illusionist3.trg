  "Script": "scope Illusionist3 initializer init\r\n\r\n\tprivate struct Colors\r\n\t\treadonly integer red\r\n\t\treadonly integer green\r\n\t\treadonly integer blue\r\n\t\t\r\n\t\tstatic method create takes integer red, integer green, integer blue returns Colors\r\n            local Colors this = Colors.allocate()\r\n            \r\n            set .red = red\r\n            set .green = green\r\n            set .blue = blue\r\n            \r\n            return this\r\n        endmethod\r\n\tendstruct\r\n\r\n\tglobals\r\n\t\tprivate constant string ANIMATION = \"Abilities\\\\Spells\\\\Undead\\\\ReplenishMana\\\\ReplenishManaCasterOverhead.mdl\"\r\n\t\tprivate constant integer COOLDOWN = 15\r\n\t\tprivate constant integer COLOR_AMOUNT = 5\r\n\t\tprivate Colors array Color[COLOR_AMOUNT]\r\n\t\tprivate integer CurrentColor = -1\r\n\tendglobals\r\n\t\r\n\tprivate function Set takes nothing returns nothing\r\n\t\tset Color[0] = Colors.create( 50, 255, 255 )\r\n\t\tset Color[1] = Colors.create( 255, 50, 255 )\r\n\t\tset Color[2] = Colors.create( 255, 255, 50 )\r\n\t\tset Color[3] = Colors.create( 50, 255, 50 )\r\n\t\tset Color[4] = Colors.create( 50, 50, 255 )\r\n\tendfunction\r\n\t\r\n\tprivate function condition takes nothing returns boolean\r\n\t    return GetUnitTypeId(udg_DamageEventTarget) == 'h020' and GetUnitLifePercent(udg_DamageEventTarget) <= 60\r\n\tendfunction\r\n\t\r\n\tprivate function WorldChange takes unit boss returns nothing\r\n\t\tlocal Colors color\r\n\t\r\n\t\tcall DestroyEffect( AddSpecialEffectTarget( ANIMATION, boss, \"origin\") )\r\n\t    call SaveBoolean( udg_hash, GetHandleId( boss ), StringHash( \"bsilb\" ), GetRandomInt(1, 2) == 1 )\r\n\t    if CurrentColor == -1 then\r\n\t    \tset CurrentColor = GetRandomInt(0, COLOR_AMOUNT - 1)\r\n    \telse\r\n    \t\tset CurrentColor = CurrentColor + 1\r\n    \t\tif CurrentColor >= COLOR_AMOUNT then\r\n    \t\t\tset CurrentColor = 0\r\n    \t\tendif\r\n\t    endif\r\n\t    set color = Color[CurrentColor]\r\n\t    call SetUnitVertexColor(boss, color.red, color.green, color.blue, 255 )\r\n\tendfunction\r\n\t\r\n\tprivate function ChangeTimer takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer( ) )\r\n\t    local unit boss = LoadUnitHandle( udg_hash, id, StringHash( \"boss_illusionist_world_change\" ) )\r\n\t    \r\n\t    if IsUnitDead(boss) or not( udg_fightmod[0] ) then\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t    else\r\n\t\t\tcall WorldChange(boss)\r\n\t    endif\r\n\r\n\t    set boss = null\r\n\tendfunction\r\n\t\r\n\tprivate function action takes nothing returns nothing\r\n\t    call DisableTrigger( GetTriggeringTrigger() )\r\n\t    \r\n\t    call WorldChange(udg_DamageEventTarget)\r\n\t    call SaveInteger(udg_hash, GetHandleId(udg_DamageEventTarget), StringHash( \"boss_illusionist_extra_area\" ), 1 )\r\n\t    call InvokeTimerWithUnit( udg_DamageEventTarget, \"boss_illusionist_world_change\", bosscast(COOLDOWN), true, function ChangeTimer )\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_Illusionist3 = CreateEventTrigger( \"udg_AfterDamageEvent\", function action, function condition )\r\n\t    call DisableTrigger( gg_trg_Illusionist3 )\r\n\t    call Set()\r\n\tendfunction\r\n\t\r\nendscope",
