{
  "Id": 50332078,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "library SetRaritySpawnLib\r\n\r\n    function SetRaritySpawn takes integer leg, integer rar returns nothing\r\n        set udg_RarityChance[3] = leg\r\n        set udg_RarityChance[2] = rar\r\n        set udg_RarityChance[1] = IMaxBJ(0,100-(udg_RarityChance[3]+udg_RarityChance[2]))\r\n    endfunction\r\n    \r\n    function AddRaritySpawn takes integer leg, integer rar returns nothing\r\n        set udg_RarityChance[3] = udg_RarityChance[3] + leg\r\n        set udg_RarityChance[2] = udg_RarityChance[2] + rar\r\n        set udg_RarityChance[1] = IMaxBJ(0,100-(udg_RarityChance[3]+udg_RarityChance[2]))\r\n    endfunction\r\n    \r\n    function GetRandomRarity takes nothing returns integer\r\n    \tlocal integer rand = GetRandomInt(1, 100)\r\n    \tlocal integer commonMin = 1\r\n    \tlocal integer commonMax = udg_RarityChance[1]\r\n    \tlocal integer rareMin = commonMax + 1\r\n    \tlocal integer rareMax = commonMax + udg_RarityChance[2]\r\n    \tlocal integer legMin = rareMax + 1\r\n    \tlocal integer legMax = rareMax + udg_RarityChance[3]\r\n    \t\r\n    \tcall BJDebugMsg(\"commonMin: \" + I2S(commonMin))\r\n    \tcall BJDebugMsg(\"commonMax: \" + I2S(commonMax))\r\n    \tcall BJDebugMsg(\"rareMin: \" + I2S(rareMin))\r\n    \tcall BJDebugMsg(\"rareMax: \" + I2S(rareMax))\r\n    \tcall BJDebugMsg(\"legMin: \" + I2S(legMin))\r\n    \tcall BJDebugMsg(\"legMax: \" + I2S(legMax))\r\n    \tcall BJDebugMsg(\"rand: \" + I2S(rand))\r\n    \t\r\n    \tif commonMin <= rand and rand <= commonMax then\r\n    \t\treturn 1\r\n\t\telseif rareMin <= rand and rand <= rareMax then\r\n\t\t\treturn 2\r\n\t\telseif legMin <= rand and rand <= legMax then\r\n\t\t\treturn 3\r\n\t\tendif\r\n        \r\n        call BJDebugMsg(\"Error! SetRaritySpawnLib: GetRandomRarity. Rarity not calculated properly! rand: \" + I2S(rand))\r\n        return 0\r\n    endfunction\r\n\r\nendlibrary",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}