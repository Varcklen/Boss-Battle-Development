{
  "Id": 50332088,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "library ShieldstLib initializer init requires BuffsLibLib\r\n\r\n    globals\r\n        real Event_ShieldDestroyed_Real\r\n        unit Event_ShieldDestroyed_Hero\r\n        \r\n        private texttag array TextTagList\r\n        private integer TextTagList_Max = 0\r\n    endglobals\r\n    \r\n    globals\r\n    \tprivate constant real TICK = 0.04\r\n    \tprivate constant real TEXT_HEIGHT = 0.03\r\n    \tprivate constant real Y_AXIS = -300\r\n    \t\r\n    \tprivate constant integer EFFECT_ID = 'A11F'\r\n    \tprivate constant integer BUFF_ID = 'B05P'\r\n    \r\n    \tprivate constant integer MIN_VALUE_FOR_ANIMATION = 150\r\n    \tprivate constant string SPAWN_ANIMATION = \"Abilities\\\\Spells\\\\Items\\\\AIre\\\\AIreTarget.mdl\"\r\n    \t\r\n    \tprivate constant string BASE_BUFF_ANIMATION = \"Buff_Shield_Non.mdx\"\r\n    \tprivate constant string BUFF_ANIMATION_POSITION = \"chest\"\r\n    \tprivate constant real BUFF_ANIMATION_SCALE = 1\r\n    \t\r\n    \tprivate effect TempEffect = null\r\n    endglobals\r\n    \r\n    //ShieldstLib_GetCurrentShield\r\n    public function GetCurrentShield takes unit target returns real\r\n    \treturn LoadReal( udg_hash, GetHandleId(target), StringHash( \"shield\" ) )\r\n    endfunction\r\n\r\n\tprivate function CleatTexts takes nothing returns nothing\r\n\t\tlocal integer i = 0\r\n\t\t\r\n\t\tloop\r\n\t\t\texitwhen i >= TextTagList_Max\r\n\t\t\tcall DestroyTextTag( TextTagList[i] )\r\n\t\t\tset i = i + 1\r\n\t\tendloop\r\n\t\t\r\n\t\tset TextTagList_Max = 0\r\n\tendfunction\r\n\t\r\n    /*function ShieldEnd takes nothing returns nothing\r\n        local integer id = GetHandleId( GetExpiredTimer() )\r\n        local unit u = LoadUnitHandle( udg_hash, id, StringHash( \"shield\" ) )\r\n        local texttag tt = LoadTextTagHandle( udg_hash, id, StringHash( \"shieldtt\" ) )\r\n\r\n        if tt != null then\r\n            call DestroyTextTag( tt )\r\n        endif\r\n        call SaveReal( udg_hash, GetHandleId( u ), StringHash( \"shield\" ), 0 )\r\n        call SaveReal( udg_hash, GetHandleId( u ), StringHash( \"shieldMax\" ), 0 )\r\n        \r\n        call FlushChildHashtable( udg_hash, id )\r\n        \r\n        set u = null\r\n    endfunction*/\r\n    \r\n    private function RemoveShield takes unit u returns nothing\r\n        local integer id = GetHandleId( u )\r\n        local texttag tx = LoadTextTagHandle( udg_hash, id, StringHash( \"shldtx\" ) )\r\n        local effect animation = LoadEffectHandle( udg_hash, id, StringHash( \"shield_effect\" ) )\r\n\r\n        call DestroyTextTag( tx )\r\n        call DestroyEffect(animation)\r\n        call SaveTextTagHandle( udg_hash, id, StringHash( \"shldtx\" ), null )\r\n        call SaveEffectHandle( udg_hash, id, StringHash( \"shield_effect\" ), null )\r\n        call SaveBoolean( udg_hash, id, StringHash( \"shield_effect_active\" ), false )\r\n        call SaveReal( udg_hash, id, StringHash( \"shield\" ), 0 )\r\n        call SaveReal( udg_hash, id, StringHash( \"shieldMax\" ), 0 )\r\n        call UnitRemoveAbility( u, EFFECT_ID )\r\n        call UnitRemoveAbility( u, BUFF_ID )\r\n        \r\n        set Event_ShieldDestroyed_Hero = u\r\n        set Event_ShieldDestroyed_Real = 0.00\r\n        set Event_ShieldDestroyed_Real = 1.00\r\n        set Event_ShieldDestroyed_Real = 0.00\r\n        \r\n        set animation = null\r\n        set tx = null\r\n        set u = null\r\n    endfunction\r\n    \r\n    private function ShieldCast takes nothing returns nothing\r\n        local integer id = GetHandleId( GetExpiredTimer() )\r\n        local unit u = LoadUnitHandle( udg_hash, id, StringHash( \"shld\" ) )\r\n        local integer unitId = GetHandleId( u )\r\n        local texttag tx = LoadTextTagHandle( udg_hash, unitId, StringHash( \"shldtx\" ) )\r\n        local real shieldValue = LoadReal( udg_hash, unitId, StringHash( \"shield\" ) )\r\n        local real maxValue\r\n\r\n        if shieldValue < 1 or IsUnitDead( u ) or tx == null then\r\n            call RemoveShield(u)\r\n            call DestroyTimer( GetExpiredTimer() )\r\n        else\r\n        \tset maxValue = LoadReal( udg_hash, unitId, StringHash( \"shieldMax\" ) )\r\n        \r\n            call SetTextTagText(tx, R2SI(shieldValue) + \"/\" + R2SI(maxValue), TEXT_HEIGHT )\r\n            call SetTextTagPosUnit(tx, u, Y_AXIS)\r\n        endif\r\n        \r\n        set u = null\r\n        set tx = null\r\n    endfunction\r\n    \r\n    private function MakeTextTag takes unit target, real shieldValue, real maxValue returns nothing\r\n    \tlocal texttag tt = CreateTextTag()\r\n\r\n        set TextTagList[TextTagList_Max] = tt\r\n    \tset TextTagList_Max = TextTagList_Max + 1\r\n        \r\n        call SetTextTagText(tt, R2SI(shieldValue) + \"/\" + R2SI(maxValue), TEXT_HEIGHT )\r\n        call SetTextTagPosUnit(tt, target, Y_AXIS)\r\n        call SetTextTagColor(tt, 200, 200, 200, 127 )\r\n        \r\n        call SaveTextTagHandle( udg_hash, GetHandleId( target ), StringHash( \"shldtx\" ), tt )\r\n    endfunction\r\n    \r\n    public function MakeEffect takes unit target, string effectAnim, string effectPos, real scale returns effect\r\n    \tlocal integer targetId = GetHandleId( target )\r\n    \t\r\n    \tif LoadBoolean( udg_hash, targetId, StringHash( \"shield_effect_active\" ) ) then\r\n    \t\treturn null\r\n\t\tendif\r\n\t\tset TempEffect = AddSpecialEffectTarget( effectAnim, target, effectPos )\r\n    \t\r\n    \tcall BlzSetSpecialEffectScale( TempEffect, scale )\r\n    \tcall SaveEffectHandle( udg_hash, targetId, StringHash( \"shield_effect\" ), TempEffect )\r\n    \tcall SaveBoolean( udg_hash, targetId, StringHash( \"shield_effect_active\" ), true )\r\n\r\n    \treturn TempEffect\r\n    endfunction\r\n    \r\n    function shield takes unit caster, unit target, real shieldValue returns nothing\r\n        local integer id\r\n        local real maxValue\r\n        local integer targetId\r\n        \r\n        if shieldValue < 1 then\r\n        \treturn\r\n        endif\r\n        \r\n        if target == null then\r\n            set target = caster\r\n        endif\r\n        \r\n        if IsUnitDead(target) then\r\n        \treturn\r\n        endif\r\n        \r\n        if IsMinion( target ) then\r\n        \treturn\r\n        endif\r\n        \r\n        set targetId = GetHandleId( target )\r\n \r\n        set shieldValue = shieldValue * GetUnitSpellPower(caster)\r\n        set shieldValue = LoadReal( udg_hash, targetId, StringHash( \"shield\" ) ) + shieldValue\r\n        set maxValue = LoadReal( udg_hash, targetId, StringHash( \"shieldMax\" ) )\r\n        \r\n        set maxValue = RMaxBJ( shieldValue, maxValue)\r\n        \r\n        if LoadTextTagHandle( udg_hash, targetId, StringHash( \"shldtx\" ) ) == null then\r\n            if shieldValue >= MIN_VALUE_FOR_ANIMATION then\r\n                call DestroyEffect( AddSpecialEffectTarget( SPAWN_ANIMATION, target, \"origin\" ) )\r\n            endif\r\n            \r\n            call MakeTextTag(target, shieldValue, maxValue)\r\n            \r\n            call InvokeTimerWithUnit( target, \"shld\", TICK, true, function ShieldCast )\r\n        endif\r\n        \r\n        call MakeEffect(target, BASE_BUFF_ANIMATION, BUFF_ANIMATION_POSITION, BUFF_ANIMATION_SCALE )\r\n\r\n        call UnitAddAbility( target, EFFECT_ID )\r\n        call SaveReal( udg_hash, targetId, StringHash( \"shield\"  ), shieldValue )\r\n        call SaveReal( udg_hash, targetId, StringHash( \"shieldMax\" ), maxValue )\r\n        \r\n        call ShieldGain.SetDataUnit(\"caster\", caster)\r\n        call ShieldGain.SetDataUnit(\"target\", target)\r\n        call ShieldGain.SetDataInteger(\"amount\", R2I(shieldValue) )\r\n\t\tcall ShieldGain.Invoke()\r\n    endfunction\r\n    \r\n    //Buff Remove\r\n    //===========================================================================\r\n    private function DeleteBuff_Conditions takes nothing returns boolean\r\n        return GetUnitAbilityLevel( Event_DeleteBuff_Unit, BUFF_ID) > 0\r\n    endfunction\r\n    \r\n    private function DeleteBuff takes nothing returns nothing\r\n        call RemoveShield(Event_DeleteBuff_Unit)\r\n    endfunction\r\n\r\n    private function init takes nothing returns nothing\r\n    \tcall CreateEventTrigger( \"Event_DeleteBuff_Real\", function DeleteBuff, function DeleteBuff_Conditions )\r\n    \tcall CreateEventTrigger( \"udg_FightEndGlobal_Real\", function CleatTexts, null )\r\n    endfunction\r\n\r\nendlibrary",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}