{
  "Id": 50332052,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "library TextLib\r\n\t//call TextLib_CreateWithPosition( TextLib_EXTRA_TEXT_POSITION )\r\n    globals\r\n        private constant real FADE_TIME = 0.5\r\n        private constant integer SATURATION = 225\r\n        \r\n        private texttag TempTextTag = null\r\n        \r\n        public constant integer EXTRA_TEXT_POSITION = -100\r\n    endglobals\r\n\r\n    function B2S takes boolean b returns string\r\n        if b then\r\n            return \"true\"\r\n        else\r\n            return \"false\"\r\n        endif\r\n    endfunction\r\n    \r\n    function R2SI takes real value returns string\r\n    \treturn I2S( R2I( value ) )\r\n\tendfunction\r\n\t\r\n    function textst takes string inf, unit caster, real speed, real angle, real size, real life returns texttag\r\n        local real sp = ( speed * 0.071 / 128 ) * Cos( angle * 0.0174 )\r\n        local real an = ( speed * 0.071 / 128 ) * Sin( angle * 0.0174 )\r\n        local real sizeValue = size * 0.023 / 10\r\n\r\n        set TempTextTag = CreateTextTag()\r\n        \r\n        call SetTextTagText( TempTextTag, inf, sizeValue ) \r\n        call SetTextTagPosUnit( TempTextTag, caster, 0 )\r\n        call SetTextTagColor( TempTextTag, SATURATION, SATURATION, SATURATION, SATURATION ) \r\n        call SetTextTagVelocity( TempTextTag, sp, an )\r\n        call SetTextTagFadepoint( TempTextTag, life ) \r\n        call SetTextTagLifespan( TempTextTag, life + FADE_TIME ) \r\n        call SetTextTagPermanent( TempTextTag, false )\r\n        \r\n        return TempTextTag\r\n    endfunction\r\n    \r\n    public function CreateWithPosition takes string inf, unit caster, real speed, real angle, real size, real life, real position returns texttag\r\n\t\tset TempTextTag = textst( inf, caster, speed, angle, size, life )\r\n\t\tcall SetTextTagPosUnit( TempTextTag, caster, position ) \r\n\t\treturn TempTextTag\r\n\tendfunction\r\n\t\r\nendlibrary",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}