{
  "Id": 50332342,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "library HeroesTableDatabase initializer init\r\n\r\n    globals\r\n        real Event_DatabaseLoaded\r\n        public constant integer CLASSES = 9\r\n        public constant integer HEROES_IN_COLUMN_MAX = 10\r\n        public integer array HEROES_IN_CLASS[CLASSES]\r\n        public integer array Uniques[CLASSES]\r\n        \r\n        ClassFramehandle array ClassFrame[CLASSES]\r\n        HeroFramehandle array HeroFrame[CLASSES][HEROES_IN_COLUMN_MAX]//Class/Position\r\n    endglobals\r\n\r\n    struct ClassFramehandle\r\n        readonly string className\r\n        readonly string icon\r\n        readonly string description\r\n        readonly integer unique\r\n        \r\n        method SetDescription takes string description returns nothing\r\n            set .description = description\r\n        endmethod\r\n        \r\n        static method create takes string className, string icon, integer unique returns ClassFramehandle\r\n            local ClassFramehandle this = ClassFramehandle.allocate()\r\n            \r\n            set .className = className\r\n            set .icon = icon\r\n            set .unique = unique\r\n            return this\r\n        endmethod\r\n    endstruct\r\n    \r\n    globals\r\n        private constant integer ALL_ROLES = 7\r\n        constant integer ROLE_DEFEND = 1\r\n        constant integer ROLE_SUPPORT = 2\r\n        constant integer ROLE_HEAL = 3\r\n        constant integer ROLE_MAGIC_DAMAGE = 4\r\n        constant integer ROLE_PHYSICAL_DAMAGE = 5\n        constant integer ROLE_SUMMONER = 6\r\n        constant integer ROLE_CONTROL = 7\r\n    endglobals\r\n    \r\n    struct HeroFramehandle\r\n        readonly integer heroId\r\n        readonly string author\r\n        readonly integer difficulty\r\n        readonly string icon\r\n        readonly integer alternativeUnique = 0\r\n        readonly unit array hero[PLAYERS_LIMIT]\r\n        readonly boolean array role[ALL_ROLES]\r\n        string story = null\r\n        \r\n        method SetAlternativeUnique takes integer alternativeUnique returns nothing\r\n            set .alternativeUnique = alternativeUnique\r\n        endmethod\r\n\r\n        method AddRoles takes integer role1, integer role2, integer role3, integer role4 returns nothing\r\n            if role1 > 0 and role1 <= ALL_ROLES then\r\n                set role[role1] = true\r\n            endif\r\n            if role2 > 0 and role2 <= ALL_ROLES then\r\n                set role[role2] = true\r\n            endif\r\n            if role3 > 0 and role3 <= ALL_ROLES then\r\n                set role[role3] = true\r\n            endif\r\n            if role4 > 0 and role4 <= ALL_ROLES then\r\n                set role[role4] = true\r\n            endif\r\n        endmethod\r\n        \r\n        static method create takes integer heroId, string author, integer difficulty, string icon returns HeroFramehandle\r\n            local HeroFramehandle this = HeroFramehandle.allocate()\r\n            \r\n            set .heroId = heroId\r\n            set .author = author\r\n            set .difficulty = difficulty\r\n            set .icon = icon\r\n            \r\n            return this\r\n        endmethod\r\n    endstruct\r\n\r\n    private function Database takes nothing returns nothing\r\n        set ClassFrame[0] = ClassFramehandle.create(\"Warlord\", \"ReplaceableTextures\\\\PassiveButtons\\\\PASBTNCommand.blp\", 'A0GD')\r\n        set ClassFrame[1] = ClassFramehandle.create(\"Deffender\", \"ReplaceableTextures\\\\PassiveButtons\\\\PASBTNUnholyAura.blp\", 'A088')\r\n        set ClassFrame[2] = ClassFramehandle.create(\"Reaper\", \"ReplaceableTextures\\\\PassiveButtons\\\\PASBTNCleavingAttack.blp\", 'A1ED')\r\n        set ClassFrame[3] = ClassFramehandle.create(\"Traveler\", \"ReplaceableTextures\\\\PassiveButtons\\\\PASBTNEvasion.blp\", 'A05Y')\r\n        set ClassFrame[4] = ClassFramehandle.create(\"Marauder\", \"ReplaceableTextures\\\\PassiveButtons\\\\PASBTNPillage.blp\", 'A0GA')\r\n        set ClassFrame[5] = ClassFramehandle.create(\"Assassin\", \"ReplaceableTextures\\\\PassiveButtons\\\\PASBTNCriticalStrike.blp\", 'A1EA')\n        set ClassFrame[6] = ClassFramehandle.create(\"Elementalist\", \"ReplaceableTextures\\\\PassiveButtons\\\\PASBTNThickFur.blp\", 'A0GC')\n        set ClassFrame[7] = ClassFramehandle.create(\"Healer\", \"ReplaceableTextures\\\\PassiveButtons\\\\PASBTNMagicImmunity.blp\", 'A0AG')\r\n        set ClassFrame[8] = ClassFramehandle.create(\"Sorcerer\", \"ReplaceableTextures\\\\PassiveButtons\\\\PASBTNFrost.blp\", 'A0GF')\r\n        \r\n        call ClassFrame[0].SetDescription(\"Warlords - powerful warriors that strengthen their allies.|n|n|cffffcc00Main stat:|r |cffff3300Strength|r|n|n|cff00cc00- Health: +100.|n- Mana: +50.|r\")\r\n        call ClassFrame[1].SetDescription(\"Deffenders - strong warriors defending their allies.|n|n|cffffcc00- Main stat:|r |cffff3300Strength|r|n|n|cff00cc00- Health: +150.|n- Armor: +1.|r\")\r\n        call ClassFrame[2].SetDescription(\"Reapers - skillful killers of minions.|n|n|cffffcc00- Main stat:|r |cffff3300Strength|r|n|n|cff00cc00- Attack Speed: + 10%.|n- Attack Power: +5.|r\")\r\n        call ClassFrame[3].SetDescription(\"Travelers - special type of heroes that combine many types of heroes.|n|n|cffffcc00- Main stat:|r |cff00cc00Agility|r|n|n|cff00cc00- They have personal unique ability.|r\")\r\n        call ClassFrame[4].SetDescription(\"Marauders - skilled dodgers who find gold in the most unexpected places.|n|n|cffffcc00- Main stat:|r |cff00cc00Agility|r|n|n|cff00cc00- Attack Speed: +10%|n- Luck: +5.|r\")\r\n        call ClassFrame[5].SetDescription(\"Assassins - professional enemy destroyers.|n|n|cffffcc00- Main stat:|r |cff00cc00Agility|r|n|n|cff00cc00- Attack Power: +10.|r\")\r\n        call ClassFrame[6].SetDescription(\"Elementalists - powerful magicians who use different powers.|n|n|cffffcc00- Main stat:|r |cff0099FFIntelligence|r|n|n|cff00cc00- Mana: +50.|n- Spell Power: +10%.|r\")\r\n        call ClassFrame[7].SetDescription(\"Healers - wizards who use their magic to support allies.|n|n|cffffcc00- Main stat:|r |cff0099FFIntelligence|r|n|n|cff00cc00- Health: +50.|n- Mana: +100.|r\")\r\n        call ClassFrame[8].SetDescription(\"Sorcerers - special type of mage that weakens enemies with their spells.|n|n|cffffcc00- Main stat:|r |cff0099FFIntelligence|r|n|n|cff00cc00- Mana: +50.|n- Movement Speed: +10%.|r\")\r\n    \r\n        //Uniques\r\n        set Uniques[0] = 'A0GD'\r\n        set Uniques[1] = 'A088'\r\n        set Uniques[2] = 'A1ED'\r\n        set Uniques[3] = 'A0MW'\r\n        set Uniques[4] = 'A0GA'\r\n        set Uniques[5] = 'A1EA'\r\n        set Uniques[6] = 'A0GC'\r\n        set Uniques[7] = 'A0AG'\r\n        set Uniques[8] = 'A0GF'\r\n    \r\n        //Random hero\r\n        set HeroFrame[9][0] = HeroFramehandle.create('u002', \"\", 0, \"\" )\r\n        \r\n        // Warlord\r\n        set HEROES_IN_CLASS[0] = 9\r\n        set HeroFrame[0][0] = HeroFramehandle.create('O00S', \"pashtet\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNNagaMyrmidonRoyalGuard.blp\" )\r\n        set HeroFrame[0][1] = HeroFramehandle.create('O00L', \"Varcklen\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNPitLord.blp\" )\r\n        set HeroFrame[0][2] = HeroFramehandle.create('O010', \"Varcklen\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNTuskaarBlack.blp\" )\r\n        set HeroFrame[0][3] = HeroFramehandle.create('N054', \"faceroll\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNDragonHawk.blp\" )\r\n        set HeroFrame[0][4] = HeroFramehandle.create('N05A', \"SkifterOk\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNScout.blp\" )\r\n        set HeroFrame[0][5] = HeroFramehandle.create('N02H', \"ZiHeLL\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNMedivh.blp\" )\r\n        set HeroFrame[0][6] = HeroFramehandle.create('N03V', \"Sadtwig\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNDranai.blp\")\n        set HeroFrame[0][7] = HeroFramehandle.create('O00C', \"Varcklen\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNBlueDragonSpawn.blp\" )\n        set HeroFrame[0][8] = HeroFramehandle.create('N04E', \"Sheepy\", 2, \"war3mapImported\\\\BTNHolyMage.blp\" )\r\n        \r\n        set HeroFrame[0][0].story = \"A seasoned commander of the naga, he carved his legacy in the dark trenches beneath Nazjatar through brutal efficiency and tactical brilliance. Once a highborne noble, his transformation left only ambition and a cold sense of duty. Wielding a barbed trident infused with arcane energy, he leads with calculated cruelty, striking down indecision as swiftly as his enemies. Though outwardly loyal to Queen Azshara, he harbors a private vision of naga supremacy that stretches beyond her shadow. He values discipline, strength, and absolute control—tolerating neither weakness nor disobedience. Among his ranks, his name is spoken with reverence and fear.\"\r\n        set HeroFrame[0][1].story = \"A malevolent overlord forged in the fel crucibles of the Burning Legion, he commands legions with a voice that trembles realms. Towering and clad in infernal armor, he wields a jagged spear pulsing with demonic fire—an extension of his wrath and dominion. Once a lesser pit lord, he rose through treachery and conquest, earning his title through rivers of blood and ash. He is ruthless, cunning, and utterly devoid of mercy, preferring manipulation over mindless destruction—though both suit him well. Loyal only to power itself, he views even his demonic peers as stepping stones. His presence poisons the very air, and his name is etched into the screams of conquered worlds.\"\r\n        set HeroFrame[0][2].story = \"A hearty tuskarr from the windswept coast of Dragonblight, he left his fishing village in search of something greater than the icebound routines of tradition. With a broad grin and a heavier axe, he roams the world as an adventurer, driven by curiosity, honor, and the thrill of a good tale. His axe, carved from driftwood and enchanted steel, has split both timber and troll alike. Jovial but unshakably brave, he greets danger with laughter and defends the innocent without hesitation. Though he longs for the warmth of homefires and whale blubber stew, he believes his path lies where the snow is untrodden and the stories are still unwritten.\"\r\n        set HeroFrame[0][3].story = \"Tiberius's first memory is opening his eyes and seeing a Dragon Hawk dangling a mangled sheep over him. He remembers eating with the baby Dragon Hawks, raised as one of them. Tiberius' first years in nature hunting and living with his pack of Dragon Hawks has attuned him to the Sun, his god which he communes with every day. In return, he has been granted a great power - he spends the next 20 years in mastering the power, and now soars the sky looking to recruit an army for the Sun, their purpose unknown.\"\r\n        set HeroFrame[0][4].story = \"In his youth, Soren loved to hear stories of mysterious Guardians of Ga'Hoole - legendary group of owls and owe their life to fight to protect their fellow Guardians, as well as innocent owls throughout the world. And after being snatched by St Aggie's, those legends were everything that he could hope for. Who would've thought, that after seizing his one and only chance to escape, after travelling seemingly to nowhere, he will not only find the Great Tree itself, but also find out, that legends were true. Guardians were true. And moreover, now he is the part of the legends. But not even Soren could dream of becoming a leader of the elite group of the Guardians - Chaw of Chaws. And even less so - became the King of the Great Ga'Hoole Tree.\"\r\n        set HeroFrame[0][5].story = \"It is unknown where did Zote come from, nor where does his destination lie. A man of immense wits and intelligence, he saw the history of the world being written with his very own eyes. \\\"Pulvis et umbra sumus\\\" - was all he told me.\"\r\n        set HeroFrame[0][6].story = \"Kel is a draenei shepherd who uses spiritual magic. He casts spells using his pet fish 'Hiffel' as a magical focus. Kel doesn't know how he got into this arena, but he is determined to get back home and bring all these sheep with him safely.\"\r\n        set HeroFrame[0][7].story = \"A disciplined legionnaire of the dragonflights, he was forged in the crucible of ancient war and bound by oath to protect draconic legacy. With scales hardened by volcanic ash and wings scarred from countless battles, he stands as both guardian and enforcer. His spear, tipped with obsidian and enchanted by wyrmfire, is a symbol of his relentless resolve. Though dragonkin by blood, he reveres structure over instinct, following the chain of command with unwavering loyalty. Stern, silent, and unyielding, he speaks only when necessary and strikes only with purpose. He views weakness as a threat to the balance he’s sworn to uphold. In his presence, even younger dragons show restraint—for behind his calm eyes burns the memory of wars that nearly tore the skies apart.\"\r\n        set HeroFrame[0][8].story = \"An ethereal servant of the Light, she descends from the radiant heavens to bring hope where shadows gather. As a Divine Maiden, she embodies purity, compassion, and unwavering resolve. Her presence soothes the wounded and unsettles the wicked, her voice carrying the weight of celestial judgment. She channels light magic through her very being—wings aglow, eyes shining with divine fire. Though gentle in demeanor, she is a fierce protector of the innocent and a relentless foe to darkness. Guided by visions and sacred duty, she walks the mortal realm not as a conqueror, but as a beacon. Those who witness her in battle speak of blinding brilliance, serenity amid chaos, and the feeling of being touched by something eternal.\"\r\n        \r\n        call HeroFrame[0][0].AddRoles(ROLE_SUPPORT, ROLE_PHYSICAL_DAMAGE, 0, 0)\r\n        call HeroFrame[0][1].AddRoles(ROLE_SUPPORT, ROLE_PHYSICAL_DAMAGE, ROLE_DEFEND, ROLE_CONTROL)\r\n        call HeroFrame[0][2].AddRoles(ROLE_SUPPORT, ROLE_PHYSICAL_DAMAGE, ROLE_MAGIC_DAMAGE, 0)\r\n        call HeroFrame[0][3].AddRoles(ROLE_SUPPORT, ROLE_HEAL, ROLE_MAGIC_DAMAGE, 0)\r\n        call HeroFrame[0][4].AddRoles(ROLE_MAGIC_DAMAGE, 0, 0, 0)\r\n        call HeroFrame[0][5].AddRoles(ROLE_SUPPORT, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[0][6].AddRoles(ROLE_SUPPORT, ROLE_SUMMONER, 0, 0)\r\n        call HeroFrame[0][7].AddRoles(ROLE_SUPPORT, ROLE_PHYSICAL_DAMAGE, 0, 0)\r\n        call HeroFrame[0][8].AddRoles(ROLE_SUPPORT, ROLE_HEAL, 0, 0)\r\n        \n\r\n        // Deffender\r\n        set HEROES_IN_CLASS[1] = 10\r\n        set HeroFrame[1][0] = HeroFramehandle.create('N000', \"Varcklen\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNPolarFurbolgTracker.blp\" )\r\n        set HeroFrame[1][1] = HeroFramehandle.create('N055', \"faceroll\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNTheCaptain.blp\" )\r\n        set HeroFrame[1][2] = HeroFramehandle.create('N01Q', \"Varcklen\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNTauren.blp\" )\r\n        set HeroFrame[1][3] = HeroFramehandle.create('H01D', \"ZiHeLL\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNSpiritWalker.blp\" )\r\n        set HeroFrame[1][4] = HeroFramehandle.create('N04C', \"Rena\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNSnapDragon.blp\" )  \r\n        set HeroFrame[1][5] = HeroFramehandle.create('N04J', \"Mike\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNGreenDragon.blp\" )\r\n        set HeroFrame[1][6] = HeroFramehandle.create('N02O', \"Yoti Coyote\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNInfernal.blp\" )\r\n        set HeroFrame[1][7] = HeroFramehandle.create('H01A', \"Varcklen\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNSkeletonWarrior.blp\" )\r\n        set HeroFrame[1][8] = HeroFramehandle.create('N01P', \"Sheepy\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeroCryptLord.blp\" )\r\n        set HeroFrame[1][9] = HeroFramehandle.create('H01U', \"Sheepy\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNDalaranReject.blp\" )\r\n\r\n        set HeroFrame[1][0].story = \"A towering figure among the furbolg tribes, he rose to chieftain not by inheritance, but through strength, wisdom, and an unbreakable bond with the forest. His claws, gnarled and hardened like ancient roots, are his weapons—used to defend his people and the sacred groves they call home. He speaks rarely, letting action and the growl of nature guide his judgment. Fiercely territorial and deeply spiritual, he communes with the spirits of earth and beast, drawing strength from their ancient wisdom. Though peaceful by nature, he becomes a whirlwind of fury when his tribe or forest is threatened. Elders seek his counsel, warriors follow his roar, and intruders learn the cost of disturbing the wilds.\"\r\n        set HeroFrame[1][1].story = \"Galvan was a blacksmith's child before he enlisted in the local militia. He learned not only how to forge strong weapons, but to use them effectively. He's on a quest to obtain and learn how to use every weapon in the world.\"\r\n        set HeroFrame[1][2].story = \"Minos is an old minotaur that lives in a swamp labyrinth. One day, the swamp was infected with corruption, which drove all its inhabitants crazy. Minos had to leave the swamp to save his life. A few months later, he was offered to participate in the arena in exchange for saving the swamp. Having agreed to the terms of the contract, the minotaur fights furiously in the arena for a personal goal.\"\r\n        set HeroFrame[1][3].story = \"Burg Miller is a well-renowned for the research in both the runic and arcane fields of magic. His mastery over them was instrumental in crafting many a great enchanted artifacts, aimed primarily at guaranteeing safety; years following the creation of said relics, Burg Miller is still commonly referred to as the Barrier Sage in commemoration. He now resides at the Arena, eager to aid those in need of protection.\"\r\n        set HeroFrame[1][4].story = \"From the murky depths comes an agile and tough aquatic creature ready to absolutely thrash and exhaust prey before inevitably devouring it. However those that manage to survive its initial assault will soon discover that it has the power to command the origin pulse, power of water magic. Local hunters speculate that its an avatar, while others believe it had gained powers after eating a proper water mage, one thing is for certain though. It loves the taste of prawns and anything that bleeds.\"\r\n        set HeroFrame[1][5].story = \"A rare and cunning mimic, it abandoned chests and shadows for grandeur, assuming the form of a crystalline dragon to lure prey with awe instead of stealth. Its shimmering body, formed from enchanted crystal and illusion, reflects light like a gemstone hoard—irresistible to greedy eyes. Beneath the beauty lies a predator, its true nature revealed only when it strikes, spewing corrosive acid that melts steel and bone alike. It feels no loyalty, no fear—only hunger and cunning. Imitating draconic majesty, it mimics not just form but arrogance, toying with victims before dissolving them into silence. It has wandered ancient ruins, hoarded voices of the fallen, and learned to speak in broken tongues. To gaze upon it is to admire art—until it moves.\"\r\n        set HeroFrame[1][6].story = \"Born from the darkest rifts of the Twisting Nether, this abyssal infernal is a towering colossus of molten rock and raging flame. It is neither alive nor dead, a relentless force of destruction summoned to scorch worlds into ash. Its fiery core burns with the fury of countless felstorms, and it wields infernal fire with devastating precision—engulfing enemies in hellfire that consumes both flesh and spirit. Silent and unyielding, it moves with the slow certainty of a volcanic eruption, crushing all in its path without hesitation or mercy. Neither bound by loyalty nor free will, it serves only the will of those who command it, an unstoppable weapon forged in chaos. Its presence warps the air, turning hope to despair beneath a sky darkened by smoke and embers.\"\r\n        set HeroFrame[1][7].story = \"Once a proud warrior fallen in a forgotten battle, he was resurrected by dark magic as a bone knight—an undead sentinel bound to eternal duty. His hollow eye sockets burn with a faint, eerie glow, reflecting the remnants of his lost humanity. Clad in rusted armor pieced from shattered relics, he wields a weathered sword and shield, symbols of both offense and defense. Silent and relentless, he guards ancient tombs and cursed battlegrounds, driven by a code etched deep into his bones. Though stripped of life, his sense of honor endures, guiding his every move. He strikes with cold precision, unyielding and unfeeling, a grim reminder of mortality’s shadow. Few dare challenge him, for his presence chills the soul—a sentinel forever caught between death and duty.\"\r\n        set HeroFrame[1][8].story = \"Ruler of the shadowed tunnels beneath the frozen wastes, the Scarab King commands the ancient Nerubian legions with unmatched ferocity and cunning. His razor-sharp paws, honed over centuries, rend armor and flesh alike, leaving foes shattered and broken. Cloaked in a carapace as dark as obsidian, he moves with silent grace, a predator born of shadow and ice. Cunning and ruthless, he governs with an iron will, balancing the delicate politics of his subterranean realm. Legends whisper that he possesses knowledge lost to time, secrets buried deep beneath the earth’s frozen crust. His subjects revere him as both protector and executioner, while enemies tremble at the mere glimpse of his gleaming claws. In the cold, eternal night of the Nerubian kingdom, his reign is absolute—an unyielding force carved from darkness and death.\"\r\n        set HeroFrame[1][9].story = \"A living mass of corrosive slime, it oozes through the darkest swamps and forgotten ruins, leaving a trail of decay and ruin. Formless yet relentless, it uses acidic secretions to dissolve anything that stands in its path—armor, stone, and flesh alike melt under its touch. It lacks thought or mercy, driven only by instinct and hunger, a primal force of nature reborn from fel corruption and stagnant waters. Though slow, it can engulf enemies whole, breaking down defenses with deadly patience. Its presence warps the land, turning fertile soil into toxic wastelands. Legends speak of it as a creeping nightmare, an ever-hungry shadow beneath the earth that swallows hope along with its victims. Where it flows, life withers, and only ruin remains.\"\r\n\r\n        call HeroFrame[1][0].AddRoles(ROLE_DEFEND, ROLE_CONTROL, 0, 0)\r\n        call HeroFrame[1][1].AddRoles(ROLE_DEFEND, ROLE_PHYSICAL_DAMAGE, 0, 0)\r\n        call HeroFrame[1][2].AddRoles(ROLE_DEFEND, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[1][3].AddRoles(ROLE_DEFEND, ROLE_SUPPORT, 0, 0)\r\n        call HeroFrame[1][4].AddRoles(ROLE_DEFEND, ROLE_SUPPORT, 0, 0)\r\n        call HeroFrame[1][5].AddRoles(ROLE_DEFEND, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[1][6].AddRoles(ROLE_DEFEND, ROLE_SUMMONER, 0, 0)\r\n        call HeroFrame[1][7].AddRoles(ROLE_DEFEND, ROLE_CONTROL, 0, 0)\r\n        call HeroFrame[1][8].AddRoles(ROLE_DEFEND, ROLE_CONTROL, 0, 0)\r\n        call HeroFrame[1][9].AddRoles(ROLE_DEFEND, ROLE_SUMMONER, 0, 0)\r\n        \r\n        // Reaper\r\n        set HEROES_IN_CLASS[2] = 9\r\n        set HeroFrame[2][0] = HeroFramehandle.create('N00N', \"Varcklen\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeroDeathKnight.blp\" )\r\n        set HeroFrame[2][1] = HeroFramehandle.create('N02R', \"Varcklen\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNBeastMaster.blp\" )\r\n        set HeroFrame[2][2] = HeroFramehandle.create('N04B', \"Rena\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNZergling.blp\" )\r\n        set HeroFrame[2][3] = HeroFramehandle.create('N028', \"Varcklen\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeroDreadLord.blp\" )  \r\n        set HeroFrame[2][4] = HeroFramehandle.create('N014', \"ZiHeLL\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNGarithos.blp\" )\r\n        set HeroFrame[2][5] = HeroFramehandle.create('N00X', \"Varcklen\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNOneHeadedOgre.blp\" )\r\n        set HeroFrame[2][6] = HeroFramehandle.create('N04I', \"ZiHeLL\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeroDemonHunter.blp\" )\r\n        set HeroFrame[2][7] = HeroFramehandle.create('N03P', \"ZiHeLL\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNDruidOfTheClaw.blp\" )\r\n        set HeroFrame[2][8] = HeroFramehandle.create('N03Z', \"Varcklen\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNDoomGuard.blp\" )\r\n        \r\n        set HeroFrame[2][0].story = \"Once a noble warrior, he was bound by dark fate to serve as a soul reaper—a death knight wielding a cursed sword forged in the shadows of the Scourge. His eyes burn with cold fire, reflecting the torment of countless souls claimed in battle. Clad in blackened armor etched with runes of despair, he moves with relentless purpose, harvesting the souls of the fallen to fuel his unholy power. Silent and ruthless, he walks the line between life and death, neither fully alive nor dead, driven by a grim sense of duty and vengeance. His sword cleaves not just flesh, but the very essence of his enemies, leaving behind echoes of their suffering. Feared by allies and enemies alike, he is a harbinger of doom, a grim reminder that death is never final.\"\r\n        set HeroFrame[2][1].story = \"A rugged human barbarian from the harsh northern wilderness, he lives by the strength of his arms and the fury of his spirit. Wielding twin axes forged in the fires of his clan’s ancestral forge, he charges into battle with wild abandon, a storm of steel and rage. Scarred by countless battles, his roar echoes across the frozen plains, rallying allies and striking fear into foes. Though rough and fierce, he holds a fierce loyalty to his tribe and an unyielding code of honor. Life taught him to trust only his instincts and the weight of his axes. In a world of shifting alliances and ceaseless war, he carves his own path—one marked by blood, valor, and the unbreakable will of a warrior born for battle.\"\r\n        set HeroFrame[2][2].story = \"Chaos is rampant in these lands and with constant chaos came horrific creatures from other realms, bleeding into our own reality. Acrid however just loves to act like a dog, chasing things smaller than it, playing fetch and being protective of those it cares for with complete ignorance to the fact its acid might harm those that aren't immune to it. Acrid's innocent nature just means there's much worse out there... in the great beyond.\"\r\n        set HeroFrame[2][3].story = \"Dio is a great vampire who previously lived in Enedaria. He withered many of the citizens of the city, for which he was recognized as a dangerous threat to the city. However, he was defeated by a certain \\\"Beer Fighter\\\" and imprisoned in the arena, in which he is obliged to fight forever.\"\r\n        set HeroFrame[2][4].story = \"Garithos was a stern and ambitious human commander of Lordaeron, known for his unwavering loyalty to the Alliance and ruthless methods. Serving as the military leader during the Second War, he sought to purge the undead Scourge with brutal efficiency, often clashing with allies over his harsh tactics. His distrust of non-humans and zeal to maintain order led to strained relations, especially with figures like Prince Arthas. Garithos’s rigid sense of duty blinded him to the complexity of the threats facing Azeroth, and his obsession with control ultimately sowed discord. Despite his flaws, he remained a fierce protector of his kingdom until his demise during the Scourge’s invasion of Quel’Thalas. His legacy is one of stern resolve and tragic downfall—a man hardened by war but undone by his own inflexibility. Did nothing wrong.\"\r\n        set HeroFrame[2][5].story = \"A hulking combat ogre, he thrives in the chaos of battle with raw strength and brutal force. His massive hammer, cracked and heavy, crushes shields and skulls alike with bone-shattering blows. Simple-minded and driven by instinct, he follows orders without question, his loyalty earned through fear or reward. Though slow to grasp strategy or subtlety, his sheer power makes him a terrifying frontline warrior. His booming roar shakes the earth, and his relentless charge breaks enemy lines like a battering ram. Despite his low intelligence, he understands the language of violence and survival, thriving where cunning falters. In the heat of combat, his mind clears, and the world narrows to the swing of his hammer and the taste of victory.\"\r\n        set HeroFrame[2][6].story = \"No one knows why Kayn became on Outcast in the first place, but he is definitely seeking vengeance now. His powers exceed limits of any mortal, but the Demon never really abuses them in the first place.\"\r\n        set HeroFrame[2][7].story = \"The Atero bloodline is known for the works of many infamous druids, Furrih being one of them. He got struck with lycanthropy in his youth, which changed his life completely. Now he is a valuable warrior on the Arena, as Furrih is both known for his physical power of a lycan and magical abilities of a druid. \"\r\n        set HeroFrame[2][8].story = \"Summoned by dark sorcery during a wartime ritual, a red-skinned demon child - Anung Un Rama - was meant to bring about the apocalypse. But fate intervened. Rescued by Druid of Nature and raised within the Bureau for Paranormal Research and Defense, the child became Wrath Collector: a creature of myth raised with a human heart. Wielding the unbreakable Right Hand of Doom, he hunted monsters, battled ancient evils, and defied the prophecy tied to his blood. Though born to awaken the Ogdru Jahad - primal gods of destruction - Wrath Collector chose a different path. Rejecting his infernal destiny, he ground down his horns and stood as a guardian between worlds. In a realm of monsters, magic, and forgotten gods, he became a hero not by fate, but by choice.\"\r\n        \r\n        call HeroFrame[2][0].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[2][1].AddRoles(ROLE_PHYSICAL_DAMAGE, 0, 0, 0)\r\n        call HeroFrame[2][2].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[2][3].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_MAGIC_DAMAGE, ROLE_DEFEND, 0)\r\n        call HeroFrame[2][4].AddRoles(ROLE_PHYSICAL_DAMAGE, 0, 0, 0)\r\n        call HeroFrame[2][5].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_CONTROL, 0, 0)\r\n        call HeroFrame[2][6].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[2][7].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_SUPPORT, 0, 0)\r\n        call HeroFrame[2][8].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_CONTROL, 0, 0)\r\n        \r\n        // Traveler\r\n        set HEROES_IN_CLASS[3] = 9 //10 TEST\r\n        set HeroFrame[3][0] = HeroFramehandle.create('O00E', \"Varcklen\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNEarthBrewmaster.blp\" )\r\n        set HeroFrame[3][1] = HeroFramehandle.create('O00I', \"Varcklen\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeadhunter.blp\" )\r\n        set HeroFrame[3][2] = HeroFramehandle.create('O00Z', \"LightBeam\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNDryad.blp\" )\r\n        set HeroFrame[3][3] = HeroFramehandle.create('O00N', \"ZiHeLL\", 1, \"war3mapImported\\\\BTNSummonWaterElemental.blp\" )  \r\n        set HeroFrame[3][4] = HeroFramehandle.create('O017', \"Eric\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNWitchDoctor.blp\" )\r\n        set HeroFrame[3][5] = HeroFramehandle.create('O01N', \"faceroll and ZiHeLL\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeroBloodElfPrince.blp\" )\r\n        set HeroFrame[3][6] = HeroFramehandle.create('U00T', \"Varcklen\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeroLich.blp\" )\r\n        set HeroFrame[3][7] = HeroFramehandle.create('O00T', \"Varcklen\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNUnbroken.blp\" )\r\n        set HeroFrame[3][8] = HeroFramehandle.create('O01O', \"ZiHeLL\", 2, \"war3mapImported\\\\BTNEasterWabbit.blp\" )\r\n        //set HeroFrame[3][9] = HeroFramehandle.create('N03P', \"ZiHeLL\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNDruidOfTheClaw.blp\" ) TEST\r\n        \r\n        set HeroFrame[3][0].story = \"Cho is a peppy beer monk who wanders the world in search of new types of drinks. His life is full of fun and travel. Due to his martial arts skills, he was nicknamed the \\\"Beer Fighter\\\".\"\r\n        set HeroFrame[3][1].story = \"A cunning troll houndmaster from the jungles of Stranglethorn, he is as much a hunter as a warrior. With sharp eyes and quick reflexes, he commands his fierce companion—a massive, snarling hound bred for tracking and tearing prey. Armed with a finely balanced throwing spear, he strikes with deadly precision from afar, using hit-and-run tactics honed in the dense wilderness. His bond with his pet is unbreakable; together, they move silently through the shadows, stalking targets and defending their tribe. Wary of outsiders but fiercely loyal to his own, he blends tribal tradition with deadly efficiency. His deep connection to nature and beasts makes him a master of survival, a predator who thrives where others fall. In battle, his spear flies true, and his hound’s growl signals doom for any who cross their path.\"\r\n        set HeroFrame[3][2].story = \"A guardian of the ancient forests, she moves with the grace of the wind through towering trees and tangled vines. As a dryad, she embodies the spirit of nature—fierce, protective, and deeply connected to the land. Her weapon of choice is a finely crafted throwing spear, balanced perfectly to strike from a distance with lethal accuracy. Silent and elusive, she watches over sacred groves, punishing those who threaten the balance with swift, precise attacks. Her connection to the forest allows her to meld with shadows and disappear among leaves, making her a deadly huntress. Though gentle and nurturing to the creatures she protects, she becomes an unstoppable force when defending her home, her spear flying like a streak of lightning to quell any who dare harm the wild.\"\r\n        set HeroFrame[3][3].story = \"Created by collective effort of greatest Mages and Alchemists, Lye is abnormally destructive mindless doll. He is almost a disaster in his magical body, poisoning lives and disrupting not only physical, but even mental health of those who appear nearby.\"\r\n        set HeroFrame[3][4].story = \"Once, Erks tribes homelands were bound in great arcane mysteries, teeming with magic which sought manipulatable hosts. Slowly it seeped into his tribe and loved ones, irreparably blackening their thoughts and dreams. Before Erk was fully enveloped, he was able to break out and ran wherever he could. Although free, the magic still lingers within - swarming the mind with entropic visions of hate. Erk believes however, he could potentially harness this magic to help others where he once could not.\"\r\n        set HeroFrame[3][5].story = \"A child of noble birth, educated at esteemed schools. He began poetry at 19, and after gaining worldwide fame as one of the best minstrels in the Northern Kingdoms he is approached by a mysterious man. After some time together, the man bestows a power upon Jaskier which allows him to sew magic into his poems.\"\r\n        set HeroFrame[3][6].story = \"Once a powerful mortal mage, he embraced undeath to transcend mortality, becoming a feared Skeleton Lord and Lich. Cloaked in tattered robes and crowned with bones, he commands legions of skeletal warriors, raising them from the earth with dark magic fueled by forbidden rituals. His eyes glow with eerie blue fire, reflecting centuries of arcane mastery and cold ambition. Ruthless and calculating, he bends death itself to his will, turning battlefields into graveyards teeming with endless undead. His thirst for power drives him to seek ancient relics and lost knowledge, willing to sacrifice anything for dominance. Though once a man, he now exists as a shadow of his former self—an immortal tyrant ruling through fear and necromantic might, his presence a blight upon the living world.\"\r\n        set HeroFrame[3][7].story = \"Born from the void’s deepest shadows, the Lord of Chaos is a faceless enigma, shrouded in swirling darkness and endless whispers. Neither bound by form nor fate, it wields a massive hammer forged from warped voidstone, a weapon that shatters reality itself with every strike. A master of chaos magic, it bends the very fabric of existence, unraveling order and sowing discord wherever it treads. Its presence distorts minds and warps landscapes, leaving madness in its wake. Silent and inscrutable, it commands legions of twisted servants born from chaos’s raw power. Neither friend nor foe to any, it moves beyond morality—an agent of entropy dedicated to breaking down the walls between worlds. Where it treads, laws unravel, and certainty crumbles, heralding an age of chaos and ruin.\"\r\n        set HeroFrame[3][8].story = \"Bonnie and Bor Rise and real bros. They rarely brawl, but more rarely win. Never are bored and they rest undisturbed. Don't tolerate robbery and less so for snobbery. They break all the eggs and wear some rags. Bravo, i guess.\"\r\n        //set HeroFrame[3][9].story = \"The Atero bloodline is known for the works of many infamous druids, Furrih being one of them. He got struck with lycanthropy in his youth, which changed his life completely. Now he is a valuable warrior on the Arena, as Furrih is both known for his physical power of a lycan and magical abilities of a druid. \"\r\n        \r\n        call HeroFrame[3][0].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_HEAL, 0, 0)\r\n        call HeroFrame[3][1].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_SUMMONER, 0, 0)\r\n        call HeroFrame[3][2].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_SUMMONER, ROLE_SUPPORT, 0)\r\n        call HeroFrame[3][3].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_MAGIC_DAMAGE, ROLE_HEAL, 0)\r\n        call HeroFrame[3][4].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_HEAL, 0, 0)\r\n        call HeroFrame[3][5].AddRoles(ROLE_SUPPORT, ROLE_HEAL, 0, 0)\r\n        call HeroFrame[3][6].AddRoles(ROLE_SUMMONER, 0, 0, 0)\r\n        call HeroFrame[3][7].AddRoles(ROLE_DEFEND, ROLE_MAGIC_DAMAGE, ROLE_PHYSICAL_DAMAGE, ROLE_HEAL)\r\n        call HeroFrame[3][8].AddRoles(ROLE_SUMMONER, ROLE_MAGIC_DAMAGE, ROLE_CONTROL, 0)\r\n        //call HeroFrame[3][9].AddRoles(ROLE_PHYSICAL_DAMAGE, 0, 0, 0)\r\n        \r\n        call HeroFrame[3][0].SetAlternativeUnique('A0IJ')\r\n        call HeroFrame[3][1].SetAlternativeUnique('A0MW')\r\n        call HeroFrame[3][2].SetAlternativeUnique('A0JJ')\n        call HeroFrame[3][3].SetAlternativeUnique('A0FS')\n        call HeroFrame[3][4].SetAlternativeUnique('A13G')\n        call HeroFrame[3][5].SetAlternativeUnique('A0CR')\r\n        call HeroFrame[3][6].SetAlternativeUnique('A0IP')\r\n        call HeroFrame[3][7].SetAlternativeUnique('A0IS')\n        call HeroFrame[3][8].SetAlternativeUnique('A1BD')\r\n        \r\n        // Marauder\r\n        set HEROES_IN_CLASS[4] = 9\r\n        set HeroFrame[4][0] = HeroFramehandle.create('O00J', \"Varcklen\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNForestTrollShadowPriest.blp\" )\r\n        set HeroFrame[4][1] = HeroFramehandle.create('O00B', \"Varcklen\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNBandit.blp\" )\r\n        set HeroFrame[4][2] = HeroFramehandle.create('O015', \"Infoneral\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeroAlchemist.blp\" )\r\n        set HeroFrame[4][3] = HeroFramehandle.create('O01A', \"ZiHeLL\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNKeeperOfTheGrove.blp\" )\r\n        set HeroFrame[4][4] = HeroFramehandle.create('O01L', \"Lichloved\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNKeeperGhostBlue.blp\" )\r\n        set HeroFrame[4][5] = HeroFramehandle.create('O01Z', \"Sadtwig\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNAncientOfWonders.blp\" )\r\n        set HeroFrame[4][6] = HeroFramehandle.create('O00Q', \"Varcklen\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNProudmoore.blp\" )\r\n        set HeroFrame[4][7] = HeroFramehandle.create('O019', \"Mike\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNAbomination.blp\" )\r\n        set HeroFrame[4][8] = HeroFramehandle.create('O01I', \"Yoti Coyote\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNMeatWagon.blp\" )\r\n        \r\n        set HeroFrame[4][0].story = \"A brilliant troll miracle alchemist, he blends ancient tribal knowledge with arcane science to create potent concoctions that defy nature. His throwing potions explode in bursts of flame, frost, or venom, turning the tide of battle with unpredictable force. Driven by curiosity and a desire to prove his mastery, he experiments relentlessly, crafting elixirs rumored to heal the gravest wounds or unleash devastating curses. His wild hair and vibrant tattoos mark him as both a shaman and a scientist, revered and feared in equal measure. With a keen mind and quick reflexes, he strikes from the shadows, tossing volatile mixtures that disrupt enemy ranks and bolster allies. Though unpredictable, his loyalty to his tribe is unwavering—he fights not only for survival but to elevate his people through the miraculous power of alchemy.\"\r\n        set HeroFrame[4][1].story = \"A rugged pirate hailing from the storm-battered coasts, he commands respect with his fierce gaze and weathered axe. Clad in patchwork armor and bearing a battered shield, he fights with a blend of brute strength and tactical defense, carving through foes with savage efficiency. Years on the high seas have sharpened his instincts and hardened his resolve, making him as dangerous in close combat as he is cunning in navigation and plunder. Fiercely loyal to his crew but ruthless to enemies, he thrives in the chaos of naval battles and island skirmishes. His laughter echoes over roaring waves, masking a mind as sharp as his blade. Driven by freedom and fortune, he sails where others fear, always chasing the next prize and the endless horizon.\"\r\n        set HeroFrame[4][2].story = \"A sly troll gambler known across taverns and back alleys, he thrives on risk and chance, trusting luck as much as skill. His spears are quick and precise, thrown with deadly accuracy, while his fists deliver brutal, unpredictable strikes in close combat. Always wearing a crooked grin, he’s as comfortable at the card table as on the battlefield, reading opponents’ tells as easily as their moves. His life is a high-stakes game where every throw of dice could mean fortune or ruin. Known for his sharp wit and even sharper reflexes, he blends cunning and combat seamlessly. Though his loyalty shifts with the wind, his fierce pride keeps him true to those few he calls allies. His reputation as both a formidable fighter and a master gambler precedes him—none can predict where he’ll strike next or what odds he’ll chase.\"\r\n        set HeroFrame[4][3].story = \"Drawzi is an expert banana dealer, and sees a great profit available on the way. His methods are questionable at best, but no one ever complained about the quality of the product, yet. He is able to pick up new tricks and strategies on go from others, all in the name of friendship and tax fraud.\"\r\n        set HeroFrame[4][4].story = \"A shadowy wraith bound by a dark Faustian pact, he wields forbidden magic drawn from realms beyond mortal comprehension. Cloaked in whispers and cold mist, he commands powers that twist souls and unravel reality itself. His very presence chills the air, a reminder of the price paid for power that defies death and destiny. Once a mortal who sought immortality, he sacrificed his humanity to become an eternal agent of shadow and decay. His magic corrupts and consumes, bending foes to his will or shattering them in torment. Silent and relentless, he moves unseen through the mortal world, weaving curses and dark bargains with a voice that promises salvation at a terrible cost. Feared by those who know of him and unknown to most, he walks a lonely path between life and oblivion, forever bound to the pact that fuels his terrible might.\"\r\n        set HeroFrame[4][5].story = \"Odo the Runesmith is a magical creature that can carve powerful Runes from Rocks. He seems to lack emotions and acts rather rough, but he helps out other creatures in weird ways whenever he can. All in all a pretty nice fellow.\"\r\n        set HeroFrame[4][6].story = \"Crusoe is a seasoned ship captain who paid the price for his greed. After the crash of his personal ship in a fight with pirates, he made a deal with a certain pharmaceutical company, which promised him an amnesty in exchange for collecting unusual components from around the world. Now the admiral has gone to the arena, as he has learned that there may be many valuable artifacts for him and his employers.\"\r\n        set HeroFrame[4][7].story = \"A grotesque abomination stitched from flesh and greed, they lumber through battlefields with a monstrous hook in hand, their swollen form bulging with stolen gold and treasure. Created by dark sorcery to be both vault and enforcer, their very body is a twisted hoard, glinting with coins and gems pressed beneath skin and sinew. They strike fear into foes with brutal swings of their hook, dragging enemies close to devour or crush. Driven by insatiable hunger for wealth, they are as cunning as they are terrifying, using their bulk and treasure-laden form to intimidate and overpower. Though a creature of nightmare, they hold fragments of a tormented mind—an eternal prisoner of avarice, forever burdened by the weight of their golden curse. In their wake lies ruin and riches, a living vault of greed and violence.\"\r\n        set HeroFrame[4][8].story = \"A hulking abomination of flesh and bone, the Meat Wagon lumbers across battlefields as a living engine of destruction. Its grotesque body bristles with spikes and openings that launch deadly projectiles—rotting corpses, jagged bones, and toxic bile—turning the battlefield into a maelstrom of decay. Despite its monstrous form, it possesses an uncanny instinct for unearthing gold hidden deep beneath the earth, drawn by an unnatural hunger for wealth. This dual nature makes it both a terrifying weapon and a reluctant prospector, tearing through enemies while unearthing treasure amid the carnage. Driven by dark necromantic forces, it moves with relentless purpose, spreading ruin wherever it roams. Feared by all, it is a living siege engine and a cursed scavenger, embodying death, decay, and greed—an unstoppable force forged in the darkest magics of the undead.\"\r\n        \r\n        call HeroFrame[4][0].AddRoles(ROLE_MAGIC_DAMAGE, 0, 0, 0)\r\n        call HeroFrame[4][1].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_SUPPORT, 0, 0)\r\n        call HeroFrame[4][2].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_SUMMONER, 0, 0)\r\n        call HeroFrame[4][3].AddRoles(ROLE_DEFEND, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[4][4].AddRoles(ROLE_SUPPORT, ROLE_SUMMONER, ROLE_MAGIC_DAMAGE, 0)\r\n        call HeroFrame[4][5].AddRoles(ROLE_SUPPORT, 0, 0, 0)\r\n        call HeroFrame[4][6].AddRoles(ROLE_SUPPORT, ROLE_HEAL, ROLE_PHYSICAL_DAMAGE, 0)\r\n        call HeroFrame[4][7].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_DEFEND, 0, 0)\r\n        call HeroFrame[4][8].AddRoles(ROLE_MAGIC_DAMAGE, 0, 0, 0)\r\n        \r\n        // Assassin\r\n        set HEROES_IN_CLASS[5] = 9\r\n        set HeroFrame[5][0] = HeroFramehandle.create('N004', \"Varcklen\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNNagaSummoner.blp\" )\r\n        set HeroFrame[5][1] = HeroFramehandle.create('N019', \"Varcklen\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeroBlademaster.blp\" )\r\n        set HeroFrame[5][2] = HeroFramehandle.create('N02K', \"VAT01\", 0, \"war3mapImported\\\\BTNRifleman_Kul-Tiras_HD_noTC.blp\" )\r\n        set HeroFrame[5][3] = HeroFramehandle.create('N057', \"stonebludgeon\", 0, \"war3mapImported\\\\BTNskinvaleera.blp\" )  \r\n        set HeroFrame[5][4] = HeroFramehandle.create('N02E', \"Varcklen\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNRifleman.blp\" )\r\n        set HeroFrame[5][5] = HeroFramehandle.create('N04M', \"vatk0end\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeroWarden.blp\" )\r\n        set HeroFrame[5][6] = HeroFramehandle.create('N02G', \"ZiHeLL\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNPriestessOfTheMoon.blp\" )\r\n        set HeroFrame[5][7] = HeroFramehandle.create('N032', \"Varcklen\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNBansheeRanger.blp\" )\r\n        set HeroFrame[5][8] = HeroFramehandle.create('N04K', \"Leviolon\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNArchimonde.blp\" )\r\n\r\n        set HeroFrame[5][0].story = \"A graceful yet deadly mermaid among the naga, she rules the sunken reefs with poise and power. Her sleek, scaled tail propels her swiftly through the ocean depths, while her spear—a finely crafted weapon of coral and enchanted steel—strikes with precision and lethal force. Born from the ancient union of sea and sorcery, she commands both the currents and the creatures of the deep, protecting her realm from intruders with fierce determination. Her voice carries haunting melodies that can soothe or summon storms, a testament to her deep connection with the ocean’s mysteries. Though serene in appearance, she is a formidable warrior, blending beauty with deadly skill. Her loyalty to her people is unshakable, and she fights not only for survival but for the preservation of the ocean’s sacred balance.\"\r\n        set HeroFrame[5][1].story = \"An orc samurai forged in the crucible of honor and battle, he wields a gleaming katana with disciplined precision. Raised in a clan that blends orcish strength with the ancient ways of the samurai, he follows a strict code of bushido—valor, loyalty, and respect guide his every action. His massive frame contrasts with the elegance of his swordplay, striking a balance between raw power and refined technique. Scarred by countless conflicts, he moves with quiet confidence, each strike deliberate and deadly. Fiercely protective of his clan and traditions, he seeks to prove that honor can thrive even amidst war and chaos. His presence commands respect on the battlefield, where he fights not just for victory but to uphold a legacy of dignity and strength. In a world torn by conflict, he is a warrior of principle—a living symbol of discipline and might.\"\r\n        set HeroFrame[5][2].story = \"A rugged human gun master, he carves his own path with grit and ingenuity. Forging his weapon by hand, his homemade shotgun roars with a thunderous blast that echoes through the wild frontiers. Skilled in both crafting and combat, he combines raw talent with precise marksmanship, making every shot count. His eyes, sharp and calculating, miss nothing as he navigates dangerous lands where law and order are scarce. A survivor at heart, he trusts his wits and his shotgun above all else, relying on quick reflexes and clever traps to outsmart foes. Though rough around the edges, his sense of justice runs deep—he fights for those who cannot defend themselves, carving out a reputation as a fierce protector. In a world where danger lurks at every turn, he stands ready, his homemade shotgun always loaded and aimed.\"\r\n        set HeroFrame[5][3].story = \"A cunning human jester, she weaves laughter and chaos with deadly grace. Her sharp daggers flash like lightning, hidden beneath colorful sleeves, while her enchanted playing cards slice through the air with precision and flair. Trained in both performance and subterfuge, she uses misdirection and charm to disarm foes before striking swiftly. Her laughter masks a sharp mind and a darker edge, making her unpredictable in both court and combat. Whether flipping cards to distract or plunging daggers in shadows, she thrives in the delicate dance between humor and danger. Once a performer in noble courts, she now walks a darker path—using wit and weaponry to navigate a world where trust is rare and betrayal is a game. Her every act is a calculated gamble, and she plays to win, no matter the cost.\"\r\n        set HeroFrame[5][4].story = \"Crazymeister is an elderly old man from a quiet village. He went on a journey to improve his rifle, which he affectionately calls \\\"Mary Sue\\\". Rumor has it that the old man went crazy, but no one has ever said the exact statements.\"\r\n        set HeroFrame[5][5].story = \"A shadow among shadows, she moves silently through moonlit forests and ruined temples, embodying the deadly grace of a grim ninja. As a night elf, her connection to the night deepens her stealth and agility, allowing her to vanish like a wisp of smoke before striking with twin daggers honed for silent lethality. Hardened by loss and driven by a relentless sense of duty, she operates alone, carrying out covert missions that others dare not face. Her eyes—sharp and unwavering—miss nothing in the darkness. Wrapped in shadowy garb, she blends seamlessly with the night, a ghost of vengeance and precision. Every kill is swift, leaving no trace but a whispered warning. Though she walks a lonely path, her resolve is ironclad—she is both protector and executioner, wielding death with quiet honor beneath the eternal moon.\"\r\n        set HeroFrame[5][6].story = \"A devoted priestess of the moon goddess, she is bound by a sacred oath to protect the wild and the feline spirits she reveres. A night elf of serene beauty and fierce resolve, she wields a bow with unmatched precision, each arrow guided by the grace of the hunt. Her constant companion is a majestic white tiger, a symbol of purity and strength, stalking silently at her side through dense forests and ancient ruins. Obsessed with cats of all kinds, she honors them as sacred guardians and embodiments of nature’s mystery. Her rituals blend ancient magic with the primal instincts of the wild, granting her heightened senses and agility. Calm yet fierce, she fights to preserve the balance between light and shadow, her loyalty to the cat spirits unwavering. Together with her tiger, she prowls the wilderness—a silent sentinel of moonlit justice. Meow meow mew meow meow. Meow, meow meew meow! Meow. Meow mew meoowwww.\"\r\n        set HeroFrame[5][7].story = \"A haunting figure cloaked in shadow, she is an undead elf who has mastered the deadly art of the shadow archer. Her bow, forged from cursed wood and imbued with dark magic, sings death with every arrow loosed. She blends supernatural precision with arcane shadows, weaving spells that cloak her movements and sap the strength of her enemies. Once a proud night elf, now bound by undeath, she walks the twilight between worlds—neither fully alive nor at rest. Cold and calculating, her eyes burn with eerie light, revealing a soul twisted by loss and vengeance. Silent and deadly, she strikes from the darkness, her attacks leaving victims drained and broken. Driven by a grim purpose, she serves the shadows willingly, embracing the power that corruption grants, becoming an unstoppable force that haunts battlefields and shatters hope with every shot.\"\r\n        set HeroFrame[5][8].story = \"A malevolent demon born in the fiery depths of the Twisting Nether, he is a feared Soul Stealer who wields dark magic to harvest the essence of the living. Cloaked in shadows and flames, his presence chills the air, and his eyes burn with unholy hunger. With every incantation, he rends souls from mortal bodies, fueling his power and spreading despair. Ruthless and cunning, he strikes fear into the hearts of enemies, manipulating dark energies to corrupt and consume. His form shifts like smoke and shadow, allowing him to appear and vanish at will. Driven by insatiable greed for souls, he serves neither god nor master, bound only to his own dark ambitions. Wherever death lingers, he follows, a predator of spirits who leaves nothing but emptiness and ruin in his wake.\"\r\n\r\n        call HeroFrame[5][0].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[5][1].AddRoles(ROLE_PHYSICAL_DAMAGE, 0, 0, 0)\r\n        call HeroFrame[5][2].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[5][3].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[5][4].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_HEAL, ROLE_PHYSICAL_DAMAGE, 0)\r\n        call HeroFrame[5][5].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[5][6].AddRoles(ROLE_SUMMONER, ROLE_PHYSICAL_DAMAGE, 0, 0)\r\n        call HeroFrame[5][7].AddRoles(ROLE_PHYSICAL_DAMAGE, ROLE_SUPPORT, 0, 0 )\r\n        call HeroFrame[5][8].AddRoles(ROLE_MAGIC_DAMAGE, 0, 0, 0)\r\n\r\n        // Elementalist\r\n        set HEROES_IN_CLASS[6] = 8\r\n        set HeroFrame[6][0] = HeroFramehandle.create('N039', \"VAT01\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNWispSplode.blp\" )\r\n        set HeroFrame[6][1] = HeroFramehandle.create('N04H', \"Wondershovel\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNShaman.blp\" )\r\n        set HeroFrame[6][2] = HeroFramehandle.create('N02P', \"Cotya_Ra\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeroAvatarOfFlame.blp\" )\r\n        set HeroFrame[6][3] = HeroFramehandle.create('N046', \"Sheepy\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNFootman.blp\" )\r\n        set HeroFrame[6][4] = HeroFramehandle.create('N02T', \"ZiHeLL\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNGuldan.blp\" )\r\n        set HeroFrame[6][5] = HeroFramehandle.create('N049', \"ZiHeLL\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNVengeanceIncarnate.blp\" )\r\n        set HeroFrame[6][6] = HeroFramehandle.create('N001', \"Varcklen\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNOwlBear.blp\" )\r\n        set HeroFrame[6][7] = HeroFramehandle.create('N00Y', \"Varcklen\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNBanditMage.blp\" )\r\n        \r\n        set HeroFrame[6][0].story = \"A flickering wisp of pure energy, it pulses with crackling electricity that dances across its ethereal form. Born from the heart of stormy skies and ancient ley lines, this Energy Ball harnesses raw electrical power, unleashing devastating bolts that arc with deadly precision. Though small and seemingly fragile, its unpredictable bursts of energy can stun or obliterate foes in an instant. It drifts silently through the air, guided by instinct and ancient magic, drawn to sources of power and conflict alike. Its vibrant glow illuminates dark places, a beacon of both danger and mystery. Untethered to any form, it embodies the storm’s fury—a living spark of nature’s wrath. Neither friend nor foe, it serves as a wild force of elemental destruction, a fleeting spark that ignites chaos wherever it wanders.\"\r\n        set HeroFrame[6][1].story = \"A fierce orc warrior known as the Thunderous Nomad, he roams the vast plains wielding the raw power of lightning itself. Born under stormy skies, his body crackles with electric energy, channeled through his fists and weapons to devastating effect. Clad in rugged armor scarred by countless battles, he harnesses the fury of storms, striking enemies with thunderous blows that leave scorch marks and shattered defenses. His nomadic life has hardened him, making him both resilient and unpredictable in combat. Driven by a deep connection to the storm spirits of his ancestors, he seeks to prove his strength and honor through battle, carrying the wild power of the tempest wherever he travels. Feared and respected, he is a living storm—unstoppable, relentless, and electrifying every fight with the fury of thunder.\"\r\n        set HeroFrame[6][2].story = \"A blazing inferno given form, the Pyrolord is a mighty fire elemental whose very essence burns with unquenchable fury. Born from the heart of a volcano and tempered in the crucible of elemental chaos, he commands flames that consume all in their path. His fiery hands shape torrents of fire into weapons of destruction, unleashing searing waves and blazing spears with relentless intensity. Driven by a primal hunger for destruction and renewal, he embodies both the destructive and cleansing power of fire. His molten core pulses with raw energy, and his presence ignites the air around him, scorching the earth beneath his feet. Feared by foes and revered by allies, he burns with purpose—wielding flame to incinerate enemies and purify the world through relentless firestorm. A living embodiment of fire’s wrath, he is unstoppable and eternal.\"\r\n        set HeroFrame[6][3].story = \"A master of metal magic, this human Metal Mage wields the very essence of iron and steel with uncanny precision. Combining arcane mastery with martial skill, he channels enchanted metal to shape his sword and shield mid-battle, forging weapons and defenses as fluidly as a blacksmith crafts his wares. His shield gleams with runes that deflect both physical and magical attacks, while his sword slices through armor and flesh alike, enhanced by his metallic spells. Trained in ancient lore and combat, he balances raw power with disciplined technique, standing firm as a bulwark against chaos. His presence on the battlefield inspires allies and unnerves enemies, for he can summon chains to bind foes or hurl shards of razor-sharp metal with deadly accuracy. A guardian of order and strength, he embodies the resilience and versatility of metal—unyielding, sharp, and ever adaptable.\"\r\n        set HeroFrame[6][4].story = \"Van always dreamed about starting a cult of his own. His twisted ideals led to him becoming a warlock, but he knew that was not the way of gaining support in the masses. Using the newly acquired powers in the strangest manners imaginable, he soon became a great healer as well, but could never overcome his sadistic nature.\"\r\n        set HeroFrame[6][5].story = \"Shaderosia was formed out of the Abyss Matter itself. It has no goal other than slowly devastating, decimating and, eventually, devouring everything on its way. Erasing bosses is not her true intention, but Shaderosia wouldn’t mind doing it regardless.\"\r\n        set HeroFrame[6][6].story = \"A mystical Moon Owl among the Moonkin, he channels the serene yet fierce power of the moon itself. Cloaked in feathers that shimmer with silver and indigo, he moves with silent grace beneath the night sky. His connection to lunar magic allows him to summon beams of radiant moonlight and weave illusions that confuse and weaken his foes. As a guardian of the natural order, he calls upon the tides and celestial cycles, harnessing their ebb and flow to heal allies or strike enemies with blinding bursts of lunar energy. Wise and contemplative, he is deeply attuned to the balance between light and shadow, night and day. In battle, his haunting hoots echo through the darkness as he unleashes powerful moon spells, a celestial sentinel whose power waxes and wanes with the phases of the moon.\"\r\n        set HeroFrame[6][7].story = \"No one knows for sure where, how and why time exists, but many believe that Tempus is involved in the events of the creation of the World. Little is known about Tempus, but what is known about him only raises new questions. It is known that this mysterious traveler arrived at the arena to get rid of a temporary anomaly that occurred in these parts.\"\r\n        \r\n        call HeroFrame[6][0].AddRoles(ROLE_MAGIC_DAMAGE, 0, 0, 0)\r\n        call HeroFrame[6][1].AddRoles(ROLE_MAGIC_DAMAGE, 0, 0, 0)\r\n        call HeroFrame[6][2].AddRoles(ROLE_MAGIC_DAMAGE, 0, 0, 0)\r\n        call HeroFrame[6][3].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_PHYSICAL_DAMAGE, ROLE_SUMMONER, ROLE_DEFEND)\r\n        call HeroFrame[6][4].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_HEAL, 0, 0)\r\n        call HeroFrame[6][5].AddRoles(ROLE_MAGIC_DAMAGE, 0, 0, 0)\r\n        call HeroFrame[6][6].AddRoles(ROLE_MAGIC_DAMAGE, 0, 0, 0)\r\n        call HeroFrame[6][7].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_PHYSICAL_DAMAGE, 0, 0)\r\n        \r\n        // Healer\r\n        set HEROES_IN_CLASS[7] = 9\r\n        set HeroFrame[7][0] = HeroFramehandle.create('N002', \"Varcklen\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNDruidOfTheTalon.blp\" )\r\n        set HeroFrame[7][1] = HeroFramehandle.create('N02S', \"Varcklen\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNMurgulShadowCaster.blp\" )\r\n        set HeroFrame[7][2] = HeroFramehandle.create('N01M', \"Cotya_Ra\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeroPaladin.blp\" )\r\n        set HeroFrame[7][3] = HeroFramehandle.create('N02Q', \"Varcklen\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNDranaiMage.blp\" ) \r\n        set HeroFrame[7][4] = HeroFramehandle.create('N04A', \"Ratman\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNYouDirtyRat!.blp\" )\r\n        set HeroFrame[7][5] = HeroFramehandle.create('N017', \"faceroll\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNCorruptedEnt.blp\" )\r\n        set HeroFrame[7][6] = HeroFramehandle.create('N038', \"Varcklen\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHarpyWitch.blp\" )\r\n        set HeroFrame[7][7] = HeroFramehandle.create('N01R', \"regint\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNKelThuzad.blp\" )\r\n        set HeroFrame[7][8] = HeroFramehandle.create('N04W', \"Yoti Coyote\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNDestroyer.blp\" )\r\n\r\n        set HeroFrame[7][0].story = \"Since childhood, Bob has loved to enjoy his parents' garden in Nordel. When Bob was strong enough, he left his hometown to become a druid. However, by the end of his training, his hometown was struck by an unknown corruption. Upon learning of this, this young druid decided to figure out how to get rid of this disease. He learned that if he went to the arena, he could find answers.\"\r\n        set HeroFrame[7][1].story = \"A mysterious Swamp Witch among the murlocs, she dwells deep in the murky wetlands, weaving dark voodoo magic to protect her territory. Covered in swamp moss and adorned with bones and charms, she commands the spirits of the marsh to curse and confound her enemies. Her rituals summon poisonous fogs and restless spirits that haunt those who dare enter her domain. With her eerie chants and eerie presence, she bends nature’s darkest forces to her will, turning the swamp into a deadly trap. Fierce and cunning, she uses voodoo dolls and hexes to weaken foes before striking with sharp claws or twisted spells. Feared even by other murlocs, she walks the fine line between the living world and the spirit realm, a guardian of ancient swamp secrets who wields magic as wild and unpredictable as the marsh itself.\"\r\n        set HeroFrame[7][2].story = \"A steadfast Paladin devoted to the Light, he walks the path of righteousness with unwavering faith. Clad in gleaming armor, he wields a mighty hammer imbued with holy power, each strike delivering justice and healing. His command of light magic allows him to shield allies from harm and smite darkness with radiant fury. As a preacher of the Light, he inspires hope in the hearts of the weary and stands as a bulwark against evil’s encroachment. His voice carries the wisdom of ancient scriptures, rallying comrades with sermons of courage and redemption. Bound by duty and honor, he journeys across war-torn lands, seeking to purge corruption and protect the innocent. Calm yet fierce, his presence brings both comfort and judgment—a living beacon in the shadowed world, wielding light and hammer to uphold the sacred vow of justice.\"\r\n        set HeroFrame[7][3].story = \"A wise Draenei Mentor, he carries the weight of centuries in his calm, compassionate gaze. Trained in the ancient arts of healing magic, he mends wounds and restores hope on the battlefield. His hands glow with a soft, soothing light, able to draw pain from the injured and bolster the weary spirit. More than a healer, he is a guide and teacher, imparting knowledge and strength to younger warriors and mages alike. His presence brings calm amid chaos, and his words inspire courage and resilience. Though peaceful by nature, he will fiercely protect those under his care, turning healing magic into a weapon against despair and darkness. Rooted in the Draenei’s deep connection to the Light, he embodies patience, wisdom, and unwavering dedication—a beacon of hope and guidance in a world scarred by conflict.\"\r\n        set HeroFrame[7][4].story = \"A cunning Ratman Shaman, he channels the primal forces of the rat clans with fierce devotion. His wiry frame and keen eyes hide a deep connection to the ancient spirits of the underworld and the swarming power of vermin. Using rat magic, he commands swarms of rats to overwhelm enemies, summons plagues that weaken foes, and manipulates shadows to slip unseen through the darkest alleys. His rituals involve bones, herbs, and the whispered voices of ancestors, binding him to the ever-present cycle of decay and survival. Fierce yet clever, he uses his magic both for protection and revenge, defending his clan with ferocity born of desperation. Feared by many, respected by few, he walks the line between life and death, a master of shadows and vermin who wields rat magic as both shield and spear in the unforgiving world he calls home.\"\r\n        set HeroFrame[7][5].story = \"A beech sapling that spent several years at the base of a factory that manufactures chemicals, warped over time by corruption and eventually grew sentience. The tree uprooted itself and left to wander the earth aimlessly. Beechbone encountered many situations that changed his perspective on man, and so he avoids them and dislikes them. He prefers to use his healing powers on animals and other flora and fauna.\"\r\n        set HeroFrame[7][6].story = \"A fierce harpy, she soars on powerful wings through stormy skies, her cry echoing like thunder across the mountains. Gifted with primal magic, she channels the raw forces of nature—winds that tear through forests and lightning that scorches the earth beneath her talons. Fiercely protective of her clan and territory, she uses her magic to summon storms and unleash elemental fury upon intruders. Her wild spirit is tempered by a deep connection to the ancient land, drawing strength from the earth and sky alike. Agile and relentless, she strikes swiftly, her primal spells weaving destruction with every beat of her wings. Revered by her kin and feared by enemies, she embodies the untamed wilderness—an elemental force of nature bound to neither mercy nor surrender, wielding primal magic as both weapon and shield in the eternal dance of survival.\"\r\n        set HeroFrame[7][7].story = \"A sinister figure shrouded in tattered robes and a beaked mask, this Plague Doctor is a necromancer who commands dark magic to spread pestilence and decay. Once a healer, he now walks a twisted path, using his knowledge of disease and death to manipulate life’s fragile threads. With a touch, he can summon plagues that rot flesh and weaken armies, while raising the dead to serve as his unyielding minions. His eerie presence chills the air, and his whispered incantations bring despair to those who hear them. Obsessed with the balance between life and death, he experiments with forbidden rituals, harnessing darkness to bend mortality to his will. Feared by friend and foe alike, he wields death itself as a weapon—both a harbinger of destruction and a dark guardian of secrets lost to time.\"\r\n        set HeroFrame[7][8].story = \"A mysterious Living Altar, part living construct and part ancient Sphinx, it stands as a silent guardian of forgotten rites and shadowed knowledge. Carved from obsidian and bone, its form pulses with dark magic, serving as both vessel and conduit for eldritch power. Rituals performed upon its surface summon shadows that twist and writhe, unleashing curses and hexes upon those who dare defile its sacred ground. Neither fully alive nor dead, it exists beyond mortal understanding—an eternal sentinel bound by ancient pacts. Its eyes glow with a cold, arcane light, watching over secrets lost to time, while its dark magic seeps into the earth, corrupting and bending reality. Feared by those who respect its power and reviled by those who seek to exploit it, the Living Altar wields darkness as both shield and weapon—a monument to forgotten gods and relentless shadows.\"\r\n\r\n        call HeroFrame[7][0].AddRoles(ROLE_HEAL, ROLE_SUMMONER, 0, 0)\r\n        call HeroFrame[7][1].AddRoles(ROLE_HEAL, 0, 0, 0)\r\n        call HeroFrame[7][2].AddRoles(ROLE_HEAL, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[7][3].AddRoles(ROLE_HEAL, ROLE_SUPPORT, 0, 0)\r\n        call HeroFrame[7][4].AddRoles(ROLE_HEAL, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[7][5].AddRoles(ROLE_HEAL, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        call HeroFrame[7][6].AddRoles(ROLE_HEAL, ROLE_SUPPORT, 0, 0)\r\n        call HeroFrame[7][7].AddRoles(ROLE_HEAL, ROLE_SUPPORT, 0, 0 )\r\n        call HeroFrame[7][8].AddRoles(ROLE_HEAL, ROLE_MAGIC_DAMAGE, 0, 0)\r\n        \r\n        // Sorcerer\r\n        set HEROES_IN_CLASS[8] = 8\r\n        set HeroFrame[8][0] = HeroFramehandle.create('O00K', \"Varcklen\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNHeroTinker.blp\" )\r\n        set HeroFrame[8][1] = HeroFramehandle.create('O00X', \"Varcklen\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNSatyrTrickster.blp\" )\r\n        set HeroFrame[8][2] = HeroFramehandle.create('O01Y', \"Rena\", 0, \"ReplaceableTextures\\\\CommandButtons\\\\BTNWindSerpent.blp\" )\r\n        set HeroFrame[8][3] = HeroFramehandle.create('O018', \"ZiHeLL\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNPriest.blp\" )\r\n        set HeroFrame[8][4] = HeroFramehandle.create('O01J', \"Lichloved\", 1, \"ReplaceableTextures\\\\CommandButtons\\\\BTNRevenant.blp\" )\r\n        set HeroFrame[8][5] = HeroFramehandle.create('O014', \"Shkolion and h3ts\", 1, \"war3mapImported\\\\BTNKingOfGhouls_Icon.blp\" )\r\n        set HeroFrame[8][6] = HeroFramehandle.create('O00D', \"Varcklen\", 2, \"BTNSpell_Shadow_SummonVoidWalker.blp\" )\r\n        set HeroFrame[8][7] = HeroFramehandle.create('O016', \"Rena\", 2, \"ReplaceableTextures\\\\CommandButtons\\\\BTNForgottenOne.blp\" )\r\n        \r\n        set HeroFrame[8][0].story = \"A wild-eyed goblin Demoman, he thrives on chaos and the thunderous roar of explosions. Fueled by an insatiable love for explosives and gunpowder, he crafts bombs and grenades with reckless precision, turning battlefields into fiery infernos. His quick hands and cunning mind allow him to rig traps and detonate blasts that shatter enemy lines, sowing panic and destruction. Always eager to test new volatile concoctions, his laughter echoes amidst the smoke and debris. Despite his reckless tendencies, he is fiercely loyal to his allies, using his volatile arsenal to protect them at all costs. His greasy goggles and soot-streaked face are marks of a lifetime spent in fiery chaos. A master of destruction and innovation, he is the embodiment of goblin ingenuity and mayhem—wielding explosions as both weapon and art, reveling in the beautiful chaos only he can create.\"\r\n        set HeroFrame[8][1].story = \"An ancient monster that devours the dreams and memories of living beings. It used to live in Nordel, but now it feeds on the weaknesses of the gladiators of the arena.\"\r\n        set HeroFrame[8][2].story = \"A scientist named Mengeles had been experimenting with extracts, in search of potent reagents had messed up an equation and discovered a nightmarish transformation instead. Paralysis had consumed them and they fell into a coma. Mengeles awoke years later, no longer a reknown scientist, but now known as The Plague. His abandoned laboratory too confining, and some human curiosity made them set out in search of greater experiments.\"\r\n        set HeroFrame[8][3].story = \"Referi is a prime ice wizard, unrivalled in his ability. It is a common knowledge that he once froze the entire fourth wall just to melt it with his hot elbows. Truth be told, he is actually a machine, a divine construct of the Gods themselves.\"\r\n        set HeroFrame[8][4].story = \"Once a noble protector, this Fallen One is a knight corrupted by darkness and despair. Betrayed by those he once served, he now wanders the shadowed realms, wielding dark magic that twists souls and shatters hope. His armor, blackened and scarred, bears the marks of countless battles lost to inner torment. With a haunting presence, he summons shadowy tendrils and curses to rend his foes, blending martial skill with necromantic power. Though consumed by darkness, flickers of his former honor linger, driving a relentless fury against those who betray or threaten the innocent. A tragic figure caught between light and shadow, he fights not only for vengeance but for a chance at redemption. In the cursed silence of his march, he embodies the price of fallen ideals—a dark sentinel forever bound to a path of ruin and reluctant salvation.\"\r\n        set HeroFrame[8][5].story = \"Rising from the depths of the grave, this Ghoul King commands legions of the undead with a chilling intellect and ruthless will. Unlike common ghouls, his cunning mind wields dark magic with devastating precision, summoning shadows that sap the strength of his enemies. With a single incantation, he resurrects fallen ghouls, swelling his ranks with relentless warriors bound to his command. His twisted crown of bone marks him as a ruler feared by both living and dead, a strategist who bends death itself to his will. Cold and calculating, he stalks battlefields with unyielding purpose, orchestrating waves of decay and destruction. Though his heart beats no longer, his ambition burns fiercely—seeking dominion over the realms of the living and the dead alike, a dark sovereign crowned by necromantic power and boundless malice.\"\r\n        set HeroFrame[8][6].story = \"An ominous Evil Spirit, it drifts through the mortal realm as a haunting presence of sorrow and vengeance. Born from restless souls twisted by pain and betrayal, it wields dark magic that corrupts and consumes. Its ethereal form flickers like smoke, invisible to most but felt as a chilling cold that seeps into the bones. It manipulates shadows to strike fear and despair, casting curses that unravel minds and bodies alike. Driven by anger and unfinished business, it lingers between worlds, a malevolent force seeking to claim the living for its spectral dominion. With every whispered incantation, it drains life and hope, weaving darkness as both shield and weapon. Neither bound by flesh nor mercy, the Evil Spirit embodies relentless torment—a restless echo of death’s cruelty, forever entwined with the shadows it commands.\"\r\n        set HeroFrame[8][7].story = \"An initial encounter with a sluglike tentacle that had sprout from the ground marked the start of an inquiry into the great beyond and inevitably led to the establishment of the council. This same council eventually had an epiphany, \\\"We stand like this tentacle, planted in the earth, but what if the great beyond is near us, only above our heads?\\\" Members of the council took to the skies with Azathot in search of astral magics that may lead them to achieving greatness and a better understanding of the crawling chaos that inhabited these lands.\"\r\n        \r\n        call HeroFrame[8][0].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_CONTROL, 0, 0)\r\n        call HeroFrame[8][1].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_PHYSICAL_DAMAGE, 0, 0)\r\n        call HeroFrame[8][2].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_CONTROL, 0, 0)\r\n        call HeroFrame[8][3].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_CONTROL, 0, 0)\r\n        call HeroFrame[8][4].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_SUPPORT, 0, 0)\r\n        call HeroFrame[8][5].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_CONTROL, ROLE_SUMMONER, 0)\r\n        call HeroFrame[8][6].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_SUPPORT, 0, 0)\r\n        call HeroFrame[8][7].AddRoles(ROLE_MAGIC_DAMAGE, ROLE_SUMMONER, 0, 0)\r\n        \r\n        set Event_DatabaseLoaded = 0.00\r\n        set Event_DatabaseLoaded = 1.00\r\n        set Event_DatabaseLoaded = 0.00\r\n    endfunction\r\n\r\n    //===========================================================================\r\n    private function init takes nothing returns nothing\r\n        local trigger delay = CreateTrigger()\r\n        \r\n        call TriggerRegisterTimerEvent(delay,1.,false)\r\n\t\tcall TriggerAddAction(delay,function Database)\r\n        \r\n        set delay = null\r\n    endfunction\r\n\r\nendlibrary",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}