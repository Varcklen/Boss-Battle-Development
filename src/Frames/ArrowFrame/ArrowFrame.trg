  "Id": 50332290,
  "Comment": "",
  "IsScript": true,
  "RunOnMapInit": false,
  "Script": "scope ArrowFrame initializer init\r\n\r\n\tglobals\r\n\t    private framehandle arrowframe = null\r\n\t    private constant real TICK = 0.04\r\n\t    private constant real SPEED = 0.005\r\n\t    private constant real HEIGHT_MIN = 0.2\r\n\t    private constant real HEIGHT_MAX = 0.24\r\n\t    \r\n\t    private constant integer SHOW_ARROW_MAX_LEVEL = 5\r\n\tendglobals\r\n\t\r\n\tprivate function ArrowMoveCast takes nothing returns nothing\r\n\t    local integer id = GetHandleId( GetExpiredTimer() )\r\n\t    local integer c = LoadInteger( udg_hash, id, StringHash( \"arrow_frame_direction\" ) )\r\n\t    local real y = LoadReal( udg_hash, id, StringHash( \"arrow_frame_position_y\" ) ) + c * SPEED\r\n\t\r\n\t\tif udg_fightmod[0] then\r\n\t\t\tcall BlzFrameSetVisible( arrowframe, false )\r\n\t        call FlushChildHashtable( udg_hash, id )\r\n\t        call DestroyTimer( GetExpiredTimer() )\r\n\t\telse\r\n\t        call BlzFrameSetAbsPoint(arrowframe, FRAMEPOINT_CENTER, 0.4, y)\r\n\t\t\tcall SaveReal( udg_hash, id, StringHash( \"arrow_frame_position_y\" ), y )\r\n\t\t\tif y > HEIGHT_MAX or y < HEIGHT_MIN then\r\n\t\t\t\tcall SaveInteger( udg_hash, id, StringHash( \"arrow_frame_direction\" ), -c )\r\n\t\t\tendif\r\n\t\tendif\r\n\tendfunction\r\n\t\r\n\tprivate function IsDisableAnimation takes nothing returns boolean\r\n\t\tlocal integer i = 0\r\n\t\t\r\n\t\tloop\r\n\t\t\texitwhen i >= 4\r\n\t\t\tif GetPlayerSlotState( Player(i) ) == PLAYER_SLOT_STATE_PLAYING and udg_LvL[i + 1] <= SHOW_ARROW_MAX_LEVEL then\r\n\t\t\t\treturn false\r\n\t\t\tendif\r\n\t\t\tset i = i + 1\r\n\t\tendloop\r\n\t\treturn true\r\n\tendfunction\r\n\t\r\n\tprivate function ArrowFrame takes nothing returns nothing\r\n\t\tlocal integer id\r\n\t\tlocal timer timerUsed\r\n\t\r\n\t\tset arrowframe = BlzCreateFrameByType(\"BACKDROP\", \"\", BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), \"StandartFrameTemplate\", 0)\r\n        call BlzFrameSetAbsPoint(arrowframe, FRAMEPOINT_CENTER, 0.4, 0.2)\t\r\n\t\tcall BlzFrameSetSize(arrowframe, 0.025, 0.025)\r\n        call BlzFrameSetTexture(arrowframe, \"FrameArrow.blp\", 0, true)\r\n\t\tcall BlzFrameSetVisible( arrowframe, false )\r\n\t\t\t\r\n\t\tif IsDisableAnimation() then\r\n\t\t\treturn\r\n\t\tendif\r\n\t\t\r\n\t\tset timerUsed = CreateTimer()\r\n\t\tset id = GetHandleId(timerUsed) \r\n\t\tcall SaveInteger( udg_hash, id, StringHash( \"arrow_frame_direction\" ), 1 )\r\n\t\tcall SaveReal( udg_hash, id, StringHash( \"arrow_frame_position_y\" ), HEIGHT_MIN )\r\n\t\tcall TimerStart( timerUsed, TICK, true, function ArrowMoveCast )\r\n\t\t\r\n\t\tset timerUsed = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnRepick takes nothing returns nothing\r\n\t\tif GetLocalPlayer() == Event_HeroRepick_Player then\r\n\t        call BlzFrameSetVisible( arrowframe, false )\r\n\t    endif\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnReadyButtonClick takes nothing returns nothing\r\n\t\tlocal player user = ReadyButtonClick.GetDataPlayer(\"player\")\r\n\t\tif GetLocalPlayer() == user then\r\n\t        call BlzFrameSetVisible( arrowframe, false )\r\n\t    endif\r\n\t    set user = null\r\n\tendfunction\r\n\t\r\n\t//===========================================================================\r\n\tprivate function OnHeroChoise takes nothing returns nothing\r\n\t\tif GetLocalPlayer() == Event_HeroChoose_Player and udg_LvL[Event_HeroChoose_Index] <= SHOW_ARROW_MAX_LEVEL then\r\n\t        call BlzFrameSetVisible( arrowframe, true )\r\n\t    endif\r\n\tendfunction\r\n\r\n\t//===========================================================================\r\n\tprivate function init takes nothing returns nothing\r\n\t    set gg_trg_ArrowFrame = CreateTrigger(  )\r\n\t    call TriggerRegisterTimerExpireEvent( gg_trg_ArrowFrame, udg_StartTimer )\r\n\t    call TriggerAddAction( gg_trg_ArrowFrame, function ArrowFrame )\r\n\t    \r\n\t    call CreateEventTrigger( \"Event_HeroChoose_Real\", function OnHeroChoise, null )\r\n\t    call CreateEventTrigger( \"Event_HeroRepick_Real\", function OnRepick, null )\r\n\t    call ReadyButtonClick.AddListener(function OnReadyButtonClick, null)\r\n\tendfunction\r\n\r\nendscope",
  "Events": [],
  "LocalVariables": [],
  "Conditions": [],
  "Actions": []
}