  "RunOnMapInit": false,
  "Script": "library ForgeOtherLib initializer init requires Forge\r\n\t\r\n\tfunction FortuneDeck takes unit caster, item itm returns nothing\r\n\t\tlocal integer cyclA = 2\r\n\t\tlocal integer array it\r\n\t\tlocal integer k = LoadInteger( udg_hash, GetHandleId(itm), StringHash( \"frtdk\" ) )\r\n\t\tlocal boolean l\r\n\t\r\n\t    //Нельзя иметь [-1] в локали\r\n\t\tset it[0] = 0\r\n\t\tset it[1] = 0\r\n\t\tloop\r\n\t\t\texitwhen cyclA > 4\r\n\t\t\tset it[cyclA] = udg_DB_Tarot[GetRandomInt( 1, udg_Database_NumberItems[4] )]\r\n\t\t\tif (it[cyclA] == it[cyclA-1] or it[cyclA] == it[cyclA-2]) then\r\n\t\t\t\tset cyclA = cyclA - 1\r\n\t\t\tendif\r\n\t\t\tset cyclA = cyclA + 1\r\n\t\tendloop\r\n\t\r\n\t    call BlzSetItemExtendedTooltip( itm, words( caster, BlzGetItemDescription(itm), \"|cFF959697(\", \")|r\", I2S(2-k) + \"/2\" ) ) // sadtwig\r\n\t    //call BlzSetItemIconPath( itm, words( caster, BlzGetItemDescription(itm), \"|cFF959697(\", \")|r\", I2S(2-k) + \"/2\" ) )\r\n\t\tif k < 1 then\r\n\t\t\tset l = false\r\n\t\telse\r\n\t\t\tset l = true\r\n\t\tendif\r\n\t\r\n\t\tcall forge( caster, itm, it[2], it[3], it[4], l )\r\n\t    \r\n\t    set caster = null\r\n\t    set itm = null\r\n\tendfunction\r\n\t\r\n\tfunction MimicOrb takes unit caster, item itm returns nothing\r\n\t\tlocal integer cyclA = 2\r\n\t\tlocal integer array it\r\n\t\tlocal integer k = LoadInteger( udg_hash, GetHandleId(itm), StringHash( \"mmco\" ) )\r\n\t\tlocal boolean l\r\n\t\r\n\t    //Нельзя иметь [-1] в локали\r\n\t\tset it[0] = 0\r\n\t\tset it[1] = 0\r\n\t\tloop\r\n\t\t\texitwhen cyclA > 4\r\n\t\t\tset it[cyclA] = udg_DB_Orb[GetRandomInt( 1, udg_Database_NumberItems[8] )]\r\n\t\t\tif (it[cyclA] == it[cyclA-1] or it[cyclA] == it[cyclA-2]) then\r\n\t\t\t\tset cyclA = cyclA - 1\r\n\t\t\tendif\r\n\t\t\tset cyclA = cyclA + 1\r\n\t\tendloop\r\n\t\r\n\t    call BlzSetItemExtendedTooltip( itm, words( caster, BlzGetItemDescription(itm), \"|cFF959697(\", \")|r\", I2S(2-k) + \"/2\" ) ) // sadtwig\r\n\t    //call BlzSetItemIconPath( itm, words( caster, BlzGetItemDescription(itm), \"|cFF959697(\", \")|r\", I2S(2-k) + \"/2\" ) )\r\n\t\tif k < 1 then\r\n\t\t\tset l = false\r\n\t\telse\r\n\t\t\tset l = true\r\n\t\tendif\r\n\t\r\n\t\tcall forge( caster, itm, it[2], it[3], it[4], l )\r\n\t    \r\n\t    set caster = null\r\n\t    set itm = null\r\n\tendfunction\r\n\t\r\n\tglobals\r\n\t\tprivate constant integer SANDRO_CHARGES = 10\r\n\tendglobals\r\n\t\r\n\tfunction Sandro takes unit caster, item itm returns nothing\r\n\t\tlocal integer cyclA = 2\r\n\t\tlocal integer array it\r\n\t\tlocal integer k = LoadInteger( udg_hash, GetHandleId(itm), StringHash( \"snddk\" ) )\r\n\t\tlocal boolean l\r\n\t\r\n\t    //Нельзя иметь [-1] в локали\r\n\t\tset it[0] = 0\r\n\t\tset it[1] = 0\r\n\t\tloop\r\n\t\t\texitwhen cyclA > 4\r\n\t\t\tset it[cyclA] = DB_Items[2][GetRandomInt( 1, udg_Database_NumberItems[2] )]\r\n\t\t\tif (it[cyclA] == it[cyclA-1] or it[cyclA] == it[cyclA-2]) and udg_Database_NumberItems[2] > 2 then\r\n\t\t\t\tset cyclA = cyclA - 1\r\n\t\t\tendif\r\n\t\t\tset cyclA = cyclA + 1\r\n\t\tendloop\r\n\t\r\n\t    call BlzSetItemExtendedTooltip( itm, words( caster, BlzGetItemDescription(itm), \"|cFF959697(\", \")|r\", I2S( SANDRO_CHARGES - k ) + \"/\" + I2S(SANDRO_CHARGES) ) ) // sadtwig\r\n\t\tset l = k >= SANDRO_CHARGES - 1\r\n\t\r\n\t\tcall forge( caster, itm, it[2], it[3], it[4], l )\r\n\t    \r\n\t    set caster = null\r\n\t    set itm = null\r\n\tendfunction\r\n\t\r\n\tprivate function check takes nothing returns nothing\r\n\t\tlocal integer itemType = Event_AfterForge_ForgedItem\r\n\t\tlocal unit caster = Event_AfterForge_Hero\r\n\t\tlocal item forgedItem = Event_AfterForge_ForgedItem_Item\r\n\t\tlocal integer counter\r\n\t\tlocal integer id = GetHandleId(forgedItem)\r\n\t\t\r\n\t\r\n\t\tif itemType == 'I0C7' and forgedItem != null then\r\n\t\t\tset counter = LoadInteger( udg_hash, id, StringHash( \"frtdk\" ) ) + 1\r\n\t\t\tcall SaveInteger( udg_hash, id, StringHash( \"frtdk\" ), counter )\r\n\t\t\tcall FortuneDeck( caster, forgedItem )\r\n\t\tendif\r\n\t\tif itemType == 'I03F' and forgedItem != null then\r\n\t\t\tset counter = LoadInteger( udg_hash, id, StringHash( \"snddk\" ) ) + 1\r\n\t\t\tcall SaveInteger( udg_hash, id, StringHash( \"snddk\" ), counter )\r\n\t\t\tcall Sandro( caster, forgedItem )\r\n\t\tendif\r\n\t    if itemType == 'I0EN' and forgedItem != null then\r\n\t\t\tset counter = LoadInteger( udg_hash, id, StringHash( \"mmco\" ) ) + 1\r\n\t\t\tcall SaveInteger( udg_hash, id, StringHash( \"mmco\" ), counter )\r\n\t\t\tcall MimicOrb( caster, forgedItem )\r\n\t\tendif\r\n\t\tif itemType == 'I0CA' then\r\n\t\t\tcall BlzSetItemIntegerFieldBJ( bj_lastCreatedItem, ITEM_IF_NUMBER_OF_CHARGES, 3 )\r\n\t        call UnitRemoveItem(caster, bj_lastCreatedItem)\r\n\t        call UnitAddItem(caster, bj_lastCreatedItem)\r\n\t\tendif\r\n\t    if itemType == 'I05H' then\r\n\t        call BlzSetItemExtendedTooltip( bj_lastCreatedItem, \"|cFFB20080Ditto|r|n\" + BlzGetItemExtendedTooltip(bj_lastCreatedItem) ) // sadtwig\r\n\t        //call BlzSetItemIconPath( bj_lastCreatedItem, \"|cFFB20080Ditto|r|n\" + BlzGetItemExtendedTooltip(bj_lastCreatedItem) )\r\n\t    endif\r\n\t    \r\n\t    set caster = null\r\n\t    set forgedItem = null\r\n\tendfunction\r\n\t\r\n\tprivate function init takes nothing returns nothing\r\n\t\tcall CreateEventTrigger( \"Event_AfterForge_Real\", function check, null )\r\n\tendfunction\r\n\r\nendlibrary",
